<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project Rule: Cannot import avalonia as a dependency here in logic -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.6" />
  </ItemGroup>

  <PropertyGroup>
    <CargoArgs Condition="'$(Configuration)' == 'Release'">--release</CargoArgs>
    <CargoArgs Condition="'$(Configuration)' != 'Release'"></CargoArgs>
    <CargoOutDir Condition="'$(Configuration)' == 'Release'">release</CargoOutDir>
    <CargoOutDir Condition="'$(Configuration)' != 'Release'">debug</CargoOutDir>
  </PropertyGroup>

  <Target Name="BuildNativeLibrary" BeforeTargets="BeforeBuild">
    <Exec
      Command="cargo build $(CargoArgs)"
      WorkingDirectory="../aethervk.core/cdylib"
      ContinueOnError="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <Warning
      Condition="'$(CargoExitCode)' != '0'"
      Text="Cargo build failed or cargo not found. Native library might be missing."
    />

    <ItemGroup>
      <Content
        Include="..\target\$(CargoOutDir)\aethervk_core_cdylib.dll"
        Link="aethervk_core_cdylib.dll"
        Condition="Exists('..\target\$(CargoOutDir)\aethervk_core_cdylib.dll')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="..\target\$(CargoOutDir)\libaethervk_core_cdylib.so"
        Link="libaethervk_core_cdylib.so"
        Condition="Exists('..\target\$(CargoOutDir)\libaethervk_core_cdylib.so')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="..\target\$(CargoOutDir)\libaethervk_core_cdylib.dylib"
        Link="libaethervk_core_cdylib.dylib"
        Condition="Exists('..\target\$(CargoOutDir)\libaethervk_core_cdylib.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>

      <!-- macOS Vulkan SDK binaries -->
      <Content
        Include="$(VULKAN_SDK)\macOS\lib\libvulkan.dylib"
        Link="vulkan\lib\libvulkan.dylib"
        Condition="'$(OS)' == 'Unix' And Exists('$(VULKAN_SDK)\macOS\lib\libvulkan.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="$(VULKAN_SDK)\macOS\lib\libvulkan.1.dylib"
        Link="vulkan\lib\libvulkan.1.dylib"
        Condition="'$(OS)' == 'Unix' And Exists('$(VULKAN_SDK)\macOS\lib\libvulkan.1.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="$(VULKAN_SDK)\macOS\lib\libvulkan.1.*.dylib"
        Link="vulkan\lib\%(Filename)%(Extension)"
        Condition="'$(OS)' == 'Unix' And Exists('$(VULKAN_SDK)\macOS\lib\libvulkan.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="$(VULKAN_SDK)\macOS\lib\libMoltenVK.dylib"
        Link="vulkan\lib\libMoltenVK.dylib"
        Condition="'$(OS)' == 'Unix' And Exists('$(VULKAN_SDK)\macOS\lib\libMoltenVK.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- macOS Vulkan Validation Layers (Debug only) -->
      <Content
        Include="$(VULKAN_SDK)\macOS\lib\libVkLayer_*.dylib"
        Link="vulkan\explicit_layer\%(Filename)%(Extension)"
        Condition="'$(OS)' == 'Unix' And '$(Configuration)' != 'Release' And Exists('$(VULKAN_SDK)\macOS\lib\libMoltenVK.dylib')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="$(VULKAN_SDK)\macOS\share\vulkan\explicit_layer.d\*.json"
        Link="vulkan\explicit_layer\%(Filename)%(Extension)"
        Condition="'$(OS)' == 'Unix' And '$(Configuration)' != 'Release' And Exists('$(VULKAN_SDK)\macOS\share\vulkan\explicit_layer.d')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content
        Include="$(VULKAN_SDK)\macOS\share\vulkan\icd.d\MoltenVK_icd.json"
        Link="vulkan\icd\MoltenVK_icd.json"
        Condition="'$(OS)' == 'Unix' And Exists('$(VULKAN_SDK)\macOS\share\vulkan\icd.d\MoltenVK_icd.json')"
      >
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
