<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        x:Class="AetherVk.Views.SpawnImageDialogWindow"
        x:DataType="vm:SpawnImageViewModel"
        Title="Spawn Image Billboard" Width="300" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Entity Name:" />
        <TextBox Text="{Binding EntityName}" />
        
        <CheckBox Content="Is Screen Space" IsChecked="{Binding IsScreenSpace}" Margin="0,10,0,0"/>

        <TextBlock Text="Width / Height:" />
        <Grid ColumnDefinitions="*, *">
            <TextBox Grid.Column="0" Text="{Binding Width}" Margin="0,0,5,0" />
            <TextBox Grid.Column="1" Text="{Binding Height}" />
        </Grid>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancelClick" />
            <Button Content="Spawn" Click="OnSpawnClick" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>