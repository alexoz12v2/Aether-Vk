<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             x:DataType="vm:HorizonJplViewModel"
             x:Class="AetherVk.Views.HorizonJplView">
  <Grid>
    <!-- Top Right Help Tooltip -->
    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Content="?" Width="30" Height="30" CornerRadius="15" Background="Transparent" Foreground="{DynamicResource Text.Secondary}" ZIndex="100">
      <ToolTip.Tip>
        <TextBlock Text="3-Step SPK Retrieval Process:&#x0a;1. Search for comets by observation period.&#x0a;2. Select a comet to view available SPK records.&#x0a;3. Select an SPK record and download it to your local machine." />
      </ToolTip.Tip>
    </Button>
    
    <ScrollViewer Margin="0,40,0,0">
      <StackPanel Spacing="16" Margin="10">
        
        <!-- Step 1: Comet Search -->
        <Expander Header="Step 1: Comet Search" HorizontalAlignment="Stretch" IsExpanded="{Binding IsStep1Expanded, Mode=TwoWay}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto" Margin="4">
              <TextBlock Grid.Column="0" Text="First Obs After:" VerticalAlignment="Center" Margin="0,0,8,0" />
              <DatePicker Grid.Column="1" SelectedDate="{Binding SearchStartTime}" Margin="0,0,8,0" HorizontalAlignment="Stretch" />

              <TextBlock Grid.Column="2" Text="First Obs Before:" VerticalAlignment="Center" Margin="0,0,8,0" />
              <DatePicker Grid.Column="3" SelectedDate="{Binding SearchStopTime}" HorizontalAlignment="Stretch" />
            </Grid>
            <Button Content="Search Comets" Command="{Binding SearchCometsCommand}" HorizontalAlignment="Right" Classes="accent" />
            
            <DataGrid x:Name="CometsResultDataGrid" ItemsSource="{Binding CometsData}" SelectedItem="{Binding SelectedComet}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400" Margin="0,10,0,0">
            </DataGrid>
            
            <Button Content="Next: Select Comet" Command="{Binding GoToStep2Command}" HorizontalAlignment="Right" Classes="accent" Margin="0,10,0,0" IsEnabled="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Expander>

        <!-- Step 2: SPK Record Enumeration -->
        <Expander Header="Step 2: SPK Records" HorizontalAlignment="Stretch" IsExpanded="{Binding IsStep2Expanded, Mode=TwoWay}" IsEnabled="{Binding IsStep2Enabled}">
          <StackPanel Spacing="10">
            <TextBlock Text="Select a comet from Step 1 to view its SPK records." IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNull}}" Foreground="{DynamicResource Text.Secondary}" Margin="10"/>
            
            <StackPanel IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="10">
              <DataGrid x:Name="SpkRecordsDataGrid" ItemsSource="{Binding SpkRecordsData}" SelectedItem="{Binding SelectedSpkRecord}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400" />
              <Button Content="Next: Select Record" Command="{Binding GoToStep3Command}" HorizontalAlignment="Right" Classes="accent" IsEnabled="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Step 3: Download SPK -->
        <Expander Header="Step 3: Download SPK" HorizontalAlignment="Stretch" IsExpanded="{Binding IsStep3Expanded, Mode=TwoWay}" IsEnabled="{Binding IsStep3Enabled}">
          <StackPanel Spacing="10">
            <TextBlock Text="Select an SPK record from Step 2 to download." IsVisible="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNull}}" Foreground="{DynamicResource Text.Secondary}" Margin="10"/>
            
            <StackPanel IsVisible="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="10" HorizontalAlignment="Center" Margin="20">
               <TextBlock Text="Ready to download SPK." FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
               <Button Content="Download and Save SPK" Command="{Binding DownloadAndSaveSpkCommand}" Classes="accent" FontSize="16" Padding="20,10"/>
               <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsDownloading}" Height="4" Margin="0,10,0,0"/>
               <Button Content="Start Over" Command="{Binding ResetWizardCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>