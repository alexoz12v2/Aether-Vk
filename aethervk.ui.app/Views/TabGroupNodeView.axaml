<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:TabGroupNodeViewModel"
             x:Class="AetherVk.Views.TabGroupNodeView">
  <Border BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1" Margin="2"
          Background="{DynamicResource Bg.Canvas}" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,0,0,1"
              Background="{DynamicResource Bg.Surface}" CornerRadius="6,6,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TabItemViewModel">

                    <Border Background="Transparent" CornerRadius="4" PointerPressed="OnTabPointerPressed">

                      <Border.Styles>
                        <Style Selector="Border:pointerover">
                          <Setter Property="Background" Value="{DynamicResource Bg.Hover}" />
                        </Style>
                      </Border.Styles>
                      <StackPanel Orientation="Horizontal" Spacing="4">

                        <Border Background="Transparent" ToolTip.Tip="Drag to Split"
                                PointerPressed="OnTabIconPointerPressed">
                          <PathIcon x:Name="TabDragHandle" Data="M2,2 L14,2 L14,14 L2,14 Z" Width="12" Height="12"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Accent.Primary}" />
                        </Border>

                        <TextBlock Text="{Binding Title}" Padding="4,6,4,6" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}" />
                        <Button Content="✕"
                                Width="20" Height="20" Padding="0"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="Close Tab"
                                Command="{Binding $parent[UserControl].((vm:TabGroupNodeViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="+"
                      Width="28" Height="28"
                      Padding="0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Add new tab"
                      Classes="accent">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="UI Test Panel" Command="{Binding AddNewTabCommand}" />
                    <MenuItem Header="Console" Command="{Binding AddNewConsoleTabCommand}" />
                    <MenuItem Header="Horizon JPL Data Viewer" Command="{Binding AddNewHorizonJplTabCommand}" />
                    <MenuItem Header="Timeline Editor" Command="{Binding AddNewTimelineTabCommand}" />
                    <MenuItem Header="Almanac Explorer" Command="{Binding AddNewAlmanacTabCommand}" />
                    <MenuItem Header="Outline" Command="{Binding AddNewOutlineTabCommand}" />
                    <MenuItem Header="Properties" Command="{Binding AddNewPropertiesTabCommand}" />
                    <MenuItem Header="Viewport 3D" Command="{Binding AddNewViewport3DTabCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              
              <Button Content="⇆"
                      Width="28" Height="28"
                      Padding="0" FontSize="18"
                      VerticalAlignment="Center" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Change Selected Tab"
                      IsVisible="{Binding HasTabs}">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="UI Test Panel" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="UITestPanel" />
                    <MenuItem Header="Console" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Console" />
                    <MenuItem Header="Debug UI" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="DebugUI" />
                    <MenuItem Header="Horizon JPL Data Viewer" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="HorizonJpl" />
                    <MenuItem Header="Timeline Editor" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Timeline" />
                    <MenuItem Header="Almanac Explorer" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Almanac" />
                    <MenuItem Header="Outline" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Outline" />
                    <MenuItem Header="Properties" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Properties" />
                    <MenuItem Header="Viewport 3D" Command="{Binding ChangeSelectedTabCommand}" CommandParameter="Viewport3D" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              
              <Button Content="✕"
                      Width="28" Height="28"
                      Padding="0" FontSize="14"
                      VerticalAlignment="Center" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Close All Tabs"
                      Command="{Binding CloseAllTabsCommand}"
                      IsVisible="{Binding HasTabs}" />

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding SelectedTab}" Margin="4" IsVisible="{Binding HasTabs}" />
      
      <Button Grid.Row="1" Content="+" Classes="accent" FontSize="48" Width="100" Height="100" 
              HorizontalAlignment="Center" VerticalAlignment="Center" 
              IsVisible="{Binding !HasTabs}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Button.Flyout>
              <MenuFlyout>
                  <MenuItem Header="UI Test Panel" Command="{Binding AddNewTabCommand}" />
                  <MenuItem Header="Console" Command="{Binding AddNewConsoleTabCommand}" />
                  <MenuItem Header="Horizon JPL Data Viewer" Command="{Binding AddNewHorizonJplTabCommand}" />
                  <MenuItem Header="Timeline Editor" Command="{Binding AddNewTimelineTabCommand}" />
                  <MenuItem Header="Almanac Explorer" Command="{Binding AddNewAlmanacTabCommand}" />
                  <MenuItem Header="Outline" Command="{Binding AddNewOutlineTabCommand}" />
                  <MenuItem Header="Properties" Command="{Binding AddNewPropertiesTabCommand}" />
                  <MenuItem Header="Viewport 3D" Command="{Binding AddNewViewport3DTabCommand}" />
              </MenuFlyout>
          </Button.Flyout>
      </Button>

      <Grid x:Name="PreviewOverlay" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.5">
        <Border x:Name="PreviewBox" Background="{DynamicResource Accent.Hover}" IsVisible="False" BorderThickness="2"
                CornerRadius="4">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.1" />
              <DoubleTransition Property="Height" Duration="0:0:0.1" />
            </Transitions>
          </Border.Transitions>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>