<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             x:DataType="vm:Viewport3DViewModel"
             x:Class="AetherVk.Views.Viewport3DView">
    <Grid>
        <Image x:Name="RenderTargetImage" Stretch="Uniform" Focusable="True"
               PointerPressed="OnPointerPressed"
               PointerReleased="OnPointerReleased"
               PointerMoved="OnPointerMoved"
               PointerWheelChanged="OnPointerWheelChanged"
               KeyDown="OnKeyDown" />

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="5" IsVisible="{Binding IsInitialized}">
            <Border Padding="5" CornerRadius="4" Background="#80000000">
                <Rectangle x:Name="LivelinessIndicator" Width="16" Height="16" Fill="Red" RadiusX="2" RadiusY="2" />
            </Border>
            
            <Border Padding="10,5" CornerRadius="4" Background="#80000000">
                <StackPanel>
                    <TextBlock Text="{Binding IsMeasuringMode, Converter={x:Static ObjectConverters.IsNull}}" FontSize="14" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Measuring Mode" IsVisible="{Binding IsMeasuringMode}" FontSize="14" FontWeight="Bold" Foreground="Yellow" />
                    <TextBlock Text="Normal Mode" IsVisible="{Binding !IsMeasuringMode}" FontSize="14" FontWeight="Bold" Foreground="LightGray" />
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointX, StringFormat='{}Point 1: [{0:F2}, '}" Foreground="White" FontSize="12"/>
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointY, StringFormat='{}{0:F2}, '}" Foreground="White" FontSize="12"/>
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointZ, StringFormat='{}{0:F2}]'}" Foreground="White" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <Border Background="#F0202020" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowNoIntersectionFlyout}">
            <StackPanel Spacing="15">
                <TextBlock Text="No intersection found." FontWeight="Bold" FontSize="16" Foreground="Yellow"/>
                
                <TextBlock Text="Do you want to place a point at arbitrary coordinates?" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBox Text="{Binding ManualMeasurementX}" Width="80" Watermark="X" />
                    <TextBox Text="{Binding ManualMeasurementY}" Width="80" Watermark="Y" />
                    <TextBox Text="{Binding ManualMeasurementZ}" Width="80" Watermark="Z" />
                    <Button Content="Submit Coordinates" Command="{Binding SubmitManualMeasurementCommand}" />
                </StackPanel>

                <TextBlock Text="Do you want to place it under cursor?" Foreground="White" Margin="0,10,0,0"/>
                <Button Content="Place Under Cursor" Command="{Binding SubmitCursorMeasurementCommand}" />

                <TextBlock Text="Do you want to undo the raycast?" Foreground="White" Margin="0,10,0,0"/>
                <Button Content="Undo Raycast" Command="{Binding UndoMeasurementRaycastCommand}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource Bg.Canvas}" Opacity="0.9" IsVisible="{Binding !IsInitialized}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <!-- Idle State -->
                <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
                    <TextBlock Text="Initialize Native Simulation Engine" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Are you sure you want to initialize the native 3D runtime and create the first scene?" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
                    <Button Content="Initialize Scene" Classes="accent" Command="{Binding InitializeSceneCommand}" HorizontalAlignment="Center" Padding="20,10" FontSize="16" />
                </StackPanel>

                <!-- Loading State -->
                <StackPanel IsVisible="{Binding IsLoading}" Spacing="16">
                    <TextBlock Text="Initializing Engine..." FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>