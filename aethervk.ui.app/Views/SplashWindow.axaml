<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AetherVk.Views.SplashWindow"
        Title="AetherVk Starting..."
        Width="500" Height="300"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    
    <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource HeroBackgroundBrush}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <TextBlock Text="AetherVk" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowDirectionEffect ShadowDepth="2" Direction="315" Color="Black" Opacity="0.5" BlurRadius="4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Simulation Engine Initialization..." FontSize="16" Foreground="#DDDDDD" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Width="300" Height="4" Margin="0,20,0,0" Foreground="White" Background="#40FFFFFF"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
