#version 450 core

// CPU side sets 16 x 16
layout(local_size_x_id = 0, local_size_y_id = 1) in;

// Output to 16-bit floating point texture GL_RGBA16F / VK_FORMAT_R16G16B16A16_SFLOAT
layout(rgba16f, binding = 0) writeonly uniform image2D octOutMap;

// hash function for stars
// https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
float hash(vec3 p) {
  return fract(sin(dot(p, vec3(12.9898, 4.1414, 5.7777))) * 43758.5453);
}

// Simple Fractional Brownian Motion for the Milky Way dust
float fbm(vec3 p) {
  float f = 0.0;
  float w = 0.5;
  for (int i = 0; i < 4; i++) {
    f += w * (hash(p) * 2.0 - 1.0); // Rough noise, replace with Simplex if more quality needed
    p *= 2.0;
    w *= 0.5;
  }

  return f;
}

vec3 generateSpace(vec3 dir) {
  // 1. Stars
  float h = hash(floor(dir * 800.0));
  float isStar = step(0.999, h);
  float starBrightness = pow(hash(dir * 123.4), 10.0) * 10.0;
  vec3 stars = vec3(isStar * starBrightness);

  // 2. Milky Way Band (oriented along XZ plane)
  float galacticPlane = exp(-pow(dir.y * 3.0, 2.0));
  float dust = smoothstep(0.0, 1.0, fbm(dir * 10.0) * 0.5 + 0.5);
  vec3 milkyWay = vec3(0.1, 0.2, 0.4) * galacticPlane * dust * 0.8;

  return stars + milkyWay;
}

// Decode 2D UV [0,1] into 3D direction according to octahedral projection
vec3 octDecode(vec2 uv) {
  vec2 v = uv * 2.0 - 1.0;
  vec3 n = vec3(v.x, v.y, 1.0 - abs(v.x) - abs(v.y));
  float t = max(-n.z, 0.0);
  n.x += n.x >= 0 ? -t : t;
  n.y += n.y >= 0 ? -t : t;
  return normalize(n);
}

void main() {
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(octOutMap);
  if (texelCoord.x >= size.x || texelCoord.y >= size.y) return;

  // Convert texel coordinate to UV [0,1]
  vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size);

  // Get 3D direction from octahedral UV
  vec3 dir = octDecode(uv);

  // Generate procedural color
  vec3 color = generateSpace(dir);

  // write to texture
  imageStore(octOutMap, texelCoord, vec4(color, 1.0));
}
