#version 450 core
#if defined(USE_VMM) && USE_VMM == 1
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
#endif
#extension GL_GOOGLE_include_directive : require

// CPU side sets 16 x 16
layout(local_size_x_id = 0, local_size_y_id = 1) in;

// Output to 16-bit floating point texture GL_RGBA16F / VK_FORMAT_R16G16B16A16_SFLOAT
layout(rgba16f, binding = 0) writeonly uniform image2D octOutMap;

// hash function for stars
// https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
float hash(vec3 p) {
  return fract(sin(dot(p, vec3(12.9898, 4.1414, 5.7777))) * 43758.5453);
}

// Smooth (trilinearly interpolated) value noise in [0,1]. The previous version
// fed `hash(p)` directly into the fbm, which is uncorrelated per-texel white noise,
// so the galactic band came out as a grainy streak rather than soft diffuse glow.
float valueNoise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float n000 = hash(i + vec3(0, 0, 0));
  float n100 = hash(i + vec3(1, 0, 0));
  float n010 = hash(i + vec3(0, 1, 0));
  float n110 = hash(i + vec3(1, 1, 0));
  float n001 = hash(i + vec3(0, 0, 1));
  float n101 = hash(i + vec3(1, 0, 1));
  float n011 = hash(i + vec3(0, 1, 1));
  float n111 = hash(i + vec3(1, 1, 1));
  return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
             mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

// Fractional Brownian Motion for the Milky Way glow, range roughly [-1,1]
float fbm(vec3 p) {
  float f = 0.0;
  float w = 0.5;
  for (int i = 0; i < 4; i++) {
    f += w * (valueNoise(p) * 2.0 - 1.0);
    p *= 2.0;
    w *= 0.5;
  }

  return f;
}

vec3 generateSpace(vec3 dir) {
  // 1. Stars
  float h = hash(floor(dir * 800.0));
  float isStar = step(0.999, h);
  float starBrightness = pow(hash(dir * 123.4), 10.0) * 10.0;
  vec3 stars = vec3(isStar * starBrightness);

  // 2. Milky Way Band (oriented along XZ plane)
  // Kept deliberately faint, wide and neutral (slightly warm white, like integrated
  // starlight) so it cannot be mistaken for a comet dust/ion tail. It used to be a
  // narrow saturated blue band (vec3(0.1,0.2,0.4) * 0.8) that read as a blue streak.
  float galacticPlane = exp(-pow(dir.y * 2.0, 2.0));
  float glow = smoothstep(0.0, 1.0, fbm(dir * 4.0) * 0.5 + 0.5);
  vec3 milkyWay = vec3(1.0, 0.96, 0.90) * galacticPlane * glow * 0.025;

  return stars + milkyWay;
}

// Decode 2D UV [0,1] into 3D direction according to octahedral projection
vec3 octDecode(vec2 uv) {
  vec2 v = uv * 2.0 - 1.0;
  vec3 n = vec3(v.x, v.y, 1.0 - abs(v.x) - abs(v.y));
  float t = max(-n.z, 0.0);
  n.x += n.x >= 0 ? -t : t;
  n.y += n.y >= 0 ? -t : t;
  return normalize(n);
}

void main() {
  ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(octOutMap);
  if (texelCoord.x >= size.x || texelCoord.y >= size.y) return;

  // Convert texel coordinate to UV [0,1]
  vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size);

  // Get 3D direction from octahedral UV
  vec3 dir = octDecode(uv);

  // Generate procedural color
  vec3 color = generateSpace(dir);

  // write to texture
  imageStore(octOutMap, texelCoord, vec4(color, 1.0));
}