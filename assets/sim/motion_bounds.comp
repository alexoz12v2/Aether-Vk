#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"
#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const uint PRIMITIVE_TYPE = 0;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    ParticleData primitive_data;
    uint num_primitives;
    float dt;
    float particle_radius;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x; if (idx >= pc.num_primitives) return;

    if (PRIMITIVE_TYPE == 0) {
        uint base = P_BASE(idx);
        vec3 pos = vec3(uintBitsToFloat(pc.primitive_data.data[base+0]), uintBitsToFloat(pc.primitive_data.data[base+1*SUBGROUP_SIZE]), uintBitsToFloat(pc.primitive_data.data[base+2*SUBGROUP_SIZE]));
        vec3 vel = vec3(uintBitsToFloat(pc.primitive_data.data[base+3*SUBGROUP_SIZE]), uintBitsToFloat(pc.primitive_data.data[base+4*SUBGROUP_SIZE]), uintBitsToFloat(pc.primitive_data.data[base+5*SUBGROUP_SIZE]));

        vec3 p1 = pos + vel * pc.dt;
        vec3 min_p = min(pos, p1) - vec3(pc.particle_radius), max_p = max(pos, p1) + vec3(pc.particle_radius);

        uint leaf_idx  = (pc.num_primitives - 1u) + idx;
        uint parent    = tlas_parent(pc.bvh, leaf_idx);
        uint is_right  = (tlas_child(pc.bvh, parent, 1u) == leaf_idx) ? 1u : 0u;

        tlas_write_min_x(pc.bvh, parent, is_right, min_p.x); tlas_write_max_x(pc.bvh, parent, is_right, max_p.x);
        tlas_write_min_y(pc.bvh, parent, is_right, min_p.y); tlas_write_max_y(pc.bvh, parent, is_right, max_p.y);
        tlas_write_min_z(pc.bvh, parent, is_right, min_p.z); tlas_write_max_z(pc.bvh, parent, is_right, max_p.z);
    }
}
