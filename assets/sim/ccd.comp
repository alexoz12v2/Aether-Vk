#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "gjk_cta_utils.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer particle_bvh;
    SparseCollisions output_list;
    ParticleData particles;
    uint root_index;
    uint total_particles;
    float particle_radius;
    float dt;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x; if (idx >= pc.total_particles) return;

    uint my_prim_id = idx, baseA = (my_prim_id / SUBGROUP_SIZE) * (10 * SUBGROUP_SIZE) + (my_prim_id % SUBGROUP_SIZE);
    vec3 my_center = vec3(pc.particles.data[baseA+0], pc.particles.data[baseA+1*SUBGROUP_SIZE], pc.particles.data[baseA+2*SUBGROUP_SIZE]);
    vec3 my_vel = vec3(pc.particles.data[baseA+3*SUBGROUP_SIZE], pc.particles.data[baseA+4*SUBGROUP_SIZE], pc.particles.data[baseA+5*SUBGROUP_SIZE]);
    vec3 p1 = my_center + my_vel * pc.dt;

    AABB my_aabb;
    my_aabb.minBounds = min(my_center - vec3(pc.particle_radius), p1 - vec3(pc.particle_radius));
    my_aabb.maxBounds = max(my_center + vec3(pc.particle_radius), p1 + vec3(pc.particle_radius));

    uint stack[64]; int stackPtr = 0; if (pc.root_index != 0xFFFFFFFFu) stack[stackPtr++] = pc.root_index;
    uint collisions_found = 0;

    while (stackPtr > 0) {
        uint node_idx = stack[--stackPtr];
        for (uint i = 0; i < SUBGROUP_SIZE; ++i) {
            if (!bvh_node_is_valid(pc.particle_bvh.nodes[node_idx].valid_mask, i)) continue;

            AABB bound;
            bound.minBounds = vec3(pc.particle_bvh.nodes[node_idx].min_x[i], pc.particle_bvh.nodes[node_idx].min_y[i], pc.particle_bvh.nodes[node_idx].min_z[i]);
            bound.maxBounds = vec3(pc.particle_bvh.nodes[node_idx].max_x[i], pc.particle_bvh.nodes[node_idx].max_y[i], pc.particle_bvh.nodes[node_idx].max_z[i]);

            if (intersectAABB(my_aabb, bound)) {
                uint meta = pc.particle_bvh.nodes[node_idx].metadata[i];
                uint offset = bvh_get_index(meta);

                if (bvh_is_leaf(meta)) {
                    if (my_prim_id < offset) {
                        float toi = 0.0, depth = 0.0; vec3 normal = vec3(0.0), point = vec3(0.0);
                        uint baseB = (offset / SUBGROUP_SIZE) * (10 * SUBGROUP_SIZE) + (offset % SUBGROUP_SIZE);
                        vec3 other_vel = vec3(pc.particles.data[baseB+3*SUBGROUP_SIZE], pc.particles.data[baseB+4*SUBGROUP_SIZE], pc.particles.data[baseB+5*SUBGROUP_SIZE]) * pc.dt;
                        mat4 transA = mat4(1.0); transA[3].xyz = my_center;
                        mat4 transB = mat4(1.0); transB[3].xyz = vec3(pc.particle_bvh.nodes[node_idx].com_x[i], pc.particle_bvh.nodes[node_idx].com_y[i], pc.particle_bvh.nodes[node_idx].com_z[i]);

                        if (compute_toi_generic(0, vec3(pc.particle_radius,0,0), transA, my_vel * pc.dt, 0, vec3(pc.particle_radius,0,0), transB, other_vel, 1e-3, 10, toi, normal, point, depth)) {
                            if (collisions_found < 16) {
                                uint outIdx = idx * 16 + collisions_found++;
                                pc.output_list.pairs[outIdx].valid = 1; pc.output_list.pairs[outIdx].prim_a = my_prim_id; pc.output_list.pairs[outIdx].prim_b = offset;
                                pc.output_list.pairs[outIdx].toi = toi; pc.output_list.pairs[outIdx].contact_normal = normal;
                                pc.output_list.pairs[outIdx].contact_point = point; pc.output_list.pairs[outIdx].penetration_depth = depth;
                            }
                        }
                    }
                } else if (offset != 0xFFFFFFFFu) stack[stackPtr++] = offset;
            }
        }
    }
}