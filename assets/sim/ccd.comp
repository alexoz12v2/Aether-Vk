// @assets/sim/narrow_ccd.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"
#include "imex_math.glsl"
#include "gjk_cta_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer particle_bvh;
    SparseCollisions output_list;
    ParticleData particles;
    uint root_index;
    uint total_particles;
    float particle_radius;
    float dt;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;

#ifdef DEBUG_SHADERS
    if (idx == 0) {
        debugPrintfEXT("======================================\n");
        debugPrintfEXT("narrow_ccd.comp : STARTED\n");
        debugPrintfEXT("Total Particles : %d\n", pc.total_particles);
        debugPrintfEXT("======================================\n");
    }
#endif

    if (idx >= pc.total_particles) return;

    // Use built-in subgroup size explicitly instead of a macro to guarantee alignment
    uint my_prim_id = idx;
    uint block_idx = my_prim_id / gl_SubgroupSize;
    uint local_idx = my_prim_id % gl_SubgroupSize;
    uint baseA = block_idx * (PARTICLE_FIELDS * gl_SubgroupSize) + local_idx;

    vec3 my_center = vec3(
        uintBitsToFloat(pc.particles.data[baseA + 0u * gl_SubgroupSize]),
        uintBitsToFloat(pc.particles.data[baseA + 1u * gl_SubgroupSize]),
        uintBitsToFloat(pc.particles.data[baseA + 2u * gl_SubgroupSize])
    );

    vec3 my_vel = vec3(
        uintBitsToFloat(pc.particles.data[baseA + 3u * gl_SubgroupSize]),
        uintBitsToFloat(pc.particles.data[baseA + 4u * gl_SubgroupSize]),
        uintBitsToFloat(pc.particles.data[baseA + 5u * gl_SubgroupSize])
    );

    vec3 p1 = my_center + my_vel * pc.dt;

    AABB my_aabb;
    my_aabb.minBounds = min(my_center - vec3(pc.particle_radius), p1 - vec3(pc.particle_radius));
    my_aabb.maxBounds = max(my_center + vec3(pc.particle_radius), p1 + vec3(pc.particle_radius));

    uint stack[64];
    int stackPtr = 0;
    if (pc.root_index != 0xFFFFFFFFu) stack[stackPtr++] = pc.root_index;

    uint collisions_found = 0;
    uint gjk_calls = 0;
    uint max_stack_depth = 0;

    while (stackPtr > 0) {
        uint node_idx = stack[--stackPtr];

        for (uint i = 0; i < gl_SubgroupSize; ++i) {
            if (!bvh_node_is_valid(tlas_valid_mask(pc.particle_bvh, node_idx), i)) continue;

            AABB bound;
            bound.minBounds = vec3(tlas_min_x(pc.particle_bvh, node_idx, i), tlas_min_y(pc.particle_bvh, node_idx, i), tlas_min_z(pc.particle_bvh, node_idx, i));
            bound.maxBounds = vec3(tlas_max_x(pc.particle_bvh, node_idx, i), tlas_max_y(pc.particle_bvh, node_idx, i), tlas_max_z(pc.particle_bvh, node_idx, i));

            if (intersectAABB(my_aabb, bound)) {
                uint meta   = tlas_metadata(pc.particle_bvh, node_idx, i);
                uint offset = bvh_get_index(meta);

                if (bvh_is_leaf(meta)) {
                    if (my_prim_id < offset) {
                        float toi = 0.0, depth = 0.0; vec3 normal = vec3(0.0), point = vec3(0.0);

                        uint b_block = offset / gl_SubgroupSize;
                        uint b_local = offset % gl_SubgroupSize;
                        uint baseB = b_block * (PARTICLE_FIELDS * gl_SubgroupSize) + b_local;

                        vec3 other_vel = vec3(
                            uintBitsToFloat(pc.particles.data[baseB + 3u * gl_SubgroupSize]),
                            uintBitsToFloat(pc.particles.data[baseB + 4u * gl_SubgroupSize]),
                            uintBitsToFloat(pc.particles.data[baseB + 5u * gl_SubgroupSize])
                        ) * pc.dt;

                        mat4 transA = mat4(1.0); transA[3].xyz = my_center;
                        mat4 transB = mat4(1.0); transB[3].xyz = vec3(tlas_com_x(pc.particle_bvh, node_idx, i), tlas_com_y(pc.particle_bvh, node_idx, i), tlas_com_z(pc.particle_bvh, node_idx, i));

                        gjk_calls++;

                        if (compute_toi_generic(0, vec3(pc.particle_radius,0,0), transA, my_vel * pc.dt, 0, vec3(pc.particle_radius,0,0), transB, other_vel, 1e-3, 10, toi, normal, point, depth)) {

                            collisions_found++;
                            uint outIdx = atomicAdd(pc.output_list.count, 1);

                            // FIX: Strict bounds check.
                            if (outIdx < pc.output_list.capacity) {
                                pc.output_list.pairs[outIdx].prim_a = my_prim_id;
                                pc.output_list.pairs[outIdx].prim_b = offset;
                                pc.output_list.pairs[outIdx].toi = toi;
                                pc.output_list.pairs[outIdx].contact_normal = normal;
                                pc.output_list.pairs[outIdx].contact_point = point;
                                pc.output_list.pairs[outIdx].penetration_depth = depth;
                                pc.output_list.pairs[outIdx].is_lca = 0;
                                pc.output_list.pairs[outIdx].lca_id = 0;
                                pc.output_list.pairs[outIdx].entity_a = 0xFFFFFFFFu;
                                pc.output_list.pairs[outIdx].entity_b = 0xFFFFFFFFu;
                            }
#ifdef DEBUG_SHADERS
                            else {
                                debugPrintfEXT("[narrow_ccd FATAL] SparseCollisions buffer overflow! Capacity: %d\n", pc.output_list.capacity);
                            }
#endif
                        }
                    }
                } else if (offset != 0xFFFFFFFFu) {
                    // FIX: Strict stack overflow protection
                    if (stackPtr < 64) {
                        stack[stackPtr++] = offset;
                        max_stack_depth = max(max_stack_depth, stackPtr);
                    }
#ifdef DEBUG_SHADERS
                    else {
                        debugPrintfEXT("[narrow_ccd FATAL] BVH Stack overflow for particle %d!\n", my_prim_id);
                    }
#endif
                }
            }
        }
    }

#ifdef DEBUG_SHADERS
    // DIAGNOSTIC: Flag excessive GJK calls (indicates poor BVH culling)
    if (gjk_calls > 100) {
        debugPrintfEXT("[narrow_ccd WARNING] Particle %d invoked GJK %d times! Found %d collisions. Max Stack: %d\n",
            my_prim_id, gjk_calls, collisions_found, max_stack_depth);
    }
#endif
}
