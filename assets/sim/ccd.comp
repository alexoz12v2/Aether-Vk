#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "../debug_utils.glsl"
#include "gjk_cta_utils.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct SparseCollisionData {
    uint valid;
    uint prim_a;
    uint prim_b;
    float toi;
    vec3 contact_normal;
    vec3 contact_point;
    float penetration_depth;
};

// Sparse array of collision flags/data
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer SparseCollisions {
    SparseCollisionData data[]; 
};

// Particles data
layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer ParticleData {
    float data[];
};

layout(push_constant, scalar) uniform PushConstants {
    BVHArray particle_bvh;
    SparseCollisions output_list;
    ParticleData particles;
    uint root_index;
    uint total_particles;
    float particle_radius;
    float dt;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_particles) return;

    BVHNodeAABB my_node = read_bvh_node(pc.particle_bvh, pc.total_particles - 1 + idx); // Leaf node
    uint my_prim_id = my_node.left_child_or_primitive_offset;
    AABB my_aabb = my_node.bound;

    if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("Hello from ccd.comp! my_prim_id=%d, aabb_min=(%f,%f,%f) aabb_max=(%f,%f,%f)\n", 
            my_prim_id, my_aabb.minBounds.x, my_aabb.minBounds.y, my_aabb.minBounds.z, 
            my_aabb.maxBounds.x, my_aabb.maxBounds.y, my_aabb.maxBounds.z);
    }

    uint stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = pc.root_index; 

    uint collisions_found = 0;
    const uint MAX_COLLISIONS_PER_THREAD = 16;

#define EVALUATE_CCD(other_prim_id, node_center) \
    do { \
        if (my_prim_id < other_prim_id) { \
            float toi = 0.0; \
            vec3 contact_normal = vec3(0.0); \
            vec3 contact_point = vec3(0.0); \
            float depth = 0.0; \
            uint blockA = my_prim_id / SG_SIZE; \
            uint locA = my_prim_id % SG_SIZE; \
            uint baseA = blockA * (10 * SG_SIZE) + locA; \
            uint blockB = other_prim_id / SG_SIZE; \
            uint locB = other_prim_id % SG_SIZE; \
            uint baseB = blockB * (10 * SG_SIZE) + locB; \
            /* Multiply velocities by dt to get the displacement step */ \
            vec3 my_vel = vec3(pc.particles.data[baseA + 3 * SG_SIZE], pc.particles.data[baseA + 4 * SG_SIZE], pc.particles.data[baseA + 5 * SG_SIZE]) * pc.dt; \
            vec3 other_vel = vec3(pc.particles.data[baseB + 3 * SG_SIZE], pc.particles.data[baseB + 4 * SG_SIZE], pc.particles.data[baseB + 5 * SG_SIZE]) * pc.dt; \
            mat4 transA = mat4(1.0); transA[3].xyz = my_node.center_of_mass; \
            mat4 transB = mat4(1.0); transB[3].xyz = node_center; \
            bool is_colliding = compute_toi_generic( \
                0, vec3(pc.particle_radius, 0.0, 0.0), transA, my_vel, \
                0, vec3(pc.particle_radius, 0.0, 0.0), transB, other_vel, \
                1e-3, 10, toi, contact_normal, contact_point, depth \
            ); \
            if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) { \
                debugPrintfEXT("EVALUATE_CCD: a=%d b=%d velA=(%f,%f,%f) velB=(%f,%f,%f) colliding=%d\n", \
                    my_prim_id, other_prim_id, my_vel.x, my_vel.y, my_vel.z, other_vel.x, other_vel.y, other_vel.z, is_colliding ? 1 : 0); \
            } \
            if (is_colliding && collisions_found < MAX_COLLISIONS_PER_THREAD) { \
                uint outIdx = idx * MAX_COLLISIONS_PER_THREAD + collisions_found; \
                pc.output_list.data[outIdx].valid = 1; \
                pc.output_list.data[outIdx].prim_a = my_prim_id; \
                pc.output_list.data[outIdx].prim_b = other_prim_id; \
                pc.output_list.data[outIdx].toi = toi; \
                pc.output_list.data[outIdx].contact_normal = contact_normal; \
                pc.output_list.data[outIdx].contact_point = contact_point; \
                pc.output_list.data[outIdx].penetration_depth = depth; \
                collisions_found++; \
            } \
        } \
    } while (false)

    while (stackPtr > 0) {
        uint node_idx = stack[--stackPtr];
        
        if (BRANCH_FACTOR == 2) {
            BVHNodeAABB node = read_bvh_node(pc.particle_bvh, node_idx);

            if (intersectAABB(my_aabb, node.bound)) {
                if (node.primitive_count > 0) {
                    uint other_prim_id = node.left_child_or_primitive_offset;
                    EVALUATE_CCD(other_prim_id, node.center_of_mass);
                } else {
                    if (node.left_child_or_primitive_offset != 0xFFFFFFFF) stack[stackPtr++] = node.left_child_or_primitive_offset;
                    if (node.right_child_offset != 0xFFFFFFFF) stack[stackPtr++] = node.right_child_offset;
                }
            }
        } else {
            MultiBVHBlockArray multi_bvh = MultiBVHBlockArray(pc.particle_bvh);
            uint node_valid = GET_MULTI_BVH_VALID_COUNT(multi_bvh, node_idx);
            for (uint i = 0; i < BRANCH_FACTOR; ++i) {
                if (i >= node_valid) break;
                AABB bound;
                GET_MULTI_BVH_BOUND(multi_bvh, node_idx, i, bound);
                if (intersectAABB(my_aabb, bound)) {
                    bool isLeaf;
                    uint offset;
                    GET_MULTI_BVH_LEAF_INFO(multi_bvh, node_idx, i, isLeaf, offset);
                    if (isLeaf) {
                        uint other_prim_id = offset;
                        vec3 node_center = (bound.minBounds + bound.maxBounds) * 0.5; // Approximation for particle center
                        EVALUATE_CCD(other_prim_id, node_center);
                    } else {
                        if (offset != 0xFFFFFFFF) stack[stackPtr++] = offset;
                    }
                }
            }
        }
    }
}
