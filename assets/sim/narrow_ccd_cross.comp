// ---------------------------------
// @assets/sim/narrow_ccd_cross.comp
//
// Promotes the Macro entity into the micro coordinate space before solving GJK
// ---------------------------------

#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

layout(local_size_x = 256) in;

layout(push_constant, scalar) uniform PushConstants {
    LcaEntityArray lca_entities;
    RigidBodyArray rigid_bodies;
    CrossPairBuffer input_pairs;
    CrossSparseCollisions output_list;
    float dt;
} pc;

void main() {
    uint pair_idx = gl_GlobalInvocationID.x;
    if (pair_idx >= pc.input_pairs.count) return;

    CrossPair pair = pc.input_pairs.pairs[pair_idx];
    LcaEntity lca = pc.lca_entities.entities[pair.lca_id];
    RigidBody macro_ent = pc.rigid_bodies.bodies[pair.macro_id];
    RigidBody micro_ent = pc.rigid_bodies.bodies[pair.micro_id];

    // 1. Promote Macro Body into Micro LCA Local Space (km, km/s)
    vec3 macro_pos_world_au = macro_ent.position_mass.xyz;
    vec3 macro_vel_world_au = macro_ent.linear_vel_drag.xyz;

    // Relative velocity accounts for the LCA's own drift through the solar system
    vec3 macro_rel_vel_au = macro_vel_world_au - lca.linear_velocity;

    vec3 pos_A = (lca.inv_transform * vec4(macro_pos_world_au, 1.0)).xyz * AU_TO_KM;
    vec3 vel_A = (mat3(lca.inv_transform) * macro_rel_vel_au) * AU_TO_KM;
    vec3 extents_A = macro_ent.shape_extents * AU_TO_KM;

    // 2. Load Native Micro Body
    vec3 pos_B = micro_ent.position_mass.xyz;
    vec3 vel_B = micro_ent.linear_vel_drag.xyz;
    vec3 extents_B = micro_ent.shape_extents;

    // 3. Solve (Sphere vs Sphere Example)
    if (macro_ent.shape_type == 2 && micro_ent.shape_type == 2) {
        vec3 p_rel = pos_A - pos_B;
        vec3 v_rel = vel_A - vel_B;
        float radiusSum = extents_A.x + extents_B.x;

        float c = dot(p_rel, p_rel) - radiusSum * radiusSum;
        float toi = 0.0; bool hit = false;

        if (c < 0.0) { toi = 0.0; hit = true; }
        else {
            float a = dot(v_rel, v_rel);
            float b = dot(p_rel, v_rel) * 2.0;
            if (a > 1e-8) {
                float disc = b * b - 4.0 * a * c;
                if (disc >= 0.0) {
                    float t = (-b - sqrt(disc)) / (2.0 * a);
                    if (t >= 0.0 && t <= pc.dt) { toi = t; hit = true; }
                }
            }
        }

        if (hit) {
            vec3 diff = (pos_A + vel_A * toi) - (pos_B + vel_B * toi);
            float dist = length(diff);
            vec3 normal = (dist > 1e-6) ? (diff / dist) : vec3(0.0, 1.0, 0.0);

            uint count = atomicAdd(pc.output_list.count, 1);
            if (count < 4000u) {
                pc.output_list.pairs[count].valid = 1u;
                pc.output_list.pairs[count].macro_id = pair.macro_id;
                pc.output_list.pairs[count].micro_id = pair.micro_id;
                pc.output_list.pairs[count].lca_id = pair.lca_id;
                pc.output_list.pairs[count].toi = toi;
                pc.output_list.pairs[count].contact_normal = normal;
                pc.output_list.pairs[count].contact_point = (pos_B + vel_B * toi) + normal * extents_B.x;
                pc.output_list.pairs[count].penetration_depth = max(radiusSum - dist, 0.0);
            }
        }
    }
}
