// @assets/sim/graph_coloring.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer ColorArray {
    uint colors[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) buffer WeightArray {
    uint weights[];
};

layout(push_constant, std430) uniform PushConstants {
    PackedCollisions collisions;
    ColorArray colors;
    WeightArray weights;
    uint total_pairs;
} pc;

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool valid = (idx < pc.total_pairs);

    // NVIDIA Parallel ILU factorization graph coloring adapted for Vulkan 1.1 SPV1.4 Memory Model
    // We color the contact pairs (edges) so that independent contacts can be solved in parallel.

    // 1. Initialize weights
    if (valid) {
        pc.weights.weights[idx] = hash(idx + 1);
        pc.colors.colors[idx] = 0; // 0 means uncolored
    }

    // Memory barrier to ensure all weights are visible
    memoryBarrierBuffer();
    barrier();

    // 2. Luby's algorithm for independent sets
    // In a real dispatch, this would loop until all are colored, 
    // but for SPV1.4 Memory Model we can use atomics or multi-pass.
    
    bool colored = false;
    uint my_color = 1;
    uint my_weight = 0;
    PackedPair my_pair;
    uint my_a = 0;
    uint my_b = 0;

    if (valid) {
        my_weight = pc.weights.weights[idx];
        my_pair = pc.collisions.pairs[idx];
        my_a = my_pair.a.primitive_index;
        my_b = my_pair.b.primitive_index;
    }

    for (int iter = 0; iter < 10; ++iter) {
        if (valid && !colored) {
            bool is_max = true;
            
            // Check adjacent contacts (contacts sharing body A or body B)
            for (uint j = 0; j < pc.total_pairs; ++j) {
                if (idx == j) continue;
                PackedPair other_pair = pc.collisions.pairs[j];
                uint other_a = other_pair.a.primitive_index;
                uint other_b = other_pair.b.primitive_index;
                
                if (my_a == other_a || my_a == other_b || my_b == other_a || my_b == other_b) {
                    uint other_color = pc.colors.colors[j];
                    if (other_color == 0 || other_color == my_color) {
                        uint other_weight = pc.weights.weights[j];
                        if (other_weight > my_weight || (other_weight == my_weight && j > idx)) {
                            is_max = false;
                            break;
                        }
                    }
                }
            }
            
            if (is_max) {
                pc.colors.colors[idx] = my_color;
                colored = true;
            }
        }
        
        memoryBarrierBuffer();
        barrier();
        
        if (valid && !colored) {
            my_color++;
        }
    }
}
