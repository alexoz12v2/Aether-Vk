// @assets/sim/dust_draw_volume.comp
//
// The volume packet queue's consumer: a 64-lane workgroup per 64 records of the chunk's queue
// (dust_scatter.glsl DUST_VQUEUE_*, filled by dust_split.comp dust_volume_emit), dispatched
// indirectly after each chunk's splitter dispatch (Device::cmd_dust_splat), then a second time
// over the chunk's volume spill (DUST_VIEW_VOLUME_SPILL: the records the queue refused). The
// workgroup draws its records one after another, its lanes cooperating on each
// (dust_volume_draw.glsl: the arithmetic the producer would have run in its cluster's thread, with
// the packet's own rounding seed, staged across the lanes), so the pyramid is the producer's word
// for word. The same push constants as the splat (dust::DustSplatPushConstants). No CPU mirror:
// dust::volume_scatter is the same drawing. The workgroup's state between the steps lives in
// shared words. The staged form (-DDUST_VW_STAGE=1..5, -DDUST_VW_PART=1|2 for 3 and 4: the blobs
// .s1 .s2 .s3a .s3b .s4a .s4b .s5, the Adreno consumer, dispatched in that order) carries a record's
// state from one dispatch to the next in its scratch row of the pyramid buffer
// (dust::dust_queue_offsets_for's vscratch; dust_volume_draw.glsl DUST_VW_SX_*).
#version 450 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_buffer_reference : require
// the `.sg` blob (-DDUST_SUBGROUP=1, the `.prof` one too) sums the
// top-level deposits of the workgroup into its scratch words and writes them once (the accumulate
// mode; no subgroup operation now: the host's choice of blob by the device's subgroup operations
// stays, the plain blob deposits as before, word for word the same pyramid)
#ifdef DUST_PROFILE
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_ARB_shader_clock : require
#endif
#include "dust_common.glsl"
#include "dust_scatter.glsl"
#include "dust_draw_texel.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    DustMomentsBuffer moments;  // 0
    DustRenderBuffer  render;   // 8
    DustUintBuffer    pyramid;  // 16: header + levels + measure grid + the queues
    uint  liveCount;            // 24
    uint  flags;                // 28
    float exposure;             // 32
    float invUnit;              // 36
    uint  color;                // 40
    float albedo;               // 44
    mat4  mvp;                  // 48
    vec4  eyeLocal;             // 112
} pc;                           // 128 bytes

#include "dust_volume_draw.glsl"

void main() {
    uint lane = gl_LocalInvocationIndex;
    // the frame's counts (lane 0 of workgroup 0 of each drain, once per chunk; all in the main
    // header). The main drain counts only what it drew: its refusals, main raw - main n, are
    // exactly the spill's raw appends (dust_volume_emit appends each refused record to the spill
    // once; with the queue off main raw = 0), so the spill drain counts them as OVERFLOWED, and
    // splits them into SPILL_DRAWN and LOST (OVERFLOWED = SPILL_DRAWN + LOST). The spill drain's
    // workgroup 0 runs whenever its raw count is > 0: its record 0 is always held (capacity >= 1),
    // so the indirect x is >= 1.
#if !defined(DUST_VW_STAGE) || DUST_VW_STAGE == 1
    if (gl_WorkGroupID.x == 0u && lane == 0u) {
        bool spill = (pc.flags & DUST_VIEW_VOLUME_SPILL) != 0u;
        uint vbase = dust_vw_vqueue_base();
        uint base = spill ? dust_vw_vspill_base() : vbase;
        uint raw = pc.pyramid.v[base + 3u];
        uint n = min(raw, dust_vw_vqueue_capacity(base));
        if (!spill) {
            atomicAdd(pc.pyramid.v[vbase + DUST_VQUEUE_DRAWN], n);
        } else {
            atomicAdd(pc.pyramid.v[vbase + DUST_VQUEUE_OVERFLOWED], raw);
            atomicAdd(pc.pyramid.v[vbase + DUST_VQUEUE_SPILL_DRAWN], n);
            atomicAdd(pc.pyramid.v[vbase + DUST_VQUEUE_LOST], raw - n);
        }
    }
#endif
    dust_volume_draw_workgroup(lane);
}
