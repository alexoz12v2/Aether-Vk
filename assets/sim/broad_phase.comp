#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

#define TYPE_PARTICLE_SYSTEM 0
#define TYPE_RIGID_BODY      1

struct Entity {
    BVHArray bvh;
    mat4 transform;
    mat4 inv_transform;
    vec3 linear_velocity;
    uint root_index;
    vec3 angular_velocity;
    uint type;              
    uint primitive_offset;
    uint total_primitives;  
    uint frame_scale_type;
    float scale_factor;
    uint shape_type;
    vec3 shape_data;
};

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer EntityArray {
    Entity entities[];
};

layout(push_constant, scalar) uniform PushConstants {
    BVHArray tlas_bvh;
    EntityArray scene_entities;
    CollisionPairList overlapping_pairs;
    uint tlas_root_index;
    uint total_entities;
} pc;

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= pc.total_entities) return;

    BVHNodeAABB my_node = read_bvh_node(pc.tlas_bvh, pc.total_entities - 1 + local_idx);
    uint my_ent_id = my_node.left_child_or_primitive_offset;
    AABB my_aabb = my_node.bound;

    uint stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = pc.tlas_root_index;

    while (stackPtr > 0) {
        uint node_idx = stack[--stackPtr];
        
        if (BRANCH_FACTOR == 2) {
            BVHNodeAABB node = read_bvh_node(pc.tlas_bvh, node_idx);

            if (intersectAABB(my_aabb, node.bound)) {
                if (node.primitive_count > 0) {
                    uint other_ent_id = node.left_child_or_primitive_offset;
                    // Avoid symmetric duplicates and self-intersection
                    if (my_ent_id < other_ent_id) {
                        uint outIdx = atomicAdd(pc.overlapping_pairs.count, 1, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsRelaxed);
                        pc.overlapping_pairs.pairs[outIdx] = uvec2(my_ent_id, other_ent_id);
                    }
                } else {
                    if (node.left_child_or_primitive_offset != 0xFFFFFFFF && node.left_child_or_primitive_offset != 0) stack[stackPtr++] = node.left_child_or_primitive_offset;
                    if (node.right_child_offset != 0xFFFFFFFF && node.right_child_offset != 0) stack[stackPtr++] = node.right_child_offset;
                }
            }
        } else {
            MultiBVHBlockArray multi_bvh = MultiBVHBlockArray(pc.tlas_bvh);
            uint node_valid = GET_MULTI_BVH_VALID_COUNT(multi_bvh, node_idx);
            for (uint i = 0; i < BRANCH_FACTOR; ++i) {
                if (i >= node_valid) break;
                AABB bound;
                GET_MULTI_BVH_BOUND(multi_bvh, node_idx, i, bound);
                if (intersectAABB(my_aabb, bound)) {
                    bool isLeaf;
                    uint offset;
                    GET_MULTI_BVH_LEAF_INFO(multi_bvh, node_idx, i, isLeaf, offset);
                    if (isLeaf) {
                        uint other_ent_id = offset;
                        if (my_ent_id < other_ent_id) {
                            uint outIdx = atomicAdd(pc.overlapping_pairs.count, 1, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsRelaxed);
                            pc.overlapping_pairs.pairs[outIdx] = uvec2(my_ent_id, other_ent_id);
                        }
                    } else {
                        if (offset != 0xFFFFFFFF && offset != 0) stack[stackPtr++] = offset;
                    }
                }
            }
        }
    }
}
