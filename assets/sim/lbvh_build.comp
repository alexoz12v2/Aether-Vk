#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require

#ifdef DEBUG_SHADERS
  #extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

// ── Watchdog output buffer ────────────────────────────────────────────────────
// BDA of a 1-element u32 buffer. Each shader that trips a safety counter
// atomicOr-s its own bit so the CPU can identify the culprit after GPU completion.
// Bit 1 (0x2) = lbvh_build.comp
layout(buffer_reference, std430, buffer_reference_align = 4) buffer WatchdogBuffer {
    uint flags;
};
#define WATCHDOG_BIT_LBVH_BUILD 0x2u

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    MortonArray sorted_morton;
    AtomicCounters counters;
    ParticleData particles;
    uint num_primitives;
    float particle_radius;
    WatchdogBuffer watchdog_out;
    float dt;
    uint _pad;
} pc;

int common_prefix(uint n, int i, int j) {
    if (j < 0 || j >= n) return -1;

    uvec2 morton_uvec = uvec2(pc.sorted_morton);
    if (morton_uvec.x == 0u && morton_uvec.y == 0u) {
        // Fallback: use identity mapping if no morton codes provided
        uint key1 = uint(i); uint key2 = uint(j);
        return 31 - findMSB(key1 ^ key2);
    }

    uint p_i = i * PARTICLES_IN_LEAF;
    uint p_j = j * PARTICLES_IN_LEAF;

#ifdef DEBUG_SHADERS
    // Trap out-of-bounds Morton array reads
    if (p_i >= pc.num_primitives) debugPrintfEXT("TRAP! common_prefix p_i (%u) >= num_primitives (%u) for i=%d\n", p_i, pc.num_primitives, i);
    if (p_j >= pc.num_primitives) debugPrintfEXT("TRAP! common_prefix p_j (%u) >= num_primitives (%u) for j=%d\n", p_j, pc.num_primitives, j);
#endif

    uint key1 = pc.sorted_morton.entries[p_i].x;
    uint key2 = pc.sorted_morton.entries[p_j].x;

    if (key1 == key2) {
        uint idx1 = pc.sorted_morton.entries[p_i].y;
        uint idx2 = pc.sorted_morton.entries[p_j].y;
        return 32 + (31 - findMSB(idx1 ^ idx2));
    }
    return 31 - findMSB(key1 ^ key2);
}

vec2 determine_range(uint n, int i) {
    int raw_d = common_prefix(n, i, i + 1) - common_prefix(n, i, i - 1);
    // Guard: sign(0) = 0, which makes l_max*d == 0 forever (infinite loop) when all
    // Morton codes are identical (e.g. particles clustered at same position).
    // Clamp to +1 so the traversal proceeds rightward in that degenerate case.
    int d = (raw_d == 0) ? 1 : sign(raw_d);
    int min_p = common_prefix(n, i, i - d), l_max = 2;

    int safety_counter = 0;
    [[dont_unroll]] while (common_prefix(n, i, i + l_max * d) > min_p) {
        l_max *= 2;
        // NOTE: break MUST be outside #ifdef so the GPU exits even without DEBUG_SHADERS.
        if (++safety_counter > 100000) {
#ifdef DEBUG_SHADERS
            debugPrintfEXT("WATCHDOG! determine_range loop 1 hung at idx=%d! l_max=%d\n", i, l_max);
#endif
            // Signal the watchdog flag buffer so the CPU can detect the hang.
            uvec2 wd_uvec = uvec2(pc.watchdog_out);
            if (wd_uvec.x != 0u || wd_uvec.y != 0u) {
                atomicOr(pc.watchdog_out.flags, WATCHDOG_BIT_LBVH_BUILD);
            }
            break;
        }
    }

    int l = 0, t = l_max / 2;
    safety_counter = 0;

    [[dont_unroll]] while (t >= 1) {
        if (common_prefix(n, i, i + (l + t) * d) > min_p) l += t;
        t /= 2;
        if (++safety_counter > 100000) {
#ifdef DEBUG_SHADERS
            debugPrintfEXT("WATCHDOG! determine_range loop 2 hung at idx=%d! t=%d\n", i, t);
#endif
            uvec2 wd_uvec = uvec2(pc.watchdog_out);
            if (wd_uvec.x != 0u || wd_uvec.y != 0u) {
                atomicOr(pc.watchdog_out.flags, WATCHDOG_BIT_LBVH_BUILD);
            }
            break;
        }
    }
    return vec2(min(i, i + l * d), max(i, i + l * d));
}

int find_split(uint n, int first, int last) {
    int common_node = common_prefix(n, first, last), split = first, step = last - first;
    int safety_counter = 0;

    [[dont_unroll]] do {
        step = (step + 1) >> 1;
        int new_split = split + step;
        if (new_split < last && common_prefix(n, first, new_split) > common_node) split = new_split;

        if (++safety_counter > 100000) {
#ifdef DEBUG_SHADERS
            debugPrintfEXT("WATCHDOG! find_split hung at first=%d, last=%d! step=%d\n", first, last, step);
#endif
            uvec2 wd_uvec = uvec2(pc.watchdog_out);
            if (wd_uvec.x != 0u || wd_uvec.y != 0u) {
                atomicOr(pc.watchdog_out.flags, WATCHDOG_BIT_LBVH_BUILD);
            }
            break;
        }
    } while (step > 1);

    return split;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = (pc.num_primitives + PARTICLES_IN_LEAF - 1) / PARTICLES_IN_LEAF;

    if (n <= 1 || idx >= n - 1) return;

#ifdef DEBUG_SHADERS
    bool is_trace_thread = true; // Print for ALL internal nodes
    if (is_trace_thread) {
        debugPrintfEXT("--- BUILD idx=%u --- n=%u, num_prims=%u\n", idx, n, pc.num_primitives);
    }
#endif

    vec2 range = determine_range(n, int(idx));
    int first = int(range.x);
    int last = int(range.y);

#ifdef DEBUG_SHADERS
    if (is_trace_thread) debugPrintfEXT("BUILD idx=%u Range: first=%d, last=%d\n", idx, first, last);
#endif

    int split = find_split(n, first, last);

#ifdef DEBUG_SHADERS
    if (is_trace_thread) debugPrintfEXT("BUILD idx=%u Split=%d\n", idx, split);
#endif

    uint left_child;
    bool left_is_leaf;
    if (split == first) {
        left_child = n - 1 + uint(split);
        left_is_leaf = true;
    } else {
        left_child = uint(split);
        left_is_leaf = false;
    }

    uint right_child;
    bool right_is_leaf;
    if (split + 1 == last) {
        right_child = n - 1 + uint(split + 1);
        right_is_leaf = true;
    } else {
        right_child = uint(split + 1);
        right_is_leaf = false;
    }

#ifdef DEBUG_SHADERS
    uint max_nodes = n * 2;
    if (is_trace_thread) {
        debugPrintfEXT("BUILD idx=%u Children: left=%u (leaf=%d), right=%u (leaf=%d)\n", idx, left_child, int(left_is_leaf), right_child, int(right_is_leaf));
    }

    if (idx >= max_nodes) debugPrintfEXT("TRAP! idx (%u) >= max_nodes (%u)\n", idx, max_nodes);
    if (left_child >= max_nodes) debugPrintfEXT("TRAP! left_child (%u) >= max_nodes (%u) at idx=%u\n", left_child, max_nodes, idx);
    if (right_child >= max_nodes) debugPrintfEXT("TRAP! right_child (%u) >= max_nodes (%u) at idx=%u\n", right_child, max_nodes, idx);
#endif

    tlas_write_child(pc.bvh, idx, 0u, left_child);
    tlas_write_child(pc.bvh, idx, 1u, right_child);

    uint left_payload  = left_is_leaf  ? split     : left_child;
    uint right_payload = right_is_leaf ? split + 1u : right_child;

    tlas_write_metadata(pc.bvh, idx, 0u, bvh_pack_metadata(left_is_leaf,  BVH_FRAME_MICRO, BVH_SHAPE_AABB, left_payload));
    tlas_write_metadata(pc.bvh, idx, 1u, bvh_pack_metadata(right_is_leaf, BVH_FRAME_MICRO, BVH_SHAPE_AABB, right_payload));

    tlas_write_parent(pc.bvh, left_child,  idx);
    tlas_write_parent(pc.bvh, right_child, idx);

    tlas_write_valid_mask(pc.bvh, idx, uvec2(3u, 0u)); // Children 0 and 1 are valid

#ifdef DEBUG_SHADERS
    if (is_trace_thread) debugPrintfEXT("--- FINISHED BUILD idx=%u ---\n", idx);
#endif
}
