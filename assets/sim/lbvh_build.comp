#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    MortonArray sorted_morton;
    AtomicCounters counters;
    ParticleData particles;
    uint num_primitives;
    float particle_radius;
    float dt;
} pc;

int common_prefix(uint n, int i, int j) {
    if (j < 0 || j >= n) return -1;
    if (uint64_t(pc.sorted_morton) == 0ul) {
        // Fallback: use identity mapping if no morton codes provided
        uint key1 = uint(i); uint key2 = uint(j);
        return 31 - findMSB(key1 ^ key2);
    }
    uint key1 = pc.sorted_morton.entries[i].x; uint key2 = pc.sorted_morton.entries[j].x;
    if (key1 == key2) {
        uint idx1 = pc.sorted_morton.entries[i].y; uint idx2 = pc.sorted_morton.entries[j].y;
        return 32 + (31 - findMSB(idx1 ^ idx2));
    }
    return 31 - findMSB(key1 ^ key2);
}

vec2 determine_range(uint n, int i) {
    int d = sign(common_prefix(n, i, i + 1) - common_prefix(n, i, i - 1));
    int min_p = common_prefix(n, i, i - d), l_max = 2;
    [[dont_unroll]] while (common_prefix(n, i, i + l_max * d) > min_p) l_max *= 2;
    int l = 0, t = l_max / 2;
    [[dont_unroll]] while (t >= 1) { if (common_prefix(n, i, i + (l + t) * d) > min_p) l += t; t /= 2; }
    return vec2(min(i, i + l * d), max(i, i + l * d));
}

int find_split(uint n, int first, int last) {
    int common_node = common_prefix(n, first, last), split = first, step = last - first;
    [[dont_unroll]] do {
        step = (step + 1) >> 1; int new_split = split + step;
        if (new_split < last && common_prefix(n, first, new_split) > common_node) split = new_split;
    } while (step > 1);
    return split;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = pc.num_primitives;
    if (n <= 1 || idx >= n - 1) return;
    
    vec2 range = determine_range(n, int(idx));
    int first = int(range.x);
    int last = int(range.y);
    
    int split = find_split(n, first, last);
    
    uint left_child;
    bool left_is_leaf;
    if (split == first) {
        left_child = n - 1 + uint(split);
        left_is_leaf = true;
    } else {
        left_child = uint(split);
        left_is_leaf = false;
    }
    
    uint right_child;
    bool right_is_leaf;
    if (split + 1 == last) {
        right_child = n - 1 + uint(split + 1);
        right_is_leaf = true;
    } else {
        right_child = uint(split + 1);
        right_is_leaf = false;
    }
    
    pc.bvh.nodes[idx].child_indices[0] = left_child;
    pc.bvh.nodes[idx].child_indices[1] = right_child;
    pc.bvh.nodes[idx].valid_mask = uvec2(3, 0); // Both children valid
    
    uint left_payload = left_is_leaf ? (uint64_t(pc.sorted_morton) == 0ul ? split : pc.sorted_morton.entries[split].y) : left_child;
    uint right_payload = right_is_leaf ? (uint64_t(pc.sorted_morton) == 0ul ? split + 1 : pc.sorted_morton.entries[split + 1].y) : right_child;
    
    pc.bvh.nodes[idx].metadata[0] = bvh_pack_metadata(left_is_leaf, BVH_FRAME_MICRO, BVH_SHAPE_AABB, left_payload);
    pc.bvh.nodes[idx].metadata[1] = bvh_pack_metadata(right_is_leaf, BVH_FRAME_MICRO, BVH_SHAPE_AABB, right_payload);
    
    pc.bvh.nodes[left_child].parent_idx = idx;
    pc.bvh.nodes[right_child].parent_idx = idx;
    
    pc.bvh.nodes[idx].valid_mask = uvec2(3, 0); // Children 0 and 1 are valid
}
