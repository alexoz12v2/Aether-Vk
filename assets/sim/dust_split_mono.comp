// @assets/sim/dust_split_mono.comp
//
// perf9_K (the split path knob, AETHERVK_DUST_SPLIT_STAGED=0, the GTX 1070 default): the splitter as it
// was before the split family (perf9 steps Z / O), the old dust_split.comp verbatim against the
// current includes; its leaf path is dust_leaf_mono.glsl (the old dust_leaf.glsl). One dispatch per
// chunk, no prep / walk / project / sequencer stages, no leaf / candidate queues; it reads the
// sub-packet record words 0-32 only. Equivalence: its spirv-opt -O blob equals the old blob built
// with the old includes up to the order of a few global constant declarations (identical with
// --canonicalize-ids and the global section sorted; every function body the same, instruction for
// instruction): the old projection is dust_project_packet_mono below (DUST_NO_PROJECT_PACKET drops
// the current one, re-written by the split family to call dust_radiance_weight_o).
//
// (the old header:)
//
// The sub-packet queue's splitter: a workgroup per cluster of the chunk (dust_scatter.glsl
// DUST_SQUEUE_*, filled by dust_splat.comp with the cluster's packets in its sub-packet order),
// the lanes sharing the cluster's records. Every record goes through the leaf path of the former
// per-cluster thread (dust_leaf.glsl: the perspective split, the EWA leaves in-thread or to the
// EWA queue, the volumetric packets to the volume queue or its spill): a counting pass finds the
// rounding seeds each record draws, a shared-memory prefix in record order gives it its ordinal base, and
// the drawing pass draws with the seed the per-cluster thread drew, so the pyramid is the same
// word for word. The same push constants as the splat (dust::DustSplatPushConstants). No CPU
// mirror: dust::splat_tier is the same drawing.
#version 450 core
#extension GL_GOOGLE_include_directive : require
// (perf9_K) the old projection is dust_project_packet_mono below
#define DUST_NO_PROJECT_PACKET 1
#ifdef DUST_PROFILE
#extension GL_ARB_shader_clock : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#include "dust_common.glsl"
// (perf9_K) the old dust_common.glsl dust_project_packet, verbatim but for its name (see the header)
bool dust_project_packet_mono(vec3 mean, float S[6], vec3 d, float flux, float exposure, mat4 mvp,
                         float W, float H, vec3 eyeLocal, bool openStart, bool openEnd, vec2 rho,
                         out DustScreenPacket P) {
    vec4 clip = mvp * vec4(mean, 1.0);
    if (!(clip.w > 0.0)) return false;
    P.openStart = openStart;
    P.openEnd = openEnd;
    P.rho = rho;
    vec2 ndc = clip.xy / clip.w;
    P.mu = (ndc * 0.5 + 0.5) * vec2(W, H);
    // rows of the mvp (column-major)
    vec3 r0 = vec3(mvp[0][0], mvp[1][0], mvp[2][0]);
    vec3 r1 = vec3(mvp[0][1], mvp[1][1], mvp[2][1]);
    vec3 r3 = vec3(mvp[0][3], mvp[1][3], mvp[2][3]);
    // the Jacobian at the chord's midpoint (the start when the midpoint is not in front of the
    // eye; dust::project_packet_lit): exact to second order in the chord's depth span
    // only for a chord whose depth span is within DUST_SPLIT_EPS of its depth (|w_end - w| <= eps w;
    // a deeper chord keeps the start, dust::project_packet_lit); bit 23 of DUST_PYR_SPLIT_DEPTH
    // (diagnostics, AETHERVK_DUST_JACOBIAN_AT_START=1): always at the start
    float wEnd = dot(r3, mean + d) + mvp[3][3];
    bool shallow = abs(wEnd - clip.w) <= DUST_SPLIT_EPS * clip.w;
    float jAt = (shallow && ((dust_pyr_split_word >> 23u) & 1u) == 0u) ? 0.5 : 0.0;
    // the deep chord's EWA (dust_deep_chord, off by default): the Jacobian at the geometric-mean
    // depth and the flux by the perspective's light factor (dust::project_packet_lit)
    float deepK = 1.0;
    if (!shallow && dust_deep_chord && clip.w > 0.0 && wEnd > 0.0) {
        vec2 f = dust_deep_chord_factors(clip.w, wEnd, rho);
        jAt = f.x;
        deepK = f.y;
    }
    vec4 clipJ = mvp * vec4(mean + jAt * d, 1.0);
    if (!(clipJ.w > 0.0)) clipJ = clip;
    vec2 ndcJ = clipJ.xy / clipJ.w;
    vec3 jx = (r0 - ndcJ.x * r3) * (0.5 * W / clipJ.w);
    vec3 jy = (r1 - ndcJ.y * r3) * (0.5 * H / clipJ.w);
    mat3 Sm = mat3(S[0], S[1], S[2],
                   S[1], S[3], S[4],
                   S[2], S[4], S[5]);
    vec3 sx = Sm * jx, sy = Sm * jy;
    P.cov = vec3(dot(jx, sx) + DUST_PIXEL_FILTER_VAR, dot(jx, sy), dot(jy, sy) + DUST_PIXEL_FILTER_VAR);
    P.seg = vec2(dot(jx, d), dot(jy, d));
    float g00 = dot(jx, jx), g01 = dot(jx, jy), g11 = dot(jy, jy);
    float detG = max(g00 * g11 - g01 * g01, 0.0);
    // local metres per pixel within the view plane (dust::project_packet_lit)
    if (detG > 1e-30) {
        P.kx = (jx * g11 - jy * g01) / detG;
        P.ky = (jy * g00 - jx * g01) / detG;
    } else {
        P.kx = vec3(0.0);
        P.ky = vec3(0.0);
    }
    // the view direction (dust_view_forward: the same one the split uses)
    bool perspective;
    vec3 fwd = dust_view_forward(mvp, eyeLocal, perspective);
    // the photometric eye: the eye point when perspective, at infinity along the view axis when
    // orthographic (dust::ScreenPacket::eye_w)
    P.eye = (perspective || dot(fwd, fwd) == 0.0) ? vec4(eyeLocal, 1.0) : vec4(-fwd, 0.0);
    P.mean = mean;
    P.sun = dust_phot_sun;
    P.rhAu = dust_phot_rh;
    P.albedo = dust_phot_albedo;
    P.wMean = dust_phot_albedo > 0.0
        ? dust_radiance_weight(dust_phot_lut, dust_phot_albedo, dust_phot_sun, P.eye.xyz - P.eye.w * mean, dust_phot_rh)
        : 1.0;

    // `precise`: no fused multiply-add here, so the cancelling determinant rounds exactly as the
    // CPU reference's (an fma changes it by the whole cancellation error, and with it the
    // packet's amplitude and level: whole packets differed between the two)
    precise float half_ = 0.5 * (P.cov.x + P.cov.z);
    precise float dd = sqrt((0.5 * (P.cov.x - P.cov.z)) * (0.5 * (P.cov.x - P.cov.z)) + P.cov.y * P.cov.y);
    float lamMax = max(half_ + dd, DUST_PIXEL_FILTER_VAR);
    // the determinant with the anisotropy floor (f32 cancellation for very elongated packets)
    precise float detRaw = P.cov.x * P.cov.z - P.cov.y * P.cov.y;
    float detC = max(max(detRaw, DUST_DET_ANISO_FLOOR * lamMax * lamMax), 1e-30);
    P.det = detC;
    P.amp = exposure * flux * deepK * sqrt(detG) / (2.0 * DUST_PI_F32 * sqrt(detC));
    // the part of the packet in front of the eye (dust::project_packet_lit): its Gaussian along
    // the view direction, centred on the capsule's middle, cut at the eye's plane (1 for the
    // split's leaves; it matters for the leaves left straddling the plane)
    {
        if (dot(fwd, fwd) > 0.0) {
            float depth = dot(mean + 0.5 * d - eyeLocal, fwd);
            float sigmaV = sqrt(max(dust_var_along(S, fwd), 0.0));
            if (sigmaV > 0.0) P.amp *= 0.5 * (1.0 + dust_erf(depth / (sigmaV * 1.4142135623730951)));
            else if (depth < 0.0) P.amp = 0.0;
        }
    }
    if (!(P.amp > 0.0) || isinf(P.amp)) return false;
    // the smallest sigma from the floored determinant, never from the cancelling half - dd
    P.sigmaMin = sqrt(max(detC / lamMax, DUST_PIXEL_FILTER_VAR * 0.5));
    float ex = DUST_SPLAT_SIGMAS * sqrt(P.cov.x), ey = DUST_SPLAT_SIGMAS * sqrt(P.cov.z);
    float x0 = min(P.mu.x, P.mu.x + P.seg.x) - ex, x1 = max(P.mu.x, P.mu.x + P.seg.x) + ex;
    float y0 = min(P.mu.y, P.mu.y + P.seg.y) - ey, y1 = max(P.mu.y, P.mu.y + P.seg.y) + ey;
    if (x1 < 0.0 || y1 < 0.0 || x0 > W || y0 > H || !(x0 <= x1) || !(y0 <= y1)) return false;
    P.depthAu = length(mean - eyeLocal) / DUST_AU_M;
    if (any(isnan(P.mu)) || any(isinf(P.mu)) || any(isnan(P.cov)) || any(isinf(P.cov))
        || any(isnan(P.seg)) || any(isinf(P.seg)) || isnan(P.sigmaMin) || isnan(P.depthAu)) return false;
    return true;
}

#include "dust_scatter.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    DustMomentsBuffer moments;  // 0
    DustRenderBuffer  render;   // 8
    DustUintBuffer    pyramid;  // 16: header + levels + measure grid + the queues
    uint  liveCount;            // 24
    uint  flags;                // 28
    float exposure;             // 32
    float invUnit;              // 36
    uint  color;                // 40
    float albedo;               // 44
    mat4  mvp;                  // 48
    vec4  eyeLocal;             // 112
} pc;                           // 128 bytes

// the frame words the leaf path reads (the splitter draws no volumetric packet: dust_volume_emit
// queues every one, to the volume queue or its spill, for dust_draw_volume.comp)
#include "dust_frame_gates.glsl"
#include "dust_leaf_mono.glsl"

// the speck shell's radius word (dust_splat.comp defines it too; the include guards keep it out
// of dust_common.glsl)
const uint DUST_PYR_SPECKS_DMAX = 252u;

// the records' seed counts, then their exclusive prefix (DUST_SQUEUE_PER_CLUSTER at most)
shared uint dust_rec_seeds[DUST_SQUEUE_PER_CLUSTER];

// record r of the cluster (its index in the chunk's queue `recs + r`) through the leaf path:
// counting (dust_counting) or drawing from the ordinal `ord`
void dust_split_record(uint recs, uint r, uint ord, uint levels, float W, float H, vec3 fwd, bool perspective,
                       uint splitDepth, uint volumeBias, float shellDMax, uint volumeAxis) {
    vec3 mean, d, segT, color, sun;
    float S[6];
    float flux, exposure, origin, rh;
    bool openStart, openEnd, hasO, walked;
    vec2 rho;
    vec4 support;
    uint i;
    DUST_SQUEUE_GET(pc.pyramid, recs, r, mean, S, d, flux, exposure, openStart, openEnd, rho, segT, color, support, hasO, origin, sun, rh, i, walked)
    // the speck shell's hand-over per bin (dust::splat_cluster_inner): a record whose bin the
    // speck pass does not walk keeps its shell mass (no shell for it)
    float recShell = walked ? shellDMax : 0.0;
    dust_phot_support = support;
    dust_phot_has_origin = hasO;
    dust_phot_origin = origin;
    dust_phot_sun = sun;
    dust_phot_rh = rh;
    dust_cluster_seed = dust_hash32(i);
    dust_packet_ord = ord;
    dust_project_split_scatter(mean, S, d, flux, exposure, openStart, openEnd, rho, segT, color, levels,
                               W, H, fwd, perspective, splitDepth, volumeBias, recShell, volumeAxis);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint sbase = dust_squeue_base(pc.pyramid);
    uint t = dust_squeue_table(sbase) + gl_WorkGroupID.x * DUST_SQUEUE_TABLE_WORDS;
    uint recBase = pc.pyramid.v[t];
    uint total = pc.pyramid.v[t + 1u];
    uint recs = dust_squeue_records(sbase);
#ifdef DUST_PROFILE
    DUST_PROF_BEGIN(thread)
#endif
    // the per-cluster frame words (as dust_splat.comp's lanes have them)
    dust_mom_addr = uvec2(pc.moments);
    dust_phot_albedo = pc.albedo;
    dust_phot_lut_addr = uvec2(pc.pyramid);
    dust_pyr_split_word = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    dust_vqueue_on = (pc.pyramid.v[DUST_PYR_FLAGS] & DUST_FRAME_VQUEUE_OFF) == 0u;
    dust_deep_chord = (pc.pyramid.v[DUST_PYR_FLAGS] & DUST_FRAME_DEEP_CHORD) != 0u;
    uint levels = pc.pyramid.v[DUST_PYR_LEVELS];
    float W = float(pc.pyramid.v[DUST_PYR_WIDTH]);
    float H = float(pc.pyramid.v[DUST_PYR_HEIGHT]);
    bool perspective;
    vec3 fwd = dust_view_forward(pc.mvp, pc.eyeLocal.xyz, perspective);
    uint splitDepth = min(dust_pyr_split_word & 0xFFu, DUST_SPLIT_DEPTH_MAX);
    uint volumeBias = (dust_pyr_split_word >> 8u) & 0xFFu;
    uint volumeAxis = (dust_pyr_split_word >> 16u) & 0x3u;
    float shellDMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
    uint n = min(total, DUST_SQUEUE_PER_CLUSTER);
    // the serial reference (DUST_FRAME_SPLIT_SERIAL): lane 0 walks the records in order, the
    // ordinal running on as the per-cluster thread's did; otherwise the counting pass (the seeds
    // each record draws), the exclusive prefix in record order (lane 0), the drawing pass.
    // (round 9 step C4: one call site for the leaf path — the serial, counting and drawing
    // copies each had their own frame; a pass loop, pass 0 counting, pass 1 drawing)
    bool serial = (pc.pyramid.v[DUST_PYR_FLAGS] & DUST_FRAME_SPLIT_SERIAL) != 0u;
    bool ran = false;
    uint ord = 0u;
    for (uint pass = serial ? 1u : 0u; pass < 2u; ++pass) {
        if (pass == 1u && !serial) {
            barrier();
            if (lane == 0u) {
                uint acc = 0u;
                for (uint r = 0u; r < n; ++r) {
                    uint c = dust_rec_seeds[r];
                    dust_rec_seeds[r] = acc;
                    acc += c;
                }
            }
            barrier();
        }
        DUST_PROF_BEGIN_AS(cnt)
        dust_counting = pass == 0u;
        for (uint k = 0u; ; ++k) {
            uint r = serial ? k : lane + 64u * k;
            if (r >= n || (serial && lane != 0u)) break;
            dust_seed_count = 0u;
            dust_split_record(recs, recBase + r, serial ? ord : (pass == 0u ? 0u : dust_rec_seeds[r]),
                              levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
            if (pass == 0u) dust_rec_seeds[r] = dust_seed_count;
            else ran = true;
            ord = dust_packet_ord;
        }
        dust_counting = false;
        if (pass == 0u) { DUST_PROF_END_AS(count, cnt) }
    }
#ifdef DUST_PROFILE
    DUST_PROF_END(thread)
    // every lane reaches this (0 for one without a record): the subgroup reductions need them all
    DUST_PROF_FLUSH_SPLIT(pc.pyramid, dust_queue_base(pc.pyramid), ran)
#endif
}
