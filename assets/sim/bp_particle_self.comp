// @assets/sim/bp_particle_self.comp
#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

layout(local_size_x = 256) in;
const uint SUBGROUPS_PER_WG = 256 / SUBGROUP_SIZE;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData { float data[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer WrenchArray { Wrench wrenches[]; };

layout(push_constant, scalar) uniform PushConstants {
    MultiBvhBuffer bvh;
    ParticleData particles;
    WrenchArray wrench_buffer;
    uint     root_index;
    uint     total_particles;
    float    particle_radius;
    float    stiffness;
} pc;

shared uint shared_stacks[SUBGROUPS_PER_WG][32]; 
shared uint shared_stack_ptrs[SUBGROUPS_PER_WG];

bool intersectAABB(vec3 amin, vec3 amax, vec3 bmin, vec3 bmax) {
    return (amin.x <= bmax.x && amax.x >= bmin.x) &&
           (amin.y <= bmax.y && amax.y >= bmin.y) &&
           (amin.z <= bmax.z && amax.z >= bmin.z);
}

void main() {
    uint subgroup_id = gl_SubgroupID;
    uint lane_id     = gl_SubgroupInvocationID;
    
    // 1 Subgroup = 1 Target Particle
    uint my_p_idx = gl_WorkGroupID.x * SUBGROUPS_PER_WG + subgroup_id;
    if (my_p_idx >= pc.total_particles) return;

    MultiBvhBuffer bvh = pc.bvh;
    ParticleData parts = pc.particles;
    WrenchArray wrenches = pc.wrench_buffer;

    vec3 my_pos, my_min, my_max;
    float my_radius = pc.particle_radius;
    
    if (lane_id == 0) {
        uint block_idx = my_p_idx / SUBGROUP_SIZE;
        uint local_idx = my_p_idx % SUBGROUP_SIZE;
        uint base = block_idx * (10 * SUBGROUP_SIZE) + local_idx;
        
        my_pos = vec3(
            parts.data[base + 0 * SUBGROUP_SIZE],
            parts.data[base + 1 * SUBGROUP_SIZE],
            parts.data[base + 2 * SUBGROUP_SIZE]
        );
        
        my_min = my_pos - vec3(my_radius);
        my_max = my_pos + vec3(my_radius);
        
        shared_stacks[subgroup_id][0] = pc.root_index;
        shared_stack_ptrs[subgroup_id] = 1;
    }

    my_pos = vec3(subgroupBroadcast(my_pos.x, 0), subgroupBroadcast(my_pos.y, 0), subgroupBroadcast(my_pos.z, 0));
    my_min = vec3(subgroupBroadcast(my_min.x, 0), subgroupBroadcast(my_min.y, 0), subgroupBroadcast(my_min.z, 0));
    my_max = vec3(subgroupBroadcast(my_max.x, 0), subgroupBroadcast(my_max.y, 0), subgroupBroadcast(my_max.z, 0));
    my_p_idx = subgroupBroadcast(my_p_idx, 0);

    vec3 local_repulsive_force = vec3(0.0);

    // --- Subgroup-Cooperative Traversal of its own LBVH ---
    while (true) {
        subgroupMemoryBarrierShared();
        uint stack_ptr = shared_stack_ptrs[subgroup_id];
        if (stack_ptr == 0) break;
        
        stack_ptr--;
        uint node_idx = shared_stacks[subgroup_id][stack_ptr];
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        uint meta = bvh.nodes[node_idx].metadata[lane_id];
        
        bool valid = false;
        if (lane_id < 32) {
            valid = (bvh.nodes[node_idx].valid_mask.x & (1u << lane_id)) != 0u;
        } else {
            valid = (bvh.nodes[node_idx].valid_mask.y & (1u << (lane_id - 32))) != 0u;
        }
        
        vec3 c_min = vec3(bvh.nodes[node_idx].min_x[lane_id], bvh.nodes[node_idx].min_y[lane_id], bvh.nodes[node_idx].min_z[lane_id]);
        vec3 c_max = vec3(bvh.nodes[node_idx].max_x[lane_id], bvh.nodes[node_idx].max_y[lane_id], bvh.nodes[node_idx].max_z[lane_id]);
        uint child_payload = bvh.nodes[node_idx].child_indices[lane_id];

        // Fast AABB Reject against the node
        bool hit_aabb = valid && intersectAABB(my_min, my_max, c_min, c_max);
        bool is_leaf = bvh_is_leaf(meta);
        
        bool hit_node = hit_aabb && !is_leaf;

        // Prevent self-attraction by ensuring Target ID != Found ID
        bool hit_leaf = hit_aabb && is_leaf && (my_p_idx != child_payload);
        
        uvec4 leaf_ballot = subgroupBallot(hit_leaf);
        
        // Loop over the 32 lanes. If a lane hit a leaf, calculate exact physics
        for (uint i = 0; i < 4; i++) {
            uint mask = leaf_ballot[i];
            while (mask != 0) {
                uint bit = findLSB(mask);
                mask &= ~(1u << bit);
                uint src_lane = i * 32 + bit;

                uint other_idx = subgroupShuffle(child_payload, src_lane);
                
                // Fetch other particle position
                uint block_idx = other_idx / SUBGROUP_SIZE;
                uint local_idx = other_idx % SUBGROUP_SIZE;
                uint base = block_idx * (10 * SUBGROUP_SIZE) + local_idx;
                
                vec3 other_pos = vec3(
                    parts.data[base + 0 * SUBGROUP_SIZE],
                    parts.data[base + 1 * SUBGROUP_SIZE],
                    parts.data[base + 2 * SUBGROUP_SIZE]
                );
                
                float other_rad = pc.particle_radius;

                vec3 diff = my_pos - other_pos;
                float dist_sq = dot(diff, diff);
                float min_dist = my_radius + other_rad;

                // Exact Sphere-to-Sphere Test
                if (dist_sq > 1e-12 && dist_sq < min_dist * min_dist) {
                    float dist = sqrt(dist_sq);
                    float penetration = min_dist - dist;
                    vec3 normal = diff / dist;
                    
                    // Hertzian Penalty Force
                    float force_mag = pc.stiffness * penetration;
                    local_repulsive_force += normal * force_mag;
                }
            }
        }
        
        uvec4 node_ballot = subgroupBallot(hit_node);
        uint  node_count  = subgroupBallotBitCount(node_ballot);
        uint  push_offset = subgroupBallotExclusiveBitCount(node_ballot);

        if (hit_node) {
            shared_stacks[subgroup_id][stack_ptr + push_offset] = child_payload;
        }
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr + node_count;
    }

    // A single highly efficient atomic lock per Subgroup execution writes the net force!
    local_repulsive_force = subgroupAdd(local_repulsive_force);
    if (lane_id == 0 && dot(local_repulsive_force, local_repulsive_force) > 0.0) {
        ADD_LINEAR_FORCE(wrenches.wrenches[my_p_idx], local_repulsive_force);
    }
}