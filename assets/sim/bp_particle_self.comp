// @assets/sim/bp_particle_self.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 256
#endif
layout(local_size_x = LOCAL_SIZE_X) in;
const uint SUBGROUPS_PER_WG = ((LOCAL_SIZE_X / SUBGROUP_SIZE) == 0 ? 1 : (LOCAL_SIZE_X / SUBGROUP_SIZE));

// Alias memory block mapping the float-based Wrench to uints for CAS compatibility
layout(buffer_reference, std430, buffer_reference_align = 4) buffer WrenchArrayUint {
    uint data[];
};

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    ParticleData particles;
    WrenchArray wrench_buffer;
    uint root_index;
    uint total_particles;
    float particle_radius;
    float stiffness;
} pc;

shared uint shared_stacks[SUBGROUPS_PER_WG][32];
shared uint shared_stack_ptrs[SUBGROUPS_PER_WG];

// Performs a secure float accumulation via purely standard CAS looping
void atomicAddWrench(WrenchArrayUint buf, uint index, float val) {
    uint old_val = buf.data[index];
    uint assumed_val;
    do {
        assumed_val = old_val;
        float new_val = uintBitsToFloat(assumed_val) + val;
        old_val = atomicCompSwap(buf.data[index], assumed_val, floatBitsToUint(new_val));
    } while (assumed_val != old_val);
}

void atomicAddParticle(ParticleData buf, uint index, float val) {
    uint old_val = buf.data[index];
    uint assumed_val;
    do {
        assumed_val = old_val;
        float new_val = uintBitsToFloat(assumed_val) + val;
        old_val = atomicCompSwap(buf.data[index], assumed_val, floatBitsToUint(new_val));
    } while (assumed_val != old_val);
}

void main() {
    uint subgroup_id = gl_SubgroupID;
    uint lane_id     = gl_SubgroupInvocationID;

    uint my_p_idx = gl_WorkGroupID.x * SUBGROUPS_PER_WG + subgroup_id;
    if (my_p_idx >= pc.total_particles) return;

    vec3 my_pos, my_min, my_max;
    float my_radius = pc.particle_radius;

    if (lane_id == 0) {
        uint block_idx = my_p_idx / SUBGROUP_SIZE;
        uint local_idx = my_p_idx % SUBGROUP_SIZE;
        uint base = block_idx * (PARTICLE_FIELDS * SUBGROUP_SIZE) + local_idx;

        my_pos = vec3(
            uintBitsToFloat(pc.particles.data[base + 0u * SUBGROUP_SIZE]),
            uintBitsToFloat(pc.particles.data[base + 1u * SUBGROUP_SIZE]),
            uintBitsToFloat(pc.particles.data[base + 2u * SUBGROUP_SIZE])
        );

        my_min = my_pos - vec3(my_radius);
        my_max = my_pos + vec3(my_radius);

        shared_stacks[subgroup_id][0] = pc.root_index;
        shared_stack_ptrs[subgroup_id] = 1;
    }

    my_pos = vec3(subgroupBroadcast(my_pos.x, 0), subgroupBroadcast(my_pos.y, 0), subgroupBroadcast(my_pos.z, 0));
    my_min = vec3(subgroupBroadcast(my_min.x, 0), subgroupBroadcast(my_min.y, 0), subgroupBroadcast(my_min.z, 0));
    my_max = vec3(subgroupBroadcast(my_max.x, 0), subgroupBroadcast(my_max.y, 0), subgroupBroadcast(my_max.z, 0));
    my_p_idx = subgroupBroadcast(my_p_idx, 0);

    vec3 local_repulsive_force = vec3(0.0);

    while (true) {
        subgroupMemoryBarrierShared();
        uint stack_ptr = shared_stack_ptrs[subgroup_id];
        if (stack_ptr == 0) break;

        stack_ptr--;
        uint node_idx = shared_stacks[subgroup_id][stack_ptr];
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        uint meta = pc.bvh.nodes[node_idx].metadata[lane_id];
        bool valid = bvh_node_is_valid(pc.bvh.nodes[node_idx].valid_mask, lane_id);

        vec3 c_min = vec3(pc.bvh.nodes[node_idx].min_x[lane_id], pc.bvh.nodes[node_idx].min_y[lane_id], pc.bvh.nodes[node_idx].min_z[lane_id]);
        vec3 c_max = vec3(pc.bvh.nodes[node_idx].max_x[lane_id], pc.bvh.nodes[node_idx].max_y[lane_id], pc.bvh.nodes[node_idx].max_z[lane_id]);
        uint child_payload = pc.bvh.nodes[node_idx].child_indices[lane_id];
        uint leaf_payload = meta & 0x07FFFFFFu;

        bool hit_aabb = valid && intersectAABB(my_min, my_max, c_min, c_max);
        bool is_leaf = bvh_is_leaf(meta);

        bool hit_node = hit_aabb && !is_leaf;
        bool hit_leaf = hit_aabb && is_leaf && (my_p_idx != leaf_payload);

        uvec4 leaf_ballot = subgroupBallot(hit_leaf);

        for (uint i = 0; i < 4; i++) {
            uint mask = leaf_ballot[i];
            while (mask != 0) {
                uint bit = findLSB(mask);
                mask &= ~(1u << bit);

                uint other_idx = subgroupShuffle(leaf_payload, i * 32 + bit);
                uint block_idx = other_idx / SUBGROUP_SIZE;
                uint local_idx = other_idx % SUBGROUP_SIZE;
                uint base = block_idx * (PARTICLE_FIELDS * SUBGROUP_SIZE) + local_idx;

                vec3 other_pos = vec3(
                    uintBitsToFloat(pc.particles.data[base + 0u * SUBGROUP_SIZE]),
                    uintBitsToFloat(pc.particles.data[base + 1u * SUBGROUP_SIZE]),
                    uintBitsToFloat(pc.particles.data[base + 2u * SUBGROUP_SIZE])
                );

                vec3 diff = my_pos - other_pos;
                float dist_sq = dot(diff, diff);
                float min_dist = my_radius * 2.0;

                if (dist_sq > 1e-12 && dist_sq < min_dist * min_dist) {
                    float dist = sqrt(dist_sq);
                    float penetration = min_dist - dist;
                    vec3 normal = diff / dist;

                    float force_mag = pc.stiffness * penetration;
                    vec3 applied_force = normal * force_mag;
                    local_repulsive_force += applied_force;
                }
            }
        }

        uvec4 node_ballot = subgroupBallot(hit_node);
        uint  node_count  = subgroupBallotBitCount(node_ballot);
        uint  push_offset = subgroupBallotExclusiveBitCount(node_ballot);

        if (hit_node) {
            shared_stacks[subgroup_id][stack_ptr + push_offset] = child_payload;
        }
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr + node_count;
    }

    // Local summation safely inside the target subgroup
    local_repulsive_force.x = subgroupAdd(local_repulsive_force.x);
    local_repulsive_force.y = subgroupAdd(local_repulsive_force.y);
    local_repulsive_force.z = subgroupAdd(local_repulsive_force.z);

    // Subgroup-Master invokes strictly uint-backed CAS mappings
    if (lane_id == 0 && dot(local_repulsive_force, local_repulsive_force) > 0.0) {
        uint block_idx = my_p_idx / SUBGROUP_SIZE;
        uint local_idx = my_p_idx % SUBGROUP_SIZE;
        uint base = block_idx * (PARTICLE_FIELDS * SUBGROUP_SIZE) + local_idx;

        atomicAddParticle(pc.particles, base + 7u * SUBGROUP_SIZE, local_repulsive_force.x);
        atomicAddParticle(pc.particles, base + 8u * SUBGROUP_SIZE, local_repulsive_force.y);
        atomicAddParticle(pc.particles, base + 9u * SUBGROUP_SIZE, local_repulsive_force.z);
    }
}
