// @assets/sim/bp_particle_self.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

// FIX: This constant is ONLY for sizing shared memory safely at compile time.
const uint MAX_SUBGROUPS_PER_WG = (LOCAL_SIZE_X + 3) / 4;

// Alias memory block mapping the float-based Wrench to uints for CAS compatibility
layout(buffer_reference, std430, buffer_reference_align = 4) buffer WrenchArrayUint {
    uint data[];
};

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    ParticleData particles;
    WrenchArray wrench_buffer;
    uint root_index;
    uint total_particles;
    float particle_radius;
    float stiffness;
} pc;

shared uint shared_stacks[MAX_SUBGROUPS_PER_WG][32];
shared uint shared_stack_ptrs[MAX_SUBGROUPS_PER_WG];

void atomicAddParticle(ParticleData buf, uint index, float val) {
    uint old_val = buf.data[index];
    uint assumed_val;
    uint spin_count = 0;

    do {
        assumed_val = old_val;
        float new_val = uintBitsToFloat(assumed_val) + val;
        old_val = atomicCompSwap(buf.data[index], assumed_val, floatBitsToUint(new_val));
        spin_count++;

#ifdef DEBUG_SHADERS
        // Diagnostic: Detect if the software CAS is bottlenecking
        if (spin_count > 1000) {
            debugPrintfEXT("[bp_particle_self WARNING] Severe CAS contention on float index %d!\n", index);
            break; // Prevent infinite TDR hang
        }
#endif
    } while (assumed_val != old_val);
}

void main() {
    uint subgroup_id = gl_SubgroupID;
    uint lane_id     = gl_SubgroupInvocationID;

#ifdef DEBUG_SHADERS
    if (gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("======================================\n");
        debugPrintfEXT("bp_particle_self.comp : STARTED\n");
        debugPrintfEXT("Total Particles : %d\n", pc.total_particles);
        debugPrintfEXT("Radius: %1.3f | Stiffness: %1.3f\n", pc.particle_radius, pc.stiffness);
        debugPrintfEXT("======================================\n");
    }
#endif

    // FIX: Dynamic dense query mapping
    uint my_p_idx = gl_WorkGroupID.x * gl_NumSubgroups + subgroup_id;
    if (my_p_idx >= pc.total_particles) return;

    vec3 my_pos, my_min, my_max;
    float my_radius = pc.particle_radius;

    if (lane_id == 0) {
        // Explictly use gl_SubgroupSize for safe AoSoA extraction
        uint block_idx = my_p_idx / gl_SubgroupSize;
        uint local_idx = my_p_idx % gl_SubgroupSize;
        uint base = block_idx * (PARTICLE_FIELDS * gl_SubgroupSize) + local_idx;

        my_pos = vec3(
            uintBitsToFloat(pc.particles.data[base + 0u * gl_SubgroupSize]),
            uintBitsToFloat(pc.particles.data[base + 1u * gl_SubgroupSize]),
            uintBitsToFloat(pc.particles.data[base + 2u * gl_SubgroupSize])
        );

        my_min = my_pos - vec3(my_radius);
        my_max = my_pos + vec3(my_radius);

        shared_stacks[subgroup_id][0] = pc.root_index;
        shared_stack_ptrs[subgroup_id] = 1;
    }

    my_pos = vec3(subgroupBroadcast(my_pos.x, 0), subgroupBroadcast(my_pos.y, 0), subgroupBroadcast(my_pos.z, 0));
    my_min = vec3(subgroupBroadcast(my_min.x, 0), subgroupBroadcast(my_min.y, 0), subgroupBroadcast(my_min.z, 0));
    my_max = vec3(subgroupBroadcast(my_max.x, 0), subgroupBroadcast(my_max.y, 0), subgroupBroadcast(my_max.z, 0));
    my_p_idx = subgroupBroadcast(my_p_idx, 0);

    vec3 local_repulsive_force = vec3(0.0);

    while (true) {
        subgroupMemoryBarrierShared();
        uint stack_ptr = shared_stack_ptrs[subgroup_id];
        if (stack_ptr == 0) break;

        stack_ptr--;
        uint node_idx = shared_stacks[subgroup_id][stack_ptr];
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        uint meta        = tlas_metadata(pc.bvh, node_idx, lane_id);
        bool valid       = bvh_node_is_valid(tlas_valid_mask(pc.bvh, node_idx), lane_id);
        vec3 c_min       = vec3(tlas_min_x(pc.bvh, node_idx, lane_id), tlas_min_y(pc.bvh, node_idx, lane_id), tlas_min_z(pc.bvh, node_idx, lane_id));
        vec3 c_max       = vec3(tlas_max_x(pc.bvh, node_idx, lane_id), tlas_max_y(pc.bvh, node_idx, lane_id), tlas_max_z(pc.bvh, node_idx, lane_id));
        uint child_payload = tlas_child(pc.bvh, node_idx, lane_id);
        uint node_p_start  = tlas_pstart(pc.bvh, node_idx, lane_id);
        uint node_p_count  = tlas_pcount(pc.bvh, node_idx, lane_id);

        bool hit_aabb = valid && intersectAABB(my_min, my_max, c_min, c_max);
        bool is_leaf = bvh_is_leaf(meta);

        bool hit_node = hit_aabb && !is_leaf;
        bool hit_leaf = hit_aabb && is_leaf;

        uvec4 leaf_ballot = subgroupBallot(hit_leaf);

        for (uint i = 0; i < 4; i++) {
            uint mask = leaf_ballot[i];
            while (mask != 0) {
                uint bit = findLSB(mask);
                mask &= ~(1u << bit);

                uint src_lane = i * 32 + bit;

                // FIX: True register shuffle. We shuffle the cached registers, NOT memory.
                uint s_start = subgroupShuffle(node_p_start, src_lane);
                uint s_count = subgroupShuffle(node_p_count, src_lane);

                for (uint p = 0; p < s_count; p++) {
                    uint other_idx = s_start + p;
                    if (other_idx == my_p_idx) continue;

                    uint block_idx = other_idx / gl_SubgroupSize;
                    uint local_idx = other_idx % gl_SubgroupSize;
                    uint base = block_idx * (PARTICLE_FIELDS * gl_SubgroupSize) + local_idx;

                    vec3 other_pos = vec3(
                        uintBitsToFloat(pc.particles.data[base + 0u * gl_SubgroupSize]),
                        uintBitsToFloat(pc.particles.data[base + 1u * gl_SubgroupSize]),
                        uintBitsToFloat(pc.particles.data[base + 2u * gl_SubgroupSize])
                    );

                    vec3 diff = my_pos - other_pos;
                    float dist_sq = dot(diff, diff);
                    float min_dist = my_radius * 2.0;

                    if (dist_sq > 1e-12 && dist_sq < min_dist * min_dist) {
                        float dist = sqrt(dist_sq);
                        float penetration = min_dist - dist;
                        vec3 normal = diff / dist;

                        float force_mag = pc.stiffness * penetration;
                        vec3 applied_force = normal * force_mag;
                        local_repulsive_force += applied_force;
                    }
                }
            }
        }

        uvec4 node_ballot = subgroupBallot(hit_node);
        uint  node_count  = subgroupBallotBitCount(node_ballot);
        uint  push_offset = subgroupBallotExclusiveBitCount(node_ballot);

        uint new_top = min(stack_ptr + node_count, 32u);
        if (hit_node) {
            if ((stack_ptr + push_offset) < 32u) {
                shared_stacks[subgroup_id][stack_ptr + push_offset] = child_payload;
            }
#ifdef DEBUG_SHADERS
            else {
                debugPrintfEXT("[bp_particle_self FATAL] BVH Stack Overflow! P_ID: %d\n", my_p_idx);
            }
#endif
        }
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = new_top;
    }

    local_repulsive_force.x = subgroupAdd(local_repulsive_force.x);
    local_repulsive_force.y = subgroupAdd(local_repulsive_force.y);
    local_repulsive_force.z = subgroupAdd(local_repulsive_force.z);

    if (lane_id == 0 && dot(local_repulsive_force, local_repulsive_force) > 0.0) {

#ifdef DEBUG_SHADERS
        // EXPLOSION DETECTOR: Flag physics explosions from absurd repulsive forces
        if (length(local_repulsive_force) > 10000.0) {
             debugPrintfEXT("[bp_particle_self WARNING] Particle %d exploded! Force length: %1.2f\n", my_p_idx, length(local_repulsive_force));
        }
#endif

        uint block_idx = my_p_idx / gl_SubgroupSize;
        uint local_idx = my_p_idx % gl_SubgroupSize;
        uint base = block_idx * (PARTICLE_FIELDS * gl_SubgroupSize) + local_idx;

        atomicAddParticle(pc.particles, base + 7u * gl_SubgroupSize, local_repulsive_force.x);
        atomicAddParticle(pc.particles, base + 8u * gl_SubgroupSize, local_repulsive_force.y);
        atomicAddParticle(pc.particles, base + 9u * gl_SubgroupSize, local_repulsive_force.z);
    }
}
