#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"
#include "imex_math.glsl"
#include "physics_core.glsl"

layout(local_size_x = 256) in;

layout(push_constant, std430) uniform PushConstants {
    RigidBodyArray scene_entities;    // 0-7
    uint64_t particles;               // 8-15
    uint64_t output_list;             // 16-23
    uint64_t pair_buffer;             // 24-31
    float dt;                         // 32-35
    float particle_radius;            // 36-39
    GpuReferenceFrameArray lca_entities; // 40-47
    uint space_type;                  // 48-51
    uint _pad;                        // 52-55
} pc;

void main() {
    uint pair_idx = gl_GlobalInvocationID.x;
    
    uint idA, idB, lca_id;

    if (pc.space_type == 1) {
        CrossPairBuffer cross_pairs = CrossPairBuffer(pc.pair_buffer);
        if (pair_idx >= cross_pairs.count) return;
        CrossPair pair = cross_pairs.pairs[pair_idx];
        idA = pair.macro_id;
        idB = pair.micro_id;
        lca_id = pair.lca_id;
    } else {
        PairBuffer pairs = PairBuffer(pc.pair_buffer);
#ifdef DEBUG_SHADERS
        if (pair_idx == 0) debugPrintfEXT("narrow_ccd addr=%lx count=%d pair_idx=%d", pc.pair_buffer, pairs.count, pair_idx);
#endif
        if (pair_idx >= pairs.count) return;
        uvec2 pair = pairs.pairs[pair_idx];
        idA = pair.x;
        idB = pair.y;
    }

    RigidBody ent_A = pc.scene_entities.bodies[idA];
    RigidBody ent_B = pc.scene_entities.bodies[idB];
    
    uint shape_A = ent_A.shape_type;
    vec3 extents_A = ent_A.shape_extents;
    vec4 orient_A = ent_A.orientation;
    vec3 pos_A = ent_A.position_mass.xyz;
    vec3 vel_A = ent_A.linear_vel_drag.xyz;
    
    uint shape_B = ent_B.shape_type;
    vec3 extents_B = ent_B.shape_extents;
    vec4 orient_B = ent_B.orientation;
    vec3 pos_B = ent_B.position_mass.xyz;
    vec3 vel_B = ent_B.linear_vel_drag.xyz;

    mat4 trans_A = mat4(1.0);
    mat4 trans_B = mat4(1.0);
    
    if (pc.space_type == 1) {
        GpuReferenceFrame lca = pc.lca_entities.frames[lca_id];
        vec3 macro_rel_vel = vel_A - lca.center_vel;
        pos_A = (pos_A - lca.center_pos) / lca.scale;
        vel_A = macro_rel_vel / lca.scale;
        extents_A /= lca.scale;
    }
    
    mat3 rotA = quat_to_mat3(orient_A);
    trans_A = mat4(vec4(rotA[0],0), vec4(rotA[1],0), vec4(rotA[2],0), vec4(pos_A,1.0));
    
    mat3 rotB = quat_to_mat3(orient_B);
    trans_B = mat4(vec4(rotB[0],0), vec4(rotB[1],0), vec4(rotB[2],0), vec4(pos_B,1.0));

    float toi, depth;
    vec3 normal, contact;
    
#ifdef DEBUG_SHADERS
    debugPrintfEXT("Narrow Phase CCD [pair %d]: idA=%d, idB=%d\n", pair_idx, idA, idB);
#endif

    if (compute_toi_generic(shape_A, extents_A, trans_A, vel_A * pc.dt, shape_B, extents_B, trans_B, vel_B * pc.dt, 1e-3, 10, toi, normal, contact, depth)) {
        SparseCollisions out_list = SparseCollisions(pc.output_list);
        uint count = atomicAdd(out_list.count, 1);
        if (count < 4000u) {
            out_list.pairs[count].valid = 1u;
            out_list.pairs[count].entity_a = idA;
            out_list.pairs[count].entity_b = idB;
            out_list.pairs[count].prim_a = idA;
            out_list.pairs[count].prim_b = idB;
            out_list.pairs[count].toi = toi;
            out_list.pairs[count].is_lca = 0u;
            out_list.pairs[count].lca_id = 0u;
            out_list.pairs[count].contact_normal = normal;
            out_list.pairs[count].contact_point = contact;
            out_list.pairs[count].penetration_depth = max(depth, 1e-4);
        }
    }
}
