#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

layout(local_size_x = 128) in;

layout(push_constant, scalar) uniform PushConstants {
    RigidBodyUintArray rigid_bodies;
    CrossSparseCollisions collisions;
    ImpulseOutput impulses;
    LcaEntityArray lca_entities;
} pc;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    if (global_id >= pc.collisions.count) return;

    CrossCollisionData pair = pc.collisions.pairs[global_id];
    if (pair.valid == 0u) return;

    // Native Force (kg * km / s)
    vec3 impulse_micro = pc.impulses.impulses[global_id];
    if (length(impulse_micro) < 1e-6) return;

    LcaEntity lca = pc.lca_entities.entities[pair.lca_id];

    // -----------------------------------------------------------
    // 1. APPLY TO MACRO ENTITY (Demote back to AU/M_earth scale)
    // -----------------------------------------------------------
    uint baseA = pair.macro_id * 28;
    float massA_earth = uintBitsToFloat(pc.rigid_bodies.data[baseA + 3]);
    float invMA_earth = massA_earth > 0.0 ? 1.0 / massA_earth : 0.0;

    // Rotate reverse-impulse (-impulse_micro) out of LCA Space directly to World Space
    vec3 impulse_macro_world = mat3(lca.transform) * (-impulse_micro);

    if (invMA_earth > 0.0) {
        // Demote the km/kg impulse back to native AU/s
        vec3 P_world_au = impulse_macro_world / (M_EARTH_TO_KG * AU_TO_KM);
        vec3 dvA_au = P_world_au * invMA_earth;

        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 8], dvA_au.x);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 9], dvA_au.y);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 10], dvA_au.z);

        // Angular velocity (rad/s) is scale-invariant.
        vec4 qA = vec4(uintBitsToFloat(pc.rigid_bodies.data[baseA+4]), uintBitsToFloat(pc.rigid_bodies.data[baseA+5]), uintBitsToFloat(pc.rigid_bodies.data[baseA+6]), uintBitsToFloat(pc.rigid_bodies.data[baseA+7]));
        vec3 invIA_earth = vec3(uintBitsToFloat(pc.rigid_bodies.data[baseA+16]), uintBitsToFloat(pc.rigid_bodies.data[baseA+17]), uintBitsToFloat(pc.rigid_bodies.data[baseA+18]));

        // Convert the micro contact point back to Macro World Space
        vec3 pos_A_world_au = vec3(uintBitsToFloat(pc.rigid_bodies.data[baseA+0]), uintBitsToFloat(pc.rigid_bodies.data[baseA+1]), uintBitsToFloat(pc.rigid_bodies.data[baseA+2]));
        vec3 contact_world_au = (lca.transform * vec4(pair.contact_point / AU_TO_KM, 1.0)).xyz;
        vec3 rA_world_au = contact_world_au - pos_A_world_au;

        // Convert to torque natively in World Space
        vec3 torque_world_au = cross(rA_world_au, P_world_au);
        vec3 dwA = quat_rotate(qA, invIA_earth * quat_rotate_inv(qA, torque_world_au));

        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 12], dwA.x);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 13], dwA.y);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseA + 14], dwA.z);
    }

    // -----------------------------------------------------------
    // 2. APPLY TO MICRO ENTITY (Natively)
    // -----------------------------------------------------------
    uint baseB = pair.micro_id * 28;
    float massB = uintBitsToFloat(pc.rigid_bodies.data[baseB + 3]);
    float invMB = massB > 0.0 ? 1.0 / massB : 0.0;

    if (invMB > 0.0) {
        vec3 dvB = impulse_micro * invMB; // Applies native Micro impulse directly

        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 8], dvB.x);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 9], dvB.y);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 10], dvB.z);

        vec4 qB = vec4(uintBitsToFloat(pc.rigid_bodies.data[baseB+4]), uintBitsToFloat(pc.rigid_bodies.data[baseB+5]), uintBitsToFloat(pc.rigid_bodies.data[baseB+6]), uintBitsToFloat(pc.rigid_bodies.data[baseB+7]));
        vec3 invIB = vec3(uintBitsToFloat(pc.rigid_bodies.data[baseB+16]), uintBitsToFloat(pc.rigid_bodies.data[baseB+17]), uintBitsToFloat(pc.rigid_bodies.data[baseB+18]));
        vec3 pos_B = vec3(uintBitsToFloat(pc.rigid_bodies.data[baseB+0]), uintBitsToFloat(pc.rigid_bodies.data[baseB+1]), uintBitsToFloat(pc.rigid_bodies.data[baseB+2]));

        vec3 rB = pair.contact_point - pos_B;
        vec3 dwB = quat_rotate(qB, invIB * quat_rotate_inv(qB, cross(rB, impulse_micro)));

        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 12], dwB.x);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 13], dwB.y);
        ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[baseB + 14], dwB.z);
    }
}