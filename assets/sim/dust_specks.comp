    {
        vec3 mean; float S[6]; vec3 seg; vec2 rho; float flux;
        rec_leaf(mean, S, seg, rho, flux);
        SpeckView V = wr_view();
        vec2 a = df_two_sum(mean.x, -V.eye.x), b = df_two_sum(mean.y, -V.eye.y), c = df_two_sum(mean.z, -V.eye.z);
        wr_put(DUST_WR_ME, a.x); wr_put(DUST_WR_ME + 1u, a.y);
        wr_put(DUST_WR_ME + 2u, b.x); wr_put(DUST_WR_ME + 3u, b.y);
        wr_put(DUST_WR_ME + 4u, c.x); wr_put(DUST_WR_ME + 5u, c.y);
