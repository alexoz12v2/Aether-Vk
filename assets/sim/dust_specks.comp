    setup_start_box();
#endif
#if SETUP_PH(7)
    setup_start_level();
#endif
#if SETUP_PH(8)
    setup_start_paths();
#endif
#if SETUP_PH(6)
    // the start nodes to frontier 0 (the record's slot order is the depth-first push order; the
    // frontier's is free)
    {
        groupMemoryBarrier();
        uint n = WR_O(g_rec, DUST_WR_NSTART);
        uint region = wr_region();
        uint q = atomicAdd(pc.pyramid.v[region + 8u], n);
        uint cap = wr_cap(2u);
        for (uint j = 0u; j < n; ++j) {
            if (q + j >= cap) { wr_truncate(); break; }
            wr_put_node(wr_front(region, 0u, q + j), e, specks_at(n - 1u - j));
        }
        if (n > 0u) wr_args(region + 9u, (min(q + n, cap) - 1u) / DUST_STEP_NODES + 1u);  // step 0's workgroups (8 nodes each)
    }
#endif
}
#endif
#elif defined(DUST_SPECKS_LEAVES)
// ── LEAVES ──
// scatter_speck in two phases (the walk's leaves): the projection to (mu, the counts, the depth)
// and the deposit of the footprint, the same expressions. Returns on screen; total 0 = nothing to
// deposit
bool scatter_project(vec3 dp, float xsec, uint hash, vec3 sun, float rhAu, SpeckView V,
                     out vec2 mu, out uint total, out uint depthBits) {
    mu = vec2(0.0); total = 0u; depthBits = 0u;
    vec4 clip = pc.mvp * vec4(dp, 1.0);
    if (!(clip.w > 0.0)) return false;
    vec3 d = dp;
    if (!V.perspective && dot(V.fwd, V.fwd) > 0.0 && dot(d, V.fwd) <= 0.0) return false;
    vec2 ndc = clip.xy / clip.w;
    mu = (ndc * 0.5 + 0.5) * vec2(V.W, V.H);
    float fp = float(DUST_SPECKS_FOOTPRINT) + 0.5;
    if (!(mu.x > -fp && mu.y > -fp && mu.x < V.W + fp && mu.y < V.H + fp)) return false;
    vec3 r0 = vec3(pc.mvp[0][0], pc.mvp[1][0], pc.mvp[2][0]);
    vec3 r1 = vec3(pc.mvp[0][1], pc.mvp[1][1], pc.mvp[2][1]);
    vec3 r3 = vec3(pc.mvp[0][3], pc.mvp[1][3], pc.mvp[2][3]);
    vec3 jx = (r0 - ndc.x * r3) * (0.5 * V.W / clip.w);
    vec3 jy = (r1 - ndc.y * r3) * (0.5 * V.H / clip.w);
    float g00 = dot(jx, jx), g01 = dot(jx, jy), g11 = dot(jy, jy);
    float detG = max(g00 * g11 - g01 * g01, 0.0);
    float weight = 1.0;
    if (pc.albedo > 0.0) {
        vec3 toEye = V.perspective ? -d : -V.fwd;
        weight = dust_radiance_weight(pc.pyramid, pc.albedo, sun, toEye, rhAu);
    }
    float tau = V.exposure * xsec * weight * sqrt(detG);
    if (!(tau > 0.0) || isinf(tau)) return true;
    float peak = tau / (2.0 * DUST_PI_F32 * DUST_SPECKS_SIGMA_PX * DUST_SPECKS_SIGMA_PX);
    atomicMax(pc.pyramid.v[DUST_PYR_TAU_MAX], floatBitsToUint(peak));
    float countsF = min(tau * pc.invUnit, DUST_COUNT_MAX_PER_ADD);
    total = uint(floor(countsF + dust_u01(dust_specks_word(hash, 6u))));
    depthBits = floatBitsToUint(max(length(d) / DUST_AU_M, 0.0));
    return true;
}
uint scatter_deposit(vec2 mu, uint total, uint depthBits) {
    uint deposited = 0u;
    uint off = pc.pyramid.v[DUST_PYR_TABLE];
    uint lw = pc.pyramid.v[DUST_PYR_TABLE + 1u];
    uint lh = pc.pyramid.v[DUST_PYR_TABLE + 2u];
    int cx = int(floor(mu.x)), cy = int(floor(mu.y));
    float inv2s2 = 1.0 / (2.0 * DUST_SPECKS_SIGMA_PX * DUST_SPECKS_SIGMA_PX);
    float sx = 0.0, sy = 0.0;
    for (int i = 0; i < 5; ++i) {
        sx += dust_specks_fw(cx, i, mu.x, inv2s2);
        sy += dust_specks_fw(cy, i, mu.y, inv2s2);
    }
    float norm = 1.0 / (sx * sy);
    float carry = 0.0;
    for (int iy = 0; iy < 5; ++iy) {
        int ty = cy + iy - DUST_SPECKS_FOOTPRINT;
        for (int ix = 0; ix < 5; ++ix) {
            int tx = cx + ix - DUST_SPECKS_FOOTPRINT;
            float acc = float(total) * dust_specks_fw(cx, ix, mu.x, inv2s2) * dust_specks_fw(cy, iy, mu.y, inv2s2) * norm + carry;
            uint c = uint(floor(acc + 0.5));
            carry = acc - float(c);
            if (c == 0u || tx < 0 || ty < 0 || tx >= int(lw) || ty >= int(lh)) continue;
            uint i = off + (uint(ty) * lw + uint(tx)) * DUST_PYRAMID_TEXEL_WORDS;
            dust_atomic_add_sat(pc.pyramid, i, c);
            float hf = float(dust_hash32(i) >> 8u) * (1.0 / 16777216.0);
            uvec3 n = uvec3(float(c) * wr_vv(DUST_WR_COLOR) * DUST_COLOR_SCALE + hf);  // the record's colour, loaded here
            dust_atomic_add_sat(pc.pyramid, i + 1u, n.r);
            dust_atomic_add_sat(pc.pyramid, i + 2u, n.g);
            dust_atomic_add_sat(pc.pyramid, i + 3u, n.b);
            uint cur = pc.pyramid.v[i + 4u];
            if (cur == 0u || depthBits < cur) {
                uint seen = atomicCompSwap(pc.pyramid.v[i + 4u], 0u, depthBits);
                if (seen != 0u) atomicMin(pc.pyramid.v[i + 4u], depthBits);
            }
            deposited += c;
        }
    }
    if (deposited > 0u) atomicOr(pc.pyramid.v[DUST_PYR_LEVEL_MASK], 1u);
    return deposited;
}

// A workgroup per leaf (x + y * 65535: the indirect args at region words 0-1), a lane per speck
// k < 64. The speck's coordinates one axis per phase (a zeta quantile alone fills Mali-G52's 32
// registers, so nothing else may be live across one: each phase finds the leaf and its record
// again from the workgroup id), its offset from the eye, the tests, the budget and the
// projection, then the deposit, each phase behind a barrier with the speck's values in shared
// memory. The trace (a test hook) is filled by -DDUST_SPECKS_LEAVES=2.
shared float s_co[3u * 64u];   // the speck's coordinates, axis-major; then its centre and counts
shared float s_dp[3u * 64u];   // its offset from the eye, axis-major; then [k] its depth
shared uint s_live[64];        // kept (dust_specks_word 5 against keep) and k < n; then 2 = on screen
// the speck's hash (the leaf's for k = 0)
uint leaf_hs(uint at, uint k) {
    uint nodeHash = WR_O(at, 5);
    return k == 0u ? nodeHash : dust_hash32(nodeHash + k * 0x9E3779B9u);
}
// the speck's position in the leaf's cell along axis a (node_cell: dim a split (level + 2 - a) / 3 times)
float leaf_w(uint at, uint hs, uint a) {
    uint o = at;
    uint level = WR_O(o, 6) & 0xFFu;
    return float(WR_O(o, 1u + a)) * (1.0 / 4294967296.0)
         + dust_u01(dust_specks_word(hs, a)) * uintBitsToFloat(uint(127 - int((level + 2u - a) / 3u)) << 23u);
}
#if DUST_SPECKS_LEAVES == 1 || DUST_SPECKS_LEAVES == 3
// LEAVES=1: the many-speck queue, a workgroup per leaf, lane k = speck k; LEAVES=3: the single-speck
// queue, a lane per leaf (64 a workgroup), speck 0. The same phases, the same expressions.
#if DUST_SPECKS_LEAVES == 1
uint leaf_q() { return gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x; }
uint leaf_k() { return gl_LocalInvocationID.x; }
uint leaf_entry(uint region, uint q) { return wr_leaf(region, q); }
const uint LEAF_COUNT = 4u, LEAF_CAP = 1u, LEAF_TRACE_TAG = 0u;
#else
uint leaf_q() { return (gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x; }
uint leaf_k() { return 0u; }
uint leaf_entry(uint region, uint q) { return wr_leaf1(region, q); }
const uint LEAF_COUNT = DUST_WR_LEAF1, LEAF_CAP = 3u, LEAF_TRACE_TAG = 0x80000000u;
#endif
// the phase's leaf (its first word; the record's g_rec), read again
uint leaf_at() {
    groupMemoryBarrier();
    uint region = wr_region();
    uint at = leaf_entry(region, leaf_q());
    g_rec = wr_record(region, WR_O(at, 0));
    return at;
}
void main() {
    dust_mom_addr = uvec2(pc.moments);
    uint k = gl_LocalInvocationID.x;  // the lane (its shared slots)
    {
        uint region = wr_region();
        if (leaf_q() >= min(pc.pyramid.v[region + LEAF_COUNT], wr_cap(LEAF_CAP))) return;
    }
    // the speck's keep and its first axis
    {
        uint at = leaf_at();
        uint ex = (pc.pyramid.v[at + 6u] >> 16u) & 0xFFu, mant = pc.pyramid.v[at + 4u];
        uint n = ex == 0u ? min(mant, 64u) : 64u;
        uint hs = leaf_hs(at, leaf_k());
        float keep = wr_f(DUST_WR_KEEP);
        bool live = leaf_k() < n && !(keep < 1.0 && !(dust_u01(dust_specks_word(hs, 5u)) < keep));
        s_live[k] = live ? 1u : 0u;
        if (live) s_co[k] = dust_specks_inv_norm_cdf(leaf_w(at, hs, 0u));
    }
    barrier();
    if (s_live[k] != 0u) {
        uint at = leaf_at();
        s_co[64u + k] = dust_specks_inv_norm_cdf(leaf_w(at, leaf_hs(at, leaf_k()), 1u));
    }
    barrier();
    if (s_live[k] != 0u) {
        uint at = leaf_at();
        s_co[128u + k] = dust_specks_zeta_quantile(leaf_w(at, leaf_hs(at, leaf_k()), 2u), wr_vf(DUST_WR_KAPPA), wr_vf2(DUST_WR_RHO));
    }
    barrier();
    // the offset from the eye (dust_specks_offset)
    if (s_live[k] != 0u) {
        leaf_at();
        vec3 co = vec3(s_co[k], s_co[64u + k], s_co[128u + k]);
        // axis by axis (dust_specks_offset's df64 axes, the record's words loaded for each)
        for (uint a = 0u; a < 3u; ++a) {
            groupMemoryBarrier();
            s_dp[64u * a + k] = dust_specks_offset_axis(wr_vf2(DUST_WR_ME + 2u * a), wr_vf(DUST_WR_C0 + a),
                                                        wr_vf(DUST_WR_C1 + a), wr_vf(DUST_WR_C2 + a), co);
        }
    }
    barrier();
    // the tests, the budget (the speck's cross-section to the projection)
    if (s_live[k] != 0u) do {
        uint at = leaf_at();
        vec3 dp = vec3(s_dp[k], s_dp[64u + k], s_dp[128u + k]);
        s_live[k] = 0u;
        float dMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
        if (dot(dp, dp) > dMax * dMax) break;
        SpeckView V = wr_view();
        bool hasPlane = dot(V.fwd, V.fwd) > 0.0;
        if (hasPlane && dot(dp, V.fwd) <= 0.0) break;
        uint hs = leaf_hs(at, leaf_k());
        vec2 sf = unpackHalf2x16(pc.sizeFade);
        float s = dust_specks_size_um(hs, sf.x, wr_f(DUST_WR_F0), wr_f(DUST_WR_F1), dust_specks_q(pc.color)) * 1e-6;
        float xsec = DUST_PI_F32 * s * s * wr_f(DUST_WR_FADE);
        // the budget
        uint drawn = atomicAdd(pc.pyramid.v[DUST_PYR_SPECKS], 1u);
        if (drawn >= pc.pyramid.v[DUST_PYR_SPECKS_BUDGET]) {
            atomicAdd(pc.pyramid.v[DUST_PYR_SPECKS], 0xFFFFFFFFu); // undo: the drawn count stays at the budget
            atomicAdd(pc.pyramid.v[DUST_PYR_SPECKS_OVERFLOW], 1u);
            break;
        }
        s_live[k] = 3u;
        s_co[k] = xsec;
    } while (false);
    barrier();
    // the projection (scatter_speck's), the trace's first words
    if (s_live[k] == 3u) do {
        uint at = leaf_at();
        vec3 dp = vec3(s_dp[k], s_dp[64u + k], s_dp[128u + k]);
        s_live[k] = 0u;
        SpeckView V = wr_view();
        V.exposure = wr_f(DUST_WR_EXPO);
        vec2 mu; uint total, depthBits;
        bool on = scatter_project(dp, s_co[k], leaf_hs(at, leaf_k()), wr_v(DUST_WR_SUN), wr_f(DUST_WR_RH), V, mu, total, depthBits);
        if (!on) { atomicAdd(pc.pyramid.v[DUST_PYR_SPECKS], 0xFFFFFFFFu); break; } // off screen: not drawn
        s_live[k] = 2u;
        s_co[k] = mu.x; s_co[64u + k] = mu.y; s_co[128u + k] = uintBitsToFloat(total);
        // the trace (a test hook): the speck's hash, its offset from the eye, its leaf (word 11
        // until pass 2 fills the rest)
        uint spillBase = dust_spill_base(pc.pyramid);
        if (pc.pyramid.v[spillBase + 2u] != 0u) {
            uint t = atomicAdd(pc.pyramid.v[spillBase + 3u], 1u);
            if (t < pc.pyramid.v[spillBase + 2u]) {
                uint tr = dust_specks_trace_base(spillBase, pc.pyramid.v[spillBase + 1u]) + t * DUST_SPECKS_TRACE_WORDS;
                pc.pyramid.v[tr] = leaf_hs(at, leaf_k());
                pc.pyramid.v[tr + 1u] = floatBitsToUint(s_dp[k]);
                pc.pyramid.v[tr + 2u] = floatBitsToUint(s_dp[64u + k]);
                pc.pyramid.v[tr + 3u] = floatBitsToUint(s_dp[128u + k]);
                pc.pyramid.v[tr + 11u] = leaf_q() | LEAF_TRACE_TAG;
            }
        }
        s_dp[k] = uintBitsToFloat(depthBits);
    } while (false);
    barrier();
    // the deposit (a speck on screen with no counts deposits nothing)
    if (s_live[k] == 2u) {
        uint total = floatBitsToUint(s_co[128u + k]);
        if (total != 0u) {
            leaf_at();
            uint deposited = scatter_deposit(vec2(s_co[k], s_co[64u + k]), total, floatBitsToUint(s_dp[k]));
            dust_atomic_add_sat(pc.pyramid, DUST_PYR_SPECKS_COUNTS, deposited);
        }
    }
}
#else
// the trace's fill (-DDUST_SPECKS_LEAVES=2, the test hook only: a thread per trace entry): the
// cell position, the coordinates, kappa, the level, from the speck's hash and leaf (word 11)
void main() {
    uint t = gl_GlobalInvocationID.x;
    uint spillBase = dust_spill_base(pc.pyramid);
    if (t >= min(pc.pyramid.v[spillBase + 3u], pc.pyramid.v[spillBase + 2u])) return;
    uint tr = dust_specks_trace_base(spillBase, pc.pyramid.v[spillBase + 1u]) + t * DUST_SPECKS_TRACE_WORDS;
    uint region = wr_region();
    uint lq = pc.pyramid.v[tr + 11u];  // the leaf: bit 31 the single-speck queue
    uint at = (lq & 0x80000000u) != 0u ? wr_leaf1(region, lq & 0x7FFFFFFFu) : wr_leaf(region, lq);
    g_rec = wr_record(region, pc.pyramid.v[at]);
    uint hs = pc.pyramid.v[tr];
    pc.pyramid.v[tr + 4u] = floatBitsToUint(leaf_w(at, hs, 0u));
    pc.pyramid.v[tr + 5u] = floatBitsToUint(leaf_w(at, hs, 1u));
    pc.pyramid.v[tr + 6u] = floatBitsToUint(leaf_w(at, hs, 2u));
    pc.pyramid.v[tr + 10u] = floatBitsToUint(wr_f(DUST_WR_KAPPA));
    groupMemoryBarrier();
    uint o = tr;
    pc.pyramid.v[tr + 7u] = floatBitsToUint(dust_specks_inv_norm_cdf(uintBitsToFloat(WR_O(o, 4))));
    pc.pyramid.v[tr + 8u] = floatBitsToUint(dust_specks_inv_norm_cdf(uintBitsToFloat(WR_O(o, 5))));
    groupMemoryBarrier();
    pc.pyramid.v[tr + 9u] = floatBitsToUint(dust_specks_zeta_quantile(uintBitsToFloat(WR_O(o, 6)), wr_vf(DUST_WR_KAPPA), wr_vf2(DUST_WR_RHO)));
    groupMemoryBarrier();
    pc.pyramid.v[tr + 11u] = WR_O(at, 6) & 0xFFu;
}
#endif
#else
// ── STEP ──
// The step's lanes: 8 per node (8 nodes a workgroup). The node test's six coordinates (the cell's
// corners lo and lo + width, per axis: dust_specks_coord) one per lane, then the class on lane 0
// of the node, then the expansion, each phase behind a barrier with its inputs in shared memory:
// a zeta quantile alone fills Mali-G52's 32 registers, so nothing else may be live across one.
shared uint s_count;
shared uint s_frame_old;
shared uint s_flag[DUST_STEP_NODES];     // bit 0 live, bit 1 tested (not inside, mant != 0), bit 2 inside
shared float s_coord[DUST_STEP_NODES * 8u];
shared uint s_res[DUST_STEP_NODES];
shared float s_cls[DUST_STEP_NODES * 8u];  // the class's terms: sqrt r2, |d|, d.fwd, the slack's sum, preimage-out
uint step_q(uint g) { return (gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x) * DUST_STEP_NODES + g; }
void main() {
    dust_mom_addr = uvec2(pc.moments);
    uint s = pc.liveCount;  // the step (the step passes' push word 24; the gate's live count)
    uint lane = gl_LocalInvocationID.x;
    uint g = lane >> 3u, j = lane & 7u;
    if (lane == 0u) s_count = 0u;
    barrier();
    // the walk's node account (its record's count; dust::specks::DUST_SPECKS_MAX_NODES per walk)
    if (j == 0u) {
        uint region = wr_region();
        uint q = step_q(g);
        uint flag = 0u;
        if (q < min(pc.pyramid.v[region + 8u + 4u * s], wr_cap(2u))) {
            g_rec = wr_record(region, pc.pyramid.v[wr_front(region, s, q)]);
            if (atomicAdd(WR_SR(DUST_WR_NODES), 1u) >= DUST_SPECKS_MAX_NODES) wr_truncate();
            else {
                atomicAdd(s_count, 1u);
                SpeckNode node = wr_get_node(wr_front(region, s, q));
                flag = 1u | (node.mant != 0u && !node.inside ? 2u : 0u) | (node.inside ? 4u : 0u);
                if (node.mant == 0u) flag = 0u;  // popped and counted, nothing more
            }
        }
        s_flag[g] = flag;
    }
    barrier();
    // the frame's node account, one atomic a workgroup
    if (lane == 0u) s_frame_old = s_count == 0u ? 0u : atomicAdd(pc.pyramid.v[DUST_PYR_SPECKS_NODES], s_count);
    barrier();
    if (j == 0u && (s_flag[g] & 1u) != 0u && s_frame_old >= DUST_SPECKS_FRAME_NODES) {
        uint region = wr_region();
        g_rec = wr_record(region, pc.pyramid.v[wr_front(region, s, step_q(g))]);
        wr_truncate();
        s_flag[g] = 0u;
    }
    barrier();
    // the six coordinates of the cell's corners (node_cell: dim k split (level + 2 - k) / 3 times)
    if (j < 6u && (s_flag[g] & 2u) != 0u) {
        uint region = wr_region();
        uint at = wr_front(region, s, step_q(g));
        g_rec = wr_record(region, pc.pyramid.v[at]);
        uint k = j % 3u;
        uint src = at;
        uint level = WR_O(src, 6) & 0xFFu;
        float w = float(WR_O(src, 1u + k)) * (1.0 / 4294967296.0);
        if (j >= 3u) w = w + uintBitsToFloat(uint(127 - int((level + 2u - k) / 3u)) << 23u);
        s_coord[lane] = dust_specks_coord(w, k, wr_f(DUST_WR_KAPPA), wr_v2(DUST_WR_RHO));
    }
    barrier();
    // the class's terms on three lanes of the node (dust_specks_node_class's values, each the same
    // expression from the same corners): the circumradius, the centre's offset and slack, the
    // preimage bound
    if (j < 3u && (s_flag[g] & 2u) != 0u) {
        uint region = wr_region();
        g_rec = wr_record(region, pc.pyramid.v[wr_front(region, s, step_q(g))]);
        uint b = g * 8u;
        vec3 ca = vec3(s_coord[b], s_coord[b + 1u], s_coord[b + 2u]);
        vec3 cb = vec3(s_coord[b + 3u], s_coord[b + 4u], s_coord[b + 5u]);
        vec3 mid = 0.5 * (ca + cb);
        vec3 half_ = 0.5 * (cb - ca) + DUST_SPECKS_XI_TOL * (1.0 + abs(mid));
        if (j == 0u) {
            s_cls[b] = sqrt(wr_r2(half_));
        } else if (j == 1u) {
            vec3 d = wr_d(mid);
            float dn = length(d);
            vec3 fwd = wr_v(DUST_WR_FWD);
            vec3 colNorm = wr_v(DUST_WR_COLN);
            float terms = colNorm.x * abs(mid.x) + colNorm.y * abs(mid.y) + colNorm.z * abs(mid.z);
            s_cls[b + 1u] = dn;
            s_cls[b + 2u] = dot(d, fwd);
            s_cls[b + 3u] = length(wr_me()) + terms + dn;
        } else {
            float dMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
            s_cls[b + 4u] = wr_preimage_out(mid, half_, dMax) ? 1.0 : 0.0;
        }
    }
    barrier();
    // the class (dust_specks_node_class's tests in order; inside: kept, no test)
    if (j == 0u && (s_flag[g] & 1u) != 0u) {
        uint res = 3u;
        if ((s_flag[g] & 2u) != 0u) {
            uint b = g * 8u;
            uint region = wr_region();
            g_rec = wr_record(region, pc.pyramid.v[wr_front(region, s, step_q(g))]);
            float dMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
            vec3 fwd = wr_v(DUST_WR_FWD);
            bool hasPlane = dot(fwd, fwd) > 0.0;
            float r = s_cls[b] + 8.0 * DUST_SPECKS_EPS * s_cls[b + 3u];
            float dn = s_cls[b + 1u], pd = s_cls[b + 2u];
            int cls = DUST_SPECKS_NODE_MEETS;
            if (dn - r > dMax) cls = DUST_SPECKS_NODE_OUTSIDE;
            else if (dn + r <= dMax && (!hasPlane || pd - r >= 0.0)) cls = DUST_SPECKS_NODE_CONTAINED;
            else if (s_cls[b + 4u] != 0.0) cls = DUST_SPECKS_NODE_OUTSIDE;
            else if (hasPlane && pd + r < 0.0) cls = DUST_SPECKS_NODE_OUTSIDE;
            res = cls == DUST_SPECKS_NODE_OUTSIDE ? 0u : (cls == DUST_SPECKS_NODE_CONTAINED ? 3u : 1u);
        }
        s_res[g] = res;
    }
    barrier();
    if (j != 0u || (s_flag[g] & 1u) == 0u || s_res[g] == 0u) return;
    uint res = s_res[g];
    uint region = wr_region();
    uint q = step_q(g);
    g_rec = wr_record(region, pc.pyramid.v[wr_front(region, s, q)]);
    // the node's words again, read where used (not carried across the test), and its children
    // written as they are made (dust_specks_split's fields; a child pair in registers with the
    // node was 21 words)
    uint src = wr_front(region, s, q);
    uint w6 = WR_O(src, 6), mant = WR_O(src, 4);
    uint level = w6 & 0xFFu, ex = (w6 >> 16u) & 0xFFu;
    bool leaf = (mant == 1u && ex == 0u) || level >= DUST_SPECKS_MAX_LEVEL;
    if (leaf) {
        // to a leaf queue: the record, the node. One speck (the leaves pass's n = 1): the single
        // queue, a lane each; more (a leaf at the deepest level): a workgroup each
        bool single = ex == 0u && mant <= 1u;
        uint ql = atomicAdd(pc.pyramid.v[region + (single ? DUST_WR_LEAF1 : 4u)], 1u);
        if (ql < wr_cap(single ? 3u : 1u)) {
            uint dst = single ? wr_leaf1(region, ql) : wr_leaf(region, ql);
            for (uint k = 0u; k < DUST_WR_LEAF_WORDS; ++k) WR_PUT(dst, k, WR_O(src, k));
            if (single) wr_args(region + DUST_WR_LEAF1 + 1u, ql / 64u + 1u);  // 64 single leaves a workgroup
            else wr_args(region, ql + 1u);  // a workgroup a leaf
        } else wr_truncate();  // the queue is full: the walk is lost (counted with the caps)
        return;
    }
    // split dim level mod 3 at its probability midpoint; both children to frontier s + 1
    uint ml, mr;
    if (ex > 0u) {
        uvec2 h2 = dust_specks_normalise(uvec2(mant, ex - 1u));
        ml = h2.x; mr = h2.x; ex = h2.y;
    } else {
        ml = dust_specks_child_count(mant, WR_O(src, 5));
        mr = mant - ml;
        ex = 0u;
    }
    uint qn = atomicAdd(pc.pyramid.v[region + 8u + 4u * (s + 1u)], 2u);
    if (qn + 2u > wr_cap(2u)) { wr_truncate(); return; }
    uint w6c = ((level + 1u) & 0xFFu) | ((res & 2u) != 0u ? 1u << 8u : 0u) | ((ex & 0xFFu) << 16u);
    // the right child first (the depth-first push order), the dim's half added to its corner; one
    // loop for both children (two inlined blocks lost the right child's words 1..6 on the GTX 1070)
    uint dim = level % 3u;
    uint m = (level + 2u - dim) / 3u;
    uint half_ = (m + 1u >= 32u) ? 0u : (1u << (31u - m));
    for (uint c = 0u; c < 2u; ++c) {
        bool right = c == 0u;
        uint dst = wr_front(region, s + 1u, qn + c);
        WR_PUT(dst, 0, WR_O(src, 0));
        WR_PUT(dst, 1, WR_O(src, 1) + (right && dim == 0u ? half_ : 0u));
        WR_PUT(dst, 2, WR_O(src, 2) + (right && dim == 1u ? half_ : 0u));
        WR_PUT(dst, 3, WR_O(src, 3) + (right && dim == 2u ? half_ : 0u));
        WR_PUT(dst, 4, right ? mr : ml);
        WR_PUT(dst, 5, dust_hash32(WR_O(src, 5) ^ (right ? 0x6C8E9CF5u : 0x2545F491u)));
        WR_PUT(dst, 6, w6c);
    }
    wr_args(region + 9u + 4u * (s + 1u), (qn + 1u) / DUST_STEP_NODES + 1u);  // step s + 1's workgroups (8 nodes each)
}
