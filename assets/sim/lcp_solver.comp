#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_GOOGLE_include_directive : require

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

// ============================================================================
// LCP Solver: Matrix-Free 6-DoF Projected Gauss-Seidel (PGS) with Friction
// ============================================================================

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// We need World-Space Inverse Inertia Tensors for this to work.
struct RigidBody {
    vec3 position;
    float inv_mass;
    mat3 rotation;
    vec3 linear_velocity;
    float _pad0;
    vec3 angular_velocity;
    float _pad1;
    mat3 inv_inertia_tensor; // R * I_local^-1 * R^T
};

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer RigidBodyArray {
    RigidBody bodies[];
};

// Particles data (AOSOA flattened)
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData {
    float data[];
};

// Output Impulses
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer ImpulseOutput {
    vec3 impulses[];
};

layout(push_constant, scalar) uniform PushConstants {
    ParticleData particles;
    PackedCollisions collisions;
    ImpulseOutput outputs;
    uint total_clusters;
    RigidBodyArray rigid_bodies;
    float dt;
    float restitution;
} pc;

#define MAX_BODIES_PER_ISLAND 64

// Shared memory for the Matrix-Free state
shared uint shared_v_x[MAX_BODIES_PER_ISLAND];
shared uint shared_v_y[MAX_BODIES_PER_ISLAND];
shared uint shared_v_z[MAX_BODIES_PER_ISLAND];

shared uint shared_w_x[MAX_BODIES_PER_ISLAND];
shared uint shared_w_y[MAX_BODIES_PER_ISLAND];
shared uint shared_w_z[MAX_BODIES_PER_ISLAND];

// Accumulated Impulses
shared float accumulated_normal[128];
shared float accumulated_t1[128];
shared float accumulated_t2[128];

// CAS loop for shared memory float atomics
#define atomicAddSharedFloat(ADDR, val) \
    do { \
        uint old_val = ADDR; \
        uint assumed_val; \
        do { \
            assumed_val = old_val; \
            uint new_val = floatBitsToUint(uintBitsToFloat(assumed_val) + (val)); \
            old_val = atomicCompSwap(ADDR, assumed_val, new_val); \
        } while (assumed_val != old_val); \
    } while(false)

// Generates an orthogonal basis for friction
void generate_tangents(vec3 normal, out vec3 t1, out vec3 t2) {
    if (abs(normal.x) >= 0.57735) {
        t1 = normalize(vec3(normal.y, -normal.x, 0.0));
    } else {
        t1 = normalize(vec3(0.0, normal.z, -normal.y));
    }
    t2 = cross(normal, t1);
}

// Calculates the 6-DoF Effective Mass for a specific direction
float compute_effective_mass(vec3 dir, vec3 rA, vec3 rB, float invMA, float invMB, mat3 invIA, mat3 invIB) {
    vec3 crossA = cross(rA, dir);
    vec3 crossB = cross(rB, dir);
    float invMassSum = invMA + invMB;
    float angularA = dot(invIA * crossA, crossA);
    float angularB = dot(invIB * crossB, crossB);
    return 1.0 / max(invMassSum + angularA + angularB, 1e-6);
}

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint contact_idx = gl_WorkGroupID.x * gl_WorkGroupSize.x + local_id;
    bool valid = (contact_idx < pc.collisions.count);

    // --- 1. SETUP PHASE ---
    vec3 normal, t1, t2, rA, rB;
    float eff_M_n, eff_M_t1, eff_M_t2;
    float bias = 0.0;

    // Extracted body indices (assuming mapped pairs to 0..MAX_BODIES_PER_ISLAND)
    // For educational code with 1 collision per island:
    uint local_idx_A = 0;
    uint local_idx_B = 1;

    // We initialize dummy rigid bodies for particles for now, as the backend builds ParticleData.
    // Real implementation would diverge if reading RigidBody vs Particles.
    float m_A = 0.0, m_B = 0.0;
    mat3 inv_inertia_A = mat3(0.0);
    mat3 inv_inertia_B = mat3(0.0);

    if (valid) {
        PackedPair pair = pc.collisions.pairs[contact_idx];
        uint pA_id = pair.a.primitive_index;
        uint pB_id = pair.b.primitive_index;
        
        uint blockA = pA_id / SG_SIZE;
        uint locA = pA_id % SG_SIZE;
        uint baseA = blockA * (10 * SG_SIZE) + locA;
        
        uint blockB = pB_id / SG_SIZE;
        uint locB = pB_id % SG_SIZE;
        uint baseB = blockB * (10 * SG_SIZE) + locB;
        
        m_A = pc.particles.data[baseA + 6 * SG_SIZE];
        m_B = pc.particles.data[baseB + 6 * SG_SIZE];
        
        vec3 v_A = vec3(
            pc.particles.data[baseA + 3 * SG_SIZE],
            pc.particles.data[baseA + 4 * SG_SIZE],
            pc.particles.data[baseA + 5 * SG_SIZE]
        );
        vec3 pos_A = vec3(
            pc.particles.data[baseA + 0 * SG_SIZE],
            pc.particles.data[baseA + 1 * SG_SIZE],
            pc.particles.data[baseA + 2 * SG_SIZE]
        );
        
        vec3 v_B = vec3(
            pc.particles.data[baseB + 3 * SG_SIZE],
            pc.particles.data[baseB + 4 * SG_SIZE],
            pc.particles.data[baseB + 5 * SG_SIZE]
        );
        vec3 pos_B = vec3(
            pc.particles.data[baseB + 0 * SG_SIZE],
            pc.particles.data[baseB + 1 * SG_SIZE],
            pc.particles.data[baseB + 2 * SG_SIZE]
        );

        if (local_id == 0) {
            shared_v_x[local_idx_A] = floatBitsToUint(v_A.x);
            shared_v_y[local_idx_A] = floatBitsToUint(v_A.y);
            shared_v_z[local_idx_A] = floatBitsToUint(v_A.z);
            shared_w_x[local_idx_A] = floatBitsToUint(0.0);
            shared_w_y[local_idx_A] = floatBitsToUint(0.0);
            shared_w_z[local_idx_A] = floatBitsToUint(0.0);

            shared_v_x[local_idx_B] = floatBitsToUint(v_B.x);
            shared_v_y[local_idx_B] = floatBitsToUint(v_B.y);
            shared_v_z[local_idx_B] = floatBitsToUint(v_B.z);
            shared_w_x[local_idx_B] = floatBitsToUint(0.0);
            shared_w_y[local_idx_B] = floatBitsToUint(0.0);
            shared_w_z[local_idx_B] = floatBitsToUint(0.0);
        }

        normal = pair.contact_normal;
        generate_tangents(normal, t1, t2);

        rA = pair.contact_point - pos_A;
        rB = pair.contact_point - pos_B;

        float invMA = (m_A > 0.0) ? 1.0 / m_A : 0.0;
        float invMB = (m_B > 0.0) ? 1.0 / m_B : 0.0;

        eff_M_n  = compute_effective_mass(normal, rA, rB, invMA, invMB, inv_inertia_A, inv_inertia_B);
        eff_M_t1 = compute_effective_mass(t1, rA, rB, invMA, invMB, inv_inertia_A, inv_inertia_B);
        eff_M_t2 = compute_effective_mass(t2, rA, rB, invMA, invMB, inv_inertia_A, inv_inertia_B);

        // Baumgarte Stabilization
        float beta = 0.2;
        bias = (beta / max(pc.dt, 0.001)) * max(pair.penetration_depth - 0.01, 0.0);

        accumulated_normal[local_id] = 0.0;
        accumulated_t1[local_id] = 0.0;
        accumulated_t2[local_id] = 0.0;
    }
    barrier();

    // --- 2. MATRIX-FREE PGS ITERATION ---
    float mu = 0.5; // Friction coefficient

    for (uint iter = 0; iter < 20; iter++) {
        if (valid) {
            float invMA = (m_A > 0.0) ? 1.0 / m_A : 0.0;
            float invMB = (m_B > 0.0) ? 1.0 / m_B : 0.0;

            // 1. Read CURRENT velocities from shared memory
            vec3 vA = vec3(uintBitsToFloat(shared_v_x[local_idx_A]), uintBitsToFloat(shared_v_y[local_idx_A]), uintBitsToFloat(shared_v_z[local_idx_A]));
            vec3 wA = vec3(uintBitsToFloat(shared_w_x[local_idx_A]), uintBitsToFloat(shared_w_y[local_idx_A]), uintBitsToFloat(shared_w_z[local_idx_A]));

            vec3 vB = vec3(uintBitsToFloat(shared_v_x[local_idx_B]), uintBitsToFloat(shared_v_y[local_idx_B]), uintBitsToFloat(shared_v_z[local_idx_B]));
            vec3 wB = vec3(uintBitsToFloat(shared_w_x[local_idx_B]), uintBitsToFloat(shared_w_y[local_idx_B]), uintBitsToFloat(shared_w_z[local_idx_B]));

            // 2. Calculate relative velocity at contact point
            vec3 v_pt_A = vA + cross(wA, rA);
            vec3 v_pt_B = vB + cross(wB, rB);
            vec3 v_rel = v_pt_A - v_pt_B;

            // ----------------------------------------------------
            // SOLVE NORMAL (Non-Penetration)
            // ----------------------------------------------------
            float jv_n = dot(v_rel, normal);
            float lambda_n = eff_M_n * (-(1.0 + pc.restitution) * jv_n + bias);

            // Clamp total accumulated normal impulse (Must be pushing, not pulling)
            float old_acc_n = accumulated_normal[local_id];
            accumulated_normal[local_id] = max(old_acc_n + lambda_n, 0.0);
            float delta_lambda_n = accumulated_normal[local_id] - old_acc_n;

            // ----------------------------------------------------
            // SOLVE FRICTION (Tangents)
            // ----------------------------------------------------
            float jv_t1 = dot(v_rel, t1);
            float lambda_t1 = eff_M_t1 * (-jv_t1);

            float jv_t2 = dot(v_rel, t2);
            float lambda_t2 = eff_M_t2 * (-jv_t2);

            // Box Friction Cone: Friction is capped by the current normal force
            float max_fric = mu * accumulated_normal[local_id];

            float old_acc_t1 = accumulated_t1[local_id];
            accumulated_t1[local_id] = clamp(old_acc_t1 + lambda_t1, -max_fric, max_fric);
            float delta_lambda_t1 = accumulated_t1[local_id] - old_acc_t1;

            float old_acc_t2 = accumulated_t2[local_id];
            accumulated_t2[local_id] = clamp(old_acc_t2 + lambda_t2, -max_fric, max_fric);
            float delta_lambda_t2 = accumulated_t2[local_id] - old_acc_t2;

            // ----------------------------------------------------
            // APPLY IMPULSE BACK TO SHARED VELOCITIES
            // ----------------------------------------------------
            vec3 total_impulse = (normal * delta_lambda_n) + (t1 * delta_lambda_t1) + (t2 * delta_lambda_t2);

            vec3 dLinA = total_impulse * invMA;
            vec3 dAngA = inv_inertia_A * cross(rA, total_impulse);

            vec3 dLinB = -total_impulse * invMB;
            vec3 dAngB = inv_inertia_B * cross(rB, -total_impulse);

            atomicAddSharedFloat(shared_v_x[local_idx_A], dLinA.x);
            atomicAddSharedFloat(shared_v_y[local_idx_A], dLinA.y);
            atomicAddSharedFloat(shared_v_z[local_idx_A], dLinA.z);
            atomicAddSharedFloat(shared_w_x[local_idx_A], dAngA.x);
            atomicAddSharedFloat(shared_w_y[local_idx_A], dAngA.y);
            atomicAddSharedFloat(shared_w_z[local_idx_A], dAngA.z);

            atomicAddSharedFloat(shared_v_x[local_idx_B], dLinB.x);
            atomicAddSharedFloat(shared_v_y[local_idx_B], dLinB.y);
            atomicAddSharedFloat(shared_v_z[local_idx_B], dLinB.z);
            atomicAddSharedFloat(shared_w_x[local_idx_B], dAngB.x);
            atomicAddSharedFloat(shared_w_y[local_idx_B], dAngB.y);
            atomicAddSharedFloat(shared_w_z[local_idx_B], dAngB.z);
        }

        barrier();
    }

    // --- 3. WRITE OUT FINAL IMPULSES ---
    if (valid) {
        vec3 final_impulse = (normal * accumulated_normal[local_id]) +
                             (t1 * accumulated_t1[local_id]) +
                             (t2 * accumulated_t2[local_id]);
        pc.outputs.impulses[contact_idx] = final_impulse;
    }
}
