// SPDX-License-Identifier: MIT
// @assets/sim/bp_clear.comp
//
// Broad Phase Clear — Reset atomic pair counters
// ───────────────────────────────────────────────
// Zeroes the `count` field of four distinct pair-list buffers:
//   raw_scene_pairs — the unclassified output of bp_scene
//   out_rb_rb       — rigid body vs rigid body queue
//   out_rb_ps       — rigid body vs particle system queue
//   out_rb_lca      — cross-LCA / macro vs micro queue
//
// Dispatched as a single thread before the broad-phase suite runs.
// No synchronisation needed within this shader — one writer, no readers.
//
// Target: SPIR-V 1.4 · Vulkan 1.1

// @assets/sim/bp_clear.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_debug_printf : enable
#define DEBUG_SHADERS 1

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    PairBuffer raw_scene_pairs;
    PairBuffer out_rb_rb;
    PairBuffer out_rb_ps;
    PairBuffer out_rb_lca;
    PairBuffer internal_pairs;
    PairBuffer out_sparse;
} pc;

void main() {
    pc.raw_scene_pairs.count = 0u;
    pc.out_rb_rb.count       = 0u;
    pc.out_rb_ps.count       = 0u;
    pc.out_rb_lca.count      = 0u;
    pc.internal_pairs.count  = 0u;
    pc.out_sparse.count      = 0u;

#ifdef DEBUG_SHADERS
    debugPrintfEXT("bp_clear ran! zeroes applied!");
#endif
}