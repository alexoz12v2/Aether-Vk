#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "../debug_utils.glsl"
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatArray {
    float data[];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer AtomicCounters {
    uint counts[];
};

struct ParticleData {
    uint id_low;
    uint id_high;
    uint age_low;
    uint age_high;
    vec3 position;
    float mass;
    vec3 velocity;
    uint is_active;
};

layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer ParticleDataArray {
    ParticleData data[];
};

struct DrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer IndirectArray {
    DrawIndirectCommand commands[];
};

layout(push_constant, scalar) uniform PushConstants {
    FloatArray aosoa_particles;
    ParticleDataArray mega_particles;
    IndirectArray mega_indirect;
    AtomicCounters atomic_counters;
    uint mega_indirect_index;
    uint mega_particle_offset;
} pc;

const uint SUBGROUP_SIZE = 32;

void main() {
    uint total_particles = pc.atomic_counters.counts[0];

    // Only thread 0 writes the indirect command
    if (gl_GlobalInvocationID.x == 0) {
        pc.mega_indirect.commands[pc.mega_indirect_index].vertexCount = 4;
        pc.mega_indirect.commands[pc.mega_indirect_index].instanceCount = total_particles;
        pc.mega_indirect.commands[pc.mega_indirect_index].firstVertex = 0;
        pc.mega_indirect.commands[pc.mega_indirect_index].firstInstance = pc.mega_particle_offset;
    }

    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total_particles) {
        return;
    }

    uint in_block = idx / SUBGROUP_SIZE;
    uint in_lane  = idx % SUBGROUP_SIZE;
    uint in_base  = in_block * 10 * SUBGROUP_SIZE + in_lane;

    vec3 pos;
    pos.x = pc.aosoa_particles.data[in_base + 0 * SUBGROUP_SIZE];
    pos.y = pc.aosoa_particles.data[in_base + 1 * SUBGROUP_SIZE];
    pos.z = pc.aosoa_particles.data[in_base + 2 * SUBGROUP_SIZE];

    vec3 vel;
    vel.x = pc.aosoa_particles.data[in_base + 3 * SUBGROUP_SIZE];
    vel.y = pc.aosoa_particles.data[in_base + 4 * SUBGROUP_SIZE];
    vel.z = pc.aosoa_particles.data[in_base + 5 * SUBGROUP_SIZE];

    float mass = pc.aosoa_particles.data[in_base + 6 * SUBGROUP_SIZE];

    uint out_idx = pc.mega_particle_offset + idx;

    // We do not have IDs or Age from the physics simulation right now.
    // They could be added in emit_particles.comp in the future.
    pc.mega_particles.data[out_idx].id_low = 0;
    pc.mega_particles.data[out_idx].id_high = 0;
    pc.mega_particles.data[out_idx].age_low = 0;
    pc.mega_particles.data[out_idx].age_high = 0;
    pc.mega_particles.data[out_idx].position = pos;
    pc.mega_particles.data[out_idx].mass = mass;
    pc.mega_particles.data[out_idx].velocity = vel;
    pc.mega_particles.data[out_idx].is_active = 1;
}