#version 450 core
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 256
#endif
layout(local_size_x = LOCAL_SIZE_X) in;
const uint SUBGROUPS_PER_WG = ((LOCAL_SIZE_X / SUBGROUP_SIZE) == 0 ? 1 : (LOCAL_SIZE_X / SUBGROUP_SIZE));

layout(push_constant, std430) uniform PushConstants {
    ParticleData particles;
    MultiBvhBuffer bvh;
    ClusterListBuffer cluster_list;
    WrenchArray wrenches;
    uint num_clusters;
    float dt;
    float theta;
    float G;
    float softening_sq;
    uint root_node_idx;
    uint cluster_threshold;
} pc;

shared uint shared_stacks[SUBGROUPS_PER_WG][BVH_STACK_DEPTH_SHORT]; shared uint shared_stack_ptrs[SUBGROUPS_PER_WG];

void main() {
    uint subgroup_id = gl_SubgroupID, lane_id = gl_SubgroupInvocationID, cluster_job_idx = gl_WorkGroupID.x * SUBGROUPS_PER_WG + subgroup_id;
    if (cluster_job_idx >= pc.num_clusters) return;

    uint target_node_idx = 0;
    bool i_am_valid = false;
    uint my_p_idx = 0;
    
    // Check if cluster_list is null by converting BDA to uint64_t
    // We assume if pc.num_clusters is passed, it actually means num_particles if cluster_list is null.
    // Actually, in physics.rs num_clusters is set to total_particles.
    if (uint64_t(pc.cluster_list) == 0ul) {
        my_p_idx = cluster_job_idx * SUBGROUP_SIZE + lane_id;
        i_am_valid = my_p_idx < pc.num_clusters; // num_clusters is total_particles in this case
    } else {
        target_node_idx = pc.cluster_list.cluster_indices[cluster_job_idx];
        i_am_valid = bvh_node_is_valid(pc.bvh.nodes[target_node_idx].valid_mask, lane_id);
        my_p_idx   = pc.bvh.nodes[target_node_idx].child_indices[lane_id];
    }

    vec3 my_pos = vec3(0.0); float my_mass = 0.0; float my_beta = 0.0;
    if (i_am_valid) {
        uint base = P_BASE(my_p_idx);
        my_pos = vec3(P_READ(pc.particles, base), P_READ(pc.particles, base+1*SUBGROUP_SIZE), P_READ(pc.particles, base+2*SUBGROUP_SIZE));
        my_mass = P_READ(pc.particles, base+6*SUBGROUP_SIZE);
        my_beta = P_READ(pc.particles, base+10*SUBGROUP_SIZE);
    }

    vec3 safe_pos = i_am_valid ? my_pos : vec3(0.0), min_pos = subgroupMin(i_am_valid ? my_pos : vec3(1e20)), max_pos = subgroupMax(i_am_valid ? my_pos : vec3(-1e20));
    vec3 cluster_extents = max_pos - min_pos; float target_size = max(cluster_extents.x, max(cluster_extents.y, cluster_extents.z));
    float sum_mass = subgroupAdd(i_am_valid ? my_mass : 0.0); vec3 target_com = subgroupAdd(safe_pos * my_mass) / max(sum_mass, 1e-6);

    vec3 my_acc = vec3(0.0);
    if (lane_id == 0) { shared_stacks[subgroup_id][0] = pc.root_node_idx; shared_stack_ptrs[subgroup_id] = 1; }

    while (true) {
        subgroupMemoryBarrierShared(); uint stack_ptr = shared_stack_ptrs[subgroup_id]; if (stack_ptr == 0) break;
        uint source_node_idx = shared_stacks[subgroup_id][--stack_ptr]; if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        bool s_valid = bvh_node_is_valid(pc.bvh.nodes[source_node_idx].valid_mask, lane_id);
        bool s_is_leaf = bvh_is_leaf(pc.bvh.nodes[source_node_idx].metadata[lane_id]);

        vec3 s_com = vec3(pc.bvh.nodes[source_node_idx].com_x[lane_id], pc.bvh.nodes[source_node_idx].com_y[lane_id], pc.bvh.nodes[source_node_idx].com_z[lane_id]);
        float s_mass = pc.bvh.nodes[source_node_idx].masses[lane_id];
        uint s_idx = pc.bvh.nodes[source_node_idx].child_indices[lane_id], s_start = pc.bvh.nodes[source_node_idx].particle_start[lane_id], s_count = pc.bvh.nodes[source_node_idx].particle_count[lane_id];

        vec3 s_extents = vec3(pc.bvh.nodes[source_node_idx].max_x[lane_id]-pc.bvh.nodes[source_node_idx].min_x[lane_id], pc.bvh.nodes[source_node_idx].max_y[lane_id]-pc.bvh.nodes[source_node_idx].min_y[lane_id], pc.bvh.nodes[source_node_idx].max_z[lane_id]-pc.bvh.nodes[source_node_idx].min_z[lane_id]);
        float s_size = max(s_extents.x, max(s_extents.y, s_extents.z));

        bool pass_mac = ((s_size + target_size) / max(length(s_com - target_com), 1e-6)) < pc.theta;
        bool pass_lod_thresh = (s_count <= pc.cluster_threshold) && !((my_p_idx >= s_start) && (my_p_idx < s_start + s_count));
        bool action_accumulate = s_valid && (pass_mac || pass_lod_thresh || s_is_leaf), action_traverse = s_valid && !action_accumulate;

        uvec4 acc_ballot = subgroupBallot(action_accumulate);
        for (uint i = 0; i < 4; i++) {
            uint mask = acc_ballot[i];
            while (mask != 0) {
                uint bit = findLSB(mask); mask &= ~(1u << bit); uint src_lane = i * 32 + bit;
                if (i_am_valid) {
                    vec3 k_com = vec3(subgroupShuffle(s_com.x, src_lane), subgroupShuffle(s_com.y, src_lane), subgroupShuffle(s_com.z, src_lane));
                    float k_mass = subgroupShuffle(s_mass, src_lane); uint k_idx = subgroupShuffle(s_idx, src_lane); bool k_leaf = subgroupShuffle(s_is_leaf, src_lane);

                    if (!(k_leaf && my_p_idx == k_idx)) {
                        vec3 p_dir = k_com - my_pos; float p_dist_sq = dot(p_dir, p_dir);
                        my_acc += (p_dir / max(sqrt(p_dist_sq), 1e-6)) * ((pc.G * k_mass) / (p_dist_sq + pc.softening_sq));
                    }
                }
            }
        }

        uvec4 trav_ballot = subgroupBallot(action_traverse);
        // Guard against stack overflow — drop nodes that would exceed depth
        uint new_top = min(stack_ptr + subgroupBallotBitCount(trav_ballot), BVH_STACK_DEPTH_SHORT);
        if (action_traverse && (stack_ptr + subgroupBallotExclusiveBitCount(trav_ballot)) < BVH_STACK_DEPTH_SHORT)
            shared_stacks[subgroup_id][stack_ptr + subgroupBallotExclusiveBitCount(trav_ballot)] = s_idx;
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = new_top;
    }

    if (i_am_valid) {
        vec3 g_f = my_acc * my_mass * (1.0 - my_beta);
        uint base = P_BASE(my_p_idx);
        if (g_f.x != 0.0 || g_f.y != 0.0 || g_f.z != 0.0) {
            pc.particles.data[base + 7u * SUBGROUP_SIZE] = floatBitsToUint(uintBitsToFloat(pc.particles.data[base + 7u * SUBGROUP_SIZE]) + g_f.x);
            pc.particles.data[base + 8u * SUBGROUP_SIZE] = floatBitsToUint(uintBitsToFloat(pc.particles.data[base + 8u * SUBGROUP_SIZE]) + g_f.y);
            pc.particles.data[base + 9u * SUBGROUP_SIZE] = floatBitsToUint(uintBitsToFloat(pc.particles.data[base + 9u * SUBGROUP_SIZE]) + g_f.z);
        }
    }
}