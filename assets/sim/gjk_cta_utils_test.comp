#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "gjk_cta_utils.glsl"

struct SphereData {
    vec3 center;
    float radius;
    vec3 velocity;
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InputA {
    SphereData bodies[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer InputB {
    SphereData bodies[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutputToi {
    float tois[];
};

layout(push_constant) uniform PushConstants {
    InputA input_a;
    InputB input_b;
    OutputToi out_tois;
    uint num_pairs;
};

// Emulate Support interface for SphereData
vec3 support_sphere(SphereData sphere, vec3 dir) {
    vec3 dir_n = length(dir) > 1e-6 ? normalize(dir) : vec3(1.0, 0.0, 0.0);
    return sphere.center + dir_n * sphere.radius;
}

// Emulate AdvancingBody
vec3 support_advancing_sphere(SphereData sphere, float t, vec3 dir) {
    vec3 base_support = support_sphere(sphere, dir);
    return base_support + sphere.velocity * t;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= num_pairs) return;

    SphereData a = input_a.bodies[i];
    SphereData b = input_b.bodies[i];

    float t = 0.0;
    vec3 v_rel = a.velocity - b.velocity;
    float v_rel_max = length(v_rel);

    if (v_rel_max < 1e-6) {
        float dist = 0.0;
        // Basic static GJK
        // Since we don't have trait bounds in GLSL, we inline a simplified distance or just check overlap
        vec3 p_a = support_sphere(a, vec3(1.0, 0.0, 0.0));
        vec3 p_b = support_sphere(b, vec3(-1.0, 0.0, 0.0));
        if (length(a.center - b.center) <= a.radius + b.radius + 1e-3) {
            out_tois.tois[i] = 0.0;
        } else {
            out_tois.tois[i] = -1.0;
        }
        return;
    }

    bool hit = false;
    for (int iter = 0; iter < 10; ++iter) {
        // Simplified distance check (distance between centers minus radii)
        vec3 adv_center_a = a.center + a.velocity * t;
        vec3 adv_center_b = b.center + b.velocity * t;
        vec3 diff = adv_center_a - adv_center_b;
        float dist = length(diff) - (a.radius + b.radius);

        if (dist < 1e-3) {
            hit = true;
            break;
        }

        vec3 n = dist > 1e-6 ? normalize(diff) : vec3(1.0, 0.0, 0.0);
        float v_closing = -dot(v_rel, n);

        if (v_closing <= 0.0) {
            break; // Moving apart
        }

        float delta_t = dist / v_closing;
        t += delta_t;

        if (t > 1.0) {
            break;
        }
    }

    if (hit) {
        out_tois.tois[i] = t;
    } else {
        out_tois.tois[i] = -1.0;
    }
}
