#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

// ============================================================================
// Phase 5: Particle Explicit Final Kick & Next Force Evaluation
// ============================================================================

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;




// AOSOA Block Layout flattened into a 1D array
// 10 attributes per particle block:
// px, py, pz, vx, vy, vz, mass, fx, fy, fz
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData {
    float data[];
};

// AOS Emitter data
struct ForceEmitter {
    vec3 position;
    float mu; // G * M
    vec3 normal;
    uint type_id; // 0 = Gravity, 1 = Planar
    float trunc_distance;
    float scale_factor;
    uint _pad[2];
};

struct KinematicBody {
    uint entity_id_low;
    uint entity_id_high;
    vec3 position;
    vec4 rotation;
    vec3 scale_vec;
    vec3 velocity;
    uint parent_frame_id;
    float mu;
    uint own_frame_id;
    uint frame_type;
    float scale;
    uint shape_type;
    float shape_data[3];
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer EmitterArray {
    ForceEmitter emitters[];
};

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer KinematicArray {
    KinematicBody bodies[];
};

layout(push_constant, scalar) uniform PushConstants {
    ParticleData particles;
    EmitterArray emitters;
    KinematicArray kinematics;
    float dt;
    uint total_particles;
    uint num_emitters;
    uint num_kinematics;
} pc;

void main() {
    if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("Hello from p5_imex_particles.comp!\n");
    }
    uint global_id = gl_GlobalInvocationID.x;
    if (global_id >= pc.total_particles) {
        return;
    }

    uint block_idx = global_id / SUBGROUP_SIZE;
    uint local_idx = global_id % SUBGROUP_SIZE;

    uint stride = 10 * SUBGROUP_SIZE;
    uint base = block_idx * stride + local_idx;

    float mass = pc.particles.data[base + 6 * SUBGROUP_SIZE];
    if (mass <= 0.0) return;

    float inv_mass = 1.0 / mass;
    float half_dt = pc.dt * 0.5;

    // Load velocity (v_{n+1/2}) and position (q_mid)
    vec3 v_half = vec3(
        pc.particles.data[base + 3 * SUBGROUP_SIZE],
        pc.particles.data[base + 4 * SUBGROUP_SIZE],
        pc.particles.data[base + 5 * SUBGROUP_SIZE]
    );

    vec3 q_mid = vec3(
        pc.particles.data[base + 0 * SUBGROUP_SIZE],
        pc.particles.data[base + 1 * SUBGROUP_SIZE],
        pc.particles.data[base + 2 * SUBGROUP_SIZE]
    );

    // Phase 5: Second Drift
    // q_{n+1} = q_mid + (h/2) * v_{n+1/2}
    vec3 q_next = q_mid + v_half * half_dt;

    // Evaluate Forces at q_{n+1}
    vec3 f_next = vec3(0.0);

    // Extract particle's parent frame ID (stored in metadata, offset 11 in original, but wait - 
    // particles buffer in AOSOA has: 
    // 0: px, 1: py, 2: pz, 3: vx, 4: vy, 5: vz, 6: mass, 7: fx, 8: fy, 9: fz.
    // Wait, where is parent_frame_id? It's not in the 10-float particle data!
    // The Rust ParticleGpu struct is:
    // position (3), velocity (3), mass (1), force (3), entity_id (2), parent_frame_id (1), original_index (1)
    // Wait! In GPU shaders, ParticleData is defined as a float array and we only use the first 10.
    // If the struct is larger (14 floats = 56 bytes), we should just read it.
    // Let's read parent_frame_id from offset 12 (since entity_id is 10,11).
    uint parent_frame_id = floatBitsToUint(pc.particles.data[base + 12 * SUBGROUP_SIZE]);

    // LCA: Find parent's scale and position
    float parent_scale = 1.0;
    vec3 parent_macro_pos = vec3(0.0);
    for (uint i = 0; i < pc.num_kinematics; ++i) {
        if (pc.kinematics.bodies[i].own_frame_id == parent_frame_id) {
            parent_scale = pc.kinematics.bodies[i].scale;
            parent_macro_pos = pc.kinematics.bodies[i].position;
        }
    }

    // LCA: Gravity from Kinematic Bodies
    for (uint i = 0; i < pc.num_kinematics; ++i) {
        KinematicBody kb = pc.kinematics.bodies[i];
        if (parent_frame_id == kb.own_frame_id) {
            // Local interaction (origin)
            vec3 r = vec3(0.0) - q_next;
            float dist_sq = dot(r, r);
            if (dist_sq > 1e-6) {
                float dist = sqrt(dist_sq);
                float local_mu = (kb.frame_type == 1) ? kb.mu / (parent_scale * parent_scale * parent_scale) : kb.mu;
                f_next += r * (local_mu * mass / (dist_sq * dist));
            }
        } else if (kb.frame_type == 0 && parent_frame_id != kb.own_frame_id) {
            // Interaction with macro body
            vec3 macro_pos_in_micro = (kb.position - parent_macro_pos) / parent_scale;
            vec3 r = macro_pos_in_micro - q_next;
            float dist_sq = dot(r, r);
            if (dist_sq > 1e-6) {
                float dist = sqrt(dist_sq);
                float local_mu = kb.mu / (parent_scale * parent_scale * parent_scale);
                f_next += r * (local_mu * mass / (dist_sq * dist));
            }
        }
    }

    // Forces from explicitly defined Emitters
    for (uint e = 0; e < pc.num_emitters; ++e) {
        ForceEmitter em;
        em.position = pc.emitters.emitters[e].position;
        em.mu = pc.emitters.emitters[e].mu;
        em.normal = pc.emitters.emitters[e].normal;
        em.type_id = pc.emitters.emitters[e].type_id;
        em.trunc_distance = pc.emitters.emitters[e].trunc_distance;
        em.scale_factor = pc.emitters.emitters[e].scale_factor;
        
        if (SHOULD_DEBUG_PRINT && global_id == 0) {
            debugPrintfEXT("Emitter %d: pos=(%f, %f, %f) mu=%f type=%d scale=%f", 
                e, em.position.x, em.position.y, em.position.z, em.mu, em.type_id, em.scale_factor);
        }
        
        if (em.type_id == 0) {
            vec3 r = em.position - q_next;
            // Apply scale_factor to convert distance to LCA units, then force back
            float scaled_r_len_sq = dot(r, r) * em.scale_factor * em.scale_factor;
            if (scaled_r_len_sq > 1e-6) {
                float dist = sqrt(scaled_r_len_sq);
                // force in LCA units = G * M * m / (scaled_r_len_sq)
                // then we pull direction vector `r` which needs to be normalized and scaled back
                vec3 force_dir = r / length(r); 
                f_next += force_dir * (em.mu * mass / scaled_r_len_sq);
            }
        } else if (em.type_id == 1) {
            vec3 r = q_next - em.position;
            float dist = dot(r, em.normal);
            if (dist >= 0.0 && dist < em.trunc_distance) {
                float force_mag = em.mu / (1.0 + dist * dist);
                f_next += em.normal * force_mag;
            }
        }
    }

    // Final Kick
    // v_{n+1} = v_{n+1/2} + (h/2) * M^{-1} * F_{n+1}
    vec3 v_next = v_half + (f_next * inv_mass) * half_dt;

    // Write back q_{n+1} and v_{n+1}
    pc.particles.data[base + 0 * SUBGROUP_SIZE] = q_next.x;
    pc.particles.data[base + 1 * SUBGROUP_SIZE] = q_next.y;
    pc.particles.data[base + 2 * SUBGROUP_SIZE] = q_next.z;

    pc.particles.data[base + 3 * SUBGROUP_SIZE] = v_next.x;
    pc.particles.data[base + 4 * SUBGROUP_SIZE] = v_next.y;
    pc.particles.data[base + 5 * SUBGROUP_SIZE] = v_next.z;

    // VERY IMPORTANT: Write F_{n+1} into the force buffer
    // This prepares the buffer perfectly for Phase 1 of the next integration tick.
    pc.particles.data[base + 7 * SUBGROUP_SIZE] = f_next.x;
    pc.particles.data[base + 8 * SUBGROUP_SIZE] = f_next.y;
    pc.particles.data[base + 9 * SUBGROUP_SIZE] = f_next.z;

    if (SHOULD_DEBUG_PRINT) {
        debugPrintfEXT("P5 Particle %d: q_next=(%f, %f, %f), v_next=(%f, %f, %f), f_next=(%f, %f, %f)", 
            global_id, q_next.x, q_next.y, q_next.z, v_next.x, v_next.y, v_next.z, f_next.x, f_next.y, f_next.z);
    }
}
