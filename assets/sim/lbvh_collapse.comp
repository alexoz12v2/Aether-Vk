#version 450 core
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_ballot : require

#ifdef DEBUG_SHADERS
  #extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer binary_bvh;
    MultiBvhBuffer multi_bvh;
    CollapseMapBuffer collapse_map;
    uint num_multi_nodes;
} pc;

void main() {
    uint multi_node_idx = gl_WorkGroupID.x;
    if (multi_node_idx >= pc.num_multi_nodes) return;

    uint lane = gl_SubgroupInvocationID;

#ifdef DEBUG_SHADERS
    bool is_trace_thread = (multi_node_idx == 0 && lane == 0);
    if (is_trace_thread) {
        debugPrintfEXT("--- STARTING BVH COLLAPSE multi_node_idx=0 ---\n");
    }
#endif

    // Trap 1: Checking the initial collapse map read
    uint binary_idx = pc.collapse_map.binary_roots[multi_node_idx];

#ifdef DEBUG_SHADERS
    if (binary_idx > 100000000u) {
        debugPrintfEXT("TRAP! Garbage binary_idx=%u from collapse_map at multi_node_idx=%u\n", binary_idx, multi_node_idx);
    }
    if (is_trace_thread) debugPrintfEXT("Initial binary_idx=%u\n", binary_idx);
#endif

    bool is_leaf = false;
    uint payload = 0, f_parent = 0, f_dir = 0;

    int depth = findMSB(SUBGROUP_SIZE) - 1;
    int break_d = -1;

#ifdef DEBUG_SHADERS
    if (is_trace_thread) debugPrintfEXT("Subgroup size=%u, calculated depth limit=%d\n", SUBGROUP_SIZE, depth);
#endif

    for (int d = depth; d >= 0; d--) {
        uint dir = (lane >> d) & 1u;

#ifdef DEBUG_SHADERS
        // Trap 2: Catch runaway indices during downward traversal
        if (binary_idx > 100000000u) {
            debugPrintfEXT("TRAP! About to read binary_bvh with massive binary_idx=%u at depth=%d, lane=%u\n", binary_idx, d, lane);
        }
#endif

        uint meta = tlas_metadata(pc.binary_bvh, binary_idx, dir);
        is_leaf = bvh_is_leaf(meta);
        uint next_idx = bvh_get_index(meta);

        f_parent = binary_idx;
        f_dir = dir;

#ifdef DEBUG_SHADERS
        if (is_trace_thread) {
            debugPrintfEXT("  Loop d=%d | dir=%u | is_leaf=%d | next_idx=%u\n", d, dir, int(is_leaf), next_idx);
        }
#endif

        if (is_leaf) {
            payload = next_idx;
            break_d = d;
            break;
        }
        binary_idx = next_idx;
    }

    if (!is_leaf) {
        payload = binary_idx;

#ifdef DEBUG_SHADERS
        // Trap 3: Catch invalid final node state reads
        if (binary_idx > 100000000u) {
             debugPrintfEXT("TRAP! Reading parent_idx from massive binary_idx=%u (lane=%u)\n", binary_idx, lane);
        }
#endif

        f_parent = tlas_parent(pc.binary_bvh, binary_idx);

#ifdef DEBUG_SHADERS
        if (f_parent > 100000000u) {
             debugPrintfEXT("TRAP! Resolving f_dir with massive f_parent=%u (binary_idx=%u)\n", f_parent, binary_idx);
        }
#endif

        f_dir = (tlas_child(pc.binary_bvh, f_parent, 1u) == binary_idx) ? 1u : 0u;
    }

#ifdef DEBUG_SHADERS
    // Per-lane traversal result dump for multi_node 0
    if (multi_node_idx == 0) {
        bool is_valid_here = (break_d <= 0) || ((lane & ((1u << break_d) - 1u)) == 0u);
        debugPrintfEXT("COLLAPSE lane=%u: break_d=%d, valid=%d, f_parent=%u, f_dir=%u, pstart=%u, pcount=%u, mass=%f, com=(%f,%f,%f)\n",
            lane, break_d, int(is_valid_here), f_parent, f_dir,
            tlas_pstart(pc.binary_bvh, f_parent, f_dir),
            tlas_pcount(pc.binary_bvh, f_parent, f_dir),
            tlas_mass(pc.binary_bvh, f_parent, f_dir),
            tlas_com_x(pc.binary_bvh, f_parent, f_dir),
            tlas_com_y(pc.binary_bvh, f_parent, f_dir),
            tlas_com_z(pc.binary_bvh, f_parent, f_dir));
    }
    // Trap 4: Ultimate memory bounds trap before the massive attribute read/write block
    if (f_parent > 100000000u) {
        debugPrintfEXT("TRAP! FATAL f_parent=%u before massive data read! multi_node=%u, lane=%u\n", f_parent, multi_node_idx, lane);
    }
#endif

    // Massive block: if f_parent is garbage, this is where the GPU dies.
    tlas_write_min_x    (pc.multi_bvh, multi_node_idx, lane, tlas_min_x    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_max_x    (pc.multi_bvh, multi_node_idx, lane, tlas_max_x    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_min_y    (pc.multi_bvh, multi_node_idx, lane, tlas_min_y    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_max_y    (pc.multi_bvh, multi_node_idx, lane, tlas_max_y    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_min_z    (pc.multi_bvh, multi_node_idx, lane, tlas_min_z    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_max_z    (pc.multi_bvh, multi_node_idx, lane, tlas_max_z    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_child    (pc.multi_bvh, multi_node_idx, lane, payload);
    tlas_write_metadata (pc.multi_bvh, multi_node_idx, lane, bvh_pack_metadata(is_leaf, BVH_FRAME_MICRO, BVH_SHAPE_AABB, payload));
    tlas_write_pstart   (pc.multi_bvh, multi_node_idx, lane, tlas_pstart  (pc.binary_bvh, f_parent, f_dir));
    tlas_write_pcount   (pc.multi_bvh, multi_node_idx, lane, tlas_pcount  (pc.binary_bvh, f_parent, f_dir));
    tlas_write_mass     (pc.multi_bvh, multi_node_idx, lane, tlas_mass    (pc.binary_bvh, f_parent, f_dir));
    tlas_write_com_x    (pc.multi_bvh, multi_node_idx, lane, tlas_com_x   (pc.binary_bvh, f_parent, f_dir));
    tlas_write_com_y    (pc.multi_bvh, multi_node_idx, lane, tlas_com_y   (pc.binary_bvh, f_parent, f_dir));
    tlas_write_com_z    (pc.multi_bvh, multi_node_idx, lane, tlas_com_z   (pc.binary_bvh, f_parent, f_dir));
    tlas_write_force_x  (pc.multi_bvh, multi_node_idx, lane, 0.0);
    tlas_write_force_y  (pc.multi_bvh, multi_node_idx, lane, 0.0);
    tlas_write_force_z  (pc.multi_bvh, multi_node_idx, lane, 0.0);

    bool is_valid_lane = (break_d <= 0) || ((lane & ((1u << break_d) - 1u)) == 0u);
    uvec4 valid_ballot = subgroupBallot(is_valid_lane);

    if (lane == 0) {
        tlas_write_valid_mask(pc.multi_bvh, multi_node_idx, valid_ballot.xy);
    }

#ifdef DEBUG_SHADERS
    if (is_trace_thread) debugPrintfEXT("--- FINISHED BVH COLLAPSE multi_node_idx=0 ---\n");
#endif
}