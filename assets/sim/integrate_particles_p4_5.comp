// @assets/sim/integrate_particles_p4_5.comp
//
// Particle Velocity-Verlet Corrector — Phase 4 & 5
// ─────────────────────────────────────────────────
// Invariant entering this pass:
//   • AOSOA slots 3/4/5 hold v_{n+½}  (stored by integrate_particles_p1_p2)
//   • AOSOA slots 7/8/9 hold F(x_{n+1}) (written by force generators after p3)
//
//   v_{n+1} = v_{n+½} + (dt/2) · M⁻¹ · F(x_{n+1})    [VV corrector]
//
// The force buffer is intentionally NOT cleared — F(x_{n+1}) persists as
// F(x_n) for the NEXT frame's integrate_particles_p1_p2 pass.
//
// Thread 0 additionally advances the emulated 64-bit engine clock:
//   global_time_us += dt_us    (uvec2 carry-propagating addition from imex_math.glsl)
//
// Target: SPIR-V 1.4 · Vulkan 1.1 · flexible across all hardware subgroup sizes.

#version 450 core
#extension GL_EXT_buffer_reference2      : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic  : require
#extension GL_GOOGLE_include_directive   : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"
#include "imex_math.glsl"      // add64

// ─── Push constants (40 bytes) ──────────────────────────────────────────────
layout(push_constant, std430) uniform PushConstants {
    ParticleData particles;
    ClockBuffer  clock;
    float        dt;
    uint         total_particles;
    uint         dt_us_lo;
    uint         dt_us_hi;
    uint         current_time_lo;
    uint         current_time_hi;
} pc;

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint gid = gl_GlobalInvocationID.x;

#ifdef DEBUG_SHADERS
    if (gid == 0) {
        debugPrintfEXT("======================================\n");
        debugPrintfEXT("integrate_particles_p4_5.comp : STARTED\n");
        debugPrintfEXT("Total Particles: %d | dt: %1.6f\n", pc.total_particles, pc.dt);
    }
#endif

    // Thread 0 safely advances the global 64-bit simulation clock
    if (gid == 0u && (uvec2(pc.clock).x != 0 || uvec2(pc.clock).y != 0)) {
        uvec2 t_n  = uvec2(pc.current_time_lo, pc.current_time_hi);
        uvec2 dt_u = uvec2(pc.dt_us_lo,        pc.dt_us_hi);
        pc.clock.global_time_us = add64(t_n, dt_u);

#ifdef DEBUG_SHADERS
        debugPrintfEXT("[P4_5 CLOCK] Time advanced by %d us. New Time (lo/hi): (%u, %u)\n",
            pc.dt_us_lo, pc.clock.global_time_us.x, pc.clock.global_time_us.y);
        debugPrintfEXT("======================================\n");
#endif
    }

    if (gid >= pc.total_particles) return;

    // Use native gl_SubgroupSize for guaranteed safe AoSoA memory alignment
    uint block = gid / gl_SubgroupSize;
    uint lane  = gid % gl_SubgroupSize;
    uint base  = block * (PARTICLE_FIELDS * gl_SubgroupSize) + lane;

    // ── Skip inactive / massless particles ────────────────────────────────
    float mass = uintBitsToFloat(pc.particles.data[base + 6u * gl_SubgroupSize]);
    if (mass <= 0.0) return;

    float inv_m   = 1.0 / mass;
    float half_dt = 0.5 * pc.dt;

    // Write v_{n+1} back — force buffer stays intact for next frame
    float vx = uintBitsToFloat(pc.particles.data[base + 3u * gl_SubgroupSize]);
    float vy = uintBitsToFloat(pc.particles.data[base + 4u * gl_SubgroupSize]);
    float vz = uintBitsToFloat(pc.particles.data[base + 5u * gl_SubgroupSize]);

    float fx = uintBitsToFloat(pc.particles.data[base + 7u * gl_SubgroupSize]);
    float fy = uintBitsToFloat(pc.particles.data[base + 8u * gl_SubgroupSize]);
    float fz = uintBitsToFloat(pc.particles.data[base + 9u * gl_SubgroupSize]);

    vec3 v_half = vec3(vx, vy, vz);
    vec3 f_next = vec3(fx, fy, fz);

    vx += half_dt * inv_m * fx;
    vy += half_dt * inv_m * fy;
    vz += half_dt * inv_m * fz;

    vec3 v_next = vec3(vx, vy, vz);

#ifdef DEBUG_SHADERS
    // EXPLOSION DETECTOR: Catch extreme final velocities before they are written
    if (isnan(v_next.x) || length(v_next) > 100000.0) {
        debugPrintfEXT("[P4_5 FATAL] Particle %d velocity exploded! mass=%1.2f\n", gid, mass);
        debugPrintfEXT("   -> Incoming v_half: (%1.2f, %1.2f, %1.2f)\n", v_half.x, v_half.y, v_half.z);
        debugPrintfEXT("   -> Accumulated f_next: (%1.2f, %1.2f, %1.2f)\n", f_next.x, f_next.y, f_next.z);
        debugPrintfEXT("   -> Resulting v_next: (%1.2f, %1.2f, %1.2f)\n", v_next.x, v_next.y, v_next.z);
    } else if (gid == 0) {
        // Routine trace for Particle 0 to verify the corrector step
        debugPrintfEXT("[P4_5 TRACE] P0: v_half=(%1.2f,%1.2f,%1.2f) + f_next=(%1.2f,%1.2f,%1.2f) -> v_next=(%1.2f,%1.2f,%1.2f)\n",
            v_half.x, v_half.y, v_half.z, f_next.x, f_next.y, f_next.z, v_next.x, v_next.y, v_next.z);
    }
#endif

    pc.particles.data[base + 3u * gl_SubgroupSize] = floatBitsToUint(vx);
    pc.particles.data[base + 4u * gl_SubgroupSize] = floatBitsToUint(vy);
    pc.particles.data[base + 5u * gl_SubgroupSize] = floatBitsToUint(vz);
}
