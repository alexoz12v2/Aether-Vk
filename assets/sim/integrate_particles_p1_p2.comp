// @assets/sim/integrate_particles_p1_p2.comp
//
// Particle Velocity-Verlet Predictor — Phase 1 & 2
// ─────────────────────────────────────────────────
// Unit contract (see imex_math.glsl for full derivation):
//   pos   [km]    — micro-frame local position
//   vel   [km/s]  — velocity
//   force [km/s²] — per-unit-mass acceleration (ALWAYS stored in km/s²,
//                   regardless of whether the force source is a macro or micro
//                   emitter; apply_emitters_to_particles.comp handles the AU→km
//                   conversion internally before writing the force slots)
//   dt    [s]     — sub-step duration, converted from µs by the CPU
//
// Frame-start invariant: AOSOA slots 7/8/9 hold F(x_n) [km/s²] from the previous frame.
//
//   v_{n+½} = v_n  + (dt/2) · M⁻¹ · F(x_n)  [km/s  + s·km/s²  = km/s  ✓]
//   x_{n+1} = x_n  + dt    · v_{n+½}          [km    + s·km/s   = km    ✓]
//
// After writing, CLEARS slots 7/8/9 to 0 so the unified force-generation pass
// (apply_emitters, barnes_hut, narrow-phase) can safely atomicAdd into them.
// The half-kick velocity v_{n+½} is stored temporarily in slots 3/4/5 for
// integrate_particles_p4_5 to complete the VV corrector step.
//
// Target: SPIR-V 1.4 · Vulkan 1.1 · flexible across all hardware subgroup sizes.

#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    ParticleData particles;
    float dt;
    uint total_particles;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;

#ifdef DEBUG_SHADERS
    if (gid == 0) {
        debugPrintfEXT("======================================\n");
        debugPrintfEXT("integrate_particles_p1_p2.comp : STARTED\n");
        debugPrintfEXT("Total Particles: %d | dt: %1.6f\n", pc.total_particles, pc.dt);
        debugPrintfEXT("======================================\n");
    }
#endif

    if (gid >= pc.total_particles) return;

    // NOTE: Assuming P_BASE, P_READ, and P_WRITE correctly utilize the hardware
    // gl_SubgroupSize internally to calculate AoSoA strides.
    uint base = P_BASE(gid);

    float mass = P_READ(pc.particles, base + 6u * SUBGROUP_SIZE);
    if (mass <= 0.0) return;

    float inv_m = 1.0 / mass;
    float half_dt = 0.5 * pc.dt;

    vec3 v_n = vec3(
        P_READ(pc.particles, base + 3u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 4u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 5u * SUBGROUP_SIZE)
    );

    vec3 f_n = vec3(
        P_READ(pc.particles, base + 7u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 8u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 9u * SUBGROUP_SIZE)
    );

    // half-kick: [km/s] + [km/s²] * [s/2] = [km/s]
    vec3 v_half = v_n + f_n * inv_m * half_dt;

    vec3 pos_n = vec3(
        P_READ(pc.particles, base + 0u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 1u * SUBGROUP_SIZE),
        P_READ(pc.particles, base + 2u * SUBGROUP_SIZE)
    );

    // full drift: [km] + [km/s] * [s] = [km]
    vec3 pos_next = pos_n + v_half * pc.dt;

#ifdef DEBUG_SHADERS
    // EXPLOSION DETECTOR: Catch corrupted forces from previous frame immediately
    if (isnan(pos_next.x) || length(v_half) > 100000.0) {
        debugPrintfEXT("[P1_P2 FATAL] Particle %d exploded! mass=%1.2f\n", gid, mass);
        debugPrintfEXT("   -> Prev Pos: (%1.2f, %1.2f, %1.2f) | Prev Vel: (%1.2f, %1.2f, %1.2f)\n", pos_n.x, pos_n.y, pos_n.z, v_n.x, v_n.y, v_n.z);
        debugPrintfEXT("   -> Incoming Force: (%1.2f, %1.2f, %1.2f)\n", f_n.x, f_n.y, f_n.z);
        debugPrintfEXT("   -> New Vel Half: (%1.2f, %1.2f, %1.2f) | New Pos: (%1.2f, %1.2f, %1.2f)\n", v_half.x, v_half.y, v_half.z, pos_next.x, pos_next.y, pos_next.z);
    } else if (gid == 0) {
        // Routine trace for Particle 0 to verify integration math
        debugPrintfEXT("[P1_P2 TRACE] P0: mass=%1.2f fn=(%1.2f,%1.2f,%1.2f) -> v_half=(%1.2f,%1.2f,%1.2f) -> pos_next=(%1.2f,%1.2f,%1.2f)\n",
            mass, f_n.x, f_n.y, f_n.z, v_half.x, v_half.y, v_half.z, pos_next.x, pos_next.y, pos_next.z);
    }
#endif

    P_WRITE(pc.particles, base + 0u * SUBGROUP_SIZE, pos_next.x);
    P_WRITE(pc.particles, base + 1u * SUBGROUP_SIZE, pos_next.y);
    P_WRITE(pc.particles, base + 2u * SUBGROUP_SIZE, pos_next.z);

    P_WRITE(pc.particles, base + 3u * SUBGROUP_SIZE, v_half.x);
    P_WRITE(pc.particles, base + 4u * SUBGROUP_SIZE, v_half.y);
    P_WRITE(pc.particles, base + 5u * SUBGROUP_SIZE, v_half.z);

    // Clear forces for the current frame's collision/gravity passes
    P_WRITE(pc.particles, base + 7u * SUBGROUP_SIZE, 0.0);
    P_WRITE(pc.particles, base + 8u * SUBGROUP_SIZE, 0.0);
    P_WRITE(pc.particles, base + 9u * SUBGROUP_SIZE, 0.0);
}
