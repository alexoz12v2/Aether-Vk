// @assets/sim/bp_cross_lca.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "../bvh_utils.glsl"

layout(local_size_x = 256) in;
const uint SUBGROUPS_PER_WG = 256 / SUBGROUP_SIZE;

struct Entity {
    MultiBvhBuffer bvh;
    mat4 transform;
    mat4 inv_transform;
    vec3 linear_velocity;
    uint root_index;
    vec3 angular_velocity;
    uint type;              
    uint primitive_offset;
    uint total_primitives;  
    uint frame_scale_type;
    float scale_factor;
    uint shape_type;
    vec3 shape_data;
};

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer EntityArray { Entity entities[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer PairBufferIn { uint count; uvec2 pairs[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer PairBufferOut { uint count; uvec2 pairs[]; };

layout(push_constant, scalar) uniform PushConstants {
    EntityArray scene_entities;
    PairBufferIn lca_query_pairs;
    PairBufferOut output_internal_pairs;
    uint     total_queries;
} pc;

shared uint shared_stacks[SUBGROUPS_PER_WG][32]; 
shared uint shared_stack_ptrs[SUBGROUPS_PER_WG];
shared MultiBvhBuffer shared_lca_bvh[SUBGROUPS_PER_WG];

void transform_aabb(mat4 inv_transform, vec3 bmin, vec3 bmax, out vec3 out_min, out vec3 out_max) {
    vec3 corners[8] = vec3[8](
        vec3(bmin.x, bmin.y, bmin.z), vec3(bmax.x, bmin.y, bmin.z), vec3(bmin.x, bmax.y, bmin.z), vec3(bmax.x, bmax.y, bmin.z),
        vec3(bmin.x, bmin.y, bmax.z), vec3(bmax.x, bmin.y, bmax.z), vec3(bmin.x, bmax.y, bmax.z), vec3(bmax.x, bmax.y, bmax.z)
    );
    out_min = vec3(1e20); out_max = vec3(-1e20);
    for (int i = 0; i < 8; i++) {
        vec3 local_p = (inv_transform * vec4(corners[i], 1.0)).xyz;
        out_min = min(out_min, local_p); out_max = max(out_max, local_p);
    }
}

bool intersectAABB(vec3 amin, vec3 amax, vec3 bmin, vec3 bmax) {
    return (amin.x <= bmax.x && amax.x >= bmin.x) &&
           (amin.y <= bmax.y && amax.y >= bmin.y) &&
           (amin.z <= bmax.z && amax.z >= bmin.z);
}

void main() {
    uint subgroup_id = gl_SubgroupID;
    uint lane_id     = gl_SubgroupInvocationID;
    
    uint query_idx = gl_WorkGroupID.x * SUBGROUPS_PER_WG + subgroup_id;
    if (query_idx >= pc.total_queries) return;

    EntityArray entities = pc.scene_entities;
    PairBufferIn in_pairs = pc.lca_query_pairs;
    PairBufferOut out_pairs = pc.output_internal_pairs;

    uvec2 query = in_pairs.pairs[query_idx];
    uint foreign_ent_id = query.x; // Macro Comet
    uint lca_ent_id = query.y;     // Micro Space Station

    vec3 query_min, query_max;
    
    if (lane_id == 0) {
        Entity foreign_ent = entities.entities[foreign_ent_id];
        Entity lca_ent = entities.entities[lca_ent_id];
        
        shared_lca_bvh[subgroup_id] = lca_ent.bvh;

        vec3 center = foreign_ent.transform[3].xyz;
        mat3 rot = mat3(foreign_ent.transform);
        vec3 extents = abs(rot[0]) * foreign_ent.shape_data.x + 
                       abs(rot[1]) * foreign_ent.shape_data.y + 
                       abs(rot[2]) * foreign_ent.shape_data.z;
        
        transform_aabb(lca_ent.inv_transform, center - extents, center + extents, query_min, query_max);
        
        shared_stacks[subgroup_id][0] = lca_ent.root_index; // Push LCA's internal TLAS root
        shared_stack_ptrs[subgroup_id] = 1;
    }
    
    subgroupMemoryBarrierShared();

    query_min = vec3(subgroupBroadcast(query_min.x, 0), subgroupBroadcast(query_min.y, 0), subgroupBroadcast(query_min.z, 0));
    query_max = vec3(subgroupBroadcast(query_max.x, 0), subgroupBroadcast(query_max.y, 0), subgroupBroadcast(query_max.z, 0));
    foreign_ent_id = subgroupBroadcast(foreign_ent_id, 0);
    
    MultiBvhBuffer tlas = shared_lca_bvh[subgroup_id];

    while (true) {
        subgroupMemoryBarrierShared();
        uint stack_ptr = shared_stack_ptrs[subgroup_id];
        if (stack_ptr == 0) break;
        
        stack_ptr--;
        uint node_idx = shared_stacks[subgroup_id][stack_ptr];
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        uint meta = tlas.nodes[node_idx].metadata[lane_id];
        
        bool valid = false;
        if (lane_id < 32) {
            valid = (tlas.nodes[node_idx].valid_mask.x & (1u << lane_id)) != 0u;
        } else {
            valid = (tlas.nodes[node_idx].valid_mask.y & (1u << (lane_id - 32))) != 0u;
        }
        
        vec3 c_min = vec3(tlas.nodes[node_idx].min_x[lane_id], tlas.nodes[node_idx].min_y[lane_id], tlas.nodes[node_idx].min_z[lane_id]);
        vec3 c_max = vec3(tlas.nodes[node_idx].max_x[lane_id], tlas.nodes[node_idx].max_y[lane_id], tlas.nodes[node_idx].max_z[lane_id]);
        uint child_payload = tlas.nodes[node_idx].child_indices[lane_id];

        bool hit = valid && intersectAABB(query_min, query_max, c_min, c_max);
        bool is_leaf = bvh_is_leaf(meta);
        
        bool hit_leaf = hit && is_leaf;
        bool hit_node = hit && !is_leaf;

        uvec4 leaf_ballot = subgroupBallot(hit_leaf);
        uint  leaf_count  = subgroupBallotBitCount(leaf_ballot);
        uint  leaf_offset = subgroupBallotExclusiveBitCount(leaf_ballot);

        if (leaf_count > 0) {
            uint base_idx = 0;
            if (lane_id == 0) base_idx = atomicAdd(out_pairs.count, leaf_count);
            base_idx = subgroupBroadcast(base_idx, 0);

            if (hit_leaf) out_pairs.pairs[base_idx + leaf_offset] = uvec2(foreign_ent_id, child_payload);
        }

        uvec4 node_ballot = subgroupBallot(hit_node);
        uint  node_count  = subgroupBallotBitCount(node_ballot);
        uint  push_offset = subgroupBallotExclusiveBitCount(node_ballot);

        if (hit_node) shared_stacks[subgroup_id][stack_ptr + push_offset] = child_payload;
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr + node_count;
    }
}