// @assets/sim/bp_cross_lca.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require

#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

// ONLY for sizing shared memory safely at compile time.
const uint MAX_SUBGROUPS_PER_WG = (LOCAL_SIZE_X + 3) / 4;

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer tlas_bvh;
    GpuReferenceFrameArray lca_entities;
    LeafBuffer macro_leaves;
    RigidBodyArray rigid_bodies;
    PairBuffer lca_query_pairs;
    PairBuffer out_rb_rb;
    PairBuffer out_rb_ps;
    PairBuffer out_ps_ps;
    CrossPairBuffer out_cross_pairs;
    uint total_queries;
    uint max_pairs; // DEPRECATED: Retained for Rust struct size parity
    uint num_rigid_bodies;
    uint _pad;
} pc;

// Allocate stack per subgroup using the safe compile-time max
shared uint shared_stacks[MAX_SUBGROUPS_PER_WG][BVH_STACK_DEPTH];
shared uint shared_stack_ptrs[MAX_SUBGROUPS_PER_WG];

void transform_aabb_macro_to_micro(vec3 lca_center_pos, float lca_scale, vec3 macro_center, vec3 macro_extents, out vec3 out_min, out vec3 out_max) {
    vec3 center_km = macro_center;
    vec3 extents_km = macro_extents;

    vec3 corners[8] = vec3[8](
        vec3(center_km.x - extents_km.x, center_km.y - extents_km.y, center_km.z - extents_km.z),
        vec3(center_km.x + extents_km.x, center_km.y - extents_km.y, center_km.z - extents_km.z),
        vec3(center_km.x - extents_km.x, center_km.y + extents_km.y, center_km.z - extents_km.z),
        vec3(center_km.x + extents_km.x, center_km.y + extents_km.y, center_km.z - extents_km.z),
        vec3(center_km.x - extents_km.x, center_km.y - extents_km.y, center_km.z + extents_km.z),
        vec3(center_km.x + extents_km.x, center_km.y - extents_km.y, center_km.z + extents_km.z),
        vec3(center_km.x - extents_km.x, center_km.y + extents_km.y, center_km.z + extents_km.z),
        vec3(center_km.x + extents_km.x, center_km.y + extents_km.y, center_km.z + extents_km.z)
    );

    out_min = vec3(1e20); out_max = vec3(-1e20);
#define CORNER(I) { vec3 local_p = (corners[(I)] - lca_center_pos) / lca_scale; out_min = min(out_min, local_p); out_max = max(out_max, local_p); }
    CORNER(0) CORNER(1) CORNER(2) CORNER(3)
    CORNER(4) CORNER(5) CORNER(6) CORNER(7)
#undef CORNER
}

void main() {
    uint subgroup_id = gl_SubgroupID;
    uint lane_id     = gl_SubgroupInvocationID;

    // Dynamic dense query mapping based on hardware limits
    uint query_idx   = gl_WorkGroupID.x * gl_NumSubgroups + subgroup_id;

    if (query_idx >= pc.total_queries || query_idx >= pc.lca_query_pairs.count) return;

    uvec2 query = pc.lca_query_pairs.pairs[query_idx];
    uint macro_ent_id = query.x;
    uint lca_ent_id = query.y;
    vec3 query_min, query_max;

    if (lane_id == 0) {
        GpuReferenceFrame l_ent = pc.lca_entities.frames[lca_ent_id];

        vec3 macro_min = pc.macro_leaves.leaves[macro_ent_id].min_bound;
        vec3 macro_max = pc.macro_leaves.leaves[macro_ent_id].max_bound;

        vec3 center_au = (macro_min + macro_max) * 0.5;
        vec3 extents_au = (macro_max - macro_min) * 0.5;

        transform_aabb_macro_to_micro(l_ent.center_pos, l_ent.scale, center_au, extents_au, query_min, query_max);

        shared_stacks[subgroup_id][0] = l_ent.bvh_root_index;
        shared_stack_ptrs[subgroup_id] = 1;
    }

    subgroupMemoryBarrierShared();

    query_min = vec3(subgroupBroadcast(query_min.x, 0), subgroupBroadcast(query_min.y, 0), subgroupBroadcast(query_min.z, 0));
    query_max = vec3(subgroupBroadcast(query_max.x, 0), subgroupBroadcast(query_max.y, 0), subgroupBroadcast(query_max.z, 0));
    macro_ent_id = subgroupBroadcast(macro_ent_id, 0);
    lca_ent_id = subgroupBroadcast(lca_ent_id, 0);

    MultiBvhBuffer tlas = pc.tlas_bvh;

    while (true) {
        subgroupMemoryBarrierShared();
        uint stack_ptr = shared_stack_ptrs[subgroup_id];
        if (stack_ptr == 0) break;

        stack_ptr--;
        uint node_idx = shared_stacks[subgroup_id][stack_ptr];
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = stack_ptr;

        uint meta = tlas.nodes[node_idx].metadata[lane_id];
        bool valid = bvh_node_is_valid(tlas.nodes[node_idx].valid_mask, lane_id);

        vec3 c_min = vec3(tlas.nodes[node_idx].min_x[lane_id], tlas.nodes[node_idx].min_y[lane_id], tlas.nodes[node_idx].min_z[lane_id]);
        vec3 c_max = vec3(tlas.nodes[node_idx].max_x[lane_id], tlas.nodes[node_idx].max_y[lane_id], tlas.nodes[node_idx].max_z[lane_id]);
        uint child_payload = tlas.nodes[node_idx].child_indices[lane_id];

        bool hit = valid && intersectAABB(query_min, query_max, c_min, c_max);
        bool is_leaf = bvh_is_leaf(meta);

        bool hit_leaf = hit && is_leaf;
#ifdef DEBUG_SHADERS
        if (hit_leaf) debugPrintfEXT("bp_cross_lca: hit leaf! macro=%d micro=%d lca=%d\n", macro_ent_id, bvh_get_index(meta), lca_ent_id);
#endif
        bool hit_node = hit && !is_leaf;

        uvec4 leaf_ballot = subgroupBallot(hit_leaf);
        uint  leaf_count  = subgroupBallotBitCount(leaf_ballot);
        uint  leaf_offset = subgroupBallotExclusiveBitCount(leaf_ballot);

// -----------------------------------------------------------------------------
// DUAL MACRO DEFINITION: Clean compilation depending on DEBUG_SHADERS
// -----------------------------------------------------------------------------
#ifdef DEBUG_SHADERS
#define BALLOT_WORD(I) { \
            uint m = leaf_ballot[(I)]; \
            while (m != 0) { \
                uint bit = findLSB(m); \
                m &= ~(1u << bit); \
                uint src_lane = (I) * 32u + bit; \
                if (src_lane < gl_SubgroupSize) { \
                    uint micro_ent_id = bvh_get_index(subgroupShuffle(meta, src_lane)); \
                    if (lane_id == 0) { \
                        if (macro_ent_id != micro_ent_id) { \
                            uint type_A = (macro_ent_id < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM; \
                            uint type_B = (micro_ent_id < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM; \
                            uint ent_A = macro_ent_id; \
                            uint ent_B = micro_ent_id; \
                            if (type_A > type_B) { uint temp = ent_A; ent_A = ent_B; ent_B = temp; temp = type_A; type_A = type_B; type_B = temp; } \
                            if (type_A == TYPE_RIGID_BODY && type_B == TYPE_RIGID_BODY) { \
                                uint macro_frame = pc.rigid_bodies.bodies[ent_A].frame_idx; \
                                if (macro_frame == lca_ent_id) { \
                                    uint lo = min(ent_A, ent_B); uint hi = max(ent_A, ent_B); \
                                    uint out_idx = atomicAdd(pc.out_rb_rb.count, 1); \
                                    if (out_idx < pc.out_rb_rb.capacity) pc.out_rb_rb.pairs[out_idx] = uvec2(lo, hi); \
                                    else { debugPrintfEXT("[bp_cross_lca WARNING] out_rb_rb capacity (%d) exceeded\n", pc.out_rb_rb.capacity); } \
                                } else { \
                                    uint out_idx = atomicAdd(pc.out_cross_pairs.count, 1); \
                                    if (out_idx < pc.out_cross_pairs.capacity) { pc.out_cross_pairs.pairs[out_idx].macro_id = ent_A; pc.out_cross_pairs.pairs[out_idx].micro_id = ent_B; pc.out_cross_pairs.pairs[out_idx].lca_id = lca_ent_id; } \
                                    else { debugPrintfEXT("[bp_cross_lca WARNING] out_cross_pairs capacity (%d) exceeded\n", pc.out_cross_pairs.capacity); } \
                                } \
                            } else if (type_A == TYPE_PARTICLE_SYSTEM && type_B == TYPE_RIGID_BODY) { \
                                uint out_idx = atomicAdd(pc.out_rb_ps.count, 1); \
                                if (out_idx < pc.out_rb_ps.capacity) pc.out_rb_ps.pairs[out_idx] = uvec2(ent_B, ent_A); \
                                else { debugPrintfEXT("[bp_cross_lca WARNING] out_rb_ps capacity (%d) exceeded\n", pc.out_rb_ps.capacity); } \
                            } else if (type_A == TYPE_PARTICLE_SYSTEM && type_B == TYPE_PARTICLE_SYSTEM) { \
                                uint out_idx = atomicAdd(pc.out_ps_ps.count, 1); \
                                if (out_idx < pc.out_ps_ps.capacity) pc.out_ps_ps.pairs[out_idx] = uvec2(ent_A, ent_B); \
                                else { debugPrintfEXT("[bp_cross_lca WARNING] out_ps_ps capacity (%d) exceeded\n", pc.out_ps_ps.capacity); } \
                            } \
                        } \
                    } \
                } \
            } \
        }
#else
// Production version: No else branches or debugPrintfEXT
#define BALLOT_WORD(I) { \
            uint m = leaf_ballot[(I)]; \
            while (m != 0) { \
                uint bit = findLSB(m); \
                m &= ~(1u << bit); \
                uint src_lane = (I) * 32u + bit; \
                if (src_lane < gl_SubgroupSize) { \
                    uint micro_ent_id = bvh_get_index(subgroupShuffle(meta, src_lane)); \
                    if (lane_id == 0) { \
                        if (macro_ent_id != micro_ent_id) { \
                            uint type_A = (macro_ent_id < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM; \
                            uint type_B = (micro_ent_id < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM; \
                            uint ent_A = macro_ent_id; \
                            uint ent_B = micro_ent_id; \
                            if (type_A > type_B) { uint temp = ent_A; ent_A = ent_B; ent_B = temp; temp = type_A; type_A = type_B; type_B = temp; } \
                            if (type_A == TYPE_RIGID_BODY && type_B == TYPE_RIGID_BODY) { \
                                uint macro_frame = pc.rigid_bodies.bodies[ent_A].frame_idx; \
                                if (macro_frame == lca_ent_id) { \
                                    uint lo = min(ent_A, ent_B); uint hi = max(ent_A, ent_B); \
                                    uint out_idx = atomicAdd(pc.out_rb_rb.count, 1); \
                                    if (out_idx < pc.out_rb_rb.capacity) pc.out_rb_rb.pairs[out_idx] = uvec2(lo, hi); \
                                } else { \
                                    uint out_idx = atomicAdd(pc.out_cross_pairs.count, 1); \
                                    if (out_idx < pc.out_cross_pairs.capacity) { pc.out_cross_pairs.pairs[out_idx].macro_id = ent_A; pc.out_cross_pairs.pairs[out_idx].micro_id = ent_B; pc.out_cross_pairs.pairs[out_idx].lca_id = lca_ent_id; } \
                                } \
                            } else if (type_A == TYPE_PARTICLE_SYSTEM && type_B == TYPE_RIGID_BODY) { \
                                uint out_idx = atomicAdd(pc.out_rb_ps.count, 1); \
                                if (out_idx < pc.out_rb_ps.capacity) pc.out_rb_ps.pairs[out_idx] = uvec2(ent_B, ent_A); \
                            } else if (type_A == TYPE_PARTICLE_SYSTEM && type_B == TYPE_PARTICLE_SYSTEM) { \
                                uint out_idx = atomicAdd(pc.out_ps_ps.count, 1); \
                                if (out_idx < pc.out_ps_ps.capacity) pc.out_ps_ps.pairs[out_idx] = uvec2(ent_A, ent_B); \
                            } \
                        } \
                    } \
                } \
            } \
        }
#endif
// -----------------------------------------------------------------------------

        BALLOT_WORD(0u)
        BALLOT_WORD(1u)
        BALLOT_WORD(2u)
        BALLOT_WORD(3u)
#undef BALLOT_WORD

        uvec4 node_ballot = subgroupBallot(hit_node);
        uint  node_count  = subgroupBallotBitCount(node_ballot);
        uint  push_offset = subgroupBallotExclusiveBitCount(node_ballot);

        uint new_top = min(stack_ptr + node_count, BVH_STACK_DEPTH);
        if (hit_node && (stack_ptr + push_offset) < BVH_STACK_DEPTH)
            shared_stacks[subgroup_id][stack_ptr + push_offset] = child_payload;
        if (lane_id == 0) shared_stack_ptrs[subgroup_id] = new_top;
    }
}