#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

// ============================================================================
// Phase 1 & 2: Particle Explicit Kick and Drift
// ============================================================================

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;




// AOSOA Block Layout flattened into a 1D array to bypass GLSL specification
// limitations on sizing arrays within SSBO structs with specialization constants.
// 10 attributes per particle block:
// px, py, pz, vx, vy, vz, mass, fx, fy, fz
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData {
    float data[];
};

layout(push_constant, scalar) uniform PushConstants {
    ParticleData particles;
    float dt;
    uint total_particles;
} pc;

void main() {
    if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("Hello from p1-2_imex_particles.comp!\n");
    }
    uint global_id = gl_GlobalInvocationID.x;
    if (global_id >= pc.total_particles) {
        return;
    }

    uint block_idx = global_id / SUBGROUP_SIZE;
    uint local_idx = global_id % SUBGROUP_SIZE;

    uint stride = 10 * SUBGROUP_SIZE;
    uint base = block_idx * stride + local_idx;

    // Load mass
    float mass = pc.particles.data[base + 6 * SUBGROUP_SIZE];
    
    // Avoid divide-by-zero for zero-mass (disabled) particles
    if (mass <= 0.0) return;

    float inv_mass = 1.0 / mass;
    float half_dt = pc.dt * 0.5;

    // Load velocity and previous force
    vec3 v_n = vec3(
        pc.particles.data[base + 3 * SUBGROUP_SIZE],
        pc.particles.data[base + 4 * SUBGROUP_SIZE],
        pc.particles.data[base + 5 * SUBGROUP_SIZE]
    );

    vec3 f_n = vec3(
        pc.particles.data[base + 7 * SUBGROUP_SIZE],
        pc.particles.data[base + 8 * SUBGROUP_SIZE],
        pc.particles.data[base + 9 * SUBGROUP_SIZE]
    );

    // Phase 1: Half-Kick
    // v_{n+1/2} = v_n + (h/2) * M^{-1} * F_n
    vec3 v_half = v_n + (f_n * inv_mass) * half_dt;

    // Load position
    vec3 q_n = vec3(
        pc.particles.data[base + 0 * SUBGROUP_SIZE],
        pc.particles.data[base + 1 * SUBGROUP_SIZE],
        pc.particles.data[base + 2 * SUBGROUP_SIZE]
    );

    // Phase 2: Drift to Midpoint
    // q_mid = q_n + (h/2) * v_{n+1/2}
    vec3 q_mid = q_n + v_half * half_dt;

    // Write back updated position (q_mid) and velocity (v_{n+1/2})
    pc.particles.data[base + 0 * SUBGROUP_SIZE] = q_mid.x;
    pc.particles.data[base + 1 * SUBGROUP_SIZE] = q_mid.y;
    pc.particles.data[base + 2 * SUBGROUP_SIZE] = q_mid.z;

    pc.particles.data[base + 3 * SUBGROUP_SIZE] = v_half.x;
    pc.particles.data[base + 4 * SUBGROUP_SIZE] = v_half.y;
    pc.particles.data[base + 5 * SUBGROUP_SIZE] = v_half.z;

    if (SHOULD_DEBUG_PRINT) {
        debugPrintfEXT("P1-2 Particle %d: q_mid=(%f, %f, %f), v_half=(%f, %f, %f)", 
            global_id, q_mid.x, q_mid.y, q_mid.z, v_half.x, v_half.y, v_half.z);
    }
}
