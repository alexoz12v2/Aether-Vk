#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) readonly buffer ParticleData {
    float data[];
};

layout(push_constant, scalar) uniform PushConstants {
    RigidBodyArray scene_entities;
    PackedCollisions output_list;
    ParticleData particles;
    uint num_rigid_bodies;
    uint num_particles;
    float dt;
    float particle_radius;
} pc;

void main() {
    uint p_idx = gl_GlobalInvocationID.x;
    if (p_idx >= pc.num_particles) return;

    // Load Particle state
    uint base = p_idx * 10;
    vec3 p_pos = vec3(pc.particles.data[base + 0], pc.particles.data[base + 1], pc.particles.data[base + 2]);
    vec3 p_vel = vec3(pc.particles.data[base + 3], pc.particles.data[base + 4], pc.particles.data[base + 5]);
    float p_mass = pc.particles.data[base + 8];
    if (p_mass <= 0.0) return;
    float rA = pc.particle_radius;

    for (uint rb_idx = 0; rb_idx < pc.num_rigid_bodies; rb_idx++) {
        RigidBody rb = pc.scene_entities.bodies[rb_idx];
        vec3 rb_pos = rb.position_mass.xyz;
        vec3 rb_vel = rb.linear_vel_drag.xyz;
        uint shape = rb.shape_type;
        vec3 extents = rb.shape_extents;

        if (shape == 2) {
            // Sphere - Sphere
            float rB = extents.x;
            vec3 p_rel = p_pos - rb_pos;
            vec3 v_rel = p_vel - rb_vel;
            float radiusSum = rA + rB;
            float c = dot(p_rel, p_rel) - radiusSum * radiusSum;
            
            float toi = 0.0;
            bool collision_found = false;

            if (c < 0.0) {
                toi = 0.0;
                collision_found = true;
            } else {
                float a = dot(v_rel, v_rel);
                float b = dot(p_rel, v_rel) * 2.0;
                if (a > 1e-8) {
                    float disc = b * b - 4.0 * a * c;
                    if (disc >= 0.0) {
                        float t = (-b - sqrt(disc)) / (2.0 * a);
                        if (t >= 0.0 && t <= pc.dt) {
                            toi = t;
                            collision_found = true;
                        }
                    }
                }
            }

            if (collision_found) {
                vec3 pA_toi = p_pos + p_vel * toi;
                vec3 pB_toi = rb_pos + rb_vel * toi;
                vec3 diff = pA_toi - pB_toi;
                float dist = length(diff);
                vec3 normal = (dist > 1e-6) ? (diff / dist) : vec3(0.0, 1.0, 0.0);
                float penetration = max(radiusSum - dist, 0.0);
                vec3 contact = pB_toi + normal * rB;

                uint count = atomicAdd(pc.output_list.count, 1);
                PackedPair collision;
                collision.a.entity_id = 0xFFFFFFFFu; // Particle Sentinel
                collision.a.primitive_index = p_idx;
                collision.b.entity_id = rb_idx;
                collision.b.primitive_index = rb_idx;
                collision.toi = toi;
                collision.contact_normal = normal;
                collision.contact_point = contact;
                collision.penetration_depth = penetration;
                pc.output_list.pairs[count] = collision;
            }
        } else if (shape == 1) {
            // Sphere - OBB
            vec3 centerB = rb_pos;
            vec4 orientB = rb.orientation;
            mat3 matB = quat_to_mat3(orientB);
            mat3 invB = transpose(matB);

            vec3 local_p = invB * (p_pos - centerB);
            vec3 closest = clamp(local_p, -extents, extents);
            vec3 diff = local_p - closest;
            float dist = length(diff);

            if (dist <= rA) {
                vec3 local_normal = (dist > 1e-6) ? (diff / dist) : vec3(0.0, 1.0, 0.0);
                vec3 global_normal = matB * local_normal;
                vec3 global_closest = centerB + matB * closest;

                uint count = atomicAdd(pc.output_list.count, 1);
                PackedPair collision;
                collision.a.entity_id = 0xFFFFFFFFu; // Particle Sentinel
                collision.a.primitive_index = p_idx;
                collision.b.entity_id = rb_idx;
                collision.b.primitive_index = rb_idx;
                collision.toi = 0.0;
                collision.contact_normal = global_normal;
                collision.contact_point = global_closest;
                collision.penetration_depth = rA - dist;
                pc.output_list.pairs[count] = collision;
            }
        }
    }
}
