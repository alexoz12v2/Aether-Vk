// @assets/sim/dust_compact.comp
//
// Temporal reuse, step 3 (GLSL mirror of scene/dust/cadence.rs): the deterministic stream
// compaction of a tier's owner bytes into the slot lists (in ascending range offset: the CPU's
// list order, which a ring advance preserves since the live range only loses its tail), and the
// frame's control pass. Modes (push constant):
//
//  0 COUNT    a workgroup per block of 1 024 range offsets (DUST_CMP_WG threads × 1 024 / DUST_CMP_WG
//             consecutive offsets: 256 × 4, or 64 × 16 for 64-fiber wave mode on Adreno):
//             per list descriptor, the block's members by a shared-memory reduction
//  1 PREFIX   one workgroup, a thread per list descriptor: the serial exclusive prefix over its
//             blocks, the list's length and the finalize (build: step = ⌈len / N⌉, cursor 0,
//             g_max of the promoted pending list, exists; pending emptied)
//  2 SCATTER  as COUNT: the block's exclusive scan in offset order, each member written at its
//             block's base + its rank
//  3 CONTROL  one thread (F1 and the scalar parts of F2a): the deferred cursor advance, the
//             frame's counters zeroed, the abort test (the CPU's f32 product `dd · g_max` against
//             the class bound), the exists flags moved at the swaps
//
// List descriptors: set 0 (after the swaps' transitions) = per swapped pair its shown and build
// lists; set 1 (after the classify) = per swapped pair its pending list. A member of list
// (k, p, s): class k + 1, the state bit of s, slot parity p when two phases, offset < live.
#version 450 core
#extension GL_GOOGLE_include_directive : require
#include "dust_common.glsl"
#include "dust_cadence.glsl"

// the workgroup width (256 or 64): the block (1 024 offsets, the host's dispatch and block region)
// is the same at both, each lane taking 1 024 / DUST_CMP_WG consecutive offsets (<= 32: the mask f)
#ifndef DUST_CMP_WG
#define DUST_CMP_WG 256
#endif
layout(local_size_x = DUST_CMP_WG, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    DustUintBuffer sys;     // 0: the system's cadence buffer
    DustUintBuffer params;  // 8
    uint firstSlot;         // 16
    uint liveCount;         // 20
    uint ringMask;          // 24
    uint tierMode;          // 28: tier | mode << 8 | set << 16
} pc;                       // 32 bytes

const uint DUST_CMPM_COUNT = 0u;
const uint DUST_CMPM_PREFIX = 1u;
const uint DUST_CMPM_SCATTER = 2u;
const uint DUST_CMPM_CONTROL = 3u;
const uint DUST_CMP_BLOCK = 1024u;
const uint DUST_CMP_PER = DUST_CMP_BLOCK / uint(DUST_CMP_WG);   // offsets per lane

shared uint s_scan[DUST_CMP_WG];
// the tier-wide words of COUNT / SCATTER (R, nc, np, rb, cap, nb, inc0), written once per workgroup
shared uint s_geo[8];

// list descriptor j of the set: (k, p, s)
uvec3 dust_cmp_desc(uvec2 prm, uint set, uint j) {
    uint sw = set == 0u ? j >> 1u : j;
    uint code = DustUintBuffer(prm).v[DUST_CADP_SWAP0 + sw];
    return uvec3(code & 0xFFu, code >> 8u, set == 0u ? (j & 1u) : 2u);
}
// a member on the owner byte b or (the handover) on the incoming byte ib, never SHOWN
bool dust_cmp_member(uint b, uint ib, uint slot, uvec3 d, uint np) {
    uint bit = dust_own_state_bit(d.z);
    bool own = (b & DUST_OWN_CLASS_MASK) == d.x + 1u && (b & bit) != 0u;
    bool inc = (ib & DUST_OWN_CLASS_MASK) == d.x + 1u && (ib & bit) != 0u;
    return (own || inc) && (np != 2u || (slot & 1u) == d.y);
}

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint t = pc.tierMode & 0xFFu;
    uint mode = (pc.tierMode >> 8u) & 0xFFu;
    uint set = (pc.tierMode >> 16u) & 1u;
    uvec2 prm = uvec2(uvec2(pc.params));
    uvec2 st = uvec2(DustUintBuffer(prm).v[DUST_CADP_STATE], DustUintBuffer(prm).v[DUST_CADP_STATE + 1u]);
    uint R = DustUintBuffer(prm).v[DUST_CADP_TIER0 + DUST_CADP_TIER_WORDS * (pc.tierMode & 0xFFu) + 4u];
    uint nc = DustUintBuffer(prm).v[DUST_CADP_NC];
    uint np = DustUintBuffer(prm).v[DUST_CADP_NP];
    uint nsw = DustUintBuffer(prm).v[DUST_CADP_NSWAP];
    uint nl = set == 0u ? 2u * nsw : nsw;
    uint tb = DUST_CADP_TIER0 + DUST_CADP_TIER_WORDS * t;
    uint rb = DustUintBuffer(prm).v[tb];
    uint cap = DustUintBuffer(prm).v[tb + 1u];
    uint nb = cap / DUST_CMP_BLOCK + 1u;   // the tier's block region (dust_cad_blocks)

    if (mode == DUST_CMPM_CONTROL) {
        if (gl_GlobalInvocationID.x != 0u) return;
        uint nt = DustUintBuffer(prm).v[DUST_CADP_NT];
        uint flags = DustUintBuffer(prm).v[DUST_CADP_FLAGS];
        for (uint w = DUST_CADS_HIST; w <= DUST_CADS_SHELL_FORCED; ++w) DustUintBuffer(st).v[w] = 0u;
        for (uint tt = 0u; tt < nt; ++tt)
            for (uint k = 0u; k < nc; ++k)
                for (uint pp = 0u; pp < np; ++pp) {
                    uint tp = dust_cads_tp(tt, k, pp);
                    DustUintBuffer(st).v[tp + 8u] = 0u;
                    DustUintBuffer(st).v[tp + 9u] = 0u;
                    // the advance of the previous drawn frame's chunk (the CPU's end of begin)
                    if ((flags & DUST_CADF_ADVANCE) != 0u) DustUintBuffer(st).v[tp + 3u] = min(DustUintBuffer(st).v[tp + 3u] + DustUintBuffer(st).v[tp + 4u], DustUintBuffer(st).v[tp + 1u]);
                }
        for (uint k = 0u; k < nc; ++k)
            for (uint pp = 0u; pp < np; ++pp) {
                uint pr = dust_cads_pair(k, pp);
                DustUintBuffer(st).v[pr + 2u] = 0u;
                DustUintBuffer(st).v[pr + 9u] = 0u;
                DustUintBuffer(st).v[pr + 10u] = 0u;
                DustUintBuffer(st).v[pr + 11u] = 0u;
            }
        // F1: the aborts (the build list, then the pending list of each pair)
        if ((flags & DUST_CADF_ABORTS) != 0u) {
            for (uint k = 0u; k < nc; ++k) {
                float bound = uintBitsToFloat(DustUintBuffer(prm).v[DUST_CADP_BOUND + k]);
                for (uint pp = 0u; pp < np; ++pp) {
                    uint pr = dust_cads_pair(k, pp);
                    for (uint list = 1u; list <= 2u; ++list) {
                        uint entries = 0u, gm = 0u;
                        for (uint tt = 0u; tt < nt; ++tt) {
                            uint tp = dust_cads_tp(tt, k, pp);
                            uint n = DustUintBuffer(st).v[tp + list];
                            if (n > 0u) { entries += n; gm = max(gm, DustUintBuffer(st).v[tp + 4u + list]); }
                        }
                        if (entries == 0u) continue;
                        precise float excess = uintBitsToFloat(DustUintBuffer(prm).v[DUST_CADP_DD + (k * 2u + pp) * 2u + (list - 1u)]) * uintBitsToFloat(gm);
                        // the rate first, then the host's reasons (the motion budget, the build's
                        // predicted displacement: cadence::begin F1)
                        uint forced = DustUintBuffer(prm).v[DUST_CADP_FORCE + (k * 2u + pp) * 2u + (list - 1u)];
                        uint reason;
                        if (excess > bound) reason = DUST_CAD_ABORT_RATE;
                        else if (forced != 0u) reason = forced;
                        else continue;
                        DustUintBuffer(st).v[pr + 2u] |= list;   // bit 0 build, bit 1 pending
                        DustUintBuffer(st).v[pr + 8u + list] = reason;
                        DustUintBuffer(st).v[pr + 2u + list] = floatBitsToUint(excess);
                        for (uint tt = 0u; tt < nt; ++tt) {
                            uint tp = dust_cads_tp(tt, k, pp);
                            DustUintBuffer(st).v[tp + list] = 0u;
                            DustUintBuffer(st).v[tp + 4u + list] = 0u;
                            if (list == 1u) { DustUintBuffer(st).v[tp + 3u] = 0u; DustUintBuffer(st).v[tp + 4u] = 0u; }
                        }
                        if (list == 1u) { DustUintBuffer(st).v[pr + 1u] = 0u; DustUintBuffer(st).v[pr + 5u] = 0u; DustUintBuffer(st).v[pr + 6u] = 0u; }
                    }
                }
            }
        }
        // the coverage drops: a shown image no longer covering the viewport goes now (ghost 0)
        if ((flags & DUST_CADF_COVERAGE) != 0u) {
            uint cover = DustUintBuffer(prm).v[DUST_CADP_COVER];
            for (uint k = 0u; k < nc; ++k)
                for (uint pp = 0u; pp < np; ++pp) {
                    uint pr = dust_cads_pair(k, pp);
                    if (((cover >> (k * 2u + pp)) & 1u) == 0u || DustUintBuffer(st).v[pr] == 0u) continue;
                    DustUintBuffer(st).v[pr] = 0u;
                    DustUintBuffer(st).v[pr + 11u] = 1u;
                    for (uint tt = 0u; tt < nt; ++tt) DustUintBuffer(st).v[dust_cads_tp(tt, k, pp)] = 0u;
                }
        }
        // F2a's scalars: the build image becomes the shown one; the cycle's counts are kept
        for (uint j = 0u; j < nsw; ++j) {
            uint code = DustUintBuffer(prm).v[DUST_CADP_SWAP0 + j];
            uint pr = dust_cads_pair(code & 0xFFu, code >> 8u);
            DustUintBuffer(st).v[pr] = DustUintBuffer(st).v[pr + 1u];
            DustUintBuffer(st).v[pr + 1u] = 0u;
            DustUintBuffer(st).v[pr + 7u] = DustUintBuffer(st).v[pr + 5u];
            DustUintBuffer(st).v[pr + 8u] = DustUintBuffer(st).v[pr + 6u];
            DustUintBuffer(st).v[pr + 5u] = 0u;
            DustUintBuffer(st).v[pr + 6u] = 0u;
        }
        return;
    }

    if (mode == DUST_CMPM_PREFIX) {
        uint j = lane;
        if (j >= nl) return;
        uvec3 d = dust_cmp_desc(prm, set, j);
        uint l = (d.x * np + d.y) * 3u + d.z;
        uint bl = dust_cad_blocks(R, nc, np, rb, t, nb, l);
        uint blocks = (pc.liveCount + DUST_CMP_BLOCK - 1u) / DUST_CMP_BLOCK;
        uint acc = 0u;
        for (uint b = 0u; b < blocks; ++b) {
            uint c = pc.sys.v[bl + b];
            pc.sys.v[bl + nb + b] = acc;
            acc += c;
        }
        uint tp = dust_cads_tp(t, d.x, d.y);
        if (d.z == 0u) {
            DustUintBuffer(st).v[tp] = acc;
        } else if (d.z == 1u) {
            // the promotion (cadence.rs F2a): step ⌈len / N⌉, cursor 0, the list meta moved
            uint n = DustUintBuffer(prm).v[DUST_CADP_N + d.x];
            DustUintBuffer(st).v[tp + 1u] = acc;
            DustUintBuffer(st).v[tp + 4u] = (acc + n - 1u) / n;
            DustUintBuffer(st).v[tp + 3u] = 0u;
            DustUintBuffer(st).v[tp + 5u] = DustUintBuffer(st).v[tp + 6u];
            DustUintBuffer(st).v[tp + 6u] = 0u;
            DustUintBuffer(st).v[tp + 2u] = 0u;
            if (acc > 0u) atomicOr(DustUintBuffer(st).v[dust_cads_pair(d.x, d.y) + 1u], 1u);
        } else {
            DustUintBuffer(st).v[tp + 2u] = acc;
        }
        return;
    }

    // COUNT and SCATTER: block gl_WorkGroupID.x, offsets base + PER lane .. + PER - 1. The tier's words
    // (R, nc, np, rb, cap, nb, inc0) go to s_geo once (lane 0, a barrier) and every use reads them
    // from there: nothing tier-wide is live in registers across the scan (perf9_O).
    if (lane == 0u) {
        s_geo[0] = R; s_geo[1] = nc; s_geo[2] = np; s_geo[3] = rb; s_geo[4] = cap; s_geo[5] = nb;
        s_geo[6] = dust_cad_inc0(R, nc, np);
    }
    barrier();
    for (uint j = 0u; j < nl; ++j) {
        uint c = 0u;
        uint f = 0u;   // bit i: offset o0 + i is a member
        {
            uvec2 prm2 = uvec2(uvec2(pc.params));
            uvec3 d = dust_cmp_desc(prm2, (pc.tierMode >> 16u) & 1u, j);
            uint o0 = gl_WorkGroupID.x * DUST_CMP_BLOCK + DUST_CMP_PER * gl_LocalInvocationID.x;
            // the offsets below liveCount (a variable trip count: the loop stays a loop)
            uint n = o0 < pc.liveCount ? min(DUST_CMP_PER, pc.liveCount - o0) : 0u;
            for (uint i = 0u; i < n; ++i) {
                uint s = (pc.firstSlot + o0 + i) & pc.ringMask;
                if (dust_cmp_member(dust_own_get(uvec2(pc.sys), s_geo[3] + s), dust_inc_get(uvec2(pc.sys), s_geo[6], s_geo[3] + s), s, d, s_geo[2])) { c += 1u; f |= 1u << i; }
            }
        }
        s_scan[gl_LocalInvocationID.x] = c;
        barrier();
        if (((pc.tierMode >> 8u) & 0xFFu) == DUST_CMPM_COUNT) {
            for (uint stride = uint(DUST_CMP_WG) / 2u; stride > 0u; stride >>= 1u) {
                if (gl_LocalInvocationID.x < stride) s_scan[gl_LocalInvocationID.x] += s_scan[gl_LocalInvocationID.x + stride];
                barrier();
            }
            if (gl_LocalInvocationID.x == 0u) {
                uvec2 prm2 = uvec2(uvec2(pc.params));
                uint t2 = pc.tierMode & 0xFFu;
                uint tb2 = DUST_CADP_TIER0 + DUST_CADP_TIER_WORDS * t2;
                uvec3 d = dust_cmp_desc(prm2, (pc.tierMode >> 16u) & 1u, j);
                uint l = (d.x * s_geo[2] + d.y) * 3u + d.z;
                uint bl = dust_cad_blocks(s_geo[0], s_geo[1], s_geo[2], DustUintBuffer(prm2).v[tb2], t2, s_geo[5], l);
                pc.sys.v[bl + gl_WorkGroupID.x] = s_scan[0];
            }
        } else {
            // inclusive Hillis–Steele scan
            for (uint dd = 1u; dd < uint(DUST_CMP_WG); dd <<= 1u) {
                uint v = gl_LocalInvocationID.x >= dd ? s_scan[gl_LocalInvocationID.x - dd] : 0u;
                barrier();
                s_scan[gl_LocalInvocationID.x] += v;
                barrier();
            }
            if (f != 0u) {
                uvec2 prm2 = uvec2(uvec2(pc.params));
                uint t2 = pc.tierMode & 0xFFu;
                uint tb2 = DUST_CADP_TIER0 + DUST_CADP_TIER_WORDS * t2;
                uvec3 d = dust_cmp_desc(prm2, (pc.tierMode >> 16u) & 1u, j);
                uint l = (d.x * s_geo[2] + d.y) * 3u + d.z;
                uint bl = dust_cad_blocks(s_geo[0], s_geo[1], s_geo[2], s_geo[3], t2, s_geo[5], l);
                uint pos = pc.sys.v[bl + s_geo[5] + gl_WorkGroupID.x] + s_scan[gl_LocalInvocationID.x] - c;
                uint la = dust_cad_list(s_geo[0], s_geo[1], s_geo[2], s_geo[3], s_geo[4], d.x, d.y, d.z);
                uint o0 = gl_WorkGroupID.x * DUST_CMP_BLOCK + DUST_CMP_PER * gl_LocalInvocationID.x;
                // the members in ascending offset (the set bits of f, lowest first)
                for (uint m = f; m != 0u; m &= m - 1u) {
                    pc.sys.v[la + pos] = (pc.firstSlot + o0 + uint(findLSB(m))) & pc.ringMask;
                    pos += 1u;
                }
            }
        }
        barrier();
    }
}
