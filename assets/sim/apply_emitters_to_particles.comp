// @assets/sim/apply_emitters_to_particles.comp
//
// Force unit contract:
//   Gravity emitter: position in AU (macro-frame world space).
//   Particle:        position in km (micro-frame local) when frame_type == 1,
//                    or AU (macro-frame) when frame_type == 0.
//
//   r_local is always computed in km by the frame_type branch below:
//     macro particle: r_local = (emitter_AU - pos_AU) * AU_TO_KM   [km]
//     micro particle: r_local = (emitter_AU - frame.center_AU) / scale - pos_km [km]
//
//   force_mag = mu_eff * mass / dist_km²  →  [km³/s² * kg / km²] = [km·kg/s²]
//   f_acc / mass  → acceleration [km/s²]  (stored in AOSOA slots 7-9)
#version 450 core
#extension GL_EXT_buffer_reference2         : require
#extension GL_EXT_buffer_reference_uvec2    : require
#extension GL_KHR_shader_subgroup_basic     : require
#extension GL_GOOGLE_include_directive      : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer ParticleFrameIds {
    uint frame_ids[];
};

layout(push_constant, std430) uniform PushConstants {
    ParticleData           particles;
    EmitterArray           emitters;
    GpuReferenceFrameArray frames;
    ParticleFrameIds       particle_frame_ids;
    MultiBvhBuffer         bvh;
    uint num_emitters;
    uint total_particles;
    uint root_node_idx;
    uint _pad[3];
} pc;

shared vec3 s_em_pos;
shared float s_em_mu;
shared float s_em_beta;
shared uint s_em_type;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    
    // We process particles directly. Since the buffer is already sorted,
    // memory accesses will be naturally coalesced.
    
    // Setup base index for this invocation
    uint block = gid / SUBGROUP_SIZE;
    uint lane  = gid % SUBGROUP_SIZE;
    uint base  = block * (PARTICLE_FIELDS * SUBGROUP_SIZE) + lane;
    
    bool is_active = (gid < pc.total_particles);
    float mass = 0.0;
    vec3 pos = vec3(0.0);
    uint fi = 0;
    GpuReferenceFrame frame;
    
    if (is_active) {
        mass = P_READ(pc.particles, base + 6u * SUBGROUP_SIZE);
        if (mass > 0.0) {
            pos = vec3(
                P_READ(pc.particles, base + 0u * SUBGROUP_SIZE),
                P_READ(pc.particles, base + 1u * SUBGROUP_SIZE),
                P_READ(pc.particles, base + 2u * SUBGROUP_SIZE)
            );
            fi = pc.particle_frame_ids.frame_ids[gid];
            frame = pc.frames.frames[fi];
        } else {
            is_active = false;
        }
    }
    
    // Read particle-intrinsic radiation pressure coefficient β from AOSOA slot 10.
    float p_beta = 0.0;
    if (is_active) {
        p_beta = P_READ(pc.particles, base + 10u * SUBGROUP_SIZE);
    }
    
    vec3 f_acc = vec3(0.0);

    for (uint e = 0u; e < pc.num_emitters; ++e) {
        if (gl_LocalInvocationID.x == 0) {
            s_em_type = pc.emitters.emitters[e].type_id;
            s_em_pos  = pc.emitters.emitters[e].position;
            s_em_mu   = pc.emitters.emitters[e].mu;
            s_em_beta = pc.emitters.emitters[e].beta;
        }
        barrier();
        
        if (s_em_type != 0u) { barrier(); continue; }
        
        if (is_active) {
            vec3 r_local;
            if (frame.frame_type == 0u) {
                r_local = (s_em_pos - pos) * AU_TO_KM;
            } else {
                r_local = (s_em_pos - frame.center_pos) / frame.scale - pos;
            }

            float dist_sq = dot(r_local, r_local);
            if (dist_sq > 1e-6) {
                float dist      = sqrt(dist_sq);
                float dist3     = dist_sq * dist;
                float dist5     = dist3 * dist_sq;
                float softening = 1.0 - exp(-dist5);
                float mu_eff    = s_em_mu * (1.0 - p_beta);
            // r_local [km]; force_mag [km/s²·kg]; f_acc accumulates [km/s²] per unit mass
                float force_mag = (mu_eff * mass * softening) / dist_sq;
                f_acc += (r_local / dist) * force_mag;
            }
        }
        barrier();
    }
    
    if (is_active) {
        // Self-gravity BVH pass
        uvec2 bvh_uvec = uvec2(pc.bvh);
        if (bvh_uvec.x != 0u || bvh_uvec.y != 0u) {
            uint leaf_idx = gid / PARTICLES_IN_LEAF;
            uint num_leaves = (pc.total_particles + PARTICLES_IN_LEAF - 1) / PARTICLES_IN_LEAF;
            uint current = num_leaves - 1 + leaf_idx;

            while (current != 0) {
                uint parent     = tlas_parent(pc.bvh, current);
                uint c1         = tlas_child(pc.bvh, parent, 1u);
                uint child_lane = (c1 == current) ? 1u : 0u;

                f_acc += vec3(
                    tlas_force_x(pc.bvh, parent, child_lane),
                    tlas_force_y(pc.bvh, parent, child_lane),
                    tlas_force_z(pc.bvh, parent, child_lane)
                );
                current = parent;
            }
        }

        if (f_acc.x != 0.0 || f_acc.y != 0.0 || f_acc.z != 0.0) {
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 7u * SUBGROUP_SIZE], f_acc.x);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 8u * SUBGROUP_SIZE], f_acc.y);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 9u * SUBGROUP_SIZE], f_acc.z);
        }
    }
}