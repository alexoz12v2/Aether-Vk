#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_debug_printf : enable

#define SHOULD_DEBUG_PRINT false

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer EntityArray {
    RigidBody entities[];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer PairBufferIn {
    uint count;
    uvec2 pairs[];
};

layout(push_constant, scalar) uniform PushConstants {
    EntityArray scene_entities;
    SparseCollisions output_list;
    ParticleData particles;
    PairBufferIn pair_buffer;
    float dt;
    float particle_radius;
} pc;

void main() {
    uint pair_idx = gl_WorkGroupID.x;
    if (pair_idx >= pc.pair_buffer.count) return;

    if (gl_LocalInvocationID.x != 0) return; // 1 thread per pair

    uvec2 pair = pc.pair_buffer.pairs[pair_idx];
    uint entity_A_idx = pair.x;
    uint entity_B_idx = pair.y;

    RigidBody ent_A = pc.scene_entities.entities[entity_A_idx];
    RigidBody ent_B = pc.scene_entities.entities[entity_B_idx];

    uint shape_A = ent_A.shape_type;
    uint shape_B = ent_B.shape_type;
    vec3 extents_A = ent_A.shape_extents;
    vec3 extents_B = ent_B.shape_extents;

    vec3 pos_A = ent_A.position_mass.xyz;
    vec3 pos_B = ent_B.position_mass.xyz;

    // Simple Sphere-Sphere CCD (Shape Type 2 = Sphere)
    if (shape_A == 2 && shape_B == 2) {
        float rA = extents_A.x;
        float rB = extents_B.x;
        vec3 p_rel = pos_A - pos_B;
        vec3 v_rel = ent_A.linear_vel_drag.xyz - ent_B.linear_vel_drag.xyz;

        float radiusSum = rA + rB;
        float c = dot(p_rel, p_rel) - radiusSum * radiusSum;

        float toi = 0.0;
        bool collision_found = false;

        if (c < 0.0) {
            toi = 0.0;
            collision_found = true;
        } else {
            float a = dot(v_rel, v_rel);
            float b = dot(p_rel, v_rel) * 2.0;
            if (a > 1e-8) {
                float discriminant = b * b - 4.0 * a * c;
                if (discriminant >= 0.0) {
                    float t = (-b - sqrt(discriminant)) / (2.0 * a);
                    if (t >= 0.0 && t <= pc.dt) {
                        toi = t;
                        collision_found = true;
                    }
                }
            }
        }

        if (collision_found) {
            vec3 pA_toi = pos_A + ent_A.linear_vel_drag.xyz * toi;
            vec3 pB_toi = pos_B + ent_B.linear_vel_drag.xyz * toi;
            vec3 diff = pA_toi - pB_toi;
            float dist = length(diff);
            vec3 normal = (dist > 1e-6) ? (diff / dist) : vec3(0.0, 1.0, 0.0);

            float penetration = radiusSum - dist;
            if (penetration < 0.0) penetration = 0.0;

            vec3 contact = pB_toi + normal * rB;

            uint count = atomicAdd(pc.output_list.count, 1);
            if (count < 4000u) {
                SparseCollisionData collision;
                collision.entity_a = entity_A_idx;
                collision.prim_a = entity_A_idx;
                collision.entity_b = entity_B_idx;
                collision.prim_b = entity_B_idx;
                collision.toi = toi;
                collision.contact_normal = normal;
                collision.contact_point = contact;
                collision.penetration_depth = penetration;
                pc.output_list.pairs[count] = collision;
            }
        }
    } else if ((shape_A == 1 && shape_B == 2) || (shape_A == 2 && shape_B == 1)) {
        // OBB - Sphere
        bool a_is_obb = shape_A == 1;
        RigidBody obb = a_is_obb ? ent_A : ent_B;
        RigidBody sph = a_is_obb ? ent_B : ent_A;
        vec3 ext_obb = a_is_obb ? extents_A : extents_B;
        float r_sph = a_is_obb ? extents_B.x : extents_A.x;

        mat3 rot_obb = quat_to_mat3(obb.orientation);
        vec3 c_obb = obb.position_mass.xyz;
        vec3 c_sph = sph.position_mass.xyz;

        vec3 diff = c_sph - c_obb;
        vec3 local_p = vec3(dot(diff, rot_obb[0]), dot(diff, rot_obb[1]), dot(diff, rot_obb[2]));
        vec3 local_closest = clamp(local_p, -ext_obb, ext_obb);

        vec3 closest = c_obb + local_closest.x * rot_obb[0] + local_closest.y * rot_obb[1] + local_closest.z * rot_obb[2];

        vec3 to_closest = c_sph - closest;
        float distSq = dot(to_closest, to_closest);

        if (distSq < r_sph * r_sph) {
            float dist = sqrt(distSq);
            vec3 normal;
            if (dist > 1e-6) {
                normal = to_closest / dist;
            } else {
                vec3 abs_p = abs(local_p);
                vec3 pen = ext_obb - abs_p;
                if (pen.x <= pen.y && pen.x <= pen.z) normal = rot_obb[0] * sign(local_p.x);
                else if (pen.y <= pen.x && pen.y <= pen.z) normal = rot_obb[1] * sign(local_p.y);
                else normal = rot_obb[2] * sign(local_p.z);
                dist = -min(pen.x, min(pen.y, pen.z));
            }

            vec3 final_normal = a_is_obb ? normal : -normal;

            uint count = atomicAdd(pc.output_list.count, 1);
            if (count < 4000u) {
                SparseCollisionData collision;
                collision.entity_a = entity_A_idx;
                collision.prim_a = entity_A_idx;
                collision.entity_b = entity_B_idx;
                collision.prim_b = entity_B_idx;
                collision.toi = pc.dt;
                collision.contact_normal = final_normal;
                collision.contact_point = closest;
                collision.penetration_depth = r_sph - dist;
                pc.output_list.pairs[count] = collision;
            }
        }
    } else if (shape_A == 1 && shape_B == 1) {
        // OBB - OBB SAT
        mat3 rotA = quat_to_mat3(ent_A.orientation);
        mat3 rotB = quat_to_mat3(ent_B.orientation);

        vec3 centerA = ent_A.position_mass.xyz;
        vec3 centerB = ent_B.position_mass.xyz;

        vec3 T = centerB - centerA;

        mat3 R;
        mat3 absR;
        for(int i=0; i<3; ++i) {
            for(int j=0; j<3; ++j) {
                R[i][j] = dot(rotA[i], rotB[j]);
                absR[i][j] = abs(R[i][j]) + 1e-6; // prevent parallel cross product zero
            }
        }

        float ra, rb;
        float penetration = 1e9;
        vec3 normal = vec3(0.0);
        bool disjoint = false;

        // Axes A0, A1, A2
        for(int i=0; i<3; ++i) {
            ra = extents_A[i];
            rb = extents_B[0] * absR[i][0] + extents_B[1] * absR[i][1] + extents_B[2] * absR[i][2];
            float dist = abs(dot(T, rotA[i]));
            if (dist > ra + rb) disjoint = true;
            float p = (ra + rb) - dist;
            if (p < penetration) { penetration = p; normal = dot(T, rotA[i]) < 0.0 ? -rotA[i] : rotA[i]; }
        }

        // Axes B0, B1, B2
        for(int i=0; i<3; ++i) {
            ra = extents_A[0] * absR[0][i] + extents_A[1] * absR[1][i] + extents_A[2] * absR[2][i];
            rb = extents_B[i];
            float dist = abs(dot(T, rotB[i]));
            if (dist > ra + rb) disjoint = true;
            float p = (ra + rb) - dist;
            if (p < penetration) { penetration = p; normal = dot(T, rotB[i]) < 0.0 ? -rotB[i] : rotB[i]; }
        }

        // 9 Cross products
        for(int i=0; i<3; ++i) {
            for(int j=0; j<3; ++j) {
                ra = extents_A[(i+1)%3] * absR[(i+2)%3][j] + extents_A[(i+2)%3] * absR[(i+1)%3][j];
                rb = extents_B[(j+1)%3] * absR[i][(j+2)%3] + extents_B[(j+2)%3] * absR[i][(j+1)%3];
                vec3 axis = cross(rotA[i], rotB[j]);
                float l = length(axis);
                if (l > 1e-6) {
                    axis /= l;
                    float dist = abs(dot(T, axis));
                    if (dist > ra + rb) disjoint = true;
                    float p = (ra + rb) - dist;
                    if (p < penetration) { penetration = p; normal = dot(T, axis) < 0.0 ? -axis : axis; }
                }
            }
        }

        if (!disjoint) {
            uint count = atomicAdd(pc.output_list.count, 1);
            if (count < 4000u) {
                SparseCollisionData collision;
                collision.entity_a = entity_A_idx;
                collision.prim_a = entity_A_idx;
                collision.entity_b = entity_B_idx;
                collision.prim_b = entity_B_idx;
                collision.toi = pc.dt;
                collision.contact_normal = normal;
                collision.contact_point = centerB + normal * (extents_B.x * 0.5); // very rough approx
                collision.penetration_depth = penetration;
                pc.output_list.pairs[count] = collision;
            }
        }
    }
}