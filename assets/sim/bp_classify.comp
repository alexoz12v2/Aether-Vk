#version 450 core

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

layout(push_constant, std430) uniform PushConstants {
    PairBuffer raw_pairs;

    uvec2 out_rb_rb;
    uvec2 out_rb_ps;
    uvec2 out_ps_ps;
    uvec2 out_macro_lca;
    uvec2 out_lca_lca;

    uint max_pairs; // DEPRECATED: Dangerous global bound
    uint num_rigid_bodies;
} pc;

#define BVH_SHAPE_SUB_TLAS 3u

void main() {
    uint id = gl_GlobalInvocationID.x;

#ifdef DEBUG_SHADERS
    // Diagnostic header: Only Thread 0 prints to confirm total workload
    if (id == 0) {
        debugPrintfEXT("[bp_classify] STARTING. Active raw_pairs count: %d\n", pc.raw_pairs.count);
    }
#endif

    // Safely exit unused threads
    if (id >= pc.raw_pairs.count) return;

    uvec2 pair = pc.raw_pairs.pairs[id];
    uint ent_A = pair.x;
    uint meta_B = pair.y;

    uint ent_B = bvh_get_index(meta_B);
    uint shape_B = bvh_get_shape(meta_B);

    uint type_A = (ent_A < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM;
    uint type_B = (ent_B < pc.num_rigid_bodies) ? TYPE_RIGID_BODY : TYPE_PARTICLE_SYSTEM;

    if (type_A > type_B) {
        uint temp = ent_A; ent_A = ent_B; ent_B = temp;
        temp = type_A; type_A = type_B; type_B = temp;
    }

    // Mask out any upper shape bits before storing in narrow phase buffers
    uvec2 clean_pair = uvec2(bvh_get_index(ent_A), bvh_get_index(ent_B));

    if (type_A == TYPE_PARTICLE_SYSTEM && type_B == TYPE_PARTICLE_SYSTEM) {
        if (pc.out_ps_ps.x != 0 || pc.out_ps_ps.y != 0) {
            PairBuffer buf = PairBuffer(pc.out_ps_ps);
            uint out_idx = atomicAdd(buf.count, 1);

            // FIX: Check against specific buffer capacity, not global
            if (out_idx < buf.capacity) {
                buf.pairs[out_idx] = clean_pair;
            }
#ifdef DEBUG_SHADERS
            else { debugPrintfEXT("[bp_classify FATAL] ps_ps_pairs overflowed! Capacity is %d\n", buf.capacity); }
#endif
        }
    } else if (type_A == TYPE_RIGID_BODY && type_B == TYPE_PARTICLE_SYSTEM) {
        if (pc.out_rb_ps.x != 0 || pc.out_rb_ps.y != 0) {
            PairBuffer buf = PairBuffer(pc.out_rb_ps);
            uint out_idx = atomicAdd(buf.count, 1);

            if (out_idx < buf.capacity) {
                buf.pairs[out_idx] = clean_pair;
            }
#ifdef DEBUG_SHADERS
            else { debugPrintfEXT("[bp_classify FATAL] rb_ps_pairs overflowed! Capacity is %d\n", buf.capacity); }
#endif
        }
    } else if (type_A == TYPE_RIGID_BODY && type_B == TYPE_RIGID_BODY) {
        bool b_is_lca = (shape_B == BVH_SHAPE_SUB_TLAS);

        if (b_is_lca) {
            if (pc.out_macro_lca.x != 0 || pc.out_macro_lca.y != 0) {
                PairBuffer buf = PairBuffer(pc.out_macro_lca);
                uint out_idx = atomicAdd(buf.count, 1);

                if (out_idx < buf.capacity) {
                    buf.pairs[out_idx] = clean_pair;
                }
#ifdef DEBUG_SHADERS
                else { debugPrintfEXT("[bp_classify FATAL] macro_lca overflowed! Capacity is %d\n", buf.capacity); }
#endif
            }
        } else {
            if (pc.out_rb_rb.x != 0 || pc.out_rb_rb.y != 0) {
                PairBuffer buf = PairBuffer(pc.out_rb_rb);
                uint out_idx = atomicAdd(buf.count, 1);

                if (out_idx < buf.capacity) {
                    buf.pairs[out_idx] = clean_pair;
                }
#ifdef DEBUG_SHADERS
                else { debugPrintfEXT("[bp_classify FATAL] rb_rb_pairs overflowed! Capacity is %d\n", buf.capacity); }
#endif
            }
        }
    }
}