// @assets/sim/bp_classify.comp
#version 450 core
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#define TYPE_PARTICLE_SYSTEM 0
#define TYPE_RIGID_BODY      1
#define TYPE_MICRO_LCA       2 

#include "../debug_utils.glsl"
layout(local_size_x = 256) in;

struct EntityHeader { uint type; uint pad[3]; };

layout(buffer_reference, scalar, buffer_reference_align = 8) readonly buffer EntityArray { EntityHeader entities[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer RawPairs { uint count; uvec2 pairs[]; };
layout(buffer_reference, scalar, buffer_reference_align = 4) buffer QueueBuf { uint count; uvec2 pairs[]; };

layout(push_constant, scalar) uniform PushConstants {
    EntityArray scene_entities;
    RawPairs raw_pairs;
    QueueBuf out_rb_rb;
    QueueBuf out_rb_ps;
    QueueBuf out_rb_lca;
    uint n_entities;
    uint _pad;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    
    // TEMPORARY HACK: Generate O(N^2) rigid body pairs for collision
    // Since we don't have a dynamic TLAS builder yet.
    uint N = pc.n_entities;
    if (id >= N * N) return;
    
    uint i = id / N;
    uint j = id % N;
    
    if (i < j) {
        QueueBuf out_q = pc.out_rb_rb;
        uint out_idx = atomicAdd(out_q.count, 1);
        out_q.pairs[out_idx] = uvec2(i, j);
    }
}