// @assets/sim/dust_splat.comp
//
// Dust v4 render: one thread per live cluster of one age tier, after dust_propagate.comp, before
// the compositing pass. Mirror of `dust::splat_tier`.
//
// The cluster's second moments (DustMoments) hold its size polyline: DUST_SIZE_BINS packets of
// equal cross-section along the syndyne (dust_bin_packet), each cut into <= DUST_TIME_PIECES_MAX
// pieces along the segment when the predecessor is wider (dust_time_pieces: the capsule is a
// cone), each projected with the Jacobian of the mvp at its mean (dust_project_packet: EWA / 3DGS
// covariance projection plus the pixel low-pass filter) and scattered as an analytic capsule
// (uniform along the segment to the stream predecessor r - S, Gaussian across; dust_capsule_tau)
// into the view's fixed-point
// pyramid: the level where its smallest sigma is >= DUST_SPLAT_SIGMA_TEXELS texels, counts
// round(tau * texel area / unit) into (tau, tau*rgb) by saturating adds, the nearest depth by
// atomicMin. Nothing is sampled per view: the sum over the pyramid is exposure * flux / pixel area
// for every packet (surface brightness = optical depth), whatever the zoom, distance or budget.
// The colour is the stream colour's hue rotated by the age (dust_age_color); the flow marks
// modulate the packet's amplitude by its mean age; tracers stamp a dot at the exact position.
#version 450 core
#extension GL_GOOGLE_include_directive : require
#include "dust_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// f32 bits: the speck shell's radius (host-written; dust::specks::PYR_SPECKS_DMAX). Defined here,
// not in dust_common.glsl, because dust_specks.comp defines the same constant and includes it
const uint DUST_PYR_SPECKS_DMAX = 252u;

layout(push_constant, std430) uniform PushConstants {
    DustMomentsBuffer moments;  // 0
    DustRenderBuffer  render;   // 8: predecessor validity words
    DustUintBuffer    pyramid;  // 16: header + levels
    uint  liveCount;            // 24
    uint  flags;                // 28: DUST_VIEW_*
    float exposure;             // 32: the stream colour's alpha (1 = photometric)
    float invUnit;              // 36: counts per (tau * px^2)
    uint  color;                // 40: stream colour r | g << 8 | b << 16
    float albedo;               // 44: geometric albedo (the radiance weight), <= 0 = unweighted
    mat4  mvp;                  // 48: particle-system local metres -> clip
    vec4  eyeLocal;             // 112: eye in local metres; w = the system's TTL (s), the hue clock
} pc;                           // 128 bytes

// The capsule of P into one grid of w x h texels of s px at word off (dust::scatter_into): for
// each texel row only the x-range the segment's lateral band covers is visited; `full` adds the
// colour and the nearest depth too
bool scatter_into(DustScreenPacket P, vec3 color, float s, uint off, uint w, uint h, bool full) {
    // a segment shorter than two texels at this level may miss every texel centre with open
    // ends: drawn closed (Gaussian caps), so its flux lands on the texels around it
    if (dot(P.seg, P.seg) < 4.0 * s * s) { P.openStart = false; P.openEnd = false; }
    DustBand B = dust_band_new(P);
    int y0, y1;
    if (!dust_band_rows(B, s, h, y0, y1)) return false;
    float area = s * s;
    uint depthBits = floatBitsToUint(max(P.depthAu, 0.0));
    bool any_ = false;
    // error diffusion along this thread's texel loop (dust::scatter_into): the fraction below one
    // count is carried to the next texel, so a packet deposits its whole flux however faint
    float carry = 0.0;
    for (int ty = y0; ty <= y1; ++ty) {
        float yc = (float(ty) + 0.5) * s;
        int x0, x1;
        if (!dust_band_columns(B, yc, s, w, x0, x1)) continue;
        for (int tx = x0; tx <= x1; ++tx) {
            vec2 x = vec2((float(tx) + 0.5) * s, yc);
            float tau = dust_capsule_tau(P, x) * area * pc.invUnit;
            if (P.albedo > 0.0) tau *= dust_texel_weight(P, x);
            if (!(tau >= 0.0) || isinf(tau)) continue;
            float tauC = min(tau, DUST_COUNT_MAX_PER_ADD) + carry;
            uint counts = uint(tauC + 0.5);
            carry = tauC - float(counts);
            if (counts == 0u) continue;
            uint i = off + (uint(ty) * w + uint(tx)) * DUST_PYRAMID_TEXEL_WORDS;
            dust_atomic_add_sat(pc.pyramid, i, counts);
            if (full) {
                // colour words floor(counts * c + h), h a hashed threshold per texel, an ordered
                // dither (dust::scatter_into): rounding counts * c + 0.5 per deposit turned every
                // faint texel into (1, 1, 0)
                float hf = float(dust_hash32(i) >> 8u) * (1.0 / 16777216.0);
                uvec3 n = uvec3(float(counts) * color * DUST_COLOR_SCALE + hf);
                dust_atomic_add_sat(pc.pyramid, i + 1u, n.r);
                dust_atomic_add_sat(pc.pyramid, i + 2u, n.g);
                dust_atomic_add_sat(pc.pyramid, i + 3u, n.b);
                // nearest dust: 0 means "no dust yet" (positive f32 bits order as uints)
                uint cur = pc.pyramid.v[i + 4u];
                if (cur == 0u || depthBits < cur) {
                    uint seen = atomicCompSwap(pc.pyramid.v[i + 4u], 0u, depthBits);
                    if (seen != 0u) atomicMin(pc.pyramid.v[i + 4u], depthBits);
                }
            }
            any_ = true;
        }
    }
    return any_;
}

// whether this frame's in-frame gates are on (bit 22 of DUST_PYR_SPLIT_DEPTH clear; dust::frame_gates_on)
bool dust_frame_gates_on() {
    return ((pc.pyramid.v[DUST_PYR_SPLIT_DEPTH] >> 22u) & 1u) == 0u;
}

// the level a packet past an in-frame gate is drawn at least at (dust::gate_level)
uint dust_gate_level(uint levels) {
    return levels >= 3u ? levels - 3u : 0u;
}

// the capsule band's texels at a level (dust::splat_scatter)
float dust_band_at(float segLen, float ex, float ey, uint level) {
    float s = float(1u << level);
    return (segLen / s + 2.0 * ex / s + 2.0) * (2.0 * ey / s + 2.0);
}

// v px^2 added to both axes of the screen covariance, the integral kept (dust::widen_screen_packet;
// v = s^2/4 for texels of s px: their centres sum to the integral within 1.4 %)
void dust_widen_screen_packet(inout DustScreenPacket P, float v) {
    P.cov.x += v;
    P.cov.z += v;
    precise float half_ = 0.5 * (P.cov.x + P.cov.z);
    precise float dd = sqrt((0.5 * (P.cov.x - P.cov.z)) * (0.5 * (P.cov.x - P.cov.z)) + P.cov.y * P.cov.y);
    float lamMax = max(half_ + dd, DUST_PIXEL_FILTER_VAR);
    precise float detRaw = P.cov.x * P.cov.z - P.cov.y * P.cov.y;
    float det = max(max(detRaw, DUST_DET_ANISO_FLOOR * lamMax * lamMax), 1e-30);
    P.amp *= sqrt(P.det / det);
    P.det = det;
    P.sigmaMin = sqrt(max(det / lamMax, DUST_PIXEL_FILTER_VAR * 0.5));
}

void scatter(DustScreenPacket P, vec3 color, uint levels) {
    // the peak is measured whatever the unit (a view fainter than the unit must still move it:
    // not_flow.rdc), before any texel test
    atomicMax(pc.pyramid.v[DUST_PYR_TAU_MAX], floatBitsToUint(P.amp * P.wMean));
    uint level = dust_splat_level(P.sigmaMin, levels);
    float ex = DUST_SPLAT_SIGMAS * sqrt(P.cov.x), ey = DUST_SPLAT_SIGMAS * sqrt(P.cov.z);
    // the part of the segment the band can draw: inside the frame expanded by the band's margin
    // (dust::splat_scatter: the rows and columns clip the drawn texels; the estimate must too)
    float W = float(pc.pyramid.v[DUST_PYR_WIDTH]), H = float(pc.pyramid.v[DUST_PYR_HEIGHT]);
    float segLen = sqrt(P.seg.x * P.seg.x + P.seg.y * P.seg.y)
                 * dust_visible_fraction(P.mu, P.seg, ex, ey, W, H);
    // safety valve against runaway threads: a packet whose capsule band would visit more than
    // its cap goes to a coarser level (blur, never a stall). The cap is DUST_SPLAT_MAX_TEXELS
    // quartered per level of the frame's EWA bias (bits 18-21 of DUST_PYR_SPLIT_DEPTH, host-fed
    // from DUST_PYR_EWA_TEXELS: inside the coma ~10^6 packets cross the whole screen)
    uint ewaBias = min((pc.pyramid.v[DUST_PYR_SPLIT_DEPTH] >> 18u) & 0xFu, DUST_EWA_BIAS_MAX);
    float cap = DUST_SPLAT_MAX_TEXELS / float(1u << (2u * ewaBias));
    float band = dust_band_at(segLen, ex, ey, level);
    while (band > DUST_SPLAT_MAX_TEXELS && level + 1u < levels) {
        level++;
        band = dust_band_at(segLen, ex, ey, level);
    }
    // the level the per-packet valve alone gives: beyond it (the bias, the gate) the packet is
    // widened to half its texels below, so it blurs instead of missing every texel centre
    uint levelValve = level;
    // the bias stops at the gate level (<= 16 texels a packet there; the 1 x 1 level loses a
    // widened packet's light off its single texel; dust::splat_scatter)
    while (band > cap && level + 1u < levels && level < dust_gate_level(levels)) {
        level++;
        band = dust_band_at(segLen, ex, ey, level);
    }
    // the band's texels inside the level (the rows and columns clip to it): the work counted, and
    // the in-frame gate (dust::splat_scatter): past DUST_FRAME_HARD_FACTOR budgets this frame, at
    // least dust_gate_level (a frame the host feedback has not caught up with is bounded at once)
    uint lw0 = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 1u];
    uint lh0 = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 2u];
    float work = min(band, float(lw0) * float(lh0));
    uint before = atomicAdd(pc.pyramid.v[DUST_PYR_EWA_TEXELS], uint(work / DUST_EWA_TEXEL_UNIT) + 1u);
    if (dust_frame_gates_on() && before > DUST_FRAME_HARD_FACTOR * (DUST_EWA_FRAME_BUDGET / uint(DUST_EWA_TEXEL_UNIT))) level = max(level, dust_gate_level(levels));
    if (level > levelValve) {
        float sz = float(1u << level);
        dust_widen_screen_packet(P, 0.25 * sz * sz);
    }
    uint off = pc.pyramid.v[DUST_PYR_TABLE + 3u * level];
    uint w = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 1u];
    uint h = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 2u];
    if (scatter_into(P, color, float(1u << level), off, w, h, true)) {
        atomicOr(pc.pyramid.v[DUST_PYR_LEVEL_MASK], 1u << level);
    }
    // the white-point measurement grid is derived from the finished pyramid (dust_measure.comp)
}

// One Gaussian piece of a volumetric packet (dust::VolumePiece)
struct DustVolumePiece {
    float l[6];   // Cholesky factor of its covariance
    vec3  qw;     // L^-1 (eye - mean)
    float k;      // exposure * flux / (2 pi sqrt(det S))
    vec4  bbox;   // projected 3-sigma box (px): x0 x1 y0 y1
    bool  full;   // the whole frame (the eye near it, or a box corner not in front of the eye)
    bool  on;     // on screen
};

// The n pieces of a volumetric packet (dust::volume_pieces): covariance S (pixel filter
// included), piece variance cvar of the spacing^2
// (the axes: base point axMean and covariance S, axis a = segA (the chord, rho ramp, from the base
// point) with nA pieces of variance cvarA spacing^2, axis b = segB (dust::Packet::seg_t, uniform,
// centred) with nB pieces when hasB; piece i * nB + j; without axis b the chord-only arithmetic)
void dust_volume_pieces(DustPacket p, float exposure, vec3 axMean, float S[6], vec3 segA, uint nA, float cvarA,
                        vec3 segB, uint nB, float cvarB, bool hasB, float W, float H,
                        inout DustVolumePiece pieces[DUST_VOLUME_PIECES_MAX]) {
    vec3 r0 = vec3(pc.mvp[0][0], pc.mvp[1][0], pc.mvp[2][0]);
    vec3 r1 = vec3(pc.mvp[0][1], pc.mvp[1][1], pc.mvp[2][1]);
    vec3 r3 = vec3(pc.mvp[0][3], pc.mvp[1][3], pc.mvp[2][3]);
    float t0 = pc.mvp[3][0], t1 = pc.mvp[3][1], t3 = pc.mvp[3][3];
    vec3 eye = pc.eyeLocal.xyz;
    float cvar = cvarA;
    float invN = 1.0 / float(nA);
    vec3 h = segA * invN;
    float invB = 1.0 / float(nB);
    vec3 hb = segB * invB;
    for (uint k = 0u; k < nA * nB; ++k) {
        uint i = k / nB, j = k % nB;
        float uk = (float(i) + 0.5) * invN;
        vec3 meanK = axMean + segA * uk;
        float Sk[6];
        Sk[0] = S[0] + cvar * h.x * h.x;
        Sk[1] = S[1] + cvar * h.x * h.y;
        Sk[2] = S[2] + cvar * h.x * h.z;
        Sk[3] = S[3] + cvar * h.y * h.y;
        Sk[4] = S[4] + cvar * h.y * h.z;
        Sk[5] = S[5] + cvar * h.z * h.z;
        float fluxK = p.flux * (p.rho.x + (p.rho.y - p.rho.x) * uk) * invN;
        if (hasB) {
            float vk = (float(j) + 0.5) * invB - 0.5;
            meanK = meanK + segB * vk;
            Sk[0] += cvarB * hb.x * hb.x;
            Sk[1] += cvarB * hb.x * hb.y;
            Sk[2] += cvarB * hb.x * hb.z;
            Sk[3] += cvarB * hb.y * hb.y;
            Sk[4] += cvarB * hb.y * hb.z;
            Sk[5] += cvarB * hb.z * hb.z;
            fluxK *= invB;
        }
        float Lk[6];
        dust_cholesky3(Sk, Lk);
        vec3 qw = dust_cholesky_solve3(Lk, eye - meanK);
        bool full = dot(qw, qw) < DUST_VOLUME_SIGMAS * DUST_VOLUME_SIGMAS;
        vec3 ext = vec3(3.0 * sqrt(Sk[0]), 3.0 * sqrt(Sk[3]), 3.0 * sqrt(Sk[5]));
        float x0 = 1e30, x1 = -1e30, y0 = 1e30, y1 = -1e30;
        if (!full) {
            for (uint c = 0u; c < 8u; ++c) {
                vec3 pt = vec3(meanK.x + ((c & 1u) != 0u ? ext.x : -ext.x),
                               meanK.y + ((c & 2u) != 0u ? ext.y : -ext.y),
                               meanK.z + ((c & 4u) != 0u ? ext.z : -ext.z));
                float w = dot(r3, pt) + t3;
                if (!(w > 0.0)) { full = true; break; }
                float px = ((dot(r0, pt) + t0) / w * 0.5 + 0.5) * W;
                float py = ((dot(r1, pt) + t1) / w * 0.5 + 0.5) * H;
                x0 = min(x0, px); x1 = max(x1, px);
                y0 = min(y0, py); y1 = max(y1, py);
            }
        }
        pieces[k].l = Lk;
        pieces[k].qw = qw;
        pieces[k].k = exposure * fluxK / (2.0 * DUST_PI_F32 * (Lk[0] * Lk[3] * Lk[5]));
        pieces[k].bbox = vec4(x0, x1, y0, y1);
        pieces[k].full = full;
        pieces[k].on = full || !(x1 < 0.0 || y1 < 0.0 || x0 > W || y0 > H || !(x0 <= x1) || !(y0 <= y1));
    }
}

// texel range of a piece at a level of lw x lh texels (dust::volume_range): empty off screen, the
// whole grid when full
ivec4 dust_volume_range(DustVolumePiece q, uint level, uint lw, uint lh) {
    if (!q.on) return ivec4(0, -1, 0, -1);
    if (q.full) return ivec4(0, int(lw) - 1, 0, int(lh) - 1);
    float sz = float(1u << level);
    return ivec4(int(max(floor(q.bbox.x / sz), 0.0)), int(min(ceil(q.bbox.y / sz), float(lw - 1u))),
                 int(max(floor(q.bbox.z / sz), 0.0)), int(min(ceil(q.bbox.w / sz), float(lh - 1u))));
}

// sum over the first n pieces of the texels in their ranges at a level (dust::volume_evals)
uint dust_volume_evals(DustVolumePiece pieces[DUST_VOLUME_PIECES_MAX], uint n, uint level) {
    uint lw = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 1u];
    uint lh = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 2u];
    uint total = 0u;
    for (uint k = 0u; k < n; ++k) {
        ivec4 r = dust_volume_range(pieces[k], level, lw, lh);
        total += uint(max(r.y - r.x + 1, 0) * max(r.w - r.z + 1, 0));
    }
    return total;
}

// Draws a packet by the exact ray integral of its density (dust::volume_scatter, where the
// derivation, the units and the choices are documented): per texel of one level, the optical
// depth along the ray from the eye through the texel centre,
// tau = k / sqrt(a) * exp(-|q' - (b/a) u'|^2 / 2) * Phi(-b / sqrt(a)), u' = L^-1 u, q' = L^-1 (eye -
// mean), a = |u'|^2, b = u'.q'; a chord as Gaussian pieces DUST_VOLUME_PIECE_SIGMAS apart; the
// EWA's pixel filter added at the packet's distance. The work is planned first
// (dust::volume_plan): the level from the angular sigma (>= DUST_VOLUME_MIN_LEVEL when a piece
// covers the frame) plus the frame's bias, coarsened until the evaluations (sum over the pieces
// of their texel ranges) fit DUST_VOLUME_MAX_EVALS, then the pieces merged in pairs; each piece is
// evaluated over its own range only, so the work is exactly the plan's (DUST_PYR_VOLUME_EVALS).
void dust_volume_scatter(DustPacket p, float exposure, vec3 color, uint levels, float W, float H, uint bias, uint axis) {
    vec3 r0 = vec3(pc.mvp[0][0], pc.mvp[1][0], pc.mvp[2][0]);
    vec3 r1 = vec3(pc.mvp[0][1], pc.mvp[1][1], pc.mvp[2][1]);
    vec3 r3 = vec3(pc.mvp[0][3], pc.mvp[1][3], pc.mvp[2][3]);
    vec3 eye = pc.eyeLocal.xyz;
    float n3 = dot(r3, r3);
    if (!(n3 > 0.0)) return;
    float fPx = 0.5 * min(W * sqrt(dot(r0, r0)), H * sqrt(dot(r1, r1))) / sqrt(n3);
    if (!(fPx > 0.0)) return;
    vec3 q0 = eye - p.mean;
    vec3 rSeg = q0 - p.seg * dust_segment_param(q0, p.seg);
    float dist = sqrt(dot(rSeg, rSeg));
    float rel = dist / fPx;
    float varF = DUST_PIXEL_FILTER_VAR * rel * rel;
    float S[6];
    S[0] = p.S[0] + varF; S[1] = p.S[1]; S[2] = p.S[2];
    S[3] = p.S[3] + varF; S[4] = p.S[4]; S[5] = p.S[5] + varF;
    float L[6];
    dust_cholesky3(S, L);
    // the axes (dust::volume_plan_pieces): the chord only (default), or seg_t as uniform pieces
    // instead of its 1.21 Gaussian (time: the chord then Gaussianised; grid: both gridded)
    uint mode = (axis != DUST_VOLUME_AXIS_CHORD && dot(p.segT, p.segT) > 0.0) ? axis : DUST_VOLUME_AXIS_CHORD;
    float kf = DUST_CHORD_VAR_FACTOR;
    vec3 ht = p.segT * 0.5;
    float lessT[6];
    lessT[0] = S[0] - kf * ht.x * ht.x;
    lessT[1] = S[1] - kf * ht.x * ht.y;
    lessT[2] = S[2] - kf * ht.x * ht.z;
    lessT[3] = S[3] - kf * ht.y * ht.y;
    lessT[4] = S[4] - kf * ht.y * ht.z;
    lessT[5] = S[5] - kf * ht.z * ht.z;
    vec3 axMean = p.mean;
    float axS[6];
    vec3 segA = p.seg, segB = vec3(0.0);
    bool hasB = false;
    if (mode == DUST_VOLUME_AXIS_TIME) {
        // the chord as its 1.21 Gaussian about its rho-weighted centre
        vec3 hc = p.seg * 0.5;
        float ubar = p.rho.x * 0.5 + (p.rho.y - p.rho.x) / 3.0;
        axMean = p.mean + p.seg * ubar;
        axS[0] = lessT[0] + kf * hc.x * hc.x;
        axS[1] = lessT[1] + kf * hc.x * hc.y;
        axS[2] = lessT[2] + kf * hc.x * hc.z;
        axS[3] = lessT[3] + kf * hc.y * hc.y;
        axS[4] = lessT[4] + kf * hc.y * hc.z;
        axS[5] = lessT[5] + kf * hc.z * hc.z;
        segA = vec3(0.0);
        segB = p.segT;
        hasB = true;
    } else if (mode == DUST_VOLUME_AXIS_GRID) {
        axS = lessT;
        segB = p.segT;
        hasB = true;
    } else {
        axS = S;
    }
    // pieces per axis: one per DUST_VOLUME_PIECE_SIGMAS Mahalanobis sigma of the base covariance
    float Lb[6];
    dust_cholesky3(axS, Lb);
    vec3 dw = dust_cholesky_solve3(Lb, segA);
    float lenW = sqrt(dot(dw, dw)) / DUST_VOLUME_PIECE_SIGMAS;
    bool capped = lenW > float(DUST_VOLUME_PIECES_MAX);
    uint nA = capped ? DUST_VOLUME_PIECES_MAX : max(uint(ceil(lenW)), 1u);
    float cvarA = capped ? DUST_VOLUME_PIECE_VAR_CAPPED : 1.0 / 12.0;
    uint nB = 1u;
    float cvarB = 1.0 / 12.0;
    if (hasB) {
        vec3 dwb = dust_cholesky_solve3(Lb, segB);
        float lenB = sqrt(dot(dwb, dwb)) / DUST_VOLUME_PIECE_SIGMAS;
        bool cappedB = lenB > float(DUST_VOLUME_PIECES_MAX);
        nB = cappedB ? DUST_VOLUME_PIECES_MAX : max(uint(ceil(lenB)), 1u);
        cvarB = cappedB ? DUST_VOLUME_PIECE_VAR_CAPPED : 1.0 / 12.0;
    }
    // at most DUST_VOLUME_PIECES_MAX pieces in all: fewer along seg_t first
    while (nA * nB > DUST_VOLUME_PIECES_MAX) {
        if (nB > 1u) { nB = (nB + 1u) / 2u; cvarB = DUST_VOLUME_PIECE_VAR_CAPPED; }
        else { nA = (nA + 1u) / 2u; cvarA = DUST_VOLUME_PIECE_VAR_CAPPED; }
    }
    // the level from the angular sigma
    float tr = S[0] + S[3] + S[5];
    float sigSmall = 2.0 * (L[0] * L[3] * L[5]) / tr;
    float den = max(dist, sigSmall);
    float theta = den > 0.0 ? sigSmall / den : 1.0;
    uint level = dust_volume_level(theta * fPx, levels);
    DustVolumePiece pieces[DUST_VOLUME_PIECES_MAX];
    dust_volume_pieces(p, exposure, axMean, axS, segA, nA, cvarA, segB, nB, cvarB, hasB, W, H, pieces);
    bool anyFull = false, anyOn = false;
    for (uint k = 0u; k < nA * nB; ++k) { anyFull = anyFull || pieces[k].full; anyOn = anyOn || pieces[k].on; }
    if (!anyOn) return;
    if (anyFull) level = min(max(level, DUST_VOLUME_MIN_LEVEL), levels - 1u);
    level = min(level + bias, levels - 1u);
    // the evaluation cap: a coarser level first, then fewer pieces (along seg_t first)
    for (;;) {
        if (dust_volume_evals(pieces, nA * nB, level) <= DUST_VOLUME_MAX_EVALS || level + 1u >= levels) break;
        level++;
    }
    while (dust_volume_evals(pieces, nA * nB, level) > DUST_VOLUME_MAX_EVALS) {
        if (nB > 1u) { nB = (nB + 1u) / 2u; cvarB = DUST_VOLUME_PIECE_VAR_CAPPED; }
        else if (nA > 1u) { nA = (nA + 1u) / 2u; cvarA = DUST_VOLUME_PIECE_VAR_CAPPED; }
        else break;
        dust_volume_pieces(p, exposure, axMean, axS, segA, nA, cvarA, segB, nB, cvarB, hasB, W, H, pieces);
    }
    uint n = nA * nB;
    // the in-frame gate (dust::volume_scatter): past DUST_FRAME_HARD_FACTOR budgets this frame,
    // at least dust_gate_level (the evaluations only shrink)
    uint before = atomicAdd(pc.pyramid.v[DUST_PYR_VOLUME_EVALS], dust_volume_evals(pieces, n, level));
    if (dust_frame_gates_on() && before > DUST_FRAME_HARD_FACTOR * DUST_VOLUME_FRAME_BUDGET) level = max(level, dust_gate_level(levels));
    uint off = pc.pyramid.v[DUST_PYR_TABLE + 3u * level];
    uint lw = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 1u];
    uint lh = pc.pyramid.v[DUST_PYR_TABLE + 3u * level + 2u];
    float sz = float(1u << level);
    float area = sz * sz;
    uint depthBits = floatBitsToUint(max(sqrt(dot(eye - p.mean, eye - p.mean)) / DUST_AU_M, 0.0));
    bool any_ = false;
    float carry = 0.0;
    float peak = 0.0;
    for (uint k = 0u; k < n; ++k) {
        ivec4 r = dust_volume_range(pieces[k], level, lw, lh);
        for (int ty = r.z; ty <= r.w; ++ty) {
            float yc = (float(ty) + 0.5) * sz;
            float ny = 2.0 * yc / H - 1.0;
            vec3 bRow = r1 - r3 * ny;
            for (int tx = r.x; tx <= r.y; ++tx) {
                float xc = (float(tx) + 0.5) * sz;
                float nx = 2.0 * xc / W - 1.0;
                vec3 aRow = r0 - r3 * nx;
                // the ray through the texel centre: on both planes of constant ndc, in front of the eye
                precise vec3 v = cross(aRow, bRow);
                if (dot(v, r3) < 0.0) v = -v;
                float vn = sqrt(dot(v, v));
                if (!(vn > 0.0)) continue;
                vec3 u = v * (1.0 / vn);
                vec3 uw = dust_cholesky_solve3(pieces[k].l, u);
                float a = dot(uw, uw);
                float b = dot(uw, pieces[k].qw);
                precise vec3 rr = pieces[k].qw - uw * (b / a);
                float sa = sqrt(a);
                float tauPx = pieces[k].k / sa * exp(-0.5 * dot(rr, rr))
                            * (0.5 * (1.0 + dust_erf(-b / (sa * 1.4142135623730951))));
                if (dust_phot_albedo > 0.0) {
                    vec3 x = eye + u * max(-b / a, 0.0);
                    tauPx *= dust_volume_weight(p.mean, x, u);
                }
                if (!(tauPx >= 0.0) || isinf(tauPx)) continue;
                peak = max(peak, tauPx);
                float tau = tauPx * area * pc.invUnit;
                float tauC = min(tau, DUST_COUNT_MAX_PER_ADD) + carry;
                uint counts = uint(tauC + 0.5);
                carry = tauC - float(counts);
                if (counts == 0u) continue;
                uint i = off + (uint(ty) * lw + uint(tx)) * DUST_PYRAMID_TEXEL_WORDS;
                dust_atomic_add_sat(pc.pyramid, i, counts);
                float hf = float(dust_hash32(i) >> 8u) * (1.0 / 16777216.0);
                uvec3 cw = uvec3(float(counts) * color * DUST_COLOR_SCALE + hf);
                dust_atomic_add_sat(pc.pyramid, i + 1u, cw.r);
                dust_atomic_add_sat(pc.pyramid, i + 2u, cw.g);
                dust_atomic_add_sat(pc.pyramid, i + 3u, cw.b);
                uint cur = pc.pyramid.v[i + 4u];
                if (cur == 0u || depthBits < cur) {
                    uint seen = atomicCompSwap(pc.pyramid.v[i + 4u], 0u, depthBits);
                    if (seen != 0u) atomicMin(pc.pyramid.v[i + 4u], depthBits);
                }
                any_ = true;
            }
        }
    }
    if (peak > 0.0) atomicMax(pc.pyramid.v[DUST_PYR_TAU_MAX], floatBitsToUint(peak));
    if (any_) atomicOr(pc.pyramid.v[DUST_PYR_LEVEL_MASK], 1u << level);
}

// Splits a packet for the perspective (dust_split_step: clipped at the eye plane, sliced by
// depth) and projects and scatters every leaf as it is found (dust::project_split_scatter): an
// explicit stack of DUST_SPLIT_DEPTH_MAX + 1 nodes, depth first, the same loop as the host
// mirror dust::split_packet_with. Every packet splits to the frame's depth limit depthMax (the
// host-written DUST_PYR_SPLIT_DEPTH word). The children made are counted in
// DUST_PYR_SPLIT_CHILDREN: the host lowers the next frame's depth when they pass
// DUST_SPLIT_BUDGET, and past DUST_FRAME_HARD_FACTOR budgets a thread stops splitting at once —
// the one run-time gate, so it depends on the dispatch order, only in frames the feedback has
// not caught up with (a cold start inside the coma made 5.5e7 children). A dropped packet's flux
// is atomicMax'ed into DUST_PYR_SPLIT_DROPPED_FLUX.
void dust_project_split_scatter(vec3 mean, float S[6], vec3 d, float flux, float exposure,
                                bool openStart, bool openEnd, vec2 rho, vec3 segT, vec3 color, uint levels,
                                float W, float H, vec3 fwd, bool perspective, uint depthMax, uint volumeBias,
                                float shellDMax, uint volumeAxis) {
    DustPacket stack[DUST_SPLIT_DEPTH_MAX + 1u];
    uint levelOf[DUST_SPLIT_DEPTH_MAX + 1u];
    bool clippedOf[DUST_SPLIT_DEPTH_MAX + 1u];
    stack[0].mean = mean; stack[0].S = S; stack[0].seg = d; stack[0].flux = flux;
    stack[0].openStart = openStart; stack[0].openEnd = openEnd; stack[0].rho = rho; stack[0].segT = segT;
    levelOf[0] = 0u; clippedOf[0] = false;
    uint n = 1u;
    // the in-frame gate (dust::split_packet_with): once a split of this thread finds the frame's
    // children past DUST_FRAME_HARD_FACTOR budgets, its packets split no further (depth 0)
    uint dMax = depthMax;
    while (n > 0u) {
        n--;
        DustPacket q = stack[n];
        uint level = levelOf[n];
        bool clipped = clippedOf[n];
        DustPacket a, b;
        int step = dust_split_step(q, clipped, level, dMax, pc.eyeLocal.xyz, fwd, perspective, false, a, b);
        bool leaf = false;
        if (step == DUST_SPLIT_DROP) {
            atomicMax(pc.pyramid.v[DUST_PYR_SPLIT_DROPPED_FLUX], floatBitsToUint(max(q.flux, 0.0)));
        } else if (step == DUST_SPLIT_KEEP || step == DUST_SPLIT_VOLUME) {
            // the speck shell's hand-over (dust::split_packet_with): wholly inside, the specks'
            // (not drawn); across the boundary, split once more while the depth allows, else
            // drawn with the fraction of its mass outside
            int cls = dust_shell_classify(q, pc.eyeLocal.xyz, shellDMax);
            bool draw = false;
            if (cls == DUST_SHELL_OUTSIDE) {
                draw = true;
            } else if (cls == DUST_SHELL_STRADDLES) {
                int forced = level < min(dMax, DUST_SPLIT_DEPTH_MAX)
                    ? dust_split_step(q, clipped, level, dMax, pc.eyeLocal.xyz, fwd, perspective, true, a, b)
                    : DUST_SPLIT_KEEP;
                if (forced == DUST_SPLIT_SPLIT) {
                    if (atomicAdd(pc.pyramid.v[DUST_PYR_SPLIT_CHILDREN], 2u) > DUST_FRAME_HARD_FACTOR * DUST_SPLIT_BUDGET && dust_frame_gates_on()) dMax = 0u;
                    stack[n] = b; levelOf[n] = level + 1u; clippedOf[n] = false;
                    stack[n + 1u] = a; levelOf[n + 1u] = level + 1u; clippedOf[n + 1u] = false;
                    n += 2u;
                } else {
                    q.flux *= dust_shell_outside_fraction(q, pc.eyeLocal.xyz, shellDMax);
                    draw = q.flux > 0.0;
                }
            }
            if (draw) {
                if (step == DUST_SPLIT_VOLUME) dust_volume_scatter(q, exposure, color, levels, W, H, volumeBias, volumeAxis);
                else leaf = true;
            }
        } else if (step == DUST_SPLIT_CLIP) {
            stack[n] = a; levelOf[n] = level; clippedOf[n] = true;
            n++;
        } else {
            if (atomicAdd(pc.pyramid.v[DUST_PYR_SPLIT_CHILDREN], 2u) > DUST_FRAME_HARD_FACTOR * DUST_SPLIT_BUDGET && dust_frame_gates_on()) dMax = 0u;
            stack[n] = b; levelOf[n] = level + 1u; clippedOf[n] = false;
            stack[n + 1u] = a; levelOf[n + 1u] = level + 1u; clippedOf[n + 1u] = false;
            n += 2u;
        }
        if (leaf) {
            DustScreenPacket SP;
            if (dust_project_packet(q.mean, q.S, q.seg, q.flux, exposure, pc.mvp, W, H, pc.eyeLocal.xyz, q.openStart, q.openEnd, q.rho, SP)) {
                scatter(SP, color, levels);
            }
        }
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.liveCount) return;
    DustMoments M = pc.moments.m[i];
    if (!(M.mean_flux.w > 0.0)) return;
    // diagnostics (AETHERVK_DUST_DEBUG_STREAM / _SAMPLE_MOD): draw one stream, or one time
    // sample in every m, of the tier; the value sits in flag bits 20..27
    if ((pc.flags & (DUST_VIEW_DEBUG_STREAM | DUST_VIEW_DEBUG_SAMPLE)) != 0u) {
        float yw = pc.render.c[i].age_id_dbeta_flux.y;
        uint slot = floatBitsToUint(yw) & DUST_RENDER_SLOT_MASK;
        uint shift = dust_render_shift(yw);
        uint v = (pc.flags >> 20u) & 0xFFu;
        if ((pc.flags & DUST_VIEW_DEBUG_STREAM) != 0u && (slot & ((1u << shift) - 1u)) != v) return;
        if ((pc.flags & DUST_VIEW_DEBUG_SAMPLE) != 0u && ((slot >> shift) % max(v, 1u)) != 0u) return;
    }
    uint levels = pc.pyramid.v[DUST_PYR_LEVELS];
    float W = float(pc.pyramid.v[DUST_PYR_WIDTH]);
    float H = float(pc.pyramid.v[DUST_PYR_HEIGHT]);
    float age = M.cov_b_age_id.z;
    // the segment to the stream predecessor (the dust emitted between the two samples), and its
    // width (older: wider) for the cone pieces
    int pred = dust_streak_pred(pc.render, i);
    DustMoments P = pred >= 0 ? pc.moments.m[pred] : M;
    vec3 seg = pred >= 0 ? P.mean_flux.xyz - M.mean_flux.xyz : vec3(0.0);
    float ratio = dust_width_ratio(M, pred >= 0, P);
    // the spiral of a rotating nucleus (dust::spiral_of): the pieces follow it, and there are
    // enough of them to draw it
    vec3 spAxis; float spOmega;
    bool spiral = pred >= 0 && dust_spiral_of(M, P, spAxis, spOmega);
    float ageO = M.cov_b_age_id.z, ageP = pred >= 0 ? P.cov_b_age_id.z : ageO;
    uint nT = spiral ? DUST_TIME_PIECES_MAX : dust_time_pieces(ratio);
    float invT = 1.0 / float(nT);
    float exposure = pc.exposure;
    if ((pc.flags & DUST_VIEW_FLOW) != 0u) {
        exposure *= dust_flow_factor(age, uintBitsToFloat(pc.pyramid.v[DUST_PYR_T_HI]),
                                     uintBitsToFloat(pc.pyramid.v[DUST_PYR_T_LO]));
    }
    // physical photometry: every texel of the packets gets p * Phi(alpha) / r_h^2 at the dust it
    // holds (dust_texel_weight); the cluster's Sun direction and r_h, the phase table
    dust_phot_albedo = pc.albedo;
    dust_pyr_split_word = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    dust_phot_sun = dust_sun_dir(M);
    dust_phot_rh = dust_helio_au(M);
    dust_phot_lut = pc.pyramid;
    vec3 stream = vec3(float(pc.color & 0xFFu), float((pc.color >> 8u) & 0xFFu), float((pc.color >> 16u) & 0xFFu)) / 255.0;
    vec3 color = dust_age_color(stream, age, pc.eyeLocal.w);
    // a polyline below a pixel is one pooled packet (dust_polyline_merged), uniform along the time
    // segment; otherwise every size bin is a capsule along its own chord, open towards its
    // neighbours, with the bin's time segment as a Gaussian (dust::subpackets_merged)
    bool predMerged = pred < 0 || dust_polyline_merged(P, pc.mvp, W, H);
    // (perspective: neither the polylines nor the time segment between them may be deep)
    bool merged = dust_polyline_merged(M, pc.mvp, W, H) && predMerged
               && (pred < 0 || dust_time_shallow(M, P, pc.mvp));
    // the view direction of the split and the eye-plane cut (dust_view_forward)
    bool perspective;
    vec3 fwd = dust_view_forward(pc.mvp, pc.eyeLocal.xyz, perspective);
    // bits 0-7: the split depth limit; bits 8-15: the volume level bias (host-written)
    uint splitWord = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    uint splitDepth = min(splitWord & 0xFFu, DUST_SPLIT_DEPTH_MAX);
    uint volumeBias = (splitWord >> 8u) & 0xFFu;
    // bits 16-17: the volumetric axis mode (AETHERVK_DUST_VOLUME_AXIS, host-written)
    uint volumeAxis = (splitWord >> 16u) & 0x3u;
    // the speck shell's radius (0: none; orthographic views and the specks off)
    float shellDMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
    float r0 = 1.0 / ratio;
    if (merged) {
        vec3 mean; float S[6]; float flux;
        dust_pooled_packet(M, mean, S, flux);
        float base[6];
        for (int k = 0; k < 6; ++k) base[k] = S[k];
        // the predecessor's width for the pieces: pooled with its midpoint scatter only when
        // it is a point on screen too, else the mean of its bins (dust::pooled_within_cov)
        if (nT > 1u) {
            if (predMerged) { vec3 mp; float fp; dust_pooled_packet(P, mp, base, fp); }
            else dust_pooled_within(P, base);
        }
        vec3 pm = mean + seg;
        for (uint t = 0u; t < nT; ++t) {
            float u0 = float(t) * invT;
            float sc = nT > 1u ? r0 + (1.0 - r0) * (u0 + 0.5 * invT) : 1.0;
            float sc2 = sc * sc;
            float St[6];
            for (int k = 0; k < 6; ++k) St[k] = base[k] * sc2;
            vec3 m0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0) : mean + seg * u0;
            vec3 s0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0 + invT) - m0 : seg * invT;
            dust_project_split_scatter(m0, St, s0, flux * invT, exposure, false, false, vec2(1.0), vec3(0.0), color, levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
        }
    } else {
        for (uint b = 0u; b < DUST_SIZE_BINS; ++b) {
            // the time segment of this bin: to the same bin of the predecessor
            vec3 segT = vec3(0.0);
            if (pred >= 0) segT = 0.5 * (P.edges[b].xyz + P.edges[b + 1u].xyz) - 0.5 * (M.edges[b].xyz + M.edges[b + 1u].xyz);
            bool openStart = b > 0u, openEnd = b + 1u < DUST_SIZE_BINS;
            // the longer of the bin's two axes is the exact capsule, the other a Gaussian
            // (dust::subpackets_merged)
            vec3 chordV = M.edges[b + 1u].xyz - M.edges[b].xyz;
            bool timeMajor = dot(segT, segT) > dot(chordV, chordV);
            if (timeMajor) {
                vec3 mean; float S[6]; float flux;
                dust_bin_packet(M, b, mean, S, flux);
                float base[6];
                for (int k = 0; k < 6; ++k) base[k] = S[k];
                if (nT > 1u) { vec3 mp; float fp; dust_bin_packet(P, b, mp, base, fp); }
                vec3 pm = mean + segT;
                for (uint t = 0u; t < nT; ++t) {
                    float u0 = float(t) * invT;
                    float sc = nT > 1u ? r0 + (1.0 - r0) * (u0 + 0.5 * invT) : 1.0;
                    float sc2 = sc * sc;
                    float St[6];
                    for (int k = 0; k < 6; ++k) St[k] = base[k] * sc2;
                    vec3 m0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0) : mean + segT * u0;
                    vec3 s0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0 + invT) - m0 : segT * invT;
                    // seg_t: the size chord of the bin packet the cone is built from, scaled with it
                    vec3 chordB = nT > 1u ? P.edges[b + 1u].xyz - P.edges[b].xyz : M.edges[b + 1u].xyz - M.edges[b].xyz;
                    vec3 segTB = ((0.5 * chordB) * 2.0) * sc;
                    dust_project_split_scatter(m0, St, s0, flux * invT, exposure, false, false, vec2(1.0), segTB, color, levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
                }
            } else if (nT == 1u) {
                // the time cell of the bin is the quadrilateral between its chord and the
                // predecessor's: swept when its edges are pixels apart (dust::time_sweep)
                uint nS = pred >= 0 ? dust_time_sweep(M, P, b, pc.mvp, W, H) : 1u;
                vec2 rho = dust_bin_density_ends(dust_edge_factor(M, b), dust_edge_factor(M, b + 1u));
                if (nS == 1u) {
                    vec3 mean, chord; float S[6]; float flux;
                    dust_bin_chord(M, b, segT, mean, chord, S, flux);
                    dust_project_split_scatter(mean, S, chord, flux, exposure, openStart, openEnd, rho, (0.5 * segT) * 2.0, color, levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
                } else {
                    for (uint k = 0u; k < nS; ++k) {
                        vec3 mean, chord; float S[6]; float flux;
                        dust_bin_sweep(M, P, b, k, nS, mean, chord, S, flux);
                        // seg_t: the sweep slab's Gaussianised width (dust::bin_sweep_packet)
                        vec3 da = P.edges[b].xyz - M.edges[b].xyz, dc = P.edges[b + 1u].xyz - M.edges[b + 1u].xyz;
                        vec3 dmax = dot(da, da) > dot(dc, dc) ? da : dc;
                        vec3 segTS = (dmax * (0.5 / float(nS))) * 2.0;
                        dust_project_split_scatter(mean, S, chord, flux, exposure, openStart, openEnd, rho, segTS, color, levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
                    }
                }
            } else {
                // the cone: nT pieces along the time segment with the predecessor's lateral
                // covariance scaled from the cluster's width to the predecessor's
                vec3 mean, chord; float S[6]; float flux;
                dust_bin_chord(M, b, vec3(0.0), mean, chord, S, flux);
                vec2 rho = dust_bin_density_ends(dust_edge_factor(M, b), dust_edge_factor(M, b + 1u));
                float f = 0.5 * (dust_edge_factor(M, b) + dust_edge_factor(M, b + 1u));
                float f2 = f * f;
                vec3 hs = 0.5 * invT * segT;
                float k = DUST_CHORD_VAR_FACTOR;
                vec3 mid = 0.5 * (M.edges[b].xyz + M.edges[b + 1u].xyz);
                vec3 midP = mid + segT;
                for (uint t = 0u; t < nT; ++t) {
                    float u0 = float(t) * invT;
                    float sc = r0 + (1.0 - r0) * (u0 + 0.5 * invT);
                    float sc2 = sc * sc * f2;
                    vec3 shift = spiral ? dust_spiral_point(mid, midP, ageO, ageP, spAxis, spOmega, u0) - mid : segT * u0;
                    float St[6];
                    St[0] = P.cov_a.x * sc2 + k * hs.x * hs.x;
                    St[1] = P.cov_a.y * sc2 + k * hs.x * hs.y;
                    St[2] = P.cov_a.z * sc2 + k * hs.x * hs.z;
                    St[3] = P.cov_a.w * sc2 + k * hs.y * hs.y;
                    St[4] = P.cov_b_age_id.x * sc2 + k * hs.y * hs.z;
                    St[5] = P.cov_b_age_id.y * sc2 + k * hs.z * hs.z;
                    dust_project_split_scatter(mean + shift, St, chord, flux * invT, exposure, openStart, openEnd, rho, hs * 2.0, color, levels, W, H, fwd, perspective, splitDepth, volumeBias, shellDMax, volumeAxis);
                }
            }
        }
    }
    if ((pc.flags & DUST_VIEW_TRACERS) != 0u && dust_is_tracer(floatBitsToUint(M.cov_b_age_id.w))) {
        // the tracer dot: a real particle at its exact position (dust::splat_tracer)
        uint counts = uint(max(uintBitsToFloat(pc.pyramid.v[DUST_PYR_TRACER_COUNTS]), 0.0) + 0.5);
        vec4 clip = pc.mvp * vec4(M.mean_flux.xyz, 1.0);
        if (counts > 0u && clip.w > 0.0) {
            vec2 mu = (clip.xy / clip.w * 0.5 + 0.5) * vec2(W, H);
            uint off = pc.pyramid.v[DUST_PYR_TABLE];
            uint w = pc.pyramid.v[DUST_PYR_TABLE + 1u];
            uint h = pc.pyramid.v[DUST_PYR_TABLE + 2u];
            float r = DUST_TRACER_PX;
            int x0 = int(max(floor(mu.x - r), 0.0)), x1 = min(int(ceil(mu.x + r)), int(w) - 1);
            int y0 = int(max(floor(mu.y - r), 0.0)), y1 = min(int(ceil(mu.y + r)), int(h) - 1);
            for (int ty = y0; ty <= y1; ++ty) {
                for (int tx = x0; tx <= x1; ++tx) {
                    vec2 dxy = vec2(tx, ty) + 0.5 - mu;
                    if (dot(dxy, dxy) > r * r) continue;
                    uint k = off + (uint(ty) * w + uint(tx)) * DUST_PYRAMID_TEXEL_WORDS;
                    dust_atomic_add_sat(pc.pyramid, k, counts);
                    for (uint c = 1u; c < 4u; ++c) dust_atomic_add_sat(pc.pyramid, k + c, counts * uint(DUST_COLOR_SCALE));
                }
            }
            atomicOr(pc.pyramid.v[DUST_PYR_LEVEL_MASK], 1u);
        }
    }
}
