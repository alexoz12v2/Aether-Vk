// @assets/sim/bp_reduce_toi.comp
#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_GOOGLE_include_directive : require

#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

// Sized safely based on minimum possible hardware subgroup size (4)
const uint MAX_SUBGROUPS_PER_WG = (LOCAL_SIZE_X + 3) / 4;

layout(push_constant, std430) uniform PushConstants {
    ParticleData particles;
    PackedCollisions collisions;
    OutputTOI out_toi;
    float particle_radius;
    float dt;
} pc;

// Shared memory for subgroup reduction (explicitly float)
shared float shared_min_toi_f[MAX_SUBGROUPS_PER_WG];

// Software Float Atomic Min Macro
// Handles the 0xFFFFFFFF initialization sentinel safely to prevent NaN propagation.
#define ATOMIC_MIN_FLOAT_SAFE(dest, val) \
    do { \
        uint old_val = (dest); \
        uint assumed_val; \
        uint spin_count = 0; \
        do { \
            assumed_val = old_val; \
            \
            /* 1. Catch the CPU's 0xFFFFFFFF clear sentinel immediately */ \
            if (assumed_val == 0xFFFFFFFFu) { \
                old_val = atomicCompSwap((dest), assumed_val, floatBitsToUint(val)); \
                continue; \
            } \
            \
            /* 2. Perform safe floating-point comparison */ \
            float current_min = uintBitsToFloat(assumed_val); \
            float new_min = min(current_min, (val)); \
            \
            /* 3. If our incoming value isn't smaller, bail out to save memory bandwidth */ \
            if (new_min >= current_min) break; \
            \
            /* 4. Attempt to write the new minimum */ \
            old_val = atomicCompSwap((dest), assumed_val, floatBitsToUint(new_min)); \
            \
            spin_count++; \
            if (spin_count > 1000) { \
                break; /* Prevent infinite TDR hangs in case of extreme contention */ \
            } \
        } while (assumed_val != old_val); \
    } while(false)

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint local_id = gl_LocalInvocationID.x;
    uint subgroup_id = gl_SubgroupID;

    float tc = pc.dt; // Default to max time

    if (global_id < pc.collisions.count) {
        tc = pc.collisions.pairs[global_id].toi;

#ifdef DEBUG_SHADERS
        // DIAGNOSTIC: Detect negative TOIs (Interpenetration)
        if (tc < 0.0) {
            debugPrintfEXT("[reduce_toi WARNING] Deep penetration! Pair %d has negative TOI: %1.5f\n", global_id, tc);
        }
#endif

        if (isnan(tc)) {
            tc = pc.dt;
        }
    }

    // Subgroup reduction (subgroupMin operates natively and correctly on floats)
    float subgroup_min_tc = subgroupMin(tc);

    if (gl_SubgroupInvocationID == 0) {
        shared_min_toi_f[subgroup_id] = subgroup_min_tc;
    }

    barrier();

    // Workgroup reduction
    if (local_id == 0) {
        // Use the native Vulkan builtin for actual subgroup count
        uint num_subgroups = gl_NumSubgroups;

        float wg_min_f = shared_min_toi_f[0];
        for (uint i = 1; i < num_subgroups; i++) {
            wg_min_f = min(wg_min_f, shared_min_toi_f[i]);
        }

#ifdef DEBUG_SHADERS
        // DIAGNOSTIC: Print if this workgroup found a collision earlier than dt
        if (wg_min_f < pc.dt) {
            debugPrintfEXT("[reduce_toi] WG %d proposes new minimum TOI: %1.5f\n", gl_WorkGroupID.x, wg_min_f);
        }
#endif

        // Global reduction via macro
        ATOMIC_MIN_FLOAT_SAFE(pc.out_toi.min_tc_uint, wg_min_f);
    }
}
