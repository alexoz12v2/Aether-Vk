// @assets/sim/rb_force_assign.comp
//
// Rigid Body Force Aggregation — Leaf Wrenches → CoM Wrench
// ──────────────────────────────────────────────────────────
// Each workgroup processes exactly ONE rigid body.  Threads stride across
// all leaf/primitive wrench entries [leaf_start_idx .. leaf_start_idx + leaf_count)
// and accumulate them into the body's Centre-of-Mass Wrench at wrenches[wrench_idx].
//
// Reduction strategy (subgroup-size agnostic):
//   1. Each thread accumulates its stripe of leaf wrenches into local vec3 registers.
//   2. subgroupAdd collapses each subgroup to a single value.
//   3. Subgroup lane 0 stores its result into shared memory sh_f / sh_t.
//   4. Thread 0 does a final linear summation over all subgroups and fires a
//      single atomicAdd to the CoM wrench.
//
// This avoids atomic floats on shared memory (which need a separate HW feature
// bit) and keeps shared memory usage minimal — friendly to low-end hardware.
//
// Target: SPIR-V 1.4 · Vulkan 1.1 · flexible across all hardware subgroup sizes.

#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 32
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    RigidBodyArray rigid_bodies;
    WrenchArray wrenches;
    uint n_bodies;
    uint _pad;
} pc;

shared float sh_f_x[256];
shared float sh_f_y[256];
shared float sh_f_z[256];
shared float sh_t_x[256];
shared float sh_t_y[256];
shared float sh_t_z[256];

void main() {
    uint body_id = gl_WorkGroupID.x;
    if (body_id >= pc.n_bodies) return;

    uint local_id = gl_LocalInvocationID.x;
    uint sg_lane  = gl_SubgroupInvocationID;

    RigidBody body = pc.rigid_bodies.bodies[body_id];
    uint leaf_start = body.leaf_start_idx, leaf_count = body.leaf_count, com_wrench = body.wrench_idx;

    vec3 acc_f = vec3(0.0);
    vec3 acc_t = vec3(0.0);
    for (uint i = local_id; i < leaf_count; i += gl_WorkGroupSize.x) {
        uint leaf_idx = leaf_start + i;
        Wrench w = pc.wrenches.wrenches[leaf_idx];
        acc_f += vec3(uintBitsToFloat(w.force_x), uintBitsToFloat(w.force_y), uintBitsToFloat(w.force_z));
        acc_t += vec3(uintBitsToFloat(w.torque_x), uintBitsToFloat(w.torque_y), uintBitsToFloat(w.torque_z));
        // Clear the leaf wrench after reading — prevents force accumulation
        // across frames (collision/gravity forces are re-written each frame).
        pc.wrenches.wrenches[leaf_idx].force_x  = 0u;
        pc.wrenches.wrenches[leaf_idx].force_y  = 0u;
        pc.wrenches.wrenches[leaf_idx].force_z  = 0u;
        pc.wrenches.wrenches[leaf_idx].torque_x = 0u;
        pc.wrenches.wrenches[leaf_idx].torque_y = 0u;
        pc.wrenches.wrenches[leaf_idx].torque_z = 0u;
    }

    sh_f_x[local_id] = acc_f.x;
    sh_f_y[local_id] = acc_f.y;
    sh_f_z[local_id] = acc_f.z;
    sh_t_x[local_id] = acc_t.x;
    sh_t_y[local_id] = acc_t.y;
    sh_t_z[local_id] = acc_t.z;
    barrier();

    if (local_id == 0) {
        acc_f = vec3(0.0);
        acc_t = vec3(0.0);
        for (uint i = 0; i < gl_WorkGroupSize.x; ++i) {
            acc_f += vec3(sh_f_x[i], sh_f_y[i], sh_f_z[i]);
            acc_t += vec3(sh_t_x[i], sh_t_y[i], sh_t_z[i]);
        }

        Wrench dest = pc.wrenches.wrenches[com_wrench];
        
        vec3 final_f = vec3(uintBitsToFloat(dest.force_x), uintBitsToFloat(dest.force_y), uintBitsToFloat(dest.force_z)) + acc_f;
        vec3 final_t = vec3(uintBitsToFloat(dest.torque_x), uintBitsToFloat(dest.torque_y), uintBitsToFloat(dest.torque_z)) + acc_t;
        
        pc.wrenches.wrenches[com_wrench].force_x  = floatBitsToUint(final_f.x);
        pc.wrenches.wrenches[com_wrench].force_y  = floatBitsToUint(final_f.y);
        pc.wrenches.wrenches[com_wrench].force_z  = floatBitsToUint(final_f.z);
        pc.wrenches.wrenches[com_wrench].torque_x = floatBitsToUint(final_t.x);
        pc.wrenches.wrenches[com_wrench].torque_y = floatBitsToUint(final_t.y);
        pc.wrenches.wrenches[com_wrench].torque_z = floatBitsToUint(final_t.z);
    }
}
