#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
// GL_EXT_control_flow_attributes: enables [[unroll]] / [[dont_unroll]] decorators.
// Used below to force the particle-accumulation loop to unroll, eliminating the
// AVX2-vectorized loop path in Lavapipe's JIT that leaves the buffer descriptor
// register (r8) uninitialised in its scalar fallback (observed: r8=0, hang).
#extension GL_EXT_control_flow_attributes : require

#extension GL_GOOGLE_include_directive : require

#ifdef DEBUG_SHADERS
  #extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;

// ── Watchdog output buffer ────────────────────────────────────────────────────
// Bit 2 (0x4) = lbvh_build_bottomup.comp
layout(buffer_reference, std430, buffer_reference_align = 4) buffer WatchdogBuffer {
    uint flags;
};
#define WATCHDOG_BIT_BOTTOMUP 0x4u

layout(push_constant, std430) uniform PushConstants {
    MultiBvhBuffer bvh;
    MortonArray sorted_morton;
    AtomicCounters counters;
    ParticleData particles;
    uint num_primitives;
    float particle_radius;
    WatchdogBuffer watchdog_out;
    float dt;
    uint _pad;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = (pc.num_primitives + PARTICLES_IN_LEAF - 1) / PARTICLES_IN_LEAF;
    if (idx >= n) return;
    
    uint leaf_node = n - 1 + idx;
    
    // The leaf index is `idx`. The particles for this leaf start at `idx * PARTICLES_IN_LEAF`.
    uint start_p = idx * PARTICLES_IN_LEAF;
    uint end_p = min(start_p + PARTICLES_IN_LEAF, pc.num_primitives);
    
    vec3 min_b = vec3(1e38);
    vec3 max_b = vec3(-1e38);
    
    float child_mass = 0.0;
    vec3 child_com = vec3(0.0);
    float r = pc.particle_radius;
    
    // [[unroll]]: force glslc to fully unroll this loop (with per-iteration
    // guards).  Lavapipe's JIT otherwise generates a scalar fallback alongside
    // an AVX2 vectorized path; the scalar fallback expects the buffer descriptor
    // register (r8) to be pre-loaded by the AVX2 path, but with only 1 active
    // SIMD lane (n_leaves=1) the AVX2 path never runs → r8=0 → null-deref →
    // fence never signalled → 60 s hang.  Unrolling eliminates the loop
    // structure entirely, so each access gets its own inline descriptor load.
    [[unroll]] for (uint i = start_p; i < end_p; ++i) {
        // sorted_morton is always a valid non-null BDA (guaranteed by caller).
        uint particle_idx = pc.sorted_morton.entries[i].y;
        
        uint base = P_BASE(particle_idx);
        float p_mass = uintBitsToFloat(pc.particles.data[base + 6*SUBGROUP_SIZE]);
        vec3 p_pos = vec3(
            uintBitsToFloat(pc.particles.data[base + 0*SUBGROUP_SIZE]),
            uintBitsToFloat(pc.particles.data[base + 1*SUBGROUP_SIZE]),
            uintBitsToFloat(pc.particles.data[base + 2*SUBGROUP_SIZE])
        );
        
        min_b = min(min_b, p_pos - vec3(r));
        max_b = max(max_b, p_pos + vec3(r));
        
        child_mass += p_mass;
        child_com += p_pos * p_mass;
    }
    
    if (child_mass > 1e-6) {
        child_com /= child_mass;
    } else {
        child_com = vec3(0.0);
    }
    
    uint current = leaf_node;
    uint child_particle_start = start_p;
    uint child_particle_count = end_p - start_p;

    // Maximum traversal depth: a balanced binary tree over n leaves has height ceil(log2(n)).
    // We allow 2*n as a safe upper bound that catches cycles in corrupted trees.
    uint watchdog = 0;
    uint max_steps = n * 2 + 2;
    
    // ── Single-leaf special case (n == 1) ────────────────────────────────────
    // When there is exactly one leaf, leaf_node==0 IS the root.  The while
    // loop below starts with current==0 and exits immediately, so the computed
    // cluster data is never written anywhere.  Phase A would then see
    // valid_mask==0 for node 0 and skip it, producing zero external force.
    // Fix: bootstrap by writing the cluster into node 0 slot 0 directly.
    if (leaf_node == 0u) {
        tlas_write_mass      (pc.bvh, 0u, 0u, child_mass);
        tlas_write_com_x     (pc.bvh, 0u, 0u, child_com.x);
        tlas_write_com_y     (pc.bvh, 0u, 0u, child_com.y);
        tlas_write_com_z     (pc.bvh, 0u, 0u, child_com.z);
        tlas_write_pstart    (pc.bvh, 0u, 0u, child_particle_start);
        tlas_write_pcount    (pc.bvh, 0u, 0u, child_particle_count);
        tlas_write_min_x     (pc.bvh, 0u, 0u, min_b.x);
        tlas_write_min_y     (pc.bvh, 0u, 0u, min_b.y);
        tlas_write_min_z     (pc.bvh, 0u, 0u, min_b.z);
        tlas_write_max_x     (pc.bvh, 0u, 0u, max_b.x);
        tlas_write_max_y     (pc.bvh, 0u, 0u, max_b.y);
        tlas_write_max_z     (pc.bvh, 0u, 0u, max_b.z);
        tlas_write_valid_mask(pc.bvh, 0u, uvec2(1u, 0u));  // lane 0 is the only valid cluster
        // The while loop immediately exits (current==0), so we are done.
    }

    while (current != 0) {
        // ── Cycle / runaway detection ─────────────────────────────────────────
        // NOTE: break MUST be outside #ifdef so it fires even without DEBUG_SHADERS.
        if (++watchdog > max_steps) {
#ifdef DEBUG_SHADERS
            debugPrintfEXT("WATCHDOG! bottomup cycle detected. leaf=%u, current=%u, steps=%u\n",
                           leaf_node, current, watchdog);
#endif
            uvec2 wd_uvec = uvec2(pc.watchdog_out);
            if (wd_uvec.x != 0u || wd_uvec.y != 0u) {
                atomicOr(pc.watchdog_out.flags, WATCHDOG_BIT_BOTTOMUP);
            }
            break;
        }

        uint parent = tlas_parent(pc.bvh, current);

        // ── Corrupt parent pointer guard ──────────────────────────────────────
        // If lbvh_build.comp skipped this node, its parent stays 0xFFFFFFFFu (prepass init).
        // Accessing counters.counts[0xFFFFFFFF] is an instant out-of-bounds write → GPU death.
        // NOTE: break MUST be outside #ifdef.
        if (parent == 0xFFFFFFFFu || parent >= n) {
#ifdef DEBUG_SHADERS
            debugPrintfEXT("PAGE FAULT PREVENTED! corrupt parent at node %u (parent=0x%x, n=%u)\n",
                           current, parent, n);
#endif
            uvec2 wd_uvec = uvec2(pc.watchdog_out);
            if (wd_uvec.x != 0u || wd_uvec.y != 0u) {
                atomicOr(pc.watchdog_out.flags, WATCHDOG_BIT_BOTTOMUP);
            }
            break;
        }

        uint dir = (tlas_child(pc.bvh, parent, 1u) == current) ? 1u : 0u;

        tlas_write_min_x(pc.bvh, parent, dir, min_b.x);
        tlas_write_min_y(pc.bvh, parent, dir, min_b.y);
        tlas_write_min_z(pc.bvh, parent, dir, min_b.z);
        tlas_write_max_x(pc.bvh, parent, dir, max_b.x);
        tlas_write_max_y(pc.bvh, parent, dir, max_b.y);
        tlas_write_max_z(pc.bvh, parent, dir, max_b.z);

        tlas_write_mass (pc.bvh, parent, dir, child_mass);
        tlas_write_com_x(pc.bvh, parent, dir, child_com.x);
        tlas_write_com_y(pc.bvh, parent, dir, child_com.y);
        tlas_write_com_z(pc.bvh, parent, dir, child_com.z);

        tlas_write_pstart(pc.bvh, parent, dir, child_particle_start);
        tlas_write_pcount(pc.bvh, parent, dir, child_particle_count);
        
        memoryBarrierBuffer();
        
        uint old_val = atomicAdd(pc.counters.counts[parent], 1);
        if (old_val == 0) break;
        
        memoryBarrierBuffer();
        
        vec3 c0_min = vec3(tlas_min_x(pc.bvh, parent, 0u), tlas_min_y(pc.bvh, parent, 0u), tlas_min_z(pc.bvh, parent, 0u));
        vec3 c1_min = vec3(tlas_min_x(pc.bvh, parent, 1u), tlas_min_y(pc.bvh, parent, 1u), tlas_min_z(pc.bvh, parent, 1u));
        vec3 c0_max = vec3(tlas_max_x(pc.bvh, parent, 0u), tlas_max_y(pc.bvh, parent, 0u), tlas_max_z(pc.bvh, parent, 0u));
        vec3 c1_max = vec3(tlas_max_x(pc.bvh, parent, 1u), tlas_max_y(pc.bvh, parent, 1u), tlas_max_z(pc.bvh, parent, 1u));

        min_b = min(c0_min, c1_min);
        max_b = max(c0_max, c1_max);

        float m0 = tlas_mass(pc.bvh, parent, 0u);
        float m1 = tlas_mass(pc.bvh, parent, 1u);
        child_mass = m0 + m1;

        vec3 com0 = vec3(tlas_com_x(pc.bvh, parent, 0u), tlas_com_y(pc.bvh, parent, 0u), tlas_com_z(pc.bvh, parent, 0u));
        vec3 com1 = vec3(tlas_com_x(pc.bvh, parent, 1u), tlas_com_y(pc.bvh, parent, 1u), tlas_com_z(pc.bvh, parent, 1u));

        if (child_mass > 1e-6) {
            child_com = (com0 * m0 + com1 * m1) / child_mass;
        } else {
            child_com = vec3(0.0);
        }

        uint s0 = tlas_pstart(pc.bvh, parent, 0u);
        uint s1 = tlas_pstart(pc.bvh, parent, 1u);
        uint c0 = tlas_pcount(pc.bvh, parent, 0u);
        uint c1 = tlas_pcount(pc.bvh, parent, 1u);
        
        child_particle_start = min(s0, s1);
        child_particle_count = c0 + c1;
        
        current = parent;
    }
}
