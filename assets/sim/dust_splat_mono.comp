// @assets/sim/dust_splat_mono.comp
//
// The monolithic enumerator (a device knob): the single-dispatch dust_splat.comp kept as it
// was, one dispatch at DUST_SPLAT_LANES lanes per cluster, for the devices whose default is not
// the stage chain (Device::dust_splat_staged; AETHERVK_DUST_SPLAT_STAGED). The byte-identical
// reference of the old blob: expression for expression the old monolith; the only adaptation is
// dust_haze_probe_mono below (the old include's dust_haze_probe body, verbatim: the include
// split it into dust_haze_probe_bin / _packet_at for the stages).
//
// Dust v4 render: one thread per live cluster of one age tier, after dust_propagate.comp, before
// the compositing pass. Mirror of `dust::splat_tier`.
//
// The cluster's second moments (DustMoments) hold its size polyline: DUST_SIZE_BINS packets of
// equal cross-section along the syndyne (dust_bin_packet), each cut into <= DUST_TIME_PIECES_MAX
// pieces along the segment when the predecessor is wider (dust_time_pieces: the capsule is a
// cone), each projected with the Jacobian of the mvp at its mean (dust_project_packet: EWA / 3DGS
// covariance projection plus the pixel low-pass filter) and scattered as an analytic capsule
// (uniform along the segment to the stream predecessor r - S, Gaussian across; dust_capsule_tau)
// into the view's fixed-point
// pyramid: the level where its smallest sigma is >= DUST_SPLAT_SIGMA_TEXELS texels, counts
// round(tau * texel area / unit) into (tau, tau*rgb) by saturating adds, the nearest depth by
// atomicMin. Nothing is sampled per view: the sum over the pyramid is exposure * flux / pixel area
// for every packet (surface brightness = optical depth), whatever the zoom, distance or budget.
// The colour is the stream colour's hue rotated by the age (dust_age_color); the flow marks
// modulate the packet's amplitude by its mean age; tracers stamp a dot at the exact position.
#version 450 core
#extension GL_GOOGLE_include_directive : require
// the profiler variant (dust_profile.glsl, -DDUST_PROFILE=1): the subgroup clock and sums
#ifdef DUST_PROFILE
#extension GL_ARB_shader_clock : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#include "dust_common.glsl"
#include "dust_scatter.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// the haze probe as the old dust_common.glsl had it, word for word
bool dust_haze_probe_mono(uint mi, vec3 seg, float ratio, uint nT, vec3 eye, vec3 fwd, bool perspective, uint depthMax, uint k) {
    uint nj0 = dust_bin_subbins(0u);
    if (k >= 2u * (nj0 + DUST_SIZE_BINS - 1u)) return true;
    uint s = k >> 1u;
    uint b = s < nj0 ? 0u : s - nj0 + 1u;
    uint j = s < nj0 ? s : 0u;
    uint nj = s < nj0 ? nj0 : 1u;
    bool last = (k & 1u) != 0u;
    float uFirst = dust_piece_bound(1u, nT, ratio);
    float uLast = dust_piece_bound(nT - 1u, nT, ratio);
    float u = last ? uLast : 0.0, du = last ? 1.0 - uLast : uFirst;
    DustPacket p;
    p.openStart = false;
    p.openEnd = false;
    p.rho = vec2(1.0);
    p.segT = vec3(0.0);
    vec3 a, c; float fa, fc;
    dust_sub_edges(mi, b, j, nj, a, c, fa, fc);
    bool timeMajor = dot(seg, seg) > dot(c - a, c - a);
    if (timeMajor) {
        dust_bin_packet_sub(mi, b, j, nj, p.mean, p.S, p.flux);
        p.seg = seg * du;
    } else {
        vec3 chord;
        dust_bin_chord_sub(mi, b, j, nj, seg * du, p.mean, chord, p.S, p.flux);
        p.seg = chord;
    }
    p.mean += seg * u;
    int kind = dust_split_kind(p, depthMax, eye, fwd, perspective);
    return kind == DUST_SPLIT_VOLUME || kind == DUST_SPLIT_DROP;
}

// f32 bits: the speck shell's radius (host-written; dust::specks::PYR_SPECKS_DMAX). Defined here,
// not in dust_common.glsl, because dust_specks.comp defines the same constant and includes it
const uint DUST_PYR_SPECKS_DMAX = 252u;

layout(push_constant, std430) uniform PushConstants {
    DustMomentsBuffer moments;  // 0
    DustRenderBuffer  render;   // 8: predecessor validity words
    DustUintBuffer    pyramid;  // 16: header + levels
    uint  liveCount;            // 24
    uint  flags;                // 28: DUST_VIEW_*
    float exposure;             // 32: the stream colour's alpha (1 = photometric)
    float invUnit;              // 36: counts per (tau * px^2)
    uint  color;                // 40: stream colour r | g << 8 | b << 16
    float albedo;               // 44: geometric albedo (the radiance weight), <= 0 = unweighted
    mat4  mvp;                  // 48: particle-system local metres -> clip
    vec4  eyeLocal;             // 112: eye in local metres; w = the system's TTL (s), the hue clock
} pc;                           // 128 bytes

// the volumetric packet draw and its in-frame gate helpers (shared with dust_draw_volume.comp)
// the records this lane emits (dust_splat_subpacket; counted first, then written at the
// cluster's base in sub-packet order: main)
bool dust_emitting = false;
uint dust_rec_count = 0u;
uint dust_rec_at = 0u;
uint dust_rec_cluster = 0u;
// the tier's live range in ring slots (the volume queue header: DUST_VQUEUE_FIRST_SLOT; main)
uint dust_first_slot = 0u;
// the record's bin is walked for specks (dust_specks_mask): its shell mass is the specks'
bool dust_rec_walked = false;
// the cluster is haze (dust_haze_volumetric, judged once per cluster by main's pre-pass; false
// with the knob off)
bool dust_haze_cluster = false;
#define DUST_SQUEUE_EMIT(mean_, S_, d_, flux_, exposure_, openStart_, openEnd_, rho_, segT_, color_) { \
    if (dust_emitting) { \
        DUST_SQUEUE_PUT(pc.pyramid, dust_squeue_records(dust_squeue_base(pc.pyramid)), dust_rec_at + dust_rec_count, \
                        mean_, S_, d_, flux_, exposure_, openStart_, openEnd_, rho_, segT_, color_, \
                        dust_phot_support, dust_phot_has_origin, dust_phot_origin, dust_phot_sun, dust_phot_rh, dust_rec_cluster, dust_rec_walked) \
    } \
    dust_rec_count++; \
}

// The per-cluster prelude every lane recomputes (identical values): the stream predecessor and
// the segment to it, the width ratio, the spiral, the time pieces under the level of detail
// (dust_time_pieces_lod: capped by the time segment on screen, no fewer than its depth span
// needs), the view direction and the polyline's depth rule inputs
struct DustClusterPieces {
    int pred;
    uint pi;
    vec3 seg;
    float ratio;
    bool spiral;
    vec3 spAxis;
    float spOmega;
    uint nT;
    bool perspective;
    vec3 fwd;
    bool lodDepth;
    float lodBinDepth;
    float lodNear;
    uint depthMin;
};
void dust_cluster_pieces(uint mi, out DustClusterPieces c) {
    float W = float(pc.pyramid.v[DUST_PYR_WIDTH]);
    float H = float(pc.pyramid.v[DUST_PYR_HEIGHT]);
    // the segment to the stream predecessor (the dust emitted between the two samples), and its
    // width (older: wider) for the cone pieces
    c.pred = dust_streak_pred(pc.render, mi, dust_first_slot, pc.liveCount);
    c.pi = c.pred >= 0 ? uint(c.pred) : mi;
    c.seg = c.pred >= 0 ? dust_mom.m[c.pi].mean_flux.xyz - dust_mom.m[mi].mean_flux.xyz : vec3(0.0);
    c.ratio = dust_width_ratio(mi, c.pred >= 0, c.pi);
    // the spiral of a rotating nucleus (dust::spiral_of): the pieces follow it, and there are
    // enough of them to draw it
    c.spAxis = vec3(0.0);
    c.spOmega = 0.0;
    c.spiral = c.pred >= 0 && dust_spiral_of(mi, c.pi, c.spAxis, c.spOmega);
    c.nT = c.spiral ? DUST_TIME_PIECES_MAX : dust_time_pieces(c.ratio);
    // the view direction of the split and the eye-plane cut (dust_view_forward)
    c.fwd = dust_view_forward(pc.mvp, pc.eyeLocal.xyz, c.perspective);
    // the cluster level of detail (dust_lod_*, DUST_PYR_LOD; dust::subpackets_cells): the time
    // pieces capped by the time segment on screen and no fewer than its depth span needs
    // (dust_time_pieces_depth); the chord groups in the non-merged branch of
    // dust_splat_subpacket; the sweeps step by the knob (dust_time_sweep). Perspective views only
    // for the depth rule.
    dust_lod_px = dust_lod_px_of(pc.pyramid);
    dust_group = 1u;
    c.lodBinDepth = 0.0;
    c.lodNear = 0.0;
    c.lodDepth = c.perspective && dust_polyline_depth(mi, pc.eyeLocal.xyz, c.fwd, c.lodBinDepth, c.lodNear);
    float lodSpan = c.pred >= 0 ? dot(dust_mom.m[c.pi].mean_flux.xyz - dust_mom.m[mi].mean_flux.xyz, c.fwd) : 0.0;
    c.depthMin = dust_time_pieces_depth(c.pred >= 0 && c.perspective, lodSpan, c.lodDepth, c.lodNear);
    float tPx = 0.0;
    bool hasT = c.pred >= 0 && dust_time_segment_px(mi, c.pi, pc.mvp, W, H, tPx);
    c.nT = dust_time_pieces_lod(c.nT, hasT, tPx, dust_lod_px, c.depthMin);
}

// Sub-packet `sub` of the cluster in ring slot `i` (a warp per cluster, a lane per sub-packet: the slow end bin's
// sub-bins, then a bin each, in the order the per-cluster loop ran them; a merged polyline's time
// pieces one per lane): its packets (one per dust_project_split_scatter call of the per-cluster
// thread) as records of the sub-packet queue, in that order, for dust_split.comp. Run twice by
// main: counting the records, then emitting them at the lane's prefix. The per-cluster setup is
// recomputed by every lane (identical values).
void dust_splat_subpacket(uint i, uint sub) {
    uint mi = i;
    DUST_PROF_BEGIN(setup)
    uint levels = pc.pyramid.v[DUST_PYR_LEVELS];
    float W = float(pc.pyramid.v[DUST_PYR_WIDTH]);
    float H = float(pc.pyramid.v[DUST_PYR_HEIGHT]);
    float age = dust_mom.m[mi].cov_b_age_id.z;
    // the segment to the stream predecessor (the dust emitted between the two samples), and its
    // width (older: wider) for the cone pieces
    DustClusterPieces cp;
    dust_cluster_pieces(mi, cp);
    int pred = cp.pred;
    uint pi = cp.pi;
    vec3 seg = cp.seg;
    float ratio = cp.ratio;
    vec3 spAxis = cp.spAxis; float spOmega = cp.spOmega;
    bool spiral = cp.spiral;
    float ageO = dust_mom.m[mi].cov_b_age_id.z, ageP = pred >= 0 ? dust_mom.m[pi].cov_b_age_id.z : ageO;
    uint nT = cp.nT;
    bool perspective = cp.perspective;
    vec3 fwd = cp.fwd;
    float lodBinDepth = cp.lodBinDepth, lodNear = cp.lodNear;
    bool lodDepth = cp.lodDepth;
    uint depthMin = cp.depthMin;
    // the haze detail (dust_haze_*): at the top level, fewer
    // sub-packets for a haze cluster (dust_haze_volumetric, judged once per cluster by main's
    // pre-pass: dust_haze_cluster); the default pays nothing
    uint hazeDetail = dust_haze_detail_of(pc.flags, levels, pc.pyramid);
    if (!dust_haze_cluster) hazeDetail = DUST_SIZE_BINS;
    nT = dust_haze_time_pieces(nT, hazeDetail, depthMin);
    float exposure = pc.exposure;
    if ((pc.flags & DUST_VIEW_FLOW) != 0u) {
        exposure *= dust_flow_factor(age, uintBitsToFloat(pc.pyramid.v[DUST_PYR_T_HI]),
                                     uintBitsToFloat(pc.pyramid.v[DUST_PYR_T_LO]));
    }
    // physical photometry: every texel of the packets gets p * Phi(alpha) / r_h^2 at the dust it
    // holds (dust_texel_weight); the cluster's Sun direction and r_h, the phase table
    dust_phot_albedo = pc.albedo;
    dust_pyr_split_word = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    dust_rec_cluster = i;
    dust_phot_sun = dust_sun_dir(mi);
    dust_phot_rh = dust_helio_au(mi);
    dust_phot_lut_addr = uvec2(pc.pyramid);
    vec3 stream = vec3(float(pc.color & 0xFFu), float((pc.color >> 8u) & 0xFFu), float((pc.color >> 16u) & 0xFFu)) / 255.0;
    vec3 color = dust_age_color(stream, age, pc.eyeLocal.w);
    // a polyline below a pixel is one pooled packet (dust_polyline_merged), uniform along the time
    // segment; otherwise every size bin is a capsule along its own chord, open towards its
    // neighbours, with the bin's time segment as a Gaussian (dust::subpackets_merged)
    bool predMerged = pred < 0 || dust_polyline_merged(pi, pc.mvp, W, H);
    // (perspective: neither the polylines nor the time segment between them may be deep)
    // (and never pooled when the speck pass walks some of its bins: the hand-over is per bin)
    bool merged = dust_polyline_merged(mi, pc.mvp, W, H) && predMerged
               && (pred < 0 || dust_time_shallow(mi, pi, pc.mvp))
               && dust_specks_mask(mi) == 0u;
    // haze detail 1: the cluster is its pooled packet, the one
    // dust_haze_volumetric judged, whole to the exact ray integral (never a walked cluster)
    if (hazeDetail == 1u && dust_specks_mask(mi) == 0u) merged = true;
    dust_rec_walked = false;
    // bits 0-7: the split depth limit; bits 8-15: the volume level bias (host-written)
    uint splitWord = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    uint splitDepth = min(splitWord & 0xFFu, DUST_SPLIT_DEPTH_MAX);
    uint volumeBias = (splitWord >> 8u) & 0xFFu;
    // bits 16-17: the volumetric axis mode (AETHERVK_DUST_VOLUME_AXIS, host-written)
    uint volumeAxis = (splitWord >> 16u) & 0x3u;
    // bit 28 (diagnostics, AETHERVK_DUST_TIME_CELL=1, dust::time_cell_offset): a chord-major leaf's
    // time Gaussian centred on its cell (half a segment towards the predecessor), not on its chord
    bool cellOff = ((splitWord >> 28u) & 1u) != 0u;
    // the speck shell's radius (0: none; orthographic views and the specks off)
    float shellDMax = uintBitsToFloat(pc.pyramid.v[DUST_PYR_SPECKS_DMAX]);
    float r0 = 1.0 / ratio;
    // the support planes (dust::subpackets_supported): the sample's own for its bins, a cone
    // piece's from the cell line at its centre age (the two lines interpolated along the spiral,
    // the predecessor's direction turned like its covariance)
    vec3 oM, cM, oP, cP;
    bool lineM = dust_cell_line(mi, oM, cM);
    bool lineP = pred >= 0 && dust_cell_line(pi, oP, cP);
    float vStd = 0.0;
    if (lineM && dot(cM, cM) > 0.0) {
        float Sv[6];
        Sv[0] = dust_mom.m[mi].cov_a.x; Sv[1] = dust_mom.m[mi].cov_a.y; Sv[2] = dust_mom.m[mi].cov_a.z;
        Sv[3] = dust_mom.m[mi].cov_a.w; Sv[4] = dust_mom.m[mi].cov_b_age_id.x; Sv[5] = dust_mom.m[mi].cov_b_age_id.y;
        vStd = sqrt(max(dust_var_along(Sv, cM * (1.0 / sqrt(dot(cM, cM)))), 0.0) / dot(cM, cM));
    }
    float fLo = dust_edge_factor(mi, 0u);
    vec4 ownSup = lineM ? dust_support_plane(oM, cM, vStd, fLo) : vec4(0.0);
    // the own cell's origin along its plane's normal (dust::subpackets_cells)
    bool ownHas = lineM && dust_has_support(ownSup);
    float ownO = dot(ownSup.xyz, oM);
    DUST_PROF_END(setup)
    DUST_PROF_BEGIN(subpk)
    if (merged) {
        vec3 mean; float S[6]; float flux;
        dust_pooled_packet(mi, mean, S, flux);
        float base[6];
        for (int k = 0; k < 6; ++k) base[k] = S[k];
        // the predecessor's width for the pieces: pooled with its midpoint scatter only when
        // it is a point on screen too, else the mean of its bins (dust::pooled_within_cov)
        if (nT > 1u) {
            if (predMerged) { vec3 mp; float fp; dust_pooled_packet(pi, mp, base, fp); }
            else dust_pooled_within(pi, base);
        }
        vec3 pm = mean + seg;
        // this lane's time piece
        uint t = sub;
        if (t < nT) {
            // the pieces at equal width ratios (dust_piece_bound), the predecessor's covariance
            // turned with the spiral to the piece's centre (dust::subpackets_swept)
            float u0 = dust_piece_bound(t, nT, ratio), u1 = dust_piece_bound(t + 1u, nT, ratio);
            float uc = 0.5 * (u0 + u1);
            float sc = nT > 1u ? r0 + (1.0 - r0) * uc : 1.0;
            float sc2 = sc * sc;
            float St[6];
            for (int k = 0; k < 6; ++k) St[k] = base[k] * sc2;
            if (spiral) dust_rotate_cov(St, spAxis, spOmega * (ageP - (ageO + uc * (ageP - ageO))));
            dust_phot_support = dust_piece_support_o(nT > 1u, lineM, lineP, oM, cM, oP, cP, spiral, spAxis, spOmega, ageO, ageP, uc, vStd, fLo, ownSup, ownHas, ownO, dust_phot_has_origin, dust_phot_origin);
            vec3 m0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0) : mean + seg * u0;
            vec3 s0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u1) - m0 : seg * (u1 - u0);
            DUST_SQUEUE_EMIT(m0, St, s0, flux * (u1 - u0), exposure, false, false, vec2(1.0), vec3(0.0), color)
        }
    } else {
        // the chord groups of the level of detail (dust_lod_group: a polyline whose bins are
        // shorter than the knob on screen, never deeper than the split tolerates): g bins per
        // packet, no sub-bins then (dust::subpackets_cells)
        float ext = 0.0;
        bool hasExt = dust_polyline_extent_px(mi, pc.mvp, W, H, ext);
        // (a cluster with bins walked for specks keeps every bin: the hand-over is per bin)
        uint depthCap = dust_lod_group_depth_cap(lodDepth, lodBinDepth, lodNear);
        uint g = dust_specks_mask(mi) != 0u ? 1u
               : dust_haze_group(dust_lod_group(hasExt, ext, dust_lod_px, depthCap), hazeDetail, depthCap);
        dust_group = g;
        // this lane's sub-packet (b, j) in the order the per-cluster loop ran them: the slow end
        // bin's DUST_END_SUBBINS sub-bins (dust::subpackets_cells), then a bin each (a group
        // chord each with g > 1); lanes past the count idle
        uint nj0 = g > 1u ? 1u : dust_bin_subbins(0u);
        uint b = sub < nj0 ? 0u : (sub - nj0 + 1u) * g;
        uint j = sub < nj0 ? sub : 0u;
        if (b < DUST_SIZE_BINS) {
          uint nj = g > 1u ? 1u : dust_bin_subbins(b);
          // the bin's speck hand-over (dust::splat_cluster_inner: the per-bin shell)
          dust_rec_walked = ((dust_specks_mask(mi) >> b) & 1u) != 0u;
          {
            vec3 ea, ec; float fa, fc;
            dust_sub_edges(mi, b, j, nj, ea, ec, fa, fc);
            // the time segment of this bin: to the same bin of the predecessor
            vec3 segT = vec3(0.0);
            if (pred >= 0) {
                vec3 pa, pcc; float pfa, pfc;
                dust_sub_edges(pi, b, j, nj, pa, pcc, pfa, pfc);
                segT = 0.5 * (pa + pcc) - 0.5 * (ea + ec);
            }
            bool openStart = b > 0u || j > 0u, openEnd = b + dust_group < DUST_SIZE_BINS || j + 1u < nj;
            // the longer of the bin's two axes is the exact capsule, the other a Gaussian
            // (dust::subpackets_merged)
            vec3 chordV = ec - ea;
            bool timeMajor = dot(segT, segT) > dot(chordV, chordV);
            if (timeMajor) {
                vec3 mean; float S[6]; float flux;
                dust_bin_packet_sub(mi, b, j, nj, mean, S, flux);
                float base[6];
                for (int k = 0; k < 6; ++k) base[k] = S[k];
                if (nT > 1u) { vec3 mp; float fp; dust_bin_packet_sub(pi, b, j, nj, mp, base, fp); }
                vec3 pm = mean + segT;
                for (uint t = 0u; t < nT; ++t) {
                    float u0 = dust_piece_bound(t, nT, ratio), u1 = dust_piece_bound(t + 1u, nT, ratio);
                    float uc = 0.5 * (u0 + u1);
                    float sc = nT > 1u ? r0 + (1.0 - r0) * uc : 1.0;
                    float sc2 = sc * sc;
                    float St[6];
                    for (int k = 0; k < 6; ++k) St[k] = base[k] * sc2;
                    float turn = spOmega * (ageP - (ageO + uc * (ageP - ageO)));
                    if (spiral) dust_rotate_cov(St, spAxis, turn);
                    vec3 m0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u0) : mean + segT * u0;
                    vec3 s0 = spiral ? dust_spiral_point(mean, pm, ageO, ageP, spAxis, spOmega, u1) - m0 : segT * (u1 - u0);
                    // seg_t: the size chord of the bin packet the cone is built from, scaled and
                    // turned with it
                    vec3 chordB;
                    {
                        vec3 qa, qc; float qfa, qfc;
                        if (nT > 1u) dust_sub_edges(pi, b, j, nj, qa, qc, qfa, qfc); else { qa = ea; qc = ec; }
                        chordB = qc - qa;
                    }
                    vec3 segTB = ((0.5 * chordB) * 2.0) * sc;
                    if (spiral) segTB = dust_rotate3(segTB, spAxis, turn);
                    dust_phot_support = dust_piece_support_o(nT > 1u, lineM, lineP, oM, cM, oP, cP, spiral, spAxis, spOmega, ageO, ageP, uc, vStd, fLo, ownSup, ownHas, ownO, dust_phot_has_origin, dust_phot_origin);
                    DUST_SQUEUE_EMIT(m0, St, s0, flux * (u1 - u0), exposure, false, false, vec2(1.0), segTB, color)
                }
            } else if (nT == 1u) {
                dust_phot_support = ownSup;
                dust_phot_has_origin = ownHas;
                dust_phot_origin = ownO;
                // the time cell of the bin is the quadrilateral between its chord and the
                // predecessor's: swept when its edges are pixels apart (dust::time_sweep)
                uint nS = pred >= 0 ? dust_time_sweep(mi, pi, b, pc.mvp, W, H) : 1u;
                vec2 rho = dust_bin_density_ends(fa, fc);
                if (nS == 1u) {
                    vec3 mean, chord; float S[6]; float flux;
                    dust_bin_chord_sub(mi, b, j, nj, segT, mean, chord, S, flux);
                    DUST_SQUEUE_EMIT(mean + (cellOff ? 0.5 * segT : vec3(0.0)), S, chord, flux, exposure, openStart, openEnd, rho, (0.5 * segT) * 2.0, color)
                } else {
                    for (uint k = 0u; k < nS; ++k) {
                        vec3 mean, chord; float S[6]; float flux;
                        dust_bin_sweep_sub(mi, pi, b, j, nj, k, nS, mean, chord, S, flux);
                        // seg_t: the sweep slab's Gaussianised width (dust::bin_sweep_packet)
                        vec3 pa, pcc; float pfa, pfc;
                        dust_sub_edges(pi, b, j, nj, pa, pcc, pfa, pfc);
                        vec3 da = pa - ea, dc = pcc - ec;
                        vec3 dmax = dot(da, da) > dot(dc, dc) ? da : dc;
                        vec3 segTS = (dmax * (0.5 / float(nS))) * 2.0;
                        DUST_SQUEUE_EMIT(mean, S, chord, flux, exposure, openStart, openEnd, rho, segTS, color)
                    }
                }
            } else {
                // the cone: nT pieces along the time segment with the predecessor's lateral
                // covariance scaled from the cluster's width to the predecessor's
                vec3 mean, chord; float S[6]; float flux;
                dust_bin_chord_sub(mi, b, j, nj, vec3(0.0), mean, chord, S, flux);
                vec2 rho = dust_bin_density_ends(fa, fc);
                float f = 0.5 * (fa + fc);
                float f2 = f * f;
                float k = DUST_CHORD_VAR_FACTOR;
                vec3 mid = 0.5 * (ea + ec);
                vec3 midP = mid + segT;
                for (uint t = 0u; t < nT; ++t) {
                    float u0 = dust_piece_bound(t, nT, ratio), u1 = dust_piece_bound(t + 1u, nT, ratio);
                    float uc = 0.5 * (u0 + u1);
                    vec3 hs = 0.5 * (u1 - u0) * segT;
                    float sc = r0 + (1.0 - r0) * uc;
                    float sc2 = sc * sc * f2;
                    vec3 shift = spiral ? dust_spiral_point(mid, midP, ageO, ageP, spAxis, spOmega, u0) - mid : segT * u0;
                    // the predecessor's covariance turned to the piece's centre, then its time
                    // Gaussian (dust::subpackets_swept)
                    float Sp[6];
                    Sp[0] = dust_mom.m[pi].cov_a.x; Sp[1] = dust_mom.m[pi].cov_a.y; Sp[2] = dust_mom.m[pi].cov_a.z;
                    Sp[3] = dust_mom.m[pi].cov_a.w; Sp[4] = dust_mom.m[pi].cov_b_age_id.x; Sp[5] = dust_mom.m[pi].cov_b_age_id.y;
                    if (spiral) dust_rotate_cov(Sp, spAxis, spOmega * (ageP - (ageO + uc * (ageP - ageO))));
                    dust_phot_support = dust_piece_support_o(nT > 1u, lineM, lineP, oM, cM, oP, cP, spiral, spAxis, spOmega, ageO, ageP, uc, vStd, fLo, ownSup, ownHas, ownO, dust_phot_has_origin, dust_phot_origin);
                    float St[6];
                    St[0] = Sp[0] * sc2 + k * hs.x * hs.x;
                    St[1] = Sp[1] * sc2 + k * hs.x * hs.y;
                    St[2] = Sp[2] * sc2 + k * hs.x * hs.z;
                    St[3] = Sp[3] * sc2 + k * hs.y * hs.y;
                    St[4] = Sp[4] * sc2 + k * hs.y * hs.z;
                    St[5] = Sp[5] * sc2 + k * hs.z * hs.z;
                    DUST_SQUEUE_EMIT(mean + shift + (cellOff ? hs : vec3(0.0)), St, chord, flux * (u1 - u0), exposure, openStart, openEnd, rho, hs * 2.0, color)
                }
            }
          }
        }
        dust_group = 1u;
    }
    DUST_PROF_END(subpk)
    DUST_PROF_BEGIN(tracer)
    if (sub == 0u && dust_emitting && (pc.flags & DUST_VIEW_TRACERS) != 0u && dust_is_tracer(floatBitsToUint(dust_mom.m[mi].cov_b_age_id.w))) {
        // the tracer dots: real particles of every grain size at their exact positions, a dot
        // per size-polyline edge, so a tracer cluster spans its tail from the slow grains to the
        // fast ones (dust::splat_tracer), in the dust's own colour: the stream colour's hue turned
        // by the age (dust_age_color), at full strength
        uint counts = uint(max(uintBitsToFloat(pc.pyramid.v[DUST_PYR_TRACER_COUNTS]), 0.0) + 0.5);
        uint off = pc.pyramid.v[DUST_PYR_TABLE];
        uint w = pc.pyramid.v[DUST_PYR_TABLE + 1u];
        uint h = pc.pyramid.v[DUST_PYR_TABLE + 2u];
        float r = DUST_TRACER_PX;
        bool stamped = false;
        for (uint e = 0u; counts > 0u && e < DUST_SIZE_EDGES; ++e) {
            vec4 clip = pc.mvp * vec4(dust_mom.m[mi].edges[e].xyz, 1.0);
            if (clip.w <= 0.0) continue;
            vec2 mu = (clip.xy / clip.w * 0.5 + 0.5) * vec2(W, H);
            int x0 = int(max(floor(mu.x - r), 0.0)), x1 = min(int(ceil(mu.x + r)), int(w) - 1);
            int y0 = int(max(floor(mu.y - r), 0.0)), y1 = min(int(ceil(mu.y + r)), int(h) - 1);
            for (int ty = y0; ty <= y1; ++ty) {
                for (int tx = x0; tx <= x1; ++tx) {
                    vec2 dxy = vec2(tx, ty) + 0.5 - mu;
                    if (dot(dxy, dxy) > r * r) continue;
                    uint k = off + (uint(ty) * w + uint(tx)) * DUST_PYRAMID_TEXEL_WORDS;
                    dust_atomic_add_sat(pc.pyramid, k, counts);
                    for (uint c = 1u; c < 4u; ++c) dust_atomic_add_sat(pc.pyramid, k + c, dust_tracer_color_word(counts, color[c - 1u]));
                }
            }
            stamped = true;
        }
        if (stamped) atomicOr(pc.pyramid.v[DUST_PYR_LEVEL_MASK], 1u);
    }
    DUST_PROF_END(tracer)
}

// the lanes' record counts (a warp per cluster: lanes 0-31 and 32-63) and the clusters' first
// records in the chunk's queue
shared uint dust_sub_counts[64];
shared uint dust_cluster_base[2];
// a refusal of the haze predicate by any lane of the warp's cluster (main's pre-pass)
shared uint dust_haze_keep[2];

void main() {
    // the chunk's cluster range [first, end) (the volume queue header, host-written per chunk:
    // Device::cmd_dust_splat; the whole tier when the queue is off), and whether the queue is on
    uint vbase = dust_vqueue_base(pc.pyramid);
    uint first = pc.pyramid.v[vbase + DUST_VQUEUE_FIRST];
    uint end = pc.pyramid.v[vbase + DUST_VQUEUE_END];
    uint sbase = dust_squeue_base(pc.pyramid);
    // a warp per cluster, a lane per sub-packet
    uint lane = gl_LocalInvocationID.x;
    uint sub = lane & 31u;
    // the cluster's ring offset kr in the tier's live range and its ring slot i (the render and
    // moments buffers are slot indexed; the header's ring words, Device::cmd_dust_splat)
    uint kr = first + (gl_GlobalInvocationID.x >> 5u);
    dust_first_slot = pc.pyramid.v[vbase + DUST_VQUEUE_FIRST_SLOT];
    uint i = (dust_first_slot + kr) & pc.pyramid.v[vbase + DUST_VQUEUE_RING_MASK];
    // the cadence (device/dust_cadence.rs): a list of ring slots in the sub-packet queue header's
    // words 4-5 (0: the range itself; a ~0 entry is a hole), the owner bytes in words 6-7 (0:
    // none; a SHOWN slot is drawn by its class image, not here)
    uvec2 listAddr = uvec2(pc.pyramid.v[sbase + 4u], pc.pyramid.v[sbase + 5u]);
    bool listed = true;
    if (listAddr != uvec2(0u)) {
        uint e = kr < end ? DustUintBuffer(listAddr).v[kr] : 0xFFFFFFFFu;
        listed = e != 0xFFFFFFFFu;
        i = listed ? e : 0u;
    }
    // the moments every dust_common function reads by index (dust_mom.m[mi])
    dust_mom_addr = uvec2(pc.moments);
    // (a list is bounded by its chunks' range, not by the tier's live count: liveCount keeps its
    // meaning for the predecessor rule)
    bool live = listed && kr < end && (listAddr != uvec2(0u) || kr < pc.liveCount) && dust_mom.m[i].mean_flux.w > 0.0;
    uvec2 ownAddr = uvec2(pc.pyramid.v[sbase + 6u], pc.pyramid.v[sbase + 7u]);
    if (live && ownAddr != uvec2(0u) && ((DustUintBuffer(ownAddr).v[i >> 2u] >> ((i & 3u) * 8u)) & 4u) != 0u) live = false;
    // diagnostics (AETHERVK_DUST_DEBUG_STREAM / _SAMPLE_MOD): draw one stream, or one time
    // sample in every m, of the tier; the value sits in flag bits 20..27
    if (live && (pc.flags & (DUST_VIEW_DEBUG_STREAM | DUST_VIEW_DEBUG_SAMPLE)) != 0u) {
        float yw = pc.render.c[i].age_id_dbeta_flux.y;
        uint slot = floatBitsToUint(yw) & DUST_RENDER_SLOT_MASK;
        uint shift = dust_render_shift(yw);
        uint v = (pc.flags >> 20u) & 0xFFu;
        if ((pc.flags & DUST_VIEW_DEBUG_STREAM) != 0u && (slot & ((1u << shift) - 1u)) != v) live = false;
        if ((pc.flags & DUST_VIEW_DEBUG_SAMPLE) != 0u && ((slot >> shift) % max(v, 1u)) != 0u) live = false;
    }
    // the haze predicate once per cluster (dust_haze_volumetric's probes spread
    // over the lanes: lane sub takes probes sub and sub + 32, lane 0 the pooled packet; a shared
    // word collects a refusal), only with the knob engaged (uniform: the default skips it)
    bool hazeOn = dust_haze_detail_of(pc.flags, pc.pyramid.v[DUST_PYR_LEVELS], pc.pyramid) < DUST_SIZE_BINS;
    if (hazeOn) {
        if (sub == 0u) dust_haze_keep[lane >> 5u] = 0u;
        barrier();
        if (live) {
            DustClusterPieces cp;
            dust_cluster_pieces(i, cp);
            uint depthMax = min(pc.pyramid.v[DUST_PYR_SPLIT_DEPTH] & 0xFFu, DUST_SPLIT_DEPTH_MAX);
            bool ok = cp.perspective
                   && dust_haze_probe_mono(i, cp.seg, cp.ratio, cp.nT, pc.eyeLocal.xyz, cp.fwd, cp.perspective, depthMax, sub)
                   && dust_haze_probe_mono(i, cp.seg, cp.ratio, cp.nT, pc.eyeLocal.xyz, cp.fwd, cp.perspective, depthMax, sub + 32u)
                   && (sub != 0u || dust_haze_pooled(i, cp.seg, pc.eyeLocal.xyz, cp.fwd, cp.perspective, depthMax));
            if (!ok) atomicOr(dust_haze_keep[lane >> 5u], 1u);
        }
        barrier();
        dust_haze_cluster = dust_haze_keep[lane >> 5u] == 0u;
    }
#ifdef DUST_PROFILE
    DUST_PROF_BEGIN(thread)
#endif
    // the counting pass: the records this lane's sub-packet makes
    uint count = 0u;
    DUST_PROF_BEGIN_AS(cnt)
    if (live) {
        dust_emitting = false;
        dust_counting = true;   // (the profiler's inner probes muted: this pass is `ecount`)
        dust_rec_count = 0u;
        dust_splat_subpacket(i, sub);
        count = dust_rec_count;
        dust_counting = false;
    }
    DUST_PROF_END_AS(count, cnt)
    dust_sub_counts[lane] = count;
    barrier();
    // this lane's record base within the cluster: the records of its earlier sub-packets; the
    // cluster's base in the chunk's queue (lane 0 of the warp), and the cluster's table entry
    uint base = 0u;
    for (uint k = 0u; k < sub; ++k) base += dust_sub_counts[(lane & 32u) + k];
    if (sub == 0u) {
        uint total = 0u;
        for (uint k = 0u; k < 32u; ++k) total += dust_sub_counts[(lane & 32u) + k];
        uint cb = total > 0u ? atomicAdd(pc.pyramid.v[sbase], total) : 0u;
        // (never by construction: a chunk of DUST_SQUEUE_CLUSTERS clusters fits; counted if it
        // happens, the records dropped)
        if (cb + total > DUST_SQUEUE_CAPACITY) { atomicAdd(pc.pyramid.v[sbase + 2u], total); total = 0u; }
        dust_cluster_base[lane >> 5u] = cb;
        uint c = kr - first;
        if (c < DUST_SQUEUE_CLUSTERS) {
            uint t = dust_squeue_table(sbase) + c * DUST_SQUEUE_TABLE_WORDS;
            pc.pyramid.v[t] = cb;
            pc.pyramid.v[t + 1u] = total;
            pc.pyramid.v[t + 2u] = i;
        }
    }
    barrier();
    // the emitting pass
    if (live && count > 0u && dust_cluster_base[lane >> 5u] + base + count <= DUST_SQUEUE_CAPACITY) {
        dust_emitting = true;
        dust_rec_at = dust_cluster_base[lane >> 5u] + base;
        dust_rec_count = 0u;
        dust_splat_subpacket(i, sub);
    }
#ifdef DUST_PROFILE
    DUST_PROF_END(thread)
    // every lane reaches this with its sums (0 for one without a sub-packet): the subgroup
    // reductions of the flush need them all
    DUST_PROF_FLUSH_SPLAT(pc.pyramid, dust_queue_base(pc.pyramid), live && count > 0u)
#endif
}
