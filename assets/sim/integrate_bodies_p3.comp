// @assets/sim/integrate_bodies_p3.comp
//
// Rigid Body Implicit Midpoint Rule (IMR) + Picard Gyroscopic Stabilisation
// ──────────────────────────────────────────────────────────────────────────
// Reads F(x_n) / τ(x_n) from wrenches[body.wrench_idx].
//
// Linear IMR (explicit midpoint, works fine for non-stiff translation):
//   a_lin    = F · M⁻¹
//   v_mid    = v_n + (dt/2) · a_lin
//   x_{n+1} = x_n + dt · v_mid
//   v_{n+1} = v_n + dt  · a_lin
//
// Angular IMR (Picard fixed-point for implicit gyroscopic torque):
//   Work in body-local frame (diagonal inertia I⁻¹).
//   w_mid converges such that:
//     w_mid = w_n + (dt/2) · I⁻¹ · (τ_local − w_mid × (I · w_mid))
//   Then:
//     w_{n+1} = 2 w_mid − w_n
//
// Orientation update (first-order Lie group):
//   q_{n+1} = normalize(q_n + (dt/2) · [ω_mid_world, 0] ⊗ q_n)
//
// After integration, the wrench is CLEARED so force generators can accumulate
// F(x_{n+1}) for the next frame.
//
// RigidBody struct: see imex_math.glsl
//   position_mass      = (xyz pos, w mass)
//   orientation        = quaternion (x,y,z,w)
//   linear_vel_drag    = (xyz linear vel, w drag coeff — unused here)
//   angular_vel_drag   = (xyz angular vel, w drag coeff — unused here)
//   inertia_tensor_inv = (xyz diagonal local I⁻¹)
//   wrench_idx         = index into WrenchArray (CoM wrench)
//
// Target: SPIR-V 1.4 · Vulkan 1.1 · flexible across all hardware subgroup sizes.

#version 450 core
#extension GL_EXT_buffer_reference      : require
#extension GL_EXT_scalar_block_layout   : require
#extension GL_GOOGLE_include_directive  : require

#include "../debug_utils.glsl"
#include "imex_math.glsl"    // RigidBody, Wrench, quat_*, clear_wrench

// ─── Buffer references ──────────────────────────────────────────────────────
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer RigidBodyArray {
    RigidBody bodies[];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer WrenchArray {
    Wrench wrenches[];
};

// ─── Push constants (32 bytes) ──────────────────────────────────────────────
layout(push_constant, scalar) uniform PushConstants {
    RigidBodyArray rigid_bodies;   // BDA — 8 B
    WrenchArray    wrenches;       // BDA — 8 B
    float          dt;             // 4 B
    uint           n_bodies;       // 4 B
    uint           n_iterations;   // Picard iteration count (4–10)  4 B
    uint           _pad;           // 4 B
} pc;

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.n_bodies) return;

    // ── Load rigid body state ────────────────────────────────────────────────
    RigidBody body = pc.rigid_bodies.bodies[id];

    float mass    = body.position_mass.w;
    float inv_m   = (mass > 0.0) ? 1.0 / mass : 0.0;
    // Diagonal local inverse inertia (I⁻¹)
    vec3 I_inv    = body.inertia_tensor_inv.xyz;
    // Diagonal local forward inertia (I), guarded against zero
    vec3 I_fwd    = vec3(
        (I_inv.x > 1e-14) ? 1.0 / I_inv.x : 0.0,
        (I_inv.y > 1e-14) ? 1.0 / I_inv.y : 0.0,
        (I_inv.z > 1e-14) ? 1.0 / I_inv.z : 0.0
    );

    vec3 pos_n = body.position_mass.xyz;
    vec4 q_n   = body.orientation;
    vec3 v_n   = body.linear_vel_drag.xyz;
    vec3 w_n   = body.angular_vel_drag.xyz;

    // ── Fetch F(x_n) / τ(x_n) from Wrench buffer ───────────────────────────
    uint   w_idx  = body.wrench_idx;
    Wrench wrench = pc.wrenches.wrenches[w_idx];
    vec3 f_n      = vec3(wrench.force_x,  wrench.force_y,  wrench.force_z);
    vec3 t_n      = vec3(wrench.torque_x, wrench.torque_y, wrench.torque_z);

    float half_dt = 0.5 * pc.dt;

    // ── Linear integration (explicit midpoint is fine for translation) ───────
    vec3 a_lin    = f_n * inv_m;
    vec3 v_mid    = v_n  + half_dt * a_lin;
    vec3 pos_next = pos_n + pc.dt * v_mid;
    vec3 v_next   = v_n   + pc.dt  * a_lin;

    // ── Angular integration: Picard fixed-point for gyroscopic stability ─────
    // Transform torque and angular velocity to body-local frame (diagonal I)
    vec3 t_local   = quat_rotate_inv(q_n, t_n);
    vec3 w_n_local = quat_rotate_inv(q_n, w_n);

    // Initial guess: explicit half-step
    vec3 w_mid_local = w_n_local;

    // Fixed-point iteration: converges because gyro term is O(dt) perturbation
    for (uint iter = 0u; iter < pc.n_iterations; ++iter) {
        // Gyroscopic torque in body frame: −ω × (I·ω)
        vec3 gyro     = cross(w_mid_local, I_fwd * w_mid_local);
        vec3 a_ang    = I_inv * (t_local - gyro);
        w_mid_local   = w_n_local + half_dt * a_ang;
    }

    // Complete angular step via midpoint rule identity: w_{n+1} = 2·w_mid − w_n
    vec3 w_next_local = 2.0 * w_mid_local - w_n_local;
    vec3 w_next       = quat_rotate(q_n, w_next_local);

    // Orientation update: first-order Lie group integration
    // q_{n+1} = normalize(q_n + dt · ½ · [ω_mid_world, 0] ⊗ q_n)
    vec3 w_mid_world = quat_rotate(q_n, w_mid_local);
    vec4 omega_pure  = vec4(w_mid_world, 0.0);
    vec4 q_next      = normalize(q_n + half_dt * quat_mult(omega_pure, q_n));

    // ── Write back updated state ─────────────────────────────────────────────
    pc.rigid_bodies.bodies[id].position_mass.xyz     = pos_next;
    pc.rigid_bodies.bodies[id].orientation           = q_next;
    pc.rigid_bodies.bodies[id].linear_vel_drag.xyz   = v_next;
    pc.rigid_bodies.bodies[id].angular_vel_drag.xyz  = w_next;

    // ── CRITICAL: Clear Wrench so force generators write F(x_{n+1}) cleanly ─
    clear_wrench(pc.wrenches.wrenches[w_idx]);

    if (SHOULD_DEBUG_PRINT) {
        debugPrintfEXT("[p3_imr] id=%d  pos=(%.4f,%.4f,%.4f)  v=(%.4f,%.4f,%.4f)\n",
            id,
            pos_next.x, pos_next.y, pos_next.z,
            v_next.x,   v_next.y,   v_next.z);
    }
}
