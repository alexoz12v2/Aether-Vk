// @assets/sim/integrate_bodies_p3.comp
//
// Rigid Body Implicit Midpoint Rule (IMR) + Picard Gyroscopic Stabilisation
// ──────────────────────────────────────────────────────────────────────────
// Reads F(x_n) / τ(x_n) from wrenches[body.wrench_idx].
//
// Linear IMR (explicit midpoint, works fine for non-stiff translation):
//   a_lin    = F · M⁻¹
//   v_mid    = v_n + (dt/2) · a_lin
//   x_{n+1} = x_n + dt · v_mid
//   v_{n+1} = v_n + dt  · a_lin
//
// Angular IMR (Picard fixed-point for implicit gyroscopic torque):
//   Work in body-local frame (diagonal inertia I⁻¹).
//   w_mid converges such that:
//     w_mid = w_n + (dt/2) · I⁻¹ · (τ_local − w_mid × (I · w_mid))
//   Then:
//     w_{n+1} = 2 w_mid − w_n
//
// Orientation update (first-order Lie group):
//   q_{n+1} = normalize(q_n + (dt/2) · [ω_mid_world, 0] ⊗ q_n)
//
// External Gravity Emitters (type_id == 0):
//   Emitter position is stored in macro world-space (AU).
//   Each rigid body knows its parent frame via body.frame_idx.
//   The shader transforms the emitter position into the body's local frame
//   using pc.frames (GpuReferenceFrameArray BDA):
//     • Macro frame (frame_type == 0): convert AU distance to km, mu already in km³/s².
//     • Micro frame              : r_local = (em_pos_AU - frame.center_AU) / frame.scale
//   beta (radiation-pressure) compensation: mu_eff = mu × (1 − beta).
//
// After integration, the wrench is CLEARED so force generators can accumulate
// F(x_{n+1}) for the next frame.
//
// RigidBody struct: see imex_math.glsl
//   position_mass      = (xyz pos, w mass)
//   orientation        = quaternion (x,y,z,w)
//   linear_vel_drag    = (xyz linear vel, w drag coeff — unused here)
//   angular_vel_drag   = (xyz angular vel, w drag coeff — unused here)
//   inertia_tensor_inv = (xyz diagonal local I⁻¹)
//   wrench_idx         = index into WrenchArray (CoM wrench)
//   frame_idx          = index into GpuReferenceFrameArray
//
// Target: SPIR-V 1.4 · Vulkan 1.1 · flexible across all hardware subgroup sizes.

#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

#extension GL_EXT_control_flow_attributes : enable

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 32
#endif

// Maximum Picard iterations to unroll at compile time.
// Override at compile time with -DN_ITERS=N to reduce code size on Lavapipe.
#ifndef N_ITERS
#define N_ITERS 8
#endif

// Maximum emitter count to unroll at compile time.
#ifndef MAX_EMIT
#define MAX_EMIT 8
#endif

layout(local_size_x = LOCAL_SIZE_X, local_size_y = 1, local_size_z = 1) in;


layout(push_constant, std430) uniform PushConstants {
    RigidBodyArray         rigid_bodies;
    WrenchArray            wrenches;
    EmitterArray           emitters;
    GpuReferenceFrameArray frames;  // BDA — macro GpuReferenceFrame[]; used for emitter transform
    float dt;
    uint  n_bodies;
    uint  n_iterations;
    uint  num_emitters;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x; if (id >= pc.n_bodies) return;

    RigidBody body = pc.rigid_bodies.bodies[id];
    float mass = body.position_mass.w; float inv_m = (mass > 0.0) ? 1.0 / mass : 0.0;
    vec3 I_inv = body.inertia_tensor_inv.xyz;
    vec3 I_fwd = vec3((I_inv.x > 1e-14) ? 1.0 / I_inv.x : 0.0, (I_inv.y > 1e-14) ? 1.0 / I_inv.y : 0.0, (I_inv.z > 1e-14) ? 1.0 / I_inv.z : 0.0);

    vec3 pos_n = body.position_mass.xyz; vec4 q_n = body.orientation;
    vec3 v_n = body.linear_vel_drag.xyz; vec3 w_n = body.angular_vel_drag.xyz;

    uint w_idx = body.wrench_idx; Wrench wrench = pc.wrenches.wrenches[w_idx];

    // Explicit Unpacking of CAS uint Floats
    vec3 f_n = vec3(uintBitsToFloat(wrench.force_x), uintBitsToFloat(wrench.force_y), uintBitsToFloat(wrench.force_z));
    vec3 t_n = vec3(uintBitsToFloat(wrench.torque_x), uintBitsToFloat(wrench.torque_y), uintBitsToFloat(wrench.torque_z));

    // ── External force emitters ───────────────────────────────────────────────
    uint fi = body.frame_idx;
    GpuReferenceFrame frame = pc.frames.frames[fi];

    // ── External force emitters (loop-free unroll to avoid Lavapipe JIT x30-aliasing) ──────
    // Each EMITTER_STEP(e) is guarded by a runtime check so semantics are unchanged.
#define EMITTER_STEP(E) \
    if ((E) < pc.num_emitters) { \
        vec3  _em_pos   = pc.emitters.emitters[(E)].position; \
        float _em_mu    = pc.emitters.emitters[(E)].mu; \
        vec3  _em_norm  = pc.emitters.emitters[(E)].normal; \
        uint  _em_type  = pc.emitters.emitters[(E)].type_id; \
        float _em_trunc = pc.emitters.emitters[(E)].trunc_distance; \
        float _em_beta  = pc.emitters.emitters[(E)].beta; \
        if (_em_type == 0u) { \
            vec3 _r_local; \
            if (frame.frame_type == 0u) { \
                _r_local = (_em_pos - pos_n) * AU_TO_KM; \
            } else { \
                _r_local = (_em_pos - frame.center_pos) / frame.scale - pos_n; \
            } \
            float _dist_sq = dot(_r_local, _r_local); \
            if (_dist_sq > 1e-6) { \
                float _dist      = sqrt(_dist_sq); \
                float _dist3     = _dist_sq * _dist; \
                float _dist5     = _dist3 * _dist_sq; \
                float _softening = 1.0 - exp(-_dist5); \
                float _mu_eff    = _em_mu * (1.0 - _em_beta); \
                float _force_mag = (_mu_eff * mass * _softening) / _dist_sq; \
                f_n += (_r_local / _dist) * _force_mag; \
            } \
        } else if (_em_type == 1u) { \
            float _dist = dot(pos_n - _em_pos, _em_norm); \
            if (_dist >= 0.0 && _dist <= _em_trunc) f_n += _em_norm * _em_mu; \
        } \
    }

    EMITTER_STEP(0u)
#if MAX_EMIT > 1
    EMITTER_STEP(1u)
#endif
#if MAX_EMIT > 2
    EMITTER_STEP(2u)
#endif
#if MAX_EMIT > 3
    EMITTER_STEP(3u)
#endif
#if MAX_EMIT > 4
    EMITTER_STEP(4u)
#endif
#if MAX_EMIT > 5
    EMITTER_STEP(5u)
#endif
#if MAX_EMIT > 6
    EMITTER_STEP(6u)
#endif
#if MAX_EMIT > 7
    EMITTER_STEP(7u)
#endif
#undef EMITTER_STEP



    float half_dt = 0.5 * pc.dt; vec3 a_lin = f_n * inv_m;
    vec3 v_mid = v_n + half_dt * a_lin; vec3 pos_next = pos_n + pc.dt * v_mid; vec3 v_next = v_n + pc.dt * a_lin;

    vec3 t_local = quat_rotate_inv(q_n, t_n); vec3 w_n_local = quat_rotate_inv(q_n, w_n);
    vec3 w_mid_local = w_n_local;

    // ── Picard gyroscopic iteration (loop-free unroll — see N_ITERS define) ───────────────
    // Each PICARD_STEP is guarded by a runtime check on pc.n_iterations so
    // the iteration count is still dynamic; only the MAXIMUM is compile-time.
#define PICARD_STEP(I) \
    if ((I) < pc.n_iterations) { \
        vec3 _gyro = cross(w_mid_local, I_fwd * w_mid_local); \
        vec3 _a_ang = I_inv * (t_local - _gyro); \
        w_mid_local = w_n_local + half_dt * _a_ang; \
    }

    PICARD_STEP(0u)
#if N_ITERS > 1
    PICARD_STEP(1u)
#endif
#if N_ITERS > 2
    PICARD_STEP(2u)
#endif
#if N_ITERS > 3
    PICARD_STEP(3u)
#endif
#if N_ITERS > 4
    PICARD_STEP(4u)
#endif
#if N_ITERS > 5
    PICARD_STEP(5u)
#endif
#if N_ITERS > 6
    PICARD_STEP(6u)
#endif
#if N_ITERS > 7
    PICARD_STEP(7u)
#endif
#undef PICARD_STEP


    vec3 w_next_local = 2.0 * w_mid_local - w_n_local; vec3 w_next = quat_rotate(q_n, w_next_local);
    vec3 w_mid_world = quat_rotate(q_n, w_mid_local); vec4 omega_pure = vec4(w_mid_world, 0.0);
    vec4 q_next = normalize(q_n + half_dt * quat_mult(omega_pure, q_n));

    pc.rigid_bodies.bodies[id].position_mass = vec4(pos_next, mass);
    pc.rigid_bodies.bodies[id].orientation = q_next;
    pc.rigid_bodies.bodies[id].linear_vel_drag = vec4(v_next, body.linear_vel_drag.w);
    pc.rigid_bodies.bodies[id].angular_vel_drag = vec4(w_next, body.angular_vel_drag.w);

    // Inline CLEAR_WRENCH to avoid the do-while(false) → OpLoopMerge → JIT x30-alias bug.
    pc.wrenches.wrenches[w_idx].force_x  = 0u;
    pc.wrenches.wrenches[w_idx].force_y  = 0u;
    pc.wrenches.wrenches[w_idx].force_z  = 0u;
    pc.wrenches.wrenches[w_idx].torque_x = 0u;
    pc.wrenches.wrenches[w_idx].torque_y = 0u;
    pc.wrenches.wrenches[w_idx].torque_z = 0u;

}
