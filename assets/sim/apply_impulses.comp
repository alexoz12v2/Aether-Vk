#version 450 core

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../debug_utils.glsl"
#include "../bvh_utils.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;



// Particles data mapped as uint to perform CAS loop for float atomicAdd
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer ParticleData {
    uint data[];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer ImpulseOutput {
    vec3 impulses[];
};

layout(push_constant, scalar) uniform PushConstants {
    ParticleData particles;
    PackedCollisions collisions;
    ImpulseOutput impulses;
} pc;

void atomicAddFloat(uint index, float val) {
    uint old_val = pc.particles.data[index];
    uint assumed_val;
    do {
        assumed_val = old_val;
        uint new_val = floatBitsToUint(uintBitsToFloat(assumed_val) + val);
        old_val = atomicCompSwap(pc.particles.data[index], assumed_val, new_val);
    } while (assumed_val != old_val);
}

void main() {
    if (SHOULD_DEBUG_PRINT && gl_GlobalInvocationID.x == 0) {
        debugPrintfEXT("Hello from apply_impulses.comp!\n");
        // Print offsets of fields in PackedPair
        // Since we can't do offsetof directly, we can't easily print them, but we can print the raw data!
    }
    uint global_id = gl_GlobalInvocationID.x;
    if (global_id >= pc.collisions.count) return;

    PackedPair pair = pc.collisions.pairs[global_id];
    vec3 impulse = pc.impulses.impulses[global_id];

    uint pA_id = pair.a.primitive_index;
    uint pB_id = pair.b.primitive_index;

    uint blockA = pA_id / SG_SIZE;
    uint locA = pA_id % SG_SIZE;
    uint baseA = blockA * (10 * SG_SIZE) + locA;

    uint blockB = pB_id / SG_SIZE;
    uint locB = pB_id % SG_SIZE;
    uint baseB = blockB * (10 * SG_SIZE) + locB;

    // Apply positive impulse to particle A
    float m_A = uintBitsToFloat(pc.particles.data[baseA + 6 * SG_SIZE]);
    if (m_A > 0.0) {
        vec3 dvA = impulse / m_A;
        atomicAddFloat(baseA + 3 * SG_SIZE, dvA.x);
        atomicAddFloat(baseA + 4 * SG_SIZE, dvA.y);
        atomicAddFloat(baseA + 5 * SG_SIZE, dvA.z);
    }

    // Apply negative impulse to particle B
    float m_B = uintBitsToFloat(pc.particles.data[baseB + 6 * SG_SIZE]);
    if (m_B > 0.0) {
        vec3 dvB = -impulse / m_B;
        atomicAddFloat(baseB + 3 * SG_SIZE, dvB.x);
        atomicAddFloat(baseB + 4 * SG_SIZE, dvB.y);
        atomicAddFloat(baseB + 5 * SG_SIZE, dvB.z);
    }

    if (SHOULD_DEBUG_PRINT) {
        debugPrintfEXT("ApplyImpulses Contact %d (Pairs: %d, %d): impulse=(%f, %f, %f)", 
            global_id, pA_id, pB_id, impulse.x, impulse.y, impulse.z);
    }
}
