#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require
#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif

#include "../bvh_utils.glsl"
#include "imex_math.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 128
#endif
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    ParticleData particles;
    PackedCollisions collisions;
    ImpulseOutput impulses;
    RigidBodyUintArray rigid_bodies;
    GpuReferenceFrameArray lca_entities;
    uint num_rigid_bodies;
    uint _pad;
} pc;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    if (global_id >= pc.collisions.count) return;

    PackedPair pair = pc.collisions.pairs[global_id];
    vec3 impulse = pc.impulses.impulses[global_id];
    if (length(impulse) < 1e-6) return;

    uint pA_id = pair.a.primitive_index;
    uint pB_id = pair.b.primitive_index;

    bool is_rb_a = (pair.a.entity_id != 0xFFFFFFFFu);
    bool is_rb_b = (pair.b.entity_id != 0xFFFFFFFFu);

    if (is_rb_a && pA_id < pc.num_rigid_bodies) {
        uint base = pA_id * 28; // RigidBody struct is 28 floats
        float mass = uintBitsToFloat(pc.rigid_bodies.data[base + 3]);
        float invMA = mass > 0.0 ? 1.0 / mass : 0.0;
        
        vec3 invIA = vec3(uintBitsToFloat(pc.rigid_bodies.data[base+16]), uintBitsToFloat(pc.rigid_bodies.data[base+17]), uintBitsToFloat(pc.rigid_bodies.data[base+18]));
        vec4 qA = vec4(uintBitsToFloat(pc.rigid_bodies.data[base+4]), uintBitsToFloat(pc.rigid_bodies.data[base+5]), uintBitsToFloat(pc.rigid_bodies.data[base+6]), uintBitsToFloat(pc.rigid_bodies.data[base+7]));
        vec3 posA = vec3(uintBitsToFloat(pc.rigid_bodies.data[base+0]), uintBitsToFloat(pc.rigid_bodies.data[base+1]), uintBitsToFloat(pc.rigid_bodies.data[base+2]));

        vec3 rA = vec3(pair.pt_x, pair.pt_y, pair.pt_z) - posA;

        if (invMA > 0.0) {
            vec3 dvA = -impulse * invMA;
#ifdef DEBUG_SHADERS
            debugPrintfEXT("APPLY IMPULSE A: pA_id=%d impulse=(%f,%f,%f) invMA=%f dvA=(%f,%f,%f)\n", pA_id, impulse.x, impulse.y, impulse.z, invMA, dvA.x, dvA.y, dvA.z);
#endif
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 8], dvA.x);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 9], dvA.y);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 10], dvA.z);

            vec3 dwA = quat_rotate(qA, invIA * quat_rotate_inv(qA, cross(rA, -impulse)));
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 12], dwA.x);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 13], dwA.y);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 14], dwA.z);
        }
    } else {
        uint base = P_BASE(pA_id);
        float mass = P_READ(pc.particles, base + 6u * SUBGROUP_SIZE);
        float invMA = mass > 0.0 ? 1.0 / mass : 0.0;
        if (invMA > 0.0) {
            vec3 dvA = -impulse * invMA;
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 3u * SUBGROUP_SIZE], dvA.x);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 4u * SUBGROUP_SIZE], dvA.y);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 5u * SUBGROUP_SIZE], dvA.z);
        }
    }

    vec3 impulseB = impulse; // Scale impulse for B
    if (pair.is_lca == 1u) {
        GpuReferenceFrame lca = pc.lca_entities.frames[pair.lca_id];
        impulseB = impulse / lca.scale;
    }

    if (is_rb_b && pB_id < pc.num_rigid_bodies) {
        uint base = pB_id * 28;
        float mass = uintBitsToFloat(pc.rigid_bodies.data[base + 3]);
        float invMB = mass > 0.0 ? 1.0 / mass : 0.0;

        vec3 invIB = vec3(uintBitsToFloat(pc.rigid_bodies.data[base+16]), uintBitsToFloat(pc.rigid_bodies.data[base+17]), uintBitsToFloat(pc.rigid_bodies.data[base+18]));
        vec4 qB = vec4(uintBitsToFloat(pc.rigid_bodies.data[base+4]), uintBitsToFloat(pc.rigid_bodies.data[base+5]), uintBitsToFloat(pc.rigid_bodies.data[base+6]), uintBitsToFloat(pc.rigid_bodies.data[base+7]));
        vec3 posB = vec3(uintBitsToFloat(pc.rigid_bodies.data[base+0]), uintBitsToFloat(pc.rigid_bodies.data[base+1]), uintBitsToFloat(pc.rigid_bodies.data[base+2]));

        vec3 rB = vec3(pair.pt_x, pair.pt_y, pair.pt_z) - posB;
        if (pair.is_lca == 1u) {
            GpuReferenceFrame lca = pc.lca_entities.frames[pair.lca_id];
            vec3 pt_micro = (vec3(pair.pt_x, pair.pt_y, pair.pt_z) - lca.center_pos) / lca.scale;
            rB = pt_micro - posB;
        }

        if (invMB > 0.0) {
            vec3 dvB = impulseB * invMB;
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 8], dvB.x);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 9], dvB.y);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 10], dvB.z);

            vec3 dwB = quat_rotate(qB, invIB * quat_rotate_inv(qB, cross(rB, impulseB)));
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 12], dwB.x);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 13], dwB.y);
            ATOMIC_ADD_FLOAT(pc.rigid_bodies.data[base + 14], dwB.z);
        }
    } else {
        uint base = P_BASE(pB_id);
        float mass = P_READ(pc.particles, base + 6u * SUBGROUP_SIZE);
        float invMB = mass > 0.0 ? 1.0 / mass : 0.0;
        if (invMB > 0.0) {
            vec3 dvB = impulseB * invMB;
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 3u * SUBGROUP_SIZE], dvB.x);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 4u * SUBGROUP_SIZE], dvB.y);
            ATOMIC_ADD_FLOAT(pc.particles.data[base + 5u * SUBGROUP_SIZE], dvB.z);
        }
    }
}
