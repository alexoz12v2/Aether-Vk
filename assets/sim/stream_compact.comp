#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"
#include "../debug_utils.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, scalar) uniform PushConstants {
    SparseCollisions sparse_in;
    PackedCollisions packed_out;
    uint total_elements;
} pc;

void main() {
#ifdef DEBUG_SHADERS
    if (gl_GlobalInvocationID.x == 0 && gl_GlobalInvocationID.y == 0 && gl_GlobalInvocationID.z == 0) {
        debugPrintfEXT("Executing compute shader: stream_compact.comp\n");
    }
#endif

    uint id = gl_GlobalInvocationID.x;
    uint in_count = pc.sparse_in.count;

    if (id == 0) {
        pc.packed_out.count = in_count;
        uint blocks = (in_count + 127) / 128;
        pc.packed_out.dispatch_x = blocks;
        pc.packed_out.dispatch_y = 1;
        pc.packed_out.dispatch_z = 1;
    }

    if (id < in_count) {
        // Corrected: Accessing 'pairs' instead of 'data' to match bvh_utils.glsl
        SparseCollisionData in_data = pc.sparse_in.pairs[id];

        pc.packed_out.pairs[id].a.entity_id = in_data.entity_a;
        pc.packed_out.pairs[id].a.primitive_index = in_data.prim_a;
        pc.packed_out.pairs[id].b.entity_id = in_data.entity_b;
        pc.packed_out.pairs[id].b.primitive_index = in_data.prim_b;
        pc.packed_out.pairs[id].toi = in_data.toi;
        pc.packed_out.pairs[id].contact_normal = in_data.contact_normal;
        pc.packed_out.pairs[id].contact_point = in_data.contact_point;
        pc.packed_out.pairs[id].penetration_depth = in_data.penetration_depth;
    }
}