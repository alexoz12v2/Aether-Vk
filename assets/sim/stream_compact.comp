#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// ============================================================================
// Stream Compaction: Subgroup-based Parallel Prefix Sum
// ============================================================================

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint SUBGROUP_SIZE = 32;

// Input sparse array of collision flags/data
layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer SparseCollisions {
    uvec4 data[]; // x = valid (1 or 0), y = particleA, z = particleB, w = padding
};

// Tightly packed output array
layout(buffer_reference, scalar, buffer_reference_align = 4) writeonly buffer PackedCollisions {
    uint count;
    uvec2 pairs[];
};

// Workgroup shared memory for prefix sum across subgroups
shared uint shared_sums[256 / 32];
shared uint workgroup_offset;

layout(push_constant, scalar) uniform PushConstants {
    SparseCollisions sparse_in;
    PackedCollisions packed_out;
    uint total_elements;
} pc;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint local_id = gl_LocalInvocationID.x;
    uint subgroup_id = gl_SubgroupID;
    uint subgroup_local_id = gl_SubgroupInvocationID;

    // 1. Load element
    uint valid = 0;
    uvec2 pair = uvec2(0);
    if (global_id < pc.total_elements) {
        uvec4 elem = pc.sparse_in.data[global_id];
        valid = elem.x;
        pair = elem.yz;
    }

    // 2. Subgroup-level exclusive scan
    uint subgroup_prefix = subgroupExclusiveAdd(valid);
    uint subgroup_total = subgroupAdd(valid);

    // 3. Write subgroup total to shared memory
    if (subgroup_local_id == 0) {
        shared_sums[subgroup_id] = subgroup_total;
    }

    barrier();

    // 4. Workgroup-level scan of subgroup totals (done by first subgroup)
    if (subgroup_id == 0 && subgroup_local_id < gl_NumSubgroups) {
        uint sg_tot = shared_sums[subgroup_local_id];
        shared_sums[subgroup_local_id] = subgroupExclusiveAdd(sg_tot);
    }

    barrier();

    // 5. Global offset for this workgroup
    // The last thread of the workgroup adds the total workgroup sum to the global counter
    if (local_id == gl_WorkGroupSize.x - 1) {
        uint total_wg_sum = shared_sums[subgroup_id] + subgroup_total;
        if (total_wg_sum > 0) {
            workgroup_offset = atomicAdd(pc.packed_out.count, total_wg_sum);
        } else {
            workgroup_offset = 0;
        }
    }

    barrier();

    // 6. Write valid elements to packed array
    if (valid == 1) {
        uint final_idx = workgroup_offset + shared_sums[subgroup_id] + subgroup_prefix;
        pc.packed_out.pairs[final_idx] = pair;
    }
}
