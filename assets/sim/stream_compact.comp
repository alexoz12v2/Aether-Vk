#version 450 core
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "../bvh_utils.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer QueueBuf {
    uint count;
    uvec2 pairs[];
};

layout(push_constant, scalar) uniform PushConstants {
    QueueBuf sparse_in;
    PackedCollisions packed_out;
    uint total_elements;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint in_count = pc.sparse_in.count;

    if (id == 0) {
        pc.packed_out.count = in_count;
        uint blocks = (in_count + 127) / 128;
        pc.packed_out.dispatch_x = blocks;
        pc.packed_out.dispatch_y = 1;
        pc.packed_out.dispatch_z = 1;
    }

    if (id < in_count) {
        uvec2 pair = pc.sparse_in.pairs[id];
        pc.packed_out.pairs[id].a.entity_id = 0;
        pc.packed_out.pairs[id].a.primitive_index = pair.x;
        pc.packed_out.pairs[id].b.entity_id = 0;
        pc.packed_out.pairs[id].b.primitive_index = pair.y;
        pc.packed_out.pairs[id].toi = 0.0;
        pc.packed_out.pairs[id].contact_normal = vec3(0, 1, 0);
        pc.packed_out.pairs[id].contact_point = vec3(0, 0, 0);
        pc.packed_out.pairs[id].penetration_depth = 0.0;
    }
}
