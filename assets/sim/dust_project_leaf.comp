// @assets/sim/dust_project_leaf.comp
//
// The project stage (round 9 step Z3): a lane per candidate of the chunk's candidate buffer
// (dust_scatter.glsl DUST_CQUEUE_*, the walk stage's; indirect from its header), dispatched
// between the walk and the sequencer (Device::dust_splat_impl). An EWA candidate is projected
// (dust_project_packet, with its record's exposure: the same call the splitter made) and its screen
// packet written to its slot (DUST_PQUEUE_PUT, bit 2 of word 11 when on screen) for the sequencer
// and the leaf consumers; a volumetric one is skipped. The same push constants as the splat.
#version 450 core
#extension GL_GOOGLE_include_directive : require
#ifdef DUST_PROFILE
#extension GL_ARB_shader_clock : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
#define DUST_NO_PROJECT_PACKET 1
#include "dust_common.glsl"
#include "dust_scatter.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant, std430) uniform PushConstants {
    DustMomentsBuffer moments;  // 0
    DustRenderBuffer  render;   // 8
    DustUintBuffer    pyramid;  // 16: header + levels + measure grid + the queues
    uint  liveCount;            // 24
    uint  flags;                // 28
    float exposure;             // 32
    float invUnit;              // 36
    uint  color;                // 40
    float albedo;               // 44
    mat4  mvp;                  // 48
    vec4  eyeLocal;             // 112
} pc;                           // 128 bytes

#include "proj_rw.glsl"
void main() {
    uint cbase = dust_cqueue_base_o(uvec2(pc.pyramid));
    uint ccap = dust_cqueue_capacity_o(uvec2(pc.pyramid), cbase);
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= min(pc.pyramid.v[cbase + 3u], ccap)) return;
    dust_rw_qa = dust_word_addr(cbase + DUST_VQUEUE_HEADER_WORDS + slot * 17u);
    dust_rw_qaw = cbase + DUST_VQUEUE_HEADER_WORDS + slot * 17u;
    dust_rw_paw = dust_pqueue_base_o(uvec2(pc.pyramid)) + slot * DUST_PQUEUE_RECORD_WORDS;
    if ((QW(15u) & 4u) != 0u) return;
    dust_rw_rec = QW(16u);
#if DUST_PROJ_PASS == 3
    dust_rw_lq[gl_LocalInvocationID.x] = dust_rw_qaw; dust_rw_lp[gl_LocalInvocationID.x] = dust_rw_paw; dust_rw_lr[gl_LocalInvocationID.x] = dust_rw_rec;
#endif
    dust_pyr_split_word = pc.pyramid.v[DUST_PYR_SPLIT_DEPTH];
    dust_deep_chord = (pc.pyramid.v[DUST_PYR_FLAGS] & DUST_FRAME_DEEP_CHORD) != 0u;
    dust_rw_pa = dust_word_addr(dust_pqueue_base_o(uvec2(pc.pyramid)) + slot * DUST_PQUEUE_RECORD_WORDS);
    dust_rw_pr = dust_word_addr(dust_pqueue_base_o(uvec2(pc.pyramid)) + slot * DUST_PQUEUE_RECORD_WORDS);
#if DUST_PROJ_PASS == 1
    bool on = dust_project_rw_a();
#elif DUST_PROJ_PASS == 2
    bool on = (pc.pyramid.v[dust_rw_paw + 11u] & 4u) != 0u;
    if (on) on = dust_project_rw_b();
    pc.pyramid.v[dust_rw_paw + 11u] = pc.pyramid.v[dust_rw_paw + 11u] & 3u | (on ? 4u : 0u);
    return;
#elif DUST_PROJ_PASS == 3
    bool on = (pc.pyramid.v[dust_rw_paw + 11u] & 4u) != 0u;
    if (on) on = dust_project_rw_b2();
    if (on) dust_project_rw_f();
    pc.pyramid.v[dust_rw_paw + 11u] = pc.pyramid.v[dust_rw_paw + 11u] & 3u | (on ? 4u : 0u);
    return;
#else
    bool on = dust_project_rw_a() && dust_project_rw_b();
    if (on) dust_project_rw_f();
#endif
    pc.pyramid.v[dust_pqueue_base_o(uvec2(pc.pyramid)) + slot * DUST_PQUEUE_RECORD_WORDS + 11u] = QW(15u) & 3u | (on ? 4u : 0u);
}
