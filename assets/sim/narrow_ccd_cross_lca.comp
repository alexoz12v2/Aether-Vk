#version 450 core
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require
#ifdef DEBUG_SHADERS
#extension GL_EXT_debug_printf : enable
#endif
#include "../bvh_utils.glsl"
#include "imex_math.glsl"
#include "physics_core.glsl"

#ifndef LOCAL_SIZE_X
#define LOCAL_SIZE_X 256
#endif
layout(local_size_x = LOCAL_SIZE_X) in;

layout(push_constant, std430) uniform PushConstants {
    RigidBodyArray scene_entities;    // 0-7
    uvec2 particles;                  // 8-15
    SparseCollisions output_list; // 16-23  <-- using SparseCollisions for output list
    CrossPairBuffer cross_pair_buffer; // 24-31  <-- using CrossPairBuffer for pair buffer
    float dt;                         // 32-35
    float particle_radius;            // 36-39
    GpuReferenceFrameArray lca_entities;      // 40-47
    uint space_type;                  // 48-51
    uint _pad;                        // 52-55
} pc;

void main() {
    uint pair_idx = gl_GlobalInvocationID.x;
    
    CrossPairBuffer cross_pairs = pc.cross_pair_buffer;

    if (pair_idx >= cross_pairs.count) return;
    
    CrossPair pair = cross_pairs.pairs[pair_idx];
    uint idA = pair.macro_id;
    uint idB = pair.micro_id;
    uint lca_id = pair.lca_id;

    // Self-collision: macro entity queries its own leaf in the sub-TLAS.
    // Skip it — no impulse is meaningful between a body and itself.
    if (idA == idB) return;

    RigidBody ent_A = pc.scene_entities.bodies[idA];
    RigidBody ent_B = pc.scene_entities.bodies[idB];
    
    uint shape_A = ent_A.shape_type;
    vec4 orient_A = ent_A.orientation;
    vec3 pos_A = ent_A.position_mass.xyz;
    vec3 vel_A = ent_A.linear_vel_drag.xyz;
    
    uint shape_B = ent_B.shape_type;
    vec3 extents_B = ent_B.shape_extents;
    vec4 orient_B = ent_B.orientation;
    vec3 pos_B = ent_B.position_mass.xyz;
    vec3 vel_B = ent_B.linear_vel_drag.xyz;

    GpuReferenceFrame lca = pc.lca_entities.frames[lca_id];
    
    vec3 macro_rel_vel = vel_A - lca.center_vel;
    
    pos_A = (pos_A - lca.center_pos) / lca.scale;
    vel_A = macro_rel_vel / lca.scale;
    vec3 extents_A = ent_A.shape_extents / lca.scale;

    mat3 rotA = quat_to_mat3(orient_A);
    mat4 trans_A = mat4(vec4(rotA[0],0), vec4(rotA[1],0), vec4(rotA[2],0), vec4(pos_A,1.0));
    
    mat3 rotB = quat_to_mat3(orient_B);
    mat4 trans_B = mat4(vec4(rotB[0],0), vec4(rotB[1],0), vec4(rotB[2],0), vec4(pos_B,1.0));


    float toi, depth;
    vec3 normal, contact;
    
#ifdef DEBUG_SHADERS
    debugPrintfEXT("Cross Narrow Phase CCD [pair %d]: idA=%d, idB=%d | pos_A=(%f, %f, %f) pos_B=(%f, %f, %f) | velA=(%f, %f, %f) velB=(%f, %f, %f)\n", pair_idx, idA, idB, pos_A.x, pos_A.y, pos_A.z, pos_B.x, pos_B.y, pos_B.z, vel_A.x, vel_A.y, vel_A.z, vel_B.x, vel_B.y, vel_B.z);
#endif

    bool collides = compute_toi_generic(shape_A, extents_A, trans_A, vel_A * pc.dt, shape_B, extents_B, trans_B, vel_B * pc.dt, 1e-3, 10, toi, normal, contact, depth);

    if (collides) {
        SparseCollisions cross_out = pc.output_list;
        uint count = atomicAdd(cross_out.count, 1);
        if (count < cross_out.capacity) {
            cross_out.pairs[count].valid = 1u;
            cross_out.pairs[count].entity_a = idA;
            cross_out.pairs[count].prim_a = idA;
            cross_out.pairs[count].entity_b = idB;
            cross_out.pairs[count].prim_b = idB;
            cross_out.pairs[count].toi = toi;
            cross_out.pairs[count].is_lca = 1u;
            cross_out.pairs[count].lca_id = lca_id;
            
            vec3 global_normal = normal;
            vec3 global_contact = contact * lca.scale + lca.center_pos;

            cross_out.pairs[count].contact_normal = global_normal;
            cross_out.pairs[count].contact_point = global_contact;
            cross_out.pairs[count].penetration_depth = max(depth, 1e-4) * lca.scale;
        }
    }
}
