{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: AetherVk Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/aethervk.ui.app/AetherVk.csproj",
        },
        {
            "name": "Rust: AetherVk Core rlib simulation test",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "cwd": "${workspaceFolder}/aethervk.core/rlib",
                "args": [
                    "build",
                    "--example",
                    "simulation_test"
                ]
            },
            "program": "${cargo:program}",
            "cwd": "${workspaceFolder}/aethervk.core/rlib",
            "preLaunchTask": "cargo-check"
        }
    ]
}