{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/AetherVk.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/AetherVk.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AetherVk.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "cargo-check",
            "command": "cargo",
            "type": "shell",
            "args": [
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}/aethervk.core/rlib"
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}