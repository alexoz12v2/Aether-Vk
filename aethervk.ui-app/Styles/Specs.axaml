<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Slider Style Overrides -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}"/>
    <Setter Property="Background" Value="{DynamicResource Bg.Outline}"/>
    <Setter Property="MinHeight" Value="24"/>
  </Style>
  <Style Selector="Slider /template/ Track">
    <Setter Property="Height" Value="4"/>
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Accent.Hover}"/>
  </Style>
  <Style Selector="Slider:pressed /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Accent.Active}"/>
  </Style>

  <!-- Expander Style Overrides -->
  <Style Selector="Expander">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Outline}"/>
    <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Grid RowDefinitions="Auto,*">
            <ToggleButton Name="ExpanderHeader"
                          Grid.Row="0"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10,6">
              <ToggleButton.Template>
                <ControlTemplate>
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Name="Chevron"
                            Grid.Column="0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Data="M 0 0 L 4 4 L 0 8"
                            Stroke="{DynamicResource Text.Primary}"
                            StrokeThickness="1.5"
                            Fill="Transparent"/>
                      <ContentPresenter Grid.Column="1"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Name="PART_ContentPresenter"
                              Grid.Row="1"
                              IsVisible="{TemplateBinding IsExpanded}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Background="{DynamicResource Bg.Surface}"
                              HorizontalContentAlignment="Stretch"
                              Padding="{TemplateBinding Padding}"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader /template/ Path#Chevron">
    <Setter Property="RenderTransform" Value="rotate(90deg)"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Path#Chevron">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- Neutralise Fluent's :checked blue tint on the expander header ToggleButton -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Hover}"/>
  </Style>

  <!-- Disabled Expander Style -->
  <Style Selector="Expander:disabled /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Expander:disabled /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg.Subtle}"/>
  </Style>

  <!-- Accordion (Expanders with no margin and rounded outer border) -->
  <Style Selector="Border.accordion">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Outline}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.accordion Expander">
    <Setter Property="Margin" Value="0"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Border.accordion Expander:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ListTray / ListView Overrides -->
  <Style Selector="ListBox.list-tray">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="ListBoxItem.list-tray-item">
    <Setter Property="MinHeight" Value="56"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Outline}"/>
  </Style>
  <Style Selector="ListBoxItem.list-tray-item.dense">
    <Setter Property="MinHeight" Value="40"/>
  </Style>
  <Style Selector="ListBoxItem.list-tray-item.large">
    <Setter Property="MinHeight" Value="72"/>
  </Style>

  <!-- Computed / read-only fields, derived values, not user-editable -->
  <Style Selector="TextBox.computed">
    <!-- IsReadOnly, not IsEnabled at false, cause like this it still is copyable -->
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Default}" />
    <Setter Property="CaretBrush" Value="Transparent" />
  </Style>
  
  <!-- Computed: Suppress hover/focus border changes so it never looks interactive -->
  <Style Selector="TextBox.computed:pointerover /template/ Border, TextBox.computed:focus /template/ Border, TextBox.computed:focus-within /template/ Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Default}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ── PropertyHelpButton ─────────────────────────────────────────────── -->

  <!-- Ghost trigger: no border, transparent background, fades in on hover -->
  <Style Selector="Button.help-trigger">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="Opacity"         Value="0.5"/>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.help-trigger:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- Suppress Fluent's default hover tint on the inner ContentPresenter -->
  <Style Selector="Button.help-trigger:pointerover /template/ ContentPresenter">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <!-- Flyout panel: matches the CommonTabHeader flyout visual language -->
  <Style Selector="Border.help-flyout-panel">
    <Setter Property="Background"      Value="{DynamicResource Bg.Surface}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource Bg.Outline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="6"/>
    <Setter Property="Padding"         Value="12,10"/>
  </Style>

  <!-- Flyout header: semibold, primary text -->
  <Style Selector="TextBlock.help-flyout-header">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
  </Style>

  <!-- Flyout body: regular, secondary text with comfortable line-height -->
  <Style Selector="TextBlock.help-flyout-body">
    <Setter Property="FontSize"   Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
    <Setter Property="LineHeight" Value="18"/>
  </Style>

</Styles>