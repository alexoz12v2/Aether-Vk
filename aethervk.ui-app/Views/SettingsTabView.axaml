<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:converters="using:AetherVk.Converters"
             xmlns:services="using:AetherVk.Logic.Services"
             xmlns:models="using:AetherVk.Logic.Models"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:b="using:AetherVk.Behaviors"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
             x:Class="AetherVk.Views.SettingsTabView"
             x:DataType="vm:ISettingsTabViewModel">
  <Design.DataContext>
    <vm:DesignSettingsTabViewModel />
  </Design.DataContext>

  <!-- NumericUpDown has no automation peer: only its text box reaches UI Automation, so it
  carries the control's AutomationId -->
  <UserControl.Styles>
    <Style Selector="NumericUpDown /template/ TextBox">
      <Setter Property="AutomationProperties.AutomationId"
              Value="{Binding $parent[NumericUpDown].(AutomationProperties.AutomationId)}" />
    </Style>
  </UserControl.Styles>

  <!-- Inject theme resources so DynamicResource keys resolve in the previewer.
  Uses a relative path (not avares://) because the designer host resolves
  from disk — avares:// is only available in the fully running assembly. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:EnumToBoolConverter x:Key="EnumToBool" />
      <DataTemplate x:Key="TextureOptionTemplate" x:DataType="vm:TextureOption">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Width="24" Height="24" Stretch="Uniform"
                 Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
          <TextBlock Text="{Binding Label}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 1. Default Styles for All TextBlocks in this UserControl -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 2. Textbox inside an expander -->
    <Style Selector="Expander TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="left-scrollbar" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,16,16,16">

      <!-- General Settings for Research -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrGeneral}">
          <!-- Form-Like: label auto-sizes, input stretches -->
          <Grid ColumnDefinitions="Auto,16,*"
                RowDefinitions="Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <!-- 1: Comet Name -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding StrCometName}" />
            <!-- TODO: binding to POCO state -->
            <TextBox Grid.Row="0" Grid.Column="2"
                     Watermark="e.g. 67P"
                     HorizontalAlignment="Stretch" />

            <!-- 2. Start Date -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding StrStartDate}" />
            <!-- TODO: binding to POCO state -->
            <CalendarDatePicker Grid.Row="2" Grid.Column="2"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="yyyy-MM-dd"
                                Watermark="yyyy-mm-dd"
                                HorizontalAlignment="Stretch" />

            <!-- 3: End Date -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="{Binding StrEndDate}" />
            <!-- TODO: binding to POCO state -->
            <CalendarDatePicker Grid.Row="4" Grid.Column="2"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="yyyy-MM-dd"
                                Watermark="yyyy-mm-dd"
                                HorizontalAlignment="Stretch" />
          </Grid>
        </Expander>
      </Border>

      <!-- Orbital Elements (Bunch of computed properties over the selected record in the CSV Tab) -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrOrbitalElements}">
          <!--
          Column layout:
          0 : Auto  – symbol label (TextBlock)
          1 : 6     – gap between label and help icon
          2 : Auto  – PropertyHelpButton (circled ?)
          3 : 12    – gap between help icon and computed field
          4 : *     – read-only computed TextBox
          -->
          <Grid ColumnDefinitions="Auto,6,Auto,12,*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">
            <!-- Unit of measurements will be formatted in the computed textbox -->
            <!-- TODO Bind on POCO state -->

            <!-- Eccentricity -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="𝑒" />
            <controls:PropertyHelpButton Grid.Row="0" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderEccentricity}"
                                         HelpContent="{Binding StrHelpContentEccentricity}" />
            <TextBox Grid.Row="0" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Perihelion Distance -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="𝑞" />
            <controls:PropertyHelpButton Grid.Row="2" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderPerihelionDistance}"
                                         HelpContent="{Binding StrHelpContentPerihelionDistance}" />
            <TextBox Grid.Row="2" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Time of Perihelion Passage -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="𝑇ₚ" />
            <controls:PropertyHelpButton Grid.Row="4" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderTimeOfPerihelionPassage}"
                                         HelpContent="{Binding StrHelpContentTimeOfPerihelionPassage}" />
            <TextBox Grid.Row="4" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Longitude of the Ascending Node -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="𝛺" />
            <controls:PropertyHelpButton Grid.Row="6" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderAscendingNodeLongitude}"
                                         HelpContent="{Binding StrHelpContentAscendingNodeLongitude}" />
            <TextBox Grid.Row="6" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Argument of Perihelion -->
            <TextBlock Grid.Row="8" Grid.Column="0"
                       Text="𝜔" />
            <controls:PropertyHelpButton Grid.Row="8" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderArgumentOfPerihelion}"
                                         HelpContent="{Binding StrHelpContentArgumentOfPerihelion}" />
            <TextBox Grid.Row="8" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Inclination -->
            <TextBlock Grid.Row="10" Grid.Column="0"
                       Text="𝑖" />
            <controls:PropertyHelpButton Grid.Row="10" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderInclination}"
                                         HelpContent="{Binding StrHelpContentInclination}" />
            <TextBox Grid.Row="10" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />


          </Grid>
        </Expander>
      </Border>

      <!-- Comet Appearance: aesthetic only (simulation unaffected). Display mode, mesh and
           texture wiring lock while the simulation plays; the placement offset stays live. -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrCometAppearance}" AutomationProperties.AutomationId="CometAppearanceSection">
          <StackPanel Spacing="12" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrAppearanceLockedHint}"
                       IsVisible="{Binding CometAppearance.IsWiringLocked}"
                       Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,16,*">
              <TextBlock Grid.Column="0" Text="{Binding StrDisplayMode}" />
              <!-- grouped by their parent panel, not by GroupName: a named group is global
                   while the view is unrooted, so two views' buttons fought forever -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16"
                          IsEnabled="{Binding CometAppearance.IsWiringEnabled}">
                <RadioButton Content="{Binding StrDisplayModeDefault}"
                             IsChecked="{Binding CometAppearance.IsDefaultMode}" />
                <RadioButton Content="{Binding StrDisplayModeCustom}" AutomationProperties.AutomationId="CometDisplayModeCustom"
                             IsChecked="{Binding CometAppearance.IsCustomMode}"
                             IsEnabled="{Binding CometAppearance.IsCustomModeAvailable}"
                             ToolTip.Tip="{Binding StrNoMeshesHint}"
                             ToolTip.ShowOnDisabled="True" />
              </StackPanel>
            </Grid>

            <!-- Custom mesh: only in custom display mode -->
            <Expander Header="{Binding StrCustomMesh}" IsExpanded="True"
                      IsVisible="{Binding CometAppearance.IsCustomMode}">
              <StackPanel Spacing="10" Margin="4,8,4,4">
                <TextBlock Text="{Binding StrNoMeshesHint}" TextWrapping="Wrap"
                           IsVisible="{Binding !CometAppearance.HasMeshes}" />

                <!-- Mesh + texture channels (physical_mesh2 bindings 0..3) -->
                <Grid ColumnDefinitions="Auto,16,*"
                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                      IsEnabled="{Binding CometAppearance.IsWiringEnabled}">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrMesh}" />
                  <ComboBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometMeshPicker"
                            ItemsSource="{Binding CometAppearance.MeshOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedMesh}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportedAsset">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Image Width="24" Height="24" Stretch="Uniform"
                                 Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                          <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrChannelAlbedo}" />
                  <ComboBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedAlbedo}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrChannelNormal}" />
                  <ComboBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedNormal}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrChannelRoughness}" />
                  <ComboBox Grid.Row="6" Grid.Column="2" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedRoughness}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding StrChannelAo}" />
                  <ComboBox Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedAo}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />
                </Grid>

                <!-- Placement in the comet body frame (always editable) -->
                <TextBlock Text="{Binding StrRotation}" />
                <UniformGrid Columns="3" ColumnSpacing="6">
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Yaw}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Yaw (about the body Z axis)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Pitch}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Pitch (about the body Y axis)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Roll}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Roll (about the body X axis)" />
                </UniformGrid>

                <TextBlock Text="{Binding StrTranslation}" />
                <UniformGrid Columns="3" ColumnSpacing="6">
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationX}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="X (nucleus radii)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationY}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="Y (nucleus radii)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationZ}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="Z (nucleus radii)" />
                </UniformGrid>

                <Button Content="{Binding StrResetPlacement}"
                        Command="{Binding CometAppearance.ResetPlacementCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Expander>

            <TextBlock Text="{Binding CometAppearance.StatusMessage}"
                       Foreground="{DynamicResource Sem.Warning}" TextWrapping="Wrap"
                       IsVisible="{Binding CometAppearance.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Billboards: imported textures in their own desktop windows (compare a real image with the
           simulated dust). Edits here and drags of the windows go through DesktopBillboardService. -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrBillboards}" AutomationProperties.AutomationId="BillboardsSection">
          <StackPanel Spacing="12" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrBillboardsHint}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StrBillboardsNoTextures}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Sem.Warning}"
                       IsVisible="{Binding !Billboards.HasTextures}" />

            <Grid ColumnDefinitions="Auto,16,*,8,Auto">
              <TextBlock Grid.Column="0" Text="{Binding StrBillboardTexture}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="BillboardTexturePicker"
                        ItemsSource="{Binding Billboards.TextureOptions}"
                        SelectedItem="{Binding Billboards.SelectedTexture}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ImportedAsset">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Width="24" Height="24" Stretch="Uniform"
                             Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="4" x:Name="CreateBillboardButton"
                      Content="{Binding StrCreateBillboard}"
                      Command="{Binding Billboards.CreateCommand}" />
            </Grid>

            <ItemsControl x:Name="BillboardList" ItemsSource="{Binding Billboards.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DesktopBillboardItemViewModel">
                  <Expander IsExpanded="True">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="20" Height="20" Stretch="Uniform"
                               Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                        <TextBlock Text="{Binding TextureLabel}" />
                        <TextBlock Text="{Binding DisplayLabel}" Opacity="0.7" />
                      </StackPanel>
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                          Margin="4,8,4,4">
                      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Sem.Warning}"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardMissing}"
                                 IsVisible="{Binding IsMissing}" />

                      <TextBlock Grid.Row="2" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardPosition}" />
                      <UniformGrid Grid.Row="2" Grid.Column="2" Columns="2" ColumnSpacing="6">
                        <NumericUpDown AutomationProperties.AutomationId="BillboardX" Value="{Binding X}" Increment="1" FormatString="F0" ToolTip.Tip="X" />
                        <NumericUpDown AutomationProperties.AutomationId="BillboardY" Value="{Binding Y}" Increment="1" FormatString="F0" ToolTip.Tip="Y" />
                      </UniformGrid>

                      <TextBlock Grid.Row="4" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardSize}" />
                      <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                        <UniformGrid Columns="2" ColumnSpacing="6">
                          <NumericUpDown AutomationProperties.AutomationId="BillboardWidth" Value="{Binding Width}" Minimum="16" Increment="1" FormatString="F0" ToolTip.Tip="W" />
                          <NumericUpDown AutomationProperties.AutomationId="BillboardHeight" Value="{Binding Height}" Minimum="16" Increment="1" FormatString="F0" ToolTip.Tip="H" />
                        </UniformGrid>
                        <CheckBox IsChecked="{Binding IsAspectLocked}"
                                  Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAspectLock}" />
                      </StackPanel>

                      <TextBlock Grid.Row="6" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAlpha}" />
                      <Slider Grid.Row="6" Grid.Column="2" AutomationProperties.AutomationId="BillboardAlpha" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Alpha}" />

                      <TextBlock Grid.Row="8" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardRotation}" />
                      <controls:UnboundedSlider Grid.Row="8" Grid.Column="2" Value="{Binding Rotation}"
                                                IsWrapped="True" WrapMin="-180" WrapMax="180"
                                                Step="1" DragSensitivity="2.0" DisplayFormat="F1" />

                      <CheckBox Grid.Row="10" Grid.Column="2" AutomationProperties.AutomationId="BillboardVisible" IsChecked="{Binding IsVisible}"
                                Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardVisible}" />

                      <Button Grid.Row="12" Grid.Column="2" HorizontalAlignment="Right"
                              Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardDelete}"
                              Command="{Binding DeleteCommand}" />
                    </Grid>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Particle rendering: dust drawing detail, live, saved to ~/.aethervk/preferences.json -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrParticleRendering}" x:Name="ParticleRenderingSection">
          <StackPanel Spacing="10" Margin="12,8,12,12">
            <Grid ColumnDefinitions="Auto,16,*">
              <TextBlock Grid.Column="0" Text="{Binding StrVolumeDetail}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="VolumeDetailPicker"
                        ItemsSource="{Binding ParticleRendering.VolumeDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.VolumeDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrVolumeDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <TextBlock Grid.Column="0" Text="{Binding StrPropagateDetail}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="PropagateDetailPicker"
                        ItemsSource="{Binding ParticleRendering.PropagateDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.PropagateDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrPropagateDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <TextBlock Grid.Column="0" Text="{Binding StrHazeDetail}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="HazeDetailPicker"
                        ItemsSource="{Binding ParticleRendering.HazeDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.HazeDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrHazeDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <TextBlock Grid.Column="0" Text="{Binding StrReuseTolerance}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="ReuseTolerancePicker"
                        ItemsSource="{Binding ParticleRendering.ReuseToleranceOptions}"
                        SelectedIndex="{Binding ParticleRendering.ReuseToleranceIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrReuseToleranceHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Input bindings: edited live, saved to ~/.aethervk/preferences.json -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrInputBindings}" x:Name="InputBindingsSection">
          <StackPanel Spacing="10" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrInputBindingsHint}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InputBindings.CaptureHint}" Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap" IsVisible="{Binding InputBindings.IsCapturing}" />
            <TextBlock Text="{Binding InputBindings.ConflictMessage}" Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding InputBindings.ConflictMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding InputBindings.Contexts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BindingContextViewModel">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Context}" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Command="{Binding ResetCommand}"
                              Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrResetBindings}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Actions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BindingActionViewModel">
                          <Grid ColumnDefinitions="160,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Chords}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BindingChordViewModel">
                                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,8,4">
                                    <Button Classes="binding-rebind" Content="{Binding Text}" Command="{Binding RebindCommand}"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrRebind}" />
                                    <Button Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrRemoveChord}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="2" Command="{Binding AddChordCommand}"
                                    Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrAddChord}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Camera Projection Parameters per Viewport -->
      <ItemsControl ItemsSource="{Binding ActiveViewports}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ViewportSettingsViewModel">
            <Border Classes="accordion" Margin="0,0,0,16">
              <Expander Header="{Binding ViewportName}" AutomationProperties.AutomationId="ViewportSettingsSection">
                <StackPanel Spacing="12" Margin="12,8,12,12">
                  <TextBlock AutomationProperties.AutomationId="CameraModeText" Text="{ReflectionBinding $parent[UserControl].DataContext.CameraModeName, StringFormat='Mode: {0}'}"
                             Foreground="{DynamicResource Accent.Primary}"
                             FontWeight="SemiBold" />

                  <!-- Projection type -->
                  <Grid ColumnDefinitions="Auto,16,*">
                    <TextBlock Grid.Column="0" Text="Type" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                      <RadioButton AutomationProperties.AutomationId="ProjectionPerspective" Content="Perspective"
                                   IsChecked="{Binding IsPerspective}" />
                      <RadioButton AutomationProperties.AutomationId="ProjectionOrthographic" Content="Orthographic"
                                   IsChecked="{Binding IsOrthographic}" />
                    </StackPanel>
                  </Grid>

                  <!-- Perspective parameters -->
                  <Grid ColumnDefinitions="Auto,16,*"
                        RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                        IsVisible="{Binding IsPerspective}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="FOV" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="FovSlider"
                                              Value="{Binding PerspFovDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding PerspFovMin}"
                                              MaxBound="{Binding PerspFovMax}"
                                              Step="{Binding PerspFovStep}"
                                              DragSensitivity="5.0"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Units" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="FovUnitPicker"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding FovUnits}"
                              SelectedIndex="{Binding FovUnitIndex}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Near" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="4" Grid.Column="2"
                                              Value="{Binding PerspNearDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Far" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="6" Grid.Column="2"
                                              Value="{Binding PerspFarDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Distance units" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="8" Grid.Column="2"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DistanceUnits}"
                              SelectedIndex="{Binding OrthoUnitIndex}" />
                  </Grid>

                  <!-- Orthographic parameters -->
                  <Grid ColumnDefinitions="Auto,16,*"
                        RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                        IsVisible="{Binding IsOrthographic}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Half-Width" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="OrthoHalfWidthSlider"
                                              Value="{Binding OrthoHalfWidthDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Half-Height" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="OrthoHalfHeightSlider"
                                              Value="{Binding OrthoHalfHeightDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Units" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="OrthoUnitPicker"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DistanceUnits}"
                              SelectedIndex="{Binding OrthoUnitIndex}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Near" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="6" Grid.Column="2"
                                              Value="{Binding OrthoNearDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Far" VerticalAlignment="Center" />
                    <controls:UnboundedSlider Grid.Row="8" Grid.Column="2"
                                              Value="{Binding OrthoFarDisplay}"
                                              HasBounds="True"
                                              MinBound="{Binding OrthoExtentMin}"
                                              MaxBound="{Binding OrthoExtentMax}"
                                              Step="{Binding OrthoExtentStep}"
                                              IsLogarithmic="True"
                                              DragSensitivity="5.0"
                                              DisplayFormat="G5"
                                              HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Spacing="8">
                      <CheckBox AutomationProperties.AutomationId="OrthoProportionsLock" Content="Keep Proportions Locked" IsChecked="{Binding IsOrthoProportionsLocked}" />
                      <Button AutomationProperties.AutomationId="RestoreOrthoProportionsButton" Content="Restore Proportions" Command="{Binding RestoreOrthoProportionsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </StackPanel>
                  </Grid>

                  <!-- ── CometOrbiting (comet debug): physical nucleus lighting ── -->
                  <CheckBox AutomationProperties.AutomationId="PhysicalLightingToggle"
                            Content="Physical lighting"
                            IsVisible="{Binding IsCometOrbitingMode}"
                            IsChecked="{Binding IsPhysicalLighting}"
                            ToolTip.Tip="Direct sunlight only, at the comet's heliocentric distance ((1 AU / r)², exposed so a white surface facing the Sun at 1 AU is white); no ambient fill. The surface the Sun does not reach is drawn in dark indigo." />

                  <!-- ── UpZenith: snap above a body (animation only, no tracking) ── -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsUpZenithMode}">
                    <TextBlock Text="Snap above" FontWeight="SemiBold" />
                    <UniformGrid Columns="3" ColumnSpacing="6">
                      <Button Content="Sun" Command="{Binding SnapAboveSunCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the Sun (startup view), fitting the projection" />
                      <Button Content="Comet" Command="{Binding SnapAboveCometCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the committed comet, fitting the projection to its nucleus" />
                      <Button Content="Earth" Command="{Binding SnapAboveEarthCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the Earth, fitting the projection to its radius" />
                    </UniformGrid>
                  </StackPanel>

                  <!-- ── Earth Observer Mode Settings ─────────────────────── -->
                  <!-- Visible only when CameraMode = EarthPosition            -->
                  <StackPanel Spacing="12" IsVisible="{Binding IsEarthObserverMode}">
                    <Separator />
                    <TextBlock Text="Earth Observer Settings"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent.Primary}" />

                    <!-- Latitude -->
                    <Grid ColumnDefinitions="Auto,16,*">
                      <TextBlock Grid.Column="0" Text="Latitude (°N)" />
                      <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="ObserverLatSlider"
                                                Value="{Binding EarthObserverLatDeg}"
                                                HasBounds="True" MinBound="-90" MaxBound="90"
                                                Step="0.1"
                                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Longitude -->
                    <Grid ColumnDefinitions="Auto,16,*">
                      <TextBlock Grid.Column="0" Text="Longitude (°E)" />
                      <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="ObserverLonSlider"
                                                Value="{Binding EarthObserverLonDeg}"
                                                HasBounds="True" MinBound="-180" MaxBound="180"
                                                Step="0.1"
                                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Look Direction -->
                    <TextBlock Text="Look Direction" FontWeight="SemiBold" />
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, 8, Auto">
                      <RadioButton Grid.Row="0" AutomationProperties.AutomationId="OrientFree" Content="Free look"
                                   ToolTip.Tip="Drag to look around; the direction stays fixed in space"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=Free}" />
                      <RadioButton Grid.Row="1" AutomationProperties.AutomationId="OrientCometLockIn" Content="Comet lock-in (telescope)"
                                   ToolTip.Tip="Aims at the comet, then turns with the Earth like a telescope on the ground"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=CometLockIn}" />
                      <RadioButton Grid.Row="2" AutomationProperties.AutomationId="OrientCometTracking" Content="Comet tracking"
                                   ToolTip.Tip="Follows the comet; faces the horizon where it will rise while it is below it"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=CometTracking}" />
                      <RadioButton Grid.Row="3" AutomationProperties.AutomationId="OrientSunLockIn" Content="Sun lock-in (telescope)"
                                   ToolTip.Tip="Aims at the Sun, then turns with the Earth like a telescope on the ground"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=SunLockIn}" />
                      <RadioButton Grid.Row="4" AutomationProperties.AutomationId="OrientSunTracking" Content="Sun tracking"
                                   ToolTip.Tip="Follows the Sun; faces the horizon where it will rise while it is below it"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=SunTracking}" />
                      <Button Grid.Row="6" AutomationProperties.AutomationId="RestorePresetButton" Content="Restore preset projection"
                              Command="{Binding RestoreEarthPresetProjectionCommand}"
                              ToolTip.Tip="Re-applies the lock-in / tracking projection where the target spans 10% of the view"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- Tracking target below the horizon: explain the hold, suggest a site -->
                    <Border IsVisible="{Binding IsObserverTargetBelowHorizon}"
                            Background="{DynamicResource Accent.Subtle}"
                            BorderBrush="{DynamicResource Accent.Primary}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ObserverHorizonMessage}" TextWrapping="Wrap" />
                        <Button Content="Move observer there"
                                Command="{Binding ApplySuggestedObserverSiteCommand}"
                                ToolTip.Tip="Moves the observer to the latitude / longitude where the target is overhead now"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Border>

                    <!-- ── Telescope image overlay (HUD, WP5) ───────────────── -->
                    <StackPanel Spacing="8"
                                IsVisible="{Binding SkyImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <Separator />
                      <TextBlock Text="{Binding SkyImage.StrHeader}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,6,Auto">
                        <Button Grid.Column="0" Content="{Binding SkyImage.StrLoadButton}"
                                Command="{Binding SkyImage.LoadImageCommand}"
                                ToolTip.Tip="{Binding SkyImage.StrLoadTip}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding SkyImage.StrRemoveButton}"
                                Command="{Binding SkyImage.RemoveImageCommand}" />
                      </Grid>
                      <TextBlock Text="{Binding SkyImage.ImageName}" TextWrapping="Wrap"
                                 IsVisible="{Binding SkyImage.HasImage}" />
                      <TextBlock Text="{Binding SkyImage.StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                                 IsVisible="{Binding SkyImage.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                      <StackPanel Spacing="8" IsVisible="{Binding SkyImage.HasImage}">
                        <CheckBox Content="{Binding SkyImage.StrVisible}"
                                  IsChecked="{Binding SkyImage.IsOverlayVisible}" />
                        <Grid ColumnDefinitions="Auto,16,*">
                          <TextBlock Grid.Column="0" Text="{Binding SkyImage.StrOpacity}" VerticalAlignment="Center" />
                          <Slider Grid.Column="2" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                  Value="{Binding SkyImage.Opacity}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,16,*">
                          <TextBlock Grid.Column="0" Text="{Binding SkyImage.StrStretch}" VerticalAlignment="Center" />
                          <Slider Grid.Column="2" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                  Value="{Binding SkyImage.Stretch}" />
                        </Grid>
                        <Button Content="{Binding SkyImage.StrSeekButton}"
                                Command="{Binding SkyImage.SeekToDateObsCommand}"
                                ToolTip.Tip="{Binding SkyImage.SeekToolTip}" ToolTip.ShowOnDisabled="True"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="{Binding SkyImage.StrSiteButton}"
                                Command="{Binding SkyImage.UseSiteFromHeaderCommand}"
                                ToolTip.Tip="{Binding SkyImage.SiteToolTip}" ToolTip.ShowOnDisabled="True"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="{Binding SkyImage.StrLockButton}"
                                Command="{Binding SkyImage.LockToImageCommand}"
                                ToolTip.Tip="{Binding SkyImage.LockToolTip}" ToolTip.ShowOnDisabled="True"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <!-- breadcrumb: the header facts the offers need and the image lacks -->
                        <Border IsVisible="{Binding SkyImage.HasMissingHeader}"
                                Background="{DynamicResource Accent.Subtle}"
                                BorderBrush="{DynamicResource Accent.Primary}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                          <TextBlock Text="{Binding SkyImage.MissingHeaderMessage}" TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>