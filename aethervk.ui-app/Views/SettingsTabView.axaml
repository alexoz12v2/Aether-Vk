<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:converters="using:AetherVk.Converters"
             xmlns:services="using:AetherVk.Logic.Services"
             xmlns:models="using:AetherVk.Logic.Models"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:b="using:AetherVk.Behaviors"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
             x:Class="AetherVk.Views.SettingsTabView"
             x:DataType="vm:ISettingsTabViewModel">
  <Design.DataContext>
    <vm:DesignSettingsTabViewModel />
  </Design.DataContext>

  <!-- NumericUpDown has no automation peer: only its text box reaches UI Automation, so it
  carries the control's AutomationId -->
  <UserControl.Styles>
    <Style Selector="NumericUpDown /template/ TextBox">
      <Setter Property="AutomationProperties.AutomationId"
              Value="{Binding $parent[NumericUpDown].(AutomationProperties.AutomationId)}" />
    </Style>
  </UserControl.Styles>

  <!-- Inject theme resources so DynamicResource keys resolve in the previewer.
  Uses a relative path (not avares://) because the designer host resolves
  from disk — avares:// is only available in the fully running assembly. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:EnumToBoolConverter x:Key="EnumToBool" />
      <DataTemplate x:Key="TextureOptionTemplate" x:DataType="vm:TextureOption">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Image Width="24" Height="24" Stretch="Uniform"
                 Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
          <TextBlock Text="{Binding Label}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 1. Default Styles for All TextBlocks in this UserControl -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 2. Textbox inside an expander -->
    <Style Selector="Expander TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="left-scrollbar" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,16,16,16">

      <!-- Time scale for dates (UTC ↔ TDB): how dates are typed and shown; the engine, the committed
           range and the save file always hold TDB (TDB = UTC + 69.18 s since 2017) -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrTimeScale}" AutomationProperties.AutomationId="TimeScaleSection" IsExpanded="True">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,8,12,12">
            <ComboBox AutomationProperties.AutomationId="TimeScalePicker" SelectedIndex="{Binding TimeScaleIndex}" Width="300"
                      ToolTip.Tip="The scale the Comet tab's Start/End boxes, the Timeline epoch box and the viewport's epoch label are typed and shown in. UTC is what a telescope image's DATE-OBS uses; TDB is the engine's own time. Switching only reformats the dates: the committed range does not move.">
              <ComboBoxItem Content="{Binding StrTimeScaleUtc}" />
              <ComboBoxItem Content="{Binding StrTimeScaleTdb}" />
            </ComboBox>
            <controls:PropertyHelpButton AutomationProperties.AutomationId="TimeScaleHelp" HelpHeader="{Binding StrTimeScale}"
                                         HelpContent="{Binding TimeScaleHelpText}" FlyoutMaxWidth="320" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- General Settings for Research: not wired yet (the dates live in the timeline), hidden
           until it drives the session (third feedback round) -->
      <Border Classes="accordion" IsVisible="False">
        <Expander Header="{Binding StrGeneral}" AutomationProperties.AutomationId="GeneralSection">
          <!-- Form-Like: label auto-sizes, input stretches -->
          <Grid ColumnDefinitions="Auto,16,*"
                RowDefinitions="Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <!-- 1: Comet Name -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding StrCometName}" />
            <!-- TODO: binding to POCO state -->
            <TextBox Grid.Row="0" Grid.Column="2"
                     Watermark="e.g. 67P"
                     HorizontalAlignment="Stretch" />

            <!-- 2. Start Date -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{Binding StrStartDate}" />
            <!-- TODO: binding to POCO state -->
            <CalendarDatePicker Grid.Row="2" Grid.Column="2"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="yyyy-MM-dd"
                                Watermark="yyyy-mm-dd"
                                HorizontalAlignment="Stretch" />

            <!-- 3: End Date -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="{Binding StrEndDate}" />
            <!-- TODO: binding to POCO state -->
            <CalendarDatePicker Grid.Row="4" Grid.Column="2"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="yyyy-MM-dd"
                                Watermark="yyyy-mm-dd"
                                HorizontalAlignment="Stretch" />
          </Grid>
        </Expander>
      </Border>

      <!-- Orbital Elements (Bunch of computed properties over the selected record in the CSV Tab):
           not bound yet, so it never filled; hidden until it is -->
      <Border Classes="accordion" IsVisible="False">
        <Expander Header="{Binding StrOrbitalElements}" AutomationProperties.AutomationId="OrbitalElementsSection">
          <!--
          Column layout:
          0 : Auto  – symbol label (TextBlock)
          1 : 6     – gap between label and help icon
          2 : Auto  – PropertyHelpButton (circled ?)
          3 : 12    – gap between help icon and computed field
          4 : *     – read-only computed TextBox
          -->
          <Grid ColumnDefinitions="Auto,6,Auto,12,*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">
            <!-- Unit of measurements will be formatted in the computed textbox -->
            <!-- TODO Bind on POCO state -->

            <!-- Eccentricity -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="𝑒" />
            <controls:PropertyHelpButton Grid.Row="0" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderEccentricity}"
                                         HelpContent="{Binding StrHelpContentEccentricity}" />
            <TextBox Grid.Row="0" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Perihelion Distance -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="𝑞" />
            <controls:PropertyHelpButton Grid.Row="2" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderPerihelionDistance}"
                                         HelpContent="{Binding StrHelpContentPerihelionDistance}" />
            <TextBox Grid.Row="2" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Time of Perihelion Passage -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="𝑇ₚ" />
            <controls:PropertyHelpButton Grid.Row="4" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderTimeOfPerihelionPassage}"
                                         HelpContent="{Binding StrHelpContentTimeOfPerihelionPassage}" />
            <TextBox Grid.Row="4" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Longitude of the Ascending Node -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="𝛺" />
            <controls:PropertyHelpButton Grid.Row="6" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderAscendingNodeLongitude}"
                                         HelpContent="{Binding StrHelpContentAscendingNodeLongitude}" />
            <TextBox Grid.Row="6" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Argument of Perihelion -->
            <TextBlock Grid.Row="8" Grid.Column="0"
                       Text="𝜔" />
            <controls:PropertyHelpButton Grid.Row="8" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderArgumentOfPerihelion}"
                                         HelpContent="{Binding StrHelpContentArgumentOfPerihelion}" />
            <TextBox Grid.Row="8" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />

            <!-- Inclination -->
            <TextBlock Grid.Row="10" Grid.Column="0"
                       Text="𝑖" />
            <controls:PropertyHelpButton Grid.Row="10" Grid.Column="2"
                                         HelpHeader="{Binding StrHelpHeaderInclination}"
                                         HelpContent="{Binding StrHelpContentInclination}" />
            <TextBox Grid.Row="10" Grid.Column="4"
                     Classes="computed"
                     HorizontalAlignment="Stretch" />


          </Grid>
        </Expander>
      </Border>

      <!-- Comet Appearance: aesthetic only (simulation unaffected). Display mode, mesh and
           texture wiring lock while the simulation plays; the placement offset stays live. -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrCometAppearance}" AutomationProperties.AutomationId="CometAppearanceSection">
          <StackPanel Spacing="12" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrAppearanceLockedHint}"
                       IsVisible="{Binding CometAppearance.IsWiringLocked}"
                       Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,16,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDisplayMode}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="CometDisplayModeHelp"
                                             HelpHeader="{Binding StrDisplayMode}"
                                             HelpContent="{Binding StrHelpDisplayMode}" FlyoutMaxWidth="300" />
              </StackPanel>
              <!-- grouped by their parent panel, not by GroupName: a named group is global
                   while the view is unrooted, so two views' buttons fought forever -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16"
                          IsEnabled="{Binding CometAppearance.IsWiringEnabled}">
                <RadioButton Content="{Binding StrDisplayModeDefault}" AutomationProperties.AutomationId="CometDisplayModeDefault"
                             IsChecked="{Binding CometAppearance.IsDefaultMode}" />
                <RadioButton Content="{Binding StrDisplayModeCustom}" AutomationProperties.AutomationId="CometDisplayModeCustom"
                             IsChecked="{Binding CometAppearance.IsCustomMode}"
                             IsEnabled="{Binding CometAppearance.IsCustomModeAvailable}"
                             ToolTip.Tip="{Binding StrNoMeshesHint}"
                             ToolTip.ShowOnDisabled="True" />
              </StackPanel>
            </Grid>

            <!-- Custom mesh: only in custom display mode -->
            <Expander Header="{Binding StrCustomMesh}" IsExpanded="True"
                      IsVisible="{Binding CometAppearance.IsCustomMode}">
              <StackPanel Spacing="10" Margin="4,8,4,4">
                <TextBlock Text="{Binding StrNoMeshesHint}" TextWrapping="Wrap"
                           IsVisible="{Binding !CometAppearance.HasMeshes}" />

                <!-- Mesh + texture channels (physical_mesh2 bindings 0..3) -->
                <Grid ColumnDefinitions="Auto,16,*"
                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                      IsEnabled="{Binding CometAppearance.IsWiringEnabled}">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrMesh}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="CometMeshPickerHelp"
                                                 HelpHeader="{Binding StrMesh}" HelpContent="{Binding StrHelpMesh}" />
                  </StackPanel>
                  <ComboBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometMeshPicker"
                            ItemsSource="{Binding CometAppearance.MeshOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedMesh}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ImportedAsset">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Image Width="24" Height="24" Stretch="Uniform"
                                 Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                          <TextBlock Text="{Binding Label}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrChannelAlbedo}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="CometTextureAlbedoPickerHelp"
                                                 HelpHeader="{Binding StrChannelAlbedo}" HelpContent="{Binding StrHelpChannelAlbedo}" />
                  </StackPanel>
                  <ComboBox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometTextureAlbedoPicker"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedAlbedo}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrChannelNormal}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="CometTextureNormalPickerHelp"
                                                 HelpHeader="{Binding StrChannelNormal}" HelpContent="{Binding StrHelpChannelNormal}" />
                  </StackPanel>
                  <ComboBox Grid.Row="4" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometTextureNormalPicker"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedNormal}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrChannelRoughness}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="CometTextureRoughnessPickerHelp"
                                                 HelpHeader="{Binding StrChannelRoughness}" HelpContent="{Binding StrHelpChannelRoughness}" />
                  </StackPanel>
                  <ComboBox Grid.Row="6" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometTextureRoughnessPicker"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedRoughness}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />

                  <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrChannelAo}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="CometTextureAoPickerHelp"
                                                 HelpHeader="{Binding StrChannelAo}" HelpContent="{Binding StrHelpChannelAo}" />
                  </StackPanel>
                  <ComboBox Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="CometTextureAoPicker"
                            ItemsSource="{Binding CometAppearance.TextureOptions}"
                            SelectedItem="{Binding CometAppearance.SelectedAo}"
                            ItemTemplate="{StaticResource TextureOptionTemplate}" />
                </Grid>

                <!-- Placement in the comet body frame (always editable) -->
                <TextBlock Text="{Binding StrRotation}" />
                <UniformGrid Columns="3" ColumnSpacing="6">
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Yaw}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Yaw (about the body Z axis)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Pitch}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Pitch (about the body Y axis)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.Roll}"
                                            IsWrapped="True" WrapMin="-180" WrapMax="180"
                                            Step="1" DragSensitivity="2.0" DisplayFormat="F1"
                                            ToolTip.Tip="Roll (about the body X axis)" />
                </UniformGrid>

                <TextBlock Text="{Binding StrTranslation}" />
                <UniformGrid Columns="3" ColumnSpacing="6">
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationX}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="X (nucleus radii)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationY}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="Y (nucleus radii)" />
                  <controls:UnboundedSlider Value="{Binding CometAppearance.TranslationZ}"
                                            HasBounds="True" MinBound="-5" MaxBound="5"
                                            Step="0.01" DragSensitivity="5.0" DisplayFormat="F2"
                                            ToolTip.Tip="Z (nucleus radii)" />
                </UniformGrid>

                <Button Content="{Binding StrResetPlacement}"
                        Command="{Binding CometAppearance.ResetPlacementCommand}"
                        ToolTip.Tip="Reset the mesh rotation (yaw, pitch, roll) and offset to zero, aligning it with the nucleus body axes at the nucleus centre."
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Expander>

            <TextBlock Text="{Binding CometAppearance.StatusMessage}"
                       Foreground="{DynamicResource Sem.Warning}" TextWrapping="Wrap"
                       IsVisible="{Binding CometAppearance.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Billboards: imported textures in their own desktop windows (compare a real image with the
           simulated dust). Edits here and drags of the windows go through DesktopBillboardService. -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrBillboards}" AutomationProperties.AutomationId="BillboardsSection">
          <StackPanel Spacing="12" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrBillboardsHint}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StrBillboardsNoTextures}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Sem.Warning}"
                       IsVisible="{Binding !Billboards.HasTextures}" />

            <Grid ColumnDefinitions="Auto,16,*,8,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrBillboardTexture}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardTexturePickerHelp"
                                             HelpHeader="{Binding StrBillboardTexture}"
                                             HelpContent="{Binding StrHelpBillboardTexture}" />
              </StackPanel>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="BillboardTexturePicker" AutomationProperties.AutomationId="BillboardTexturePicker"
                        ItemsSource="{Binding Billboards.TextureOptions}"
                        SelectedItem="{Binding Billboards.SelectedTexture}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ImportedAsset">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Width="24" Height="24" Stretch="Uniform"
                             Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="4" x:Name="CreateBillboardButton"
                ToolTip.Tip="Open a new billboard window showing the selected texture."
                      Content="{Binding StrCreateBillboard}"
                      Command="{Binding Billboards.CreateCommand}" />
            </Grid>

            <ItemsControl x:Name="BillboardList" ItemsSource="{Binding Billboards.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DesktopBillboardItemViewModel">
                  <Expander IsExpanded="True">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Width="20" Height="20" Stretch="Uniform"
                               Source="{Binding Thumbnail, Converter={x:Static converters:ThumbnailToBitmapConverter.Instance}}" />
                        <TextBlock Text="{Binding TextureLabel}" />
                        <TextBlock Text="{Binding DisplayLabel}" Opacity="0.7" />
                      </StackPanel>
                    </Expander.Header>
                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                          Margin="4,8,4,4">
                      <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Sem.Warning}"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardMissing}"
                                 IsVisible="{Binding IsMissing}" />

                      <TextBlock Grid.Row="2" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardPosition}" />
                      <UniformGrid Grid.Row="2" Grid.Column="2" Columns="2" ColumnSpacing="6">
                        <NumericUpDown AutomationProperties.AutomationId="BillboardX" Value="{Binding X}" Increment="1" FormatString="F0" ToolTip.Tip="Horizontal position of the billboard centre, in desktop pixels." />
                        <NumericUpDown AutomationProperties.AutomationId="BillboardY" Value="{Binding Y}" Increment="1" FormatString="F0" ToolTip.Tip="Vertical position of the billboard centre, in desktop pixels." />
                      </UniformGrid>

                      <TextBlock Grid.Row="4" Grid.Column="0"
                                 Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardSize}" />
                      <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
                        <UniformGrid Columns="2" ColumnSpacing="6">
                          <NumericUpDown AutomationProperties.AutomationId="BillboardWidth" Value="{Binding Width}" Minimum="16" Increment="1" FormatString="F0" ToolTip.Tip="Billboard width in pixels (at least 16)." />
                          <NumericUpDown AutomationProperties.AutomationId="BillboardHeight" Value="{Binding Height}" Minimum="16" Increment="1" FormatString="F0" ToolTip.Tip="Billboard height in pixels (at least 16)." />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <CheckBox IsChecked="{Binding IsAspectLocked}" AutomationProperties.AutomationId="BillboardAspectLock"
                                    Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAspectLock}" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardAspectLockHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAspectLock}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpBillboardAspectLock}" />
                        </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAlpha}" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardAlphaHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardAlpha}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpBillboardAlpha}" />
                      </StackPanel>
                      <Slider Grid.Row="6" Grid.Column="2" AutomationProperties.AutomationId="BillboardAlpha"
                              Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Alpha}" />

                      <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardRotation}" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardRotationHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardRotation}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpBillboardRotation}" />
                      </StackPanel>
                      <controls:UnboundedSlider Grid.Row="8" Grid.Column="2" Value="{Binding Rotation}"
                                                AutomationProperties.AutomationId="BillboardRotation"
                                                IsWrapped="True" WrapMin="-180" WrapMax="180"
                                                Step="1" DragSensitivity="2.0" DisplayFormat="F1" />

                      <CheckBox Grid.Row="10" Grid.Column="2" AutomationProperties.AutomationId="BillboardVisible"
                        ToolTip.Tip="Show or hide the billboard window without deleting it." IsChecked="{Binding IsVisible}"
                                Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardVisible}" />

                      <!-- Physical size (Earth observer): the image's height at the comet (km) or its
                           plate scale sizes it on the sky -->
                      <StackPanel Grid.Row="12" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderPhysicalSize}" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardPhysicalSizeHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderPhysicalSize}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpPhysicalSize}" FlyoutMaxWidth="320" />
                      </StackPanel>
                      <StackPanel Grid.Row="12" Grid.Column="2" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderImageHeightKm}" Opacity="0.85" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardImageHeightKmHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderImageHeightKm}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpImageHeightKm}" />
                        </StackPanel>
                        <TextBox AutomationProperties.AutomationId="BillboardImageHeightKm" Text="{Binding ImageHeightKmText}"
                                 Watermark="km at the comet (e.g. 120000)" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderPlateScale}" Opacity="0.85" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardArcsecPerPxHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderPlateScale}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpPlateScale}" />
                        </StackPanel>
                        <TextBox AutomationProperties.AutomationId="BillboardArcsecPerPx" Text="{Binding ImageArcsecPerPxText}"
                                 Watermark="plate scale, arcsec / image px (e.g. 0.3037)" />
                        <TextBlock Text="{Binding PhysicalSizeLabel}" TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock AutomationProperties.AutomationId="BillboardConversion" Text="{Binding ConversionLabel}" TextWrapping="Wrap" Opacity="0.8"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                   IsVisible="{Binding ConversionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Grid ColumnDefinitions="*,4,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderNucleusPixel}" Opacity="0.85" TextWrapping="Wrap" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardNucleusPixelHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderNucleusPixel}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpNucleusPixel}" Grid.Column="2" FlyoutMaxWidth="300" />
                        </Grid>
                        <Grid ColumnDefinitions="*,6,*,6,Auto">
                          <NumericUpDown Grid.Column="0" AutomationProperties.AutomationId="BillboardNucleusX" Value="{Binding NucleusX}"
                                         Increment="0.1" FormatString="F2" Watermark="image centre" />
                          <NumericUpDown Grid.Column="2" AutomationProperties.AutomationId="BillboardNucleusY" Value="{Binding NucleusY}"
                                         Increment="0.1" FormatString="F2" Watermark="image centre" />
                          <Button Grid.Column="4" AutomationProperties.AutomationId="BillboardDetectNucleus" Content="Detect"
                                  Command="{Binding DetectNucleusCommand}" />
                        </Grid>
                        <TextBlock AutomationProperties.AutomationId="BillboardGeometry" Text="{Binding GeometryLabel}" TextWrapping="Wrap" Opacity="0.7"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                        <TextBlock Text="Bound: covers the image's field at the viewport's scale on zoom and resize (a manual resize unbinds)" TextWrapping="Wrap"
                                   Opacity="0.7" IsVisible="{Binding IsPhysicalSizeBound}" />
                        <WrapPanel Orientation="Horizontal">
                          <Button AutomationProperties.AutomationId="BillboardApplyPhysicalSize" Content="Apply physical size" Margin="0,0,6,4"
                                  Command="{Binding ApplyPhysicalSizeCommand}" />
                          <Button AutomationProperties.AutomationId="BillboardCenterOnComet" Content="Center on comet" Margin="0,0,6,4"
                                  Command="{Binding CenterOnCometCommand}" />
                          <Button AutomationProperties.AutomationId="BillboardMatchCamera" Content="Match camera to image" Margin="0,0,6,4"
                                  Command="{Binding MatchCameraToImageCommand}" />
                        </WrapPanel>
                      </StackPanel>

                      <!-- FITS texture: header facts and cards, stretch, and the buttons that set the
                           simulation up like the observation (FitsImageViewModel) -->
                      <ContentControl Grid.Row="14" Grid.ColumnSpan="3" Content="{Binding Fits}" IsVisible="{Binding IsFits}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate x:DataType="vm:FitsImageViewModel">
                            <Expander Header="FITS image" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="BillboardFitsSection">
                              <StackPanel Spacing="10" Margin="4,8,4,4">
                                <TextBlock Text="Key facts" FontWeight="SemiBold" />
                                <ItemsControl x:Name="FitsFacts" ItemsSource="{Binding Facts}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FitsFactItem">
                                      <Grid ColumnDefinitions="110,8,*" Margin="0,0,0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Text.Secondary}" />
                                        <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap"
                                                             AutomationProperties.AutomationId="{Binding AutomationId}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSiteLon}">
                                  <CheckBox Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderFlipLon}" IsChecked="{Binding FlipSiteLon}"
                                            AutomationProperties.AutomationId="BillboardFitsFlipLon" />
                                  <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardFitsFlipLonHelp"
                                                               HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderFlipLon}"
                                                               HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpFlipLon}" />
                                </StackPanel>

                                <TextBlock Text="Header" FontWeight="SemiBold" />
                                <DataGrid x:Name="FitsHeaderGrid" ItemsSource="{Binding Cards}"
                                          AutoGenerateColumns="False" IsReadOnly="True" Height="240"
                                          AutomationProperties.AutomationId="BillboardFitsHeader">
                                  <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="2*" />
                                  </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderStretch}" FontWeight="SemiBold" />
                                  <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardFitsStretchHelp"
                                                               HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderStretch}"
                                                               HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpStretch}" FlyoutMaxWidth="320" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,6,*">
                                  <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BillboardFitsStretchMode"
                                            ItemsSource="{Binding StretchModes}" SelectedItem="{Binding StretchMode}" />
                                  <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="BillboardFitsTransfer"
                                            ItemsSource="{Binding Transfers}" SelectedItem="{Binding Transfer}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,6,*,12,Auto,6,*" IsVisible="{Binding HasStretchParams}">
                                  <TextBlock Grid.Column="0" Text="{Binding Param0Label}" VerticalAlignment="Center" />
                                  <TextBox Grid.Column="2" Text="{Binding Param0Text}" AutomationProperties.AutomationId="BillboardFitsStretchParam0" />
                                  <TextBlock Grid.Column="4" Text="{Binding Param1Label}" VerticalAlignment="Center" />
                                  <TextBox Grid.Column="6" Text="{Binding Param1Text}" AutomationProperties.AutomationId="BillboardFitsStretchParam1" />
                                </Grid>
                                <Grid ColumnDefinitions="*,8,Auto">
                                  <TextBlock Grid.Column="0" Text="{Binding StretchResultText}" TextWrapping="Wrap"
                                             Opacity="0.8" VerticalAlignment="Center" />
                                  <Button Grid.Column="2" Content="Apply stretch" Classes="accent"
                                          AutomationProperties.AutomationId="BillboardFitsApplyStretch"
                                          ToolTip.Tip="Re-render the FITS image with the chosen stretch mode, values and transfer curve."
                                          Command="{Binding ApplyStretchCommand}" />
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsApplyingStretch}" />

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <TextBlock Text="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderCompare}" FontWeight="SemiBold" />
                                  <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardFitsCompareHelp"
                                                               HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderCompare}"
                                                               HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpCompare}" FlyoutMaxWidth="320" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,4,Auto">
                                  <SelectableTextBlock Grid.Column="0" Text="{Binding PixelRatioText}" TextWrapping="Wrap" Opacity="0.85"
                                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                                       AutomationProperties.AutomationId="BillboardFitsPixelRatio" />
                                  <controls:PropertyHelpButton AutomationProperties.AutomationId="BillboardFitsPixelRatioHelp"
                                                               HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderPixelRatio}"
                                                               HelpContent="{Binding PixelRatioTip}" Grid.Column="2" FlyoutMaxWidth="300" />
                                </Grid>
                                <WrapPanel Orientation="Horizontal">
                                  <Button Content="Seek to observation" Margin="0,0,6,4"
                                          Command="{Binding SeekToObservationCommand}"
                                          ToolTip.Tip="Seek the timeline to the middle of the exposure (TDB)." />
                                  <Button Content="Model range" Margin="0,0,6,4"
                                          AutomationProperties.AutomationId="BillboardFitsModelRange"
                                          Command="{Binding RequestModelRangeCommand}" />
                                  <Button Content="Use observatory site" Margin="0,0,6,4"
                                          Command="{Binding UseObservatorySiteCommand}"
                                          ToolTip.Tip="Put the Earth observer on the header's site (topocentric, latitude, longitude, elevation)." />
                                  <Button Content="Orient to image" Margin="0,0,6,4" AutomationProperties.AutomationId="BillboardFitsOrientToImage"
                                          Command="{Binding OrientToImageCommand}" />
                                  <Button Content="Match camera to image" Margin="0,0,6,4" AutomationProperties.AutomationId="BillboardFitsMatchCamera"
                                          Command="{Binding MatchCameraToImageCommand}" />
                                  <Button Content="Set up comparison" Margin="0,0,6,4" Classes="accent"
                                          AutomationProperties.AutomationId="BillboardSetUpComparison"
                                          Command="{Binding SetUpComparisonCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                                           AutomationProperties.AutomationId="BillboardFitsStatus"
                                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Expander>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>

                      <Button Grid.Row="16" Grid.Column="2" HorizontalAlignment="Right"
                              Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrBillboardDelete}"
                              Command="{Binding DeleteCommand}"
                              ToolTip.Tip="Delete this billboard and close its window." />
                    </Grid>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Particle rendering: dust drawing detail, live, saved to ~/.aethervk/preferences.json -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrParticleRendering}" x:Name="ParticleRenderingSection">
          <StackPanel Spacing="10" Margin="12,8,12,12">
            <Grid ColumnDefinitions="Auto,16,*,12,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Quality" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="ParticleQualitySliderHelp"
                                             HelpHeader="{Binding StrHelpHeaderDustQuality}"
                                             HelpContent="{Binding StrHelpDustQuality}" FlyoutMaxWidth="300" />
              </StackPanel>
              <Slider Grid.Column="2" x:Name="ParticleQualitySlider"
                      AutomationProperties.AutomationId="ParticleQualitySlider"
                      Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                      TickPlacement="BottomRight"
                      Value="{Binding ParticleRendering.QualitySliderValue}" />
              <TextBlock Grid.Column="4" x:Name="ParticleQualityLabel" MinWidth="56"
                         VerticalAlignment="Center"
                         Text="{Binding ParticleRendering.QualityLabel}" />
            </Grid>
            <TextBlock Text="Lowest is the fastest; each step draws the dust finer. Editing a value below turns the quality to Custom. Saved for the next start."
                       TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
            <Grid ColumnDefinitions="Auto,16,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrVolumeDetail}" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="VolumeDetailPickerHelp"
                                             HelpHeader="{Binding StrVolumeDetail}"
                                             HelpContent="{Binding StrHelpVolumeDetail}" FlyoutMaxWidth="300" />
              </StackPanel>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="VolumeDetailPicker"
                        ItemsSource="{Binding ParticleRendering.VolumeDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.VolumeDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrVolumeDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrPropagateDetail}" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="PropagateDetailPickerHelp"
                                             HelpHeader="{Binding StrPropagateDetail}"
                                             HelpContent="{Binding StrHelpPropagateDetail}" FlyoutMaxWidth="300" />
              </StackPanel>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="PropagateDetailPicker"
                        ItemsSource="{Binding ParticleRendering.PropagateDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.PropagateDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrPropagateDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrHazeDetail}" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="HazeDetailPickerHelp"
                                             HelpHeader="{Binding StrHazeDetail}"
                                             HelpContent="{Binding StrHelpHazeDetail}" FlyoutMaxWidth="300" />
              </StackPanel>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="HazeDetailPicker"
                        ItemsSource="{Binding ParticleRendering.HazeDetailOptions}"
                        SelectedIndex="{Binding ParticleRendering.HazeDetailIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrHazeDetailHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,16,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrReuseTolerance}" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="ReuseTolerancePickerHelp"
                                             HelpHeader="{Binding StrReuseTolerance}"
                                             HelpContent="{Binding StrHelpReuseTolerance}" FlyoutMaxWidth="300" />
              </StackPanel>
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        x:Name="ReuseTolerancePicker"
                        ItemsSource="{Binding ParticleRendering.ReuseToleranceOptions}"
                        SelectedIndex="{Binding ParticleRendering.ReuseToleranceIndex}" />
            </Grid>
            <TextBlock Text="{Binding StrReuseToleranceHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Input bindings: edited live, saved to ~/.aethervk/preferences.json -->
      <Border Classes="accordion">
        <Expander Header="{Binding StrInputBindings}" x:Name="InputBindingsSection">
          <StackPanel Spacing="10" Margin="12,8,12,12">
            <TextBlock Text="{Binding StrInputBindingsHint}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding InputBindings.CaptureHint}" Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap" IsVisible="{Binding InputBindings.IsCapturing}" />
            <TextBlock Text="{Binding InputBindings.ConflictMessage}" Foreground="{DynamicResource Sem.Warning}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding InputBindings.ConflictMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding InputBindings.Contexts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BindingContextViewModel">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Context}" FontWeight="SemiBold" />
                      <Button Grid.Column="1" Command="{Binding ResetCommand}"
                        ToolTip.Tip="Restore the bindings of this group to their defaults."
                              Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrResetBindings}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Actions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BindingActionViewModel">
                          <Grid ColumnDefinitions="160,*,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Chords}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BindingChordViewModel">
                                  <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,8,4">
                                    <Button Classes="binding-rebind" Content="{Binding Text}" Command="{Binding RebindCommand}"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrRebind}" />
                                    <Button Content="✕" Command="{Binding RemoveCommand}"
                                            ToolTip.Tip="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrRemoveChord}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="2" Command="{Binding AddChordCommand}"
                              ToolTip.Tip="Add another key or mouse combination for this action."
                                    Content="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrAddChord}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Camera Projection Parameters per Viewport -->
      <ItemsControl ItemsSource="{Binding ActiveViewports}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:ViewportSettingsViewModel">
            <Border Classes="accordion" Margin="0,0,0,16">
              <Expander Header="{Binding ViewportName}" AutomationProperties.AutomationId="ViewportSettingsSection">
                <StackPanel Spacing="12" Margin="12,8,12,12">
                  <TextBlock AutomationProperties.AutomationId="CameraModeText" Text="{ReflectionBinding $parent[UserControl].DataContext.CameraModeName, StringFormat='Mode: {0}'}"
                             Foreground="{DynamicResource Accent.Primary}"
                             FontWeight="SemiBold" />

                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <CheckBox AutomationProperties.AutomationId="DiagnosticPanelsCheckBox" Content="Show diagnostic panels (all viewports)"
                              IsChecked="{ReflectionBinding $parent[UserControl].DataContext.ShowDiagnosticPanels}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="DiagnosticPanelsCheckBoxHelp" VerticalAlignment="Center"
                                                 HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewDiagnostics}"
                                                 HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewDiagnostics}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <CheckBox AutomationProperties.AutomationId="ComparisonLockCheckBox" Content="Lock viewport for comparison"
                              IsChecked="{Binding IsComparisonLocked}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="ComparisonLockCheckBoxHelp" VerticalAlignment="Center"
                                                 HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewComparisonLock}"
                                                 HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewComparisonLock}" />
                  </StackPanel>

                  <!-- Projection type -->
                  <Grid ColumnDefinitions="Auto,16,*" IsEnabled="{Binding !IsComparisonLocked}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Type" VerticalAlignment="Center" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="ProjectionTypeHelp"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewProjectionType}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewProjectionType}" FlyoutMaxWidth="300" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                      <RadioButton AutomationProperties.AutomationId="ProjectionPerspective" Content="Perspective"
                                   IsChecked="{Binding IsPerspective}" />
                      <RadioButton AutomationProperties.AutomationId="ProjectionOrthographic" Content="Orthographic"
                                   IsChecked="{Binding IsOrthographic}" />
                    </StackPanel>
                  </Grid>

                  <!-- Projection sliders: advanced (Match camera to image sets the field from the image) -->
                  <Expander AutomationProperties.AutomationId="ProjectionAdvancedExpander" Margin="0,2"
                            IsExpanded="False" HorizontalAlignment="Stretch">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Advanced: projection" VerticalAlignment="Center" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="ProjectionAdvancedExpanderHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewProjectionAdvanced}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewProjectionAdvanced}" FlyoutMaxWidth="300" />
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                      <!-- Perspective parameters -->
                      <Grid ColumnDefinitions="Auto,16,*"
                            RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                            IsVisible="{Binding IsPerspective}" IsEnabled="{Binding !IsComparisonLocked}">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="FOV" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="FovSliderHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewFov}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewFov}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="FovSlider"
                                                  Value="{Binding PerspFovDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding PerspFovMin}"
                                                  MaxBound="{Binding PerspFovMax}"
                                                  Step="{Binding PerspFovStep}"
                                                  DragSensitivity="5.0"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Units" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="FovUnitPickerHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewFovUnits}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewFovUnits}" />
                        </StackPanel>
                        <ComboBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="FovUnitPicker"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding FovUnits}"
                                  SelectedIndex="{Binding FovUnitIndex}" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Near" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="PerspNearHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewNear}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewPerspNear}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="4" Grid.Column="2"
                                                  Value="{Binding PerspNearDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Far" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="PerspFarHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewFar}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewPerspFar}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="6" Grid.Column="2"
                                                  Value="{Binding PerspFarDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Distance units" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="DistanceUnitsHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewDistanceUnits}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewDistanceUnits}" />
                        </StackPanel>
                        <ComboBox Grid.Row="8" Grid.Column="2"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DistanceUnits}"
                                  SelectedIndex="{Binding OrthoUnitIndex}" />
                      </Grid>

                      <!-- Orthographic parameters -->
                      <Grid ColumnDefinitions="Auto,16,*"
                            RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                            IsVisible="{Binding IsOrthographic}" IsEnabled="{Binding !IsComparisonLocked}">
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Half-Width" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoHalfWidthSliderHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewHalfWidth}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewHalfWidth}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="OrthoHalfWidthSlider"
                                                  Value="{Binding OrthoHalfWidthDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Half-Height" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoHalfHeightSliderHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewHalfHeight}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewHalfHeight}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="OrthoHalfHeightSlider"
                                                  Value="{Binding OrthoHalfHeightDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Units" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoUnitPickerHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewOrthoUnits}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewOrthoUnits}" />
                        </StackPanel>
                        <ComboBox Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="OrthoUnitPicker"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DistanceUnits}"
                                  SelectedIndex="{Binding OrthoUnitIndex}" />

                        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Near" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoNearHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewNear}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewOrthoNear}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="6" Grid.Column="2"
                                                  Value="{Binding OrthoNearDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Far" VerticalAlignment="Center" />
                          <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoFarHelp"
                                                       HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewFar}"
                                                       HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewOrthoFar}" />
                        </StackPanel>
                        <controls:UnboundedSlider Grid.Row="8" Grid.Column="2"
                                                  Value="{Binding OrthoFarDisplay}"
                                                  HasBounds="True"
                                                  MinBound="{Binding OrthoExtentMin}"
                                                  MaxBound="{Binding OrthoExtentMax}"
                                                  Step="{Binding OrthoExtentStep}"
                                                  IsLogarithmic="True"
                                                  DragSensitivity="5.0"
                                                  DisplayFormat="G5"
                                                  HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <CheckBox AutomationProperties.AutomationId="OrthoProportionsLock"
                                      Content="Keep Proportions Locked" IsChecked="{Binding IsOrthoProportionsLocked}" />
                            <controls:PropertyHelpButton AutomationProperties.AutomationId="OrthoProportionsLockHelp" VerticalAlignment="Center"
                                                         HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewProportionsLock}"
                                                         HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewProportionsLock}" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <CheckBox AutomationProperties.AutomationId="ShowBehindCameraCheckBox" Content="Show objects behind camera" IsChecked="{Binding ShowBehindCamera}" />
                            <controls:PropertyHelpButton AutomationProperties.AutomationId="ShowBehindCameraCheckBoxHelp" VerticalAlignment="Center"
                                                         HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewShowBehindCamera}"
                                                         HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewShowBehindCamera}" />
                          </StackPanel>
                          <Button AutomationProperties.AutomationId="RestoreOrthoProportionsButton"
                            ToolTip.Tip="Recompute the half-width from the half-height so the proportions match the viewport again." Content="Restore Proportions" Command="{Binding RestoreOrthoProportionsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Expander>

                  <!-- ── CometOrbiting (comet debug): physical nucleus lighting ── -->
                  <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsCometOrbitingMode}">
                    <CheckBox AutomationProperties.AutomationId="PhysicalLightingToggle"
                              Content="Physical lighting"
                              IsChecked="{Binding IsPhysicalLighting}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="PhysicalLightingToggleHelp" VerticalAlignment="Center"
                                                 HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewPhysicalLighting}"
                                                 HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewPhysicalLighting}" FlyoutMaxWidth="300" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,4,Auto">
                    <Button AutomationProperties.AutomationId="ViewNucleusFromEarthButton"
                            Content="Nucleus from Earth"
                            Command="{Binding ViewNucleusFromEarthCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="ViewNucleusFromEarthButtonHelp" Grid.Column="2" VerticalAlignment="Center"
                                                 HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewNucleusFromEarth}"
                                                 HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewNucleusFromEarth}" />
                  </Grid>

                  <!-- ── Comet / Earth observer: nucleus exposure ── -->
                  <StackPanel Spacing="4" IsVisible="{Binding !IsUpZenithMode}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                                 Text="{Binding NucleusExposureEv, StringFormat='Nucleus exposure: {0:+0.0;-0.0;0} EV'}" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="NucleusExposureSliderHelp"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderViewNucleusExposure}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpViewNucleusExposure}" />
                    </StackPanel>
                    <Slider AutomationProperties.AutomationId="NucleusExposureSlider"
                            Minimum="{Binding MinNucleusExposureEv}" Maximum="{Binding MaxNucleusExposureEv}"
                            SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding NucleusExposureEv}" />
                  </StackPanel>

                  <!-- ── UpZenith: snap above a body (animation only, no tracking) ── -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsUpZenithMode}">
                    <TextBlock Text="Snap above" FontWeight="SemiBold" />
                    <UniformGrid Columns="3" ColumnSpacing="6">
                      <Button Content="Sun" Command="{Binding SnapAboveSunCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the Sun (startup view), fitting the projection" />
                      <Button Content="Comet" Command="{Binding SnapAboveCometCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the committed comet, fitting the projection to its nucleus" />
                      <Button Content="Earth" Command="{Binding SnapAboveEarthCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Fly above the Earth, fitting the projection to its radius" />
                    </UniformGrid>
                  </StackPanel>

                  <!-- ── Earth Observer Mode Settings ─────────────────────── -->
                  <!-- Visible only when CameraMode = EarthPosition            -->
                  <StackPanel Spacing="12" IsVisible="{Binding IsEarthObserverMode}">
                    <Separator />
                    <TextBlock Text="Earth Observer Settings"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent.Primary}" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <CheckBox AutomationProperties.AutomationId="ObserverTopocentricCheckBox"
                                Content="Observer on the Earth's surface (topocentric)"
                                IsChecked="{Binding IsEarthObserverTopocentric}" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="ObserverTopocentricCheckBoxHelp" VerticalAlignment="Center"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverTopocentric}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverTopocentric}" FlyoutMaxWidth="320" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <CheckBox AutomationProperties.AutomationId="ObserverNorthUpCheckBox"
                                Content="North up"
                                IsChecked="{Binding IsEarthObserverNorthUp}" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="ObserverNorthUpCheckBoxHelp" VerticalAlignment="Center"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverNorthUp}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverNorthUp}" FlyoutMaxWidth="300" />
                    </StackPanel>

                    <!-- Latitude -->
                    <Grid ColumnDefinitions="Auto,16,*" IsVisible="{Binding IsEarthObserverTopocentric}">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Latitude (°N)" VerticalAlignment="Center" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="ObserverLatSliderHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverLatitude}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverLatitude}" />
                      </StackPanel>
                      <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="ObserverLatSlider"
                                                Value="{Binding EarthObserverLatDeg}"
                                                HasBounds="True" MinBound="-90" MaxBound="90"
                                                Step="0.1"
                                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Longitude -->
                    <Grid ColumnDefinitions="Auto,16,*" IsVisible="{Binding IsEarthObserverTopocentric}">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Longitude (°E)" VerticalAlignment="Center" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="ObserverLonSliderHelp"
                                                     HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverLongitude}"
                                                     HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverLongitude}" />
                      </StackPanel>
                      <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="ObserverLonSlider"
                                                Value="{Binding EarthObserverLonDeg}"
                                                HasBounds="True" MinBound="-180" MaxBound="180"
                                                Step="0.1"
                                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Look Direction -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Look Direction" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="LookDirectionHelp"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverLookDirection}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverLookDirection}" FlyoutMaxWidth="300" />
                    </StackPanel>
                    <Grid RowDefinitions="Auto, Auto, Auto, 8, Auto">
                      <RadioButton Grid.Row="0" AutomationProperties.AutomationId="OrientFree" Content="Free look"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=Free}" />
                      <RadioButton Grid.Row="1" AutomationProperties.AutomationId="OrientCometTracking" Content="Comet tracking"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=CometTracking}" />
                      <RadioButton Grid.Row="2" AutomationProperties.AutomationId="OrientSunTracking" Content="Sun tracking"
                                   IsChecked="{Binding EarthObserverOrientationMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter=SunTracking}" />
                      <Button Grid.Row="4" AutomationProperties.AutomationId="RestorePresetButton" Content="Restore preset projection"
                              Command="{Binding RestoreEarthPresetProjectionCommand}"
                              ToolTip.Tip="Re-applies the tracking projection where the target spans 10% of the view"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    </Grid>

                    <!-- Telescope scale of the view (physical pixels) -->
                    <Grid ColumnDefinitions="*,4,Auto"
                          IsVisible="{Binding EarthObserverScaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock AutomationProperties.AutomationId="EarthObserverScaleText"
                                 Text="{Binding EarthObserverScaleText}" TextWrapping="Wrap" Opacity="0.85" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="EarthObserverScaleTextHelp" Grid.Column="2" VerticalAlignment="Top"
                                                   HelpHeader="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpHeaderObserverScale}"
                                                   HelpContent="{Binding $parent[UserControl].((vm:ISettingsTabViewModel)DataContext).StrHelpObserverScale}" />
                    </Grid>

                    <!-- Tracking target below the horizon: explain the hold, suggest a site -->
                    <Border IsVisible="{Binding IsObserverTargetBelowHorizon}"
                            Background="{DynamicResource Accent.Subtle}"
                            BorderBrush="{DynamicResource Accent.Primary}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ObserverHorizonMessage}" TextWrapping="Wrap" />
                        <Button Content="Move observer there"
                                Command="{Binding ApplySuggestedObserverSiteCommand}"
                                ToolTip.Tip="Moves the observer to the latitude / longitude where the target is overhead now"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>