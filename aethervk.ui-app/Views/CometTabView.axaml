<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="900"
             x:Class="AetherVk.Views.CometTabView"
             x:DataType="vm:ICometTabViewModel">
  <Design.DataContext>
    <vm:DesignCometTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.status-ok">
      <Setter Property="Foreground" Value="{DynamicResource Sem.Success}" />
    </Style>
    <Style Selector="TextBlock.status-warn">
      <Setter Property="Foreground" Value="{DynamicResource Sem.Warning}" />
    </Style>
    <Style Selector="TextBlock.status-error">
      <Setter Property="Foreground" Value="{DynamicResource Sem.Error}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.step">
      <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Bg.Outline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="BorderBrush" Value="{DynamicResource Sem.Success}" />
    </Style>
    <Style Selector="Border.step TextBlock.step-number">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="Border.step.done TextBlock.step-number">
      <Setter Property="Foreground" Value="{DynamicResource Sem.Success}" />
    </Style>
    <Style Selector="Border.step TextBlock.step-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="Border.step.current TextBlock.step-label">
      <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.unit-of-measurement">
      <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
      <Setter Property="Margin" Value="4,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Bg.Canvas}" Padding="0">
    <ScrollViewer Classes="left-scrollbar" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Margin="12,12,12,24" IsEnabled="{Binding !IsSimulationRunning}">

        <!-- ═══════════════════════════════════════════════════════════════
        GUIDED FLOW (reviewer feedback item 3): what to enter, in order
        ═══════════════════════════════════════════════════════════════ -->
        <StackPanel AutomationProperties.AutomationId="GuidedSteps" Spacing="2">
          <WrapPanel Orientation="Horizontal">
            <Border Classes="step" Classes.current="{Binding IsStep1Current}" Classes.done="{Binding IsStep1Done}"
                    AutomationProperties.AutomationId="GuidedStep1"
                    ToolTip.Tip="{Binding StrStep1Help}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Panel>
                  <TextBlock Classes="step-number" Text="1" IsVisible="{Binding !IsStep1Done}" />
                  <TextBlock Classes="step-number" Text="✓" IsVisible="{Binding IsStep1Done}" />
                </Panel>
                <TextBlock Classes="step-label" Text="{Binding StrStep1}" />
              </StackPanel>
            </Border>
            <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource Text.Disabled}" Margin="0,0,4,4" />
            <Border Classes="step" Classes.current="{Binding IsStep2Current}" Classes.done="{Binding IsStep2Done}"
                    AutomationProperties.AutomationId="GuidedStep2"
                    ToolTip.Tip="{Binding StrStep2Help}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Panel>
                  <TextBlock Classes="step-number" Text="2" IsVisible="{Binding !IsStep2Done}" />
                  <TextBlock Classes="step-number" Text="✓" IsVisible="{Binding IsStep2Done}" />
                </Panel>
                <TextBlock Classes="step-label" Text="{Binding StrStep2}" />
              </StackPanel>
            </Border>
            <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource Text.Disabled}" Margin="0,0,4,4" />
            <Border Classes="step" Classes.current="{Binding IsStep3Current}" Classes.done="{Binding IsStep3Done}"
                    AutomationProperties.AutomationId="GuidedStep3"
                    ToolTip.Tip="{Binding StrStep3Help}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Panel>
                  <TextBlock Classes="step-number" Text="3" IsVisible="{Binding !IsStep3Done}" />
                  <TextBlock Classes="step-number" Text="✓" IsVisible="{Binding IsStep3Done}" />
                </Panel>
                <TextBlock Classes="step-label" Text="{Binding StrStep3}" />
              </StackPanel>
            </Border>
            <TextBlock Text="→" FontSize="11" Foreground="{DynamicResource Text.Disabled}" Margin="0,0,4,4" />
            <Border Classes="step" Classes.current="{Binding IsStep4Current}" Classes.done="{Binding IsStep4Done}"
                    AutomationProperties.AutomationId="GuidedStep4"
                    ToolTip.Tip="{Binding StrStep4Help}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Panel>
                  <TextBlock Classes="step-number" Text="4" IsVisible="{Binding !IsStep4Done}" />
                  <TextBlock Classes="step-number" Text="✓" IsVisible="{Binding IsStep4Done}" />
                </Panel>
                <TextBlock Classes="step-label" Text="{Binding StrStep4}" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <TextBlock AutomationProperties.AutomationId="GuidedStepHelpText" Text="{Binding CurrentStepHelp}"
                     FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════
        SECTION 1: COMET SELECTION (steps 1 and 2)
        ═══════════════════════════════════════════════════════════════ -->
        <Expander Header="Comet Selection" IsExpanded="True">
          <StackPanel Spacing="8" Margin="4,4,4,4">

            <!-- Committed state banner -->
            <Border Background="{DynamicResource Bg.Canvas.Alt}"
                    BorderBrush="{DynamicResource Sem.Success}"
                    BorderThickness="1" CornerRadius="4" Padding="8,6"
                    IsVisible="{Binding IsAlmanacCommitted}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Classes="status-ok" FontWeight="SemiBold"
                             Text="✓ Committed" FontSize="11" />
                  <TextBlock AutomationProperties.AutomationId="CommittedCometName" Text="{Binding CommittedCometName}"
                             FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource Text.Primary}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Undo"
                        Command="{Binding DecommitCometCommand}"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        ToolTip.Tip="Detach comet SPK from simulation and reset to default"
                        ToolTip.ShowDelay="500" />
              </Grid>
            </Border>

            <!-- Search row -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" AutomationProperties.AutomationId="CometSearchBox"
                ToolTip.Tip="Comet name or designation to search for, for example 67P or Halley. Press Enter to search."
                       Text="{Binding SearchQuery}"
                       Watermark="Search comets (e.g. 67P, Halley)…"
                       FontSize="12">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCometsCommand}" />
                </TextBox.KeyBindings>
                <i:Interaction.Behaviors>
                  <ia:EventTriggerBehavior EventName="DoubleTapped">
                    <ia:InvokeCommandAction Command="{Binding SearchCometsCommand}" />
                  </ia:EventTriggerBehavior>
                </i:Interaction.Behaviors>
                <TextBox.InnerRightContent>
                  <Arc IsVisible="{Binding IsSearching}"
                       Width="14" Height="14" Margin="6"
                       StartAngle="0" SweepAngle="270"
                       Stroke="{DynamicResource Accent.Active}"
                       StrokeThickness="2">
                    <Arc.RenderTransform>
                      <RotateTransform />
                    </Arc.RenderTransform>
                    <Arc.Styles>
                      <Style Selector="Arc">
                        <Style.Animations>
                          <Animation Duration="0:0:1" IterationCount="Infinite">
                            <KeyFrame Cue="0%">
                              <Setter Property="RotateTransform.Angle" Value="0" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                              <Setter Property="RotateTransform.Angle" Value="360" />
                            </KeyFrame>
                          </Animation>
                        </Style.Animations>
                      </Style>
                    </Arc.Styles>
                  </Arc>
                </TextBox.InnerRightContent>
              </TextBox>
              <Button Grid.Column="1" AutomationProperties.AutomationId="CometSearchButton"
                ToolTip.Tip="Search for comets matching the text. Select one from the list to see its available ephemeris (SPK) records."
                      Content="Search"
                      Command="{Binding SearchCometsCommand}"
                      Classes="accent"
                      IsEnabled="{Binding !IsSearching}"
                      Padding="10,6" />
            </Grid>

            <!-- Search results -->
            <ListBox AutomationProperties.AutomationId="CometResultsList"
              ToolTip.Tip="Comets matching the search. Select one to list its ephemeris (SPK) records." ItemsSource="{Binding FilteredSearchResults}"
                     SelectedItem="{Binding SelectedComet}"
                     MaxHeight="140"
                     IsVisible="{Binding FilteredSearchResults.Count}"
                     Background="{DynamicResource Bg.Canvas.Alt}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource Bg.Outline}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="2,2">
                    <TextBlock Text="{Binding Name}" FontSize="12" />
                    <TextBlock Text="{Binding PrimaryDesignation}"
                               FontSize="10"
                               Foreground="{DynamicResource Text.Disabled}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- SPK records section (visible when comet selected) -->
            <StackPanel Spacing="6"
                        IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="Available SPK Records:" FontSize="11"
                         Foreground="{DynamicResource Text.Secondary}" />
              <TextBlock Text="Loading records…" FontSize="11"
                         Foreground="{DynamicResource Text.Disabled}"
                         IsVisible="{Binding IsLoadingSpkRecords}" />
              <ListBox AutomationProperties.AutomationId="SpkRecordsList"
                ToolTip.Tip="Ephemeris (SPK) records of the selected comet: each is a fit of its orbit. Select one, then press Download &amp; Commit." ItemsSource="{Binding SpkRecords}"
                       SelectedItem="{Binding SelectedSpkRecord}"
                       MaxHeight="120"
                       IsVisible="{Binding SpkRecords.Count}"
                       Background="{DynamicResource Bg.Canvas.Alt}"
                       BorderThickness="1"
                       BorderBrush="{DynamicResource Bg.Outline}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="2,2">
                      <TextBlock Grid.Column="0" Text="{Binding RecordId}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="11" Width="70"
                                 Foreground="{DynamicResource Text.Disabled}" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="11" />
                        <TextBlock Text="{Binding EpochYear}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Text.Disabled}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

          </StackPanel>
        </Expander>

        <!-- ═══════════════════════════════════════════════════════════════
        SECTION 2: SIMULATED RANGE (step 3; reviewer feedback item 7: entered here, the
        Timeline tab only shows it and the progress)
        ═══════════════════════════════════════════════════════════════ -->
        <Expander Header="{Binding StrSimulatedRange}" AutomationProperties.AutomationId="SimulatedRangeSection" IsExpanded="True">
          <StackPanel Spacing="6" Margin="4,4,4,4">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Start (TDB):" />
              <TextBox Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="StartEpochBox"
                       Text="{Binding Range.StartEpoch}" Watermark="e.g. 2000-01-01T12:00:00Z"
                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                       ToolTip.Tip="Start of the simulated period (ISO 8601, e.g. 2000-01-01T12:00:00Z). Typing here only proposes a range; Download &amp; Commit applies it. The period must be at least 1 day long." />
              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="End (TDB):" />
              <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="EndEpochBox"
                       Text="{Binding Range.EndEpoch}" Watermark="e.g. 2000-02-01T12:00:00Z"
                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                       ToolTip.Tip="End of the simulated period (ISO 8601). It must be at least 1 day after the start. Typing here only proposes a range; Download &amp; Commit applies it." />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button AutomationProperties.AutomationId="RestoreButton" Content="Restore" Command="{Binding Range.RestoreCommand}" IsEnabled="{Binding Range.CanRestore}"
                      ToolTip.Tip="Puts the committed range (the one the simulation runs) back in the Start/End boxes and drops the edit." ToolTip.ShowDelay="1000" />
              <!-- Indicator: proposed range differs from committed -->
              <TextBlock Text="●" Foreground="{DynamicResource Sem.Warning}" IsVisible="{Binding Range.IsRangeLocked}" ToolTip.Tip="Proposed range differs from committed" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Range.HasProposedState}">
              <TextBlock Text="Proposed:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Text.Secondary}" />
              <TextBlock AutomationProperties.AutomationId="ProposedRangeText" Text="{Binding Range.DisplayProposedRange}" TextWrapping="Wrap"
                         ToolTip.Tip="The range in the boxes: what the next Download &amp; Commit or Recommit will use. It does not change the running simulation."
                         FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace" />
            </StackPanel>

            <!-- Error Message -->
            <TextBlock AutomationProperties.AutomationId="TimelineErrorText" Text="{Binding Range.ErrorMessage}" Foreground="{DynamicResource Sem.Error}"
                       IsVisible="{Binding Range.HasError}" FontSize="11" TextWrapping="Wrap" />

            <!-- Edited after a commit: the engine keeps the committed range until a recommit -->
            <StackPanel AutomationProperties.AutomationId="RangeLockedPanel" Spacing="4" IsVisible="{Binding Range.IsRangeLocked}">
              <TextBlock Text="{x:Static vm:RangeEntryViewModel.RangeLockedText}" Foreground="{DynamicResource Sem.Warning}" FontSize="11" TextWrapping="Wrap" />
              <Button AutomationProperties.AutomationId="RecommitWithRangeButton" Content="Recommit with this range" Command="{Binding Range.RecommitWithRangeCommand}"
                      ToolTip.Tip="Commits the comet again (as Download &amp; Commit) with the range in the boxes. The dust restarts from the new start." />
            </StackPanel>

            <!-- "Model" preset (feedback #20): N nucleus rotations ending at the image epoch -->
            <WrapPanel Orientation="Horizontal">
              <TextBlock Classes="label" Text="Model range:" Margin="0,0,6,4" />
              <TextBox AutomationProperties.AutomationId="ModelRotationsBox" Margin="0,0,6,4"
                       ToolTip.Tip="Number of full nucleus rotations (a whole number, at least 1) that the model range should span. One rotation lasts the rotation period (Rotational Model: 360 deg divided by the rotation rate)." Text="{Binding Range.ModelRotations}" Width="48" />
              <TextBlock Classes="label" Text="rotations ending at" Margin="0,0,6,4" />
              <TextBox AutomationProperties.AutomationId="ModelEndEpochBox" Margin="0,0,6,4"
                       ToolTip.Tip="End of the model range, normally the epoch of your telescope image (the FITS &quot;Model range&quot; button fills it with the observation epoch). Leave empty to use the End box." Text="{Binding Range.ModelEndEpoch}" Width="170" Watermark="image epoch (empty: End)" />
              <Button AutomationProperties.AutomationId="ApplyModelRangeButton" Content="Set range" Command="{Binding Range.ApplyModelRangeCommand}" Margin="0,0,0,4"
                      ToolTip.Tip="Sets Start and End so the range ends at the image epoch and starts N nucleus rotation periods earlier (N x period, never less than 1 day). The simulated dust history then covers N full spins before the image. It only proposes the range: Download &amp; Commit applies it." />
            </WrapPanel>

            <!-- R3: jets ignite this long before the committed start, so the tail exists when play starts -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="label" Text="Dust lead time:" />
              <TextBox AutomationProperties.AutomationId="DustLeadDaysBox"
                       ToolTip.Tip="Days the jets start emitting before the start epoch (0 to 30; 30 = one dust lifetime, the default). With 30 the tail is already fully formed when the timeline starts; with 0 the jets switch on at the start and the tail grows from nothing. Used the next time the comet is committed." Text="{Binding Range.DustLeadDays}" Width="56" />
              <TextBlock Classes="label" Text="days before the start" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- ═══════════════════════════════════════════════════════════════
        SECTION 3: COMMIT (step 4)
        ═══════════════════════════════════════════════════════════════ -->
        <StackPanel Spacing="8" Margin="4,0,4,0">
            <!-- Timeline-changed-after-commit warning -->
            <Border Background="{DynamicResource Bg.Canvas.Alt}"
                    BorderBrush="{DynamicResource Sem.Warning}"
                    BorderThickness="1" CornerRadius="4" Padding="8,6"
                    IsVisible="{Binding HasTimelineChangedAfterCommit}">
              <TextBlock TextWrapping="Wrap" FontSize="11"
                         Foreground="{DynamicResource Sem.Warning}"
                         Text="⚠ Timeline has changed since last commit. Re-commit to update the comet trajectory." />
            </Border>

            <!-- Reference orbit (required before the first commit, locked while committed) -->
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Reference orbit" VerticalAlignment="Center" />
                <controls:PropertyHelpButton
                  HelpHeader="Reference orbit"
                  HelpContent="The red track is a two-body (Keplerian) reference next to the true SPK path.&#x0A;&#x0A;SBDB solution: the elements JPL publishes, osculating at the solution epoch, which can be years away from your window (67P: 2015-10-10, about 0.12 AU off its 2025 path because of Jupiter).&#x0A;&#x0A;Osculating at start epoch: elements recomputed from the SPK position and velocity at your start epoch. Exact there, and within about 10³ km over a month (planetary perturbations and outgassing forces).&#x0A;&#x0A;Cannot be changed while a comet is committed." />
              </StackPanel>
              <ComboBox AutomationProperties.AutomationId="ReferenceOrbitPicker" SelectedIndex="{Binding ReferenceOrbitIndex}"
                        ToolTip.Tip="{Binding StrTipReferenceOrbit}"
                        IsEnabled="{Binding IsReferenceOrbitSelectable}"
                        PlaceholderText="Choose a reference orbit…"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Content="SBDB solution (its own epoch)" />
                <ComboBoxItem Content="Osculating at start epoch (from SPK)" />
              </ComboBox>
            </StackPanel>

            <!-- Download & Commit button -->
            <Button AutomationProperties.AutomationId="DownloadCommitButton" Content="Download &amp; Commit"
                    Command="{Binding DownloadAndCommitCommand}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="0,8"
                    IsEnabled="{Binding !IsDownloading}"
                    ToolTip.Tip="Download the selected SPK and attach it to the simulation"
                    ToolTip.ShowDelay="500" />

            <!-- Status text -->
            <TextBlock AutomationProperties.AutomationId="DownloadStatusText" Text="{Binding DownloadStatus}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource Text.Secondary}" />

          </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════════
        NUCLEUS: physical parameters (feedback item 10b; editable before a commit)
        ═══════════════════════════════════════════════════════════════ -->
        <Expander Header="{Binding StrNucleus}" AutomationProperties.AutomationId="NucleusSection" IsExpanded="True">
          <StackPanel Spacing="6" Margin="4,4,4,4">
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding StrNucleusRadius}" VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="NucleusRadiusSlider"
                                        Value="{Binding ManualNucleusRadiusKmNullable}"
                                        HasBounds="True"
                                        MinBound="0.1"
                                        MaxBound="100.0"
                                        ToolTip.Tip="Bounding-sphere radius of the comet nucleus in km; jets start on this sphere.&#x0A;Auto-filled from Horizons when a comet is committed. Override here if needed.&#x0A;An edit after Play returns the simulation to the snapshot taken at Play.">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="km" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>
            <TextBlock Margin="4,0,4,2"
                       IsVisible="{Binding IsNucleusRadiusUnknown}"
                       Text="⚠ Enter a radius or commit a comet to enable jet creation."
                       Foreground="{DynamicResource Text.Tertiary}"
                       FontSize="11"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <!-- ═══════════════════════════════════════════════════════════════
        SECTION 3: ROTATIONAL MODEL (enabled only when committed)
        ═══════════════════════════════════════════════════════════════ -->
        <Expander Header="Rotational Model" AutomationProperties.AutomationId="RotationalModelSection"
                  IsExpanded="{Binding IsAlmanacCommitted}"
                  IsEnabled="{Binding IsAlmanacCommitted}">
          <StackPanel Spacing="6" Margin="4,4,4,4">

            <TextBlock Text="Changes are pushed live to the simulation (debounced 250 ms)."
                       FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Disabled}" />

            <!-- Pole RA -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Pole RA" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="PoleRaHelp" HelpHeader="Pole RA"
                                             HelpContent="Where the spin axis points on the sky (J2000). These are not rotations: the nucleus rotates only about its own axis, and the axis stays fixed in space. RA/Dec only orient it." />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="PoleRaSlider" ToolTip.Tip="{Binding StrTipPoleRa}" Value="{Binding PoleRaDeg}" Step="0.1">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Pole Dec -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Pole Dec" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="PoleDecHelp" HelpHeader="Pole Dec"
                                             HelpContent="Where the spin axis points on the sky (J2000). These are not rotations: the nucleus rotates only about its own axis, and the axis stays fixed in space. RA/Dec only orient it." />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="PoleDecSlider" ToolTip.Tip="{Binding StrTipPoleDec}" Value="{Binding PoleDecDeg}" Step="0.1">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Prime Meridian -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Prime Meridian" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="PrimeMeridianHelp" HelpHeader="Prime Meridian"
                                             HelpContent="The nucleus' rotation angle at the reference date J2000 (where longitude 0 faces). It sets which side faces where at a given time, i.e. the timing of the jet spirals, not the outline of the fan." />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="PrimeMeridianSlider" ToolTip.Tip="{Binding StrTipPrimeMeridian}" Value="{Binding PrimeMeridianDeg}" Step="0.1">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Rotation Period: the control; the same spin as the °/day rate in the expander below -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Rotation Period (h)" VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="RotPeriodHelp" HelpHeader="Rotation Period (h)"
                                             HelpContent="Sidereal spin period. Edits the rate in the Advanced expander (°/day); the sign (prograde/retrograde) is kept. Example: 718 °/day = 12.03 h." />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="RotPeriodSlider" ToolTip.Tip="{Binding StrTipRotPeriod}" Value="{Binding RotationPeriodHours}" Step="0.01">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="h" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Precession and the °/day rate: rarely needed, so out of the way -->
            <Expander AutomationProperties.AutomationId="PolePrecessionExpander" Margin="0,2">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Advanced: rates (precession, °/day)" />
                  <controls:PropertyHelpButton AutomationProperties.AutomationId="RatesAdvancedHelp"
                                               HelpHeader="Advanced: rates"
                                               HelpContent="RA/Dec rates are a slow drift of the spin axis (precession), °/century, 0 by default. The rotation rate is the same spin as the period, in °/day (360·24 / period h)." />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
            <!-- RA Rate -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="label" Text="RA Rate" VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2" Value="{Binding PoleRaRateDegCen}"
                ToolTip.Tip="Slow drift of the spin axis right ascension (precession), in degrees per Julian century. 0 keeps the axis fixed." Step="0.001">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°/cen" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Dec Rate -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="label" Text="Dec Rate" VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2" Value="{Binding PoleDecRateDegCen}"
                ToolTip.Tip="Slow drift of the spin axis declination (precession), in degrees per Julian century. 0 keeps the axis fixed." Step="0.001">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°/cen" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <!-- Rotation Rate -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="label" Text="Rotation Rate (°/day)" VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="RotRateSlider"
                ToolTip.Tip="Nucleus spin rate in degrees per day (the IAU rotation rate W). The sign gives prograde (+) or retrograde (-) spin; the period in hours is 360 x 24 / |rate|." Value="{Binding RotRateDegDay}" Step="0.01">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="°/day" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>
              </StackPanel>
            </Expander>

            <!-- Body-Fixed Camera -->
            <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto" Margin="4,2">
              <TextBlock Grid.Column="0" Classes="label" Text="Camera orientation is body-fixed with respect to camera" VerticalAlignment="Center" TextWrapping="Wrap" />
              <ComboBox Grid.Column="2" AutomationProperties.AutomationId="BodyFixedOrientationPicker"
                ToolTip.Tip="Yes: a camera attached to the nucleus turns with it, so the nucleus surface stays fixed in the view. No: the spin is compensated, so the view keeps its direction relative to the stars while the nucleus rotates." SelectedIndex="{Binding BodyFixedOrientationIndex}" HorizontalAlignment="Center">
                <ComboBoxItem>Yes</ComboBoxItem>
                <ComboBoxItem>No</ComboBoxItem>
              </ComboBox>
            </Grid>

          </StackPanel>
        </Expander>

        <ContentControl x:Name="DebugContainer" />

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>