<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:AetherVk.Logic.Models"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:converters="using:AetherVk.Converters"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="AetherVk.Views.Components.ParticleEmitterCirclesView"
             x:DataType="models:ParticleEmitterCirclesComponent">
    <UserControl.Resources>
        <converters:UintToColorConverter x:Key="UintToColor" />
    </UserControl.Resources>
    <Design.DataContext>
        <models:ParticleEmitterCirclesComponent />
    </Design.DataContext>

    <Expander Header="{Binding Name}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,8">
        <StackPanel Spacing="8" Margin="4">

            <!-- List of emission circles -->
            <ListBox ItemsSource="{Binding Circles}" x:Name="circlesList"
                     Classes="list-tray" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:EmissionCircleItem">
                        <Border Classes="list-tray-item dense" Background="{DynamicResource Bg.Surface}"
                                CornerRadius="8" Margin="0,0,0,8" Padding="16,12"
                                BoxShadow="0 2 6 0 #1A000000">
                            <StackPanel Spacing="12">
                                <!-- Row 0: colour swatch + label + remove button -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="18" Height="18"
                                            CornerRadius="9" Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ColorArgbUint, Converter={StaticResource UintToColor}}"/>
                                        </Border.Background>
                                    </Border>
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                         <TextBlock Text="Emission Jet"
                                                    FontWeight="SemiBold" FontSize="14"/>
                                         <StackPanel Orientation="Horizontal" Spacing="4">
                                             <TextBlock Text="●" FontSize="9"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        VerticalAlignment="Center"/>
                                             <TextBlock Text="{Binding AliveCountText}" FontSize="11"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        ToolTip.Tip="Live GPU particle count"/>
                                         </StackPanel>
                                     </StackPanel>
                                    <Button Grid.Column="2" Content="✕"
                                            Classes="icon" Padding="8,4" FontSize="12"
                                            VerticalAlignment="Center" Background="Transparent"
                                            Command="{Binding $parent[ListBox].((models:ParticleEmitterCirclesComponent)DataContext).RemoveCircleCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove this emission jet"/>
                                </Grid>

                                <!-- ═══ PHYSICAL PARAMETERS ════════════════════════════════════════════ -->

                                <!-- Changes here affect physics and will invalidate the simulation.     -->
                                <Border Margin="0,4,0,0" Padding="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                            <TextBlock Text="⚛" FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="PHYSICAL PARAMETERS" FontSize="10"
                                                       FontWeight="SemiBold" Opacity="0.6"
                                                       LetterSpacing="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="· changes restart simulation"
                                                       FontSize="10" Opacity="0.4"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <!-- Surface position -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Latitude (°)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding LatitudeDeg}" HasBounds="True" MinBound="-90" MaxBound="90" Step="1" Width="120"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Longitude (°)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding LongitudeDeg}" IsWrapped="True" WrapMin="0" WrapMax="360" Step="1" Width="120"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Jet radius (km)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding CircleRadiusKm}" HasBounds="True" MinBound="0.001" Step="0.01" Width="120"/>
                                            </StackPanel>
                                            <!-- Dust grain mass -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Grain mass (g)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding MassGrams}" HasBounds="True" MinBound="0" Step="0.01" Width="120"/>
                                                <TextBlock Text="{Binding MassGrams, StringFormat='{}{0:G4} g'}"
                                                           FontSize="10" Opacity="0.55" Margin="0,2,0,0"
                                                           FontFamily="Consolas,Monospace"/>
                                            </StackPanel>
                                            <!-- Emission rate + lifetime -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Rate (/s)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding ParticlesPerSecondDouble}" HasBounds="True" MinBound="0" Step="100" Width="120"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Lifetime (ticks)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding TTLDouble}" HasBounds="True" MinBound="1" Step="10" Width="120"
                                                                           ToolTip.Tip="{Binding TtlHintText}"/>
                                                <TextBlock Text="{Binding TtlHintText}" FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Opacity="0.7" Margin="0,2,0,0" Width="120"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Max particles" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding MaxParticlesDouble}" HasBounds="True" MinBound="64" Step="256" Width="120"
                                                                           ToolTip.Tip="GPU ring-buffer capacity. Changes rebuild the particle system. Default: 16384."/>
                                                <TextBlock Text="{Binding MaxParticles, StringFormat='{}{0:N0}'}"
                                                           FontSize="10" Opacity="0.55" Margin="0,2,0,0"
                                                           FontFamily="Consolas,Monospace"/>
                                            </StackPanel>
                                            <!-- Velocity -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Velocity (km/s)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <controls:UnboundedSlider Value="{Binding MeanVelocityKms}" HasBounds="True" MinBound="0.0" Step="0.001" Width="120"/>
                                                <TextBlock Text="{Binding MeanVelocityKms, StringFormat='{}{0:G4} km/s'}"
                                                           FontSize="10" Opacity="0.55" Margin="0,2,0,0"
                                                           FontFamily="Consolas,Monospace"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Dir. spread (°)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"
                                                           ToolTip.Tip="Cone half-angle for emission direction randomness. 0 = collimated jet."/>
                                                <controls:UnboundedSlider Value="{Binding VelocityDirStdDevDeg}" HasBounds="True" MinBound="0.0" MaxBound="180.0" Step="1" Width="120"/>
                                                <TextBlock Text="{Binding VelocityDirStdDevDeg, StringFormat='{}{0:G4}°'}"
                                                           FontSize="10" Opacity="0.55" Margin="0,2,0,0"
                                                           FontFamily="Consolas,Monospace"/>
                                            </StackPanel>
                                            <!-- Radiation pressure -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="β (rad. pressure)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"
                                                           ToolTip.Tip="Ratio of radiation pressure to gravity. β=1 means full gravity cancellation (dust floats). β=0 means no radiation pressure."/>
                                                <controls:UnboundedSlider Value="{Binding Beta}" HasBounds="True" MinBound="0.0" Step="0.05" Width="120"/>
                                            </StackPanel>
                                            <!-- Spawn scatter -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Spawn scatter (km)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"
                                                           ToolTip.Tip="Randomly offset spawn positions within this disc radius. 0 = point source."/>
                                                <controls:UnboundedSlider Value="{Binding SpawnRadiusKm}" HasBounds="True" MinBound="0.0" Step="0.01" Width="120"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ VISUAL / DISPLAY PARAMETERS ══════════════════════════════════ -->
                                <!-- Changes here are cosmetic only and do not affect physics.         -->
                                <Border Padding="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                            <TextBlock Text="🎨" FontSize="11" Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="VISUAL PARAMETERS" FontSize="10"
                                                       FontWeight="SemiBold" Opacity="0.6"
                                                       LetterSpacing="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="· no simulation restart"
                                                       FontSize="10" Opacity="0.4"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <!-- Particle billboard size -->
                                            <StackPanel Margin="0,0,16,12">
                                                <TextBlock Text="Particle size (km)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"
                                                           ToolTip.Tip="Visual billboard radius per particle. Changes are live — no restart needed."/>
                                                <controls:UnboundedSlider Value="{Binding RenderRadiusKmDouble}" HasBounds="True" MinBound="0.001" Step="0.005" Width="120"/>
                                                <TextBlock Text="{Binding RenderRadiusKmDouble, StringFormat='{}{0:G4} km'}"
                                                           FontSize="10" Opacity="0.55" Margin="0,2,0,0"
                                                           FontFamily="Consolas,Monospace"/>
                                            </StackPanel>
                                            <!-- Colour -->
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Colour" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                                                <ColorPicker Color="{Binding ColorArgbUint, Converter={StaticResource UintToColor}, Mode=TwoWay}"
                                                             IsAlphaVisible="True"
                                                             Width="200" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add circle button -->
            <Button Content="＋ Add Emission Jet"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Classes="accent" Margin="0,4,0,0"
                    Command="{Binding AddCircleCommand}"/>
        </StackPanel>
    </Expander>
</UserControl>

