<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:models="using:AetherVk.Logic.Models"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:input="using:AetherVk.Input"
             x:DataType="vm:PropertiesViewModel"
             x:Class="AetherVk.Views.PropertiesView"
             input:ActionContext.Id="PropertiesPanel"
             input:ActionContext.Handler="{Binding}">
    <Grid RowDefinitions="Auto, *">
        <FlyoutBase.AttachedFlyout>
            <Flyout IsOpen="{Binding IsFlyoutMenuOpen}" Placement="Right">
                 <TextBlock Text="1: Add Cube" />
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <Grid Grid.Row="0" Margin="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Properties -" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Text="{Binding SelectedEntity.Name}" FontWeight="Bold" VerticalAlignment="Center" MinWidth="150" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Content="Delete Entity"
                    Command="{Binding DeleteSelectedEntityCommand}"
                    IsVisible="{Binding SelectedEntity.IsMeasurement}"
                    Classes="accent" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="4">
            <ItemsControl ItemsSource="{Binding PropertiesExpanders}" IsEnabled="{Binding !Timeline.IsPlaying}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:UnknownComponentViewModel">
                        <Expander Header="{Binding ComponentName}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <TextBlock Text="no properties available" FontStyle="Italic" Opacity="0.5" Margin="4" />
                        </Expander>
                    </DataTemplate>

                    <!-- Transform Component -->
                    <DataTemplate DataType="models:TransformComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch" ToolTip.Tip="Transform units are expressed in physical units relative to their parent Reference Frame (Macro = AU, Micro = km).">
                            <StackPanel Spacing="4">
                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Position" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyPositionCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding PosX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding PosY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding PosZ}"/>
                                    </Grid>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Rotation (Quat)" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyRotationCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="W:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding RotW}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding RotX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding RotY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="6" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="7" Value="{Binding RotZ}"/>
                                    </Grid>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Scale" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyScaleCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding ScaleX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding ScaleY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding ScaleZ}"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- HighRes Transform Component (f64 position) -->
                    <DataTemplate DataType="models:HighResTransformComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch" ToolTip.Tip="High-precision transform with f64 position. Units are expressed in physical units relative to their parent Reference Frame (Macro = AU, Micro = km).">
                            <StackPanel Spacing="4">
                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Position (f64)" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyPositionCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding PosX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding PosY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding PosZ}"/>
                                    </Grid>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Rotation (Quat)" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyRotationCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="W:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding RotW}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding RotX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding RotY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="6" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="7" Value="{Binding RotZ}"/>
                                    </Grid>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Scale" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Classes="icon" Command="{Binding CopyScaleCommand}" ToolTip.Tip="Copy to Clipboard" Background="Transparent" Padding="4" Margin="8,0,0,0">
                                                <PathIcon Data="M19,21H8V7H19M19,5H14.82C14.4,3.84 13.3,3 12,3C10.7,3 9.6,3.84 9.18,5H5V21A2,2 0 0,0 7,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M12,5A1,1 0 0,1 13,6A1,1 0 0,1 12,7A1,1 0 0,1 11,6A1,1 0 0,1 12,5Z" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsEditable}">
                                        <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="1" Value="{Binding ScaleX}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="3" Value="{Binding ScaleY}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <controls:UnboundedSlider Grid.Column="5" Value="{Binding ScaleZ}"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- Camera Component -->
                    <DataTemplate DataType="models:CameraComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <CheckBox Content="Orthographic" IsChecked="{Binding IsOrthographic}" />

                                <Expander Header="Projection" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FOV (°):" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding !IsOrthographic}"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                       Value="{Binding Fov}"
                                                       Minimum="0.1" Maximum="179.0"
                                                       Increment="0.5" FormatString="0.0°"
                                                       IsVisible="{Binding !IsOrthographic}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Left:" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsOrthographic}"/>
                                        <controls:UnboundedSlider Grid.Row="1" Grid.Column="1" Value="{Binding OrthoLeft}" IsVisible="{Binding IsOrthographic}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Right:" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsOrthographic}"/>
                                        <controls:UnboundedSlider Grid.Row="2" Grid.Column="1" Value="{Binding OrthoRight}" IsVisible="{Binding IsOrthographic}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom:" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsOrthographic}"/>
                                        <controls:UnboundedSlider Grid.Row="3" Grid.Column="1" Value="{Binding OrthoBottom}" IsVisible="{Binding IsOrthographic}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Top:" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsOrthographic}"/>
                                        <controls:UnboundedSlider Grid.Row="4" Grid.Column="1" Value="{Binding OrthoTop}" IsVisible="{Binding IsOrthographic}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Near (AU):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="1"
                                                       Value="{Binding NearPlane}"
                                                       Minimum="0.00001" Maximum="9999.999"
                                                       Increment="0.00001" FormatString="0.########"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Far (AU):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <NumericUpDown Grid.Row="6" Grid.Column="1"
                                                       Value="{Binding FarPlane}"
                                                       Minimum="0.000001" Maximum="10000.0"
                                                       Increment="1.0" FormatString="0.###"/>
                                    </Grid>
                                </Expander>

                                <TextBlock Text="Projection Matrix Preview" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ProjectionMatrixPreview}" FontFamily="Consolas, Monospace" Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <DataTemplate DataType="models:ScreenSpaceBillboardComponent">
                        <Expander IsExpanded="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).AreAllExpanded, FallbackValue=False}" Classes="ComponentExpander">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            </Expander.Header>
                            <StackPanel Spacing="5" Margin="5">
                                <Grid ColumnDefinitions="*,2*">
                                    <TextBlock Text="Image:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ImagePath}" Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                                        <TextBlock Text="Opacity:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                                        <Button Classes="icon" Padding="4,2" FontSize="11"
                                                Background="Transparent" ToolTip.Tip="Quick alpha slider">
                                            <Button.Content>
                                                <TextBlock Text="α" FontWeight="Bold" />
                                            </Button.Content>
                                            <Button.Flyout>
                                                <Flyout Placement="Right">
                                                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="8" Padding="12" MinWidth="200">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="Opacity" FontWeight="SemiBold" />
                                                            <Slider Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                                                            <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}" HorizontalAlignment="Right" Foreground="{DynamicResource Text.Secondary}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Value="{Binding Opacity}" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" />
                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" Foreground="{DynamicResource Text.Secondary}" Margin="6,0,0,0" />
                                </Grid>
                                <Grid ColumnDefinitions="*,2*">
                                    <TextBlock Text="Scale:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                                    <controls:UnboundedSlider Grid.Column="1" Value="{Binding Scale}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Rotation:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,8,0" />
                                    <Slider Grid.Column="1" Value="{Binding RotationDeg}" Minimum="-360" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="False" />
                                    <TextBlock Grid.Column="2" Text="{Binding RotationDeg, StringFormat='{}{0:F1}°'}" VerticalAlignment="Center" MinWidth="50" TextAlignment="Right" Foreground="{DynamicResource Text.Secondary}" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- Sun Component -->
                    <DataTemplate DataType="models:SunComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding PositionX, StringFormat='Pos X: {0}'}" />
                                <TextBlock Text="{Binding PositionY, StringFormat='Pos Y: {0}'}" />
                                <TextBlock Text="{Binding PositionZ, StringFormat='Pos Z: {0}'}" />
                                <TextBlock Text="{Binding Temperature, StringFormat='Temperature: {0} K'}" />
                                <CheckBox Content="Show Bounding Box" IsChecked="{Binding ShowBoundingBox}" />
                                <CheckBox Content="Follow" IsChecked="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).IsFollowingEntity}" />
                                <Button Content="Snap Camera" Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).SnapToSelectedEntityCommand}" Classes="accent" Margin="0,8,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- Planet Component -->
                    <DataTemplate DataType="models:PlanetComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Position" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PositionX, StringFormat='X: {0}'}" />
                                <TextBlock Text="{Binding PositionY, StringFormat='Y: {0}'}" />
                                <TextBlock Text="{Binding PositionZ, StringFormat='Z: {0}'}" />
                                <TextBlock Text="Velocity" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding VelocityX, StringFormat='X: {0}'}" />
                                <TextBlock Text="{Binding VelocityY, StringFormat='Y: {0}'}" />
                                <TextBlock Text="{Binding VelocityZ, StringFormat='Z: {0}'}" />
                                <CheckBox Content="Show Bounding Box" IsChecked="{Binding ShowBoundingBox}" Margin="0,8,0,0"/>
                                <CheckBox Content="Follow" IsChecked="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).IsFollowingEntity}" />
                                <Button Content="Snap Camera" Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).SnapToSelectedEntityCommand}" Classes="accent" Margin="0,8,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- Cursor/Grid Component -->
                    <DataTemplate DataType="models:CursorComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <CheckBox Content="Is Visible" IsChecked="{Binding IsVisible}" />
                                <CheckBox Content="Follow" IsChecked="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).IsFollowingEntity}" />
                                <Button Content="Snap Camera" Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).SnapToSelectedEntityCommand}" Classes="accent" Margin="0,8,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                    <DataTemplate DataType="models:GridComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <CheckBox Content="Is Visible" IsChecked="{Binding IsVisible}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- Comet Component -->
                    <DataTemplate DataType="models:CometComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Mechanical State" FontWeight="Bold" />
                                <TextBlock Text="{Binding PositionX, StringFormat='Pos X: {0}'}" />
                                <TextBlock Text="{Binding VelocityY, StringFormat='Vel Y: {0}'}" />
                                <TextBlock Text="Inertia Tensor:" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding InertiaTensor}" FontFamily="Consolas, Monospace" />

                                <CheckBox Content="Follow" IsChecked="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).IsFollowingEntity}" />
                                <Button Content="Snap Camera" Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).SnapToSelectedEntityCommand}" Classes="accent" Margin="0,8,0,0" HorizontalAlignment="Right" />

                                <TextBlock Text="BVH Explorer" FontWeight="Bold" Margin="0,12,0,4"/>
                                <TreeView ItemsSource="{Binding BvhTree}" MinHeight="100" MaxHeight="300">
                                    <TreeView.DataTemplates>
                                        <TreeDataTemplate DataType="models:BvhNode" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox IsChecked="{Binding IsVisible}" Margin="0,-4,0,0" ToolTip.Tip="Toggle Render Visibility" />
                                                <TextBlock Text="{Binding Type, StringFormat='[{0}]'}" Foreground="{DynamicResource Accent.Primary}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>

                                <Grid ColumnDefinitions="*, Auto" Margin="0,16,0,8">
                                    <TextBlock Grid.Column="0" Text="Surface Jets" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+" Classes="accent" Padding="8,2" Command="{Binding $parent[UserControl].((vm:PropertiesViewModel)DataContext).ToggleAddJetModeCommand}" ToolTip.Tip="Add New Jet (Shift+RMB on Comet)"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Jets}" Classes="list-tray" MaxHeight="400" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:JetMarker">
                                            <Border Classes="list-tray-item dense" Background="{DynamicResource Bg.Surface}" CornerRadius="4" Margin="0,0,0,4" Padding="12,8">
                                                <StackPanel>
                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Margin="0,0,12,0">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding ColorR, Converter={StaticResource FloatToColorConverter}}"/> <!-- Assuming there's a converter, if not, wait. I will just use a generic background or leave it -->
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Edit Color" Classes="accent" Padding="4,2" FontSize="12" ToolTip.Tip="Change Color"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,8,0,0">
                                                        <TextBlock Grid.Column="0" Text="Lat (°):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="1" Value="{Binding Latitude}" Minimum="-90" Maximum="90" FormatString="0.0" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="2" Text="Lon (°):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding Longitude}" Minimum="0" Maximum="360" FormatString="0.0"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4,0,0">
                                                        <TextBlock Grid.Column="0" Text="Radius (m):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="1" Value="{Binding Radius}" Minimum="0" FormatString="0.0" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="2" Text="Mass (g):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding MassGrams}" Minimum="0" FormatString="0.000"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,4,0,0">
                                                        <TextBlock Grid.Column="0" Text="Rate:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="1" Value="{Binding ParticlesPerTick}" Minimum="0" FormatString="0" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="2" Text="TTL:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding TTL}" Minimum="0" FormatString="0.0"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                                        <TextBlock Grid.Column="0" Text="Vel (m/s):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="1" Value="{Binding MeanVelocity}" Minimum="0" FormatString="0.0"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,4,0,0">
                                                        <TextBlock Grid.Column="0" Text="R:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="1" Value="{Binding ColorR}" Minimum="0" Maximum="1" FormatString="0.0" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="2" Text="G:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding ColorG}" Minimum="0" Maximum="1" FormatString="0.0" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="4" Text="B:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <NumericUpDown Grid.Column="5" Value="{Binding ColorB}" Minimum="0" Maximum="1" FormatString="0.0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- Sphere Gizmo Component                              -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <DataTemplate DataType="models:SphereGizmoComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <CheckBox Content="Is Visible" IsChecked="{Binding IsVisible}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!-- Particle Emitter Circles Component                     -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <DataTemplate DataType="models:ParticleEmitterCirclesComponent">
                        <Expander Header="{Binding Name}" IsExpanded="True"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Spacing="4" Margin="4,4,4,4">

                                <!-- List of emission circles -->
                                <ListBox ItemsSource="{Binding Circles}" x:Name="circlesList"
                                         Classes="list-tray" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="models:EmissionCircleItem">
                                            <Border Classes="list-tray-item dense" Background="{DynamicResource Bg.Surface}"
                                                    CornerRadius="6" Margin="0,0,0,4" Padding="12,8">
                                                <StackPanel>
                                                    <!-- Row 0: colour swatch + label + remove button -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Grid.Column="0" Width="16" Height="16"
                                                                CornerRadius="8" Margin="0,0,12,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#FFFF9944"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="Emission Circle"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="✕"
                                                                Classes="icon" Padding="6,2" FontSize="11"
                                                                VerticalAlignment="Center" Background="Transparent"
                                                                Command="{Binding $parent[ListBox].((models:ParticleEmitterCirclesComponent)DataContext).RemoveCircleCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="Remove this emission circle"/>
                                                    </Grid>

                                                    <!-- Properties wrapped for responsiveness -->
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <!-- Group 1: Lat / Lon -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="φ lat (°):" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding LatitudeDeg}" Minimum="-90" Maximum="90" FormatString="0.0" Width="80"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="λ lon (°):" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding LongitudeDeg}" Minimum="0" Maximum="360" FormatString="0.0" Width="80"/>
                                                        </StackPanel>

                                                        <!-- Group 2: Mass / Radius -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="Mass (g):" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding MassGrams}" Minimum="0" FormatString="0.000" Width="80"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="R (frac):" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding CircleRadius}" Minimum="0.001" Maximum="1.0" FormatString="0.000" Width="80"/>
                                                        </StackPanel>

                                                        <!-- Group 3: Rate / TTL -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="Rate:" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding ParticlesPerTick}" Minimum="0" FormatString="0" Width="80"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="TTL:" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding TTL}" Minimum="1" FormatString="0" Width="80"/>
                                                        </StackPanel>

                                                        <!-- Group 4: Velocity -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,16,0">
                                                            <TextBlock Text="Vel (km/s):" VerticalAlignment="Center" Margin="0,0,6,0" Width="60" Foreground="{DynamicResource Text.Secondary}"/>
                                                            <NumericUpDown Value="{Binding MeanVelocityKms}" Minimum="0.0" FormatString="0.00" Width="80"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Add circle button -->
                                <Button Content="＋ Add Emission Circle"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Classes="accent" Margin="0,4,0,0"
                                        Command="{Binding AddCircleCommand}"/>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>

                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>