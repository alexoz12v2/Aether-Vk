<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="120"
             x:Class="AetherVk.Views.TimelineTabView"
             x:DataType="vm:TimelineTabViewModel">
  <Design.DataContext>
    <vm:DesignTimelineTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.playback">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.playback:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Bg.Canvas}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,1,0,0">
    <ScrollViewer Classes="left-scrollbar" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="16,8">

        <!-- Left: the simulated range, read-only (reviewer feedback item 7: it is entered in the Comet tab) -->
        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <!-- the texts are in the chosen time scale (Settings › Time scale for dates; UTC by default) -->
            <!-- one ? for the Start/End pair -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock AutomationProperties.AutomationId="TimelineStartEpochLabel" Text="{Binding ScaleName, StringFormat='Start Epoch ({0}):'}"
                         ToolTip.Tip="{Binding ScaleTip}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="TimelineEpochRangeHelp"
                                           HelpHeader="{Binding StrHelpHeaderEpochRange}"
                                           HelpContent="{Binding StrHelpEpochRange}" FlyoutMaxWidth="300" />
            </StackPanel>
            <TextBox AutomationProperties.AutomationId="TimelineStartEpochBox" IsReadOnly="True"
                     Text="{Binding StartEpoch, Mode=OneWay}" Width="180" />

            <TextBlock AutomationProperties.AutomationId="TimelineEndEpochLabel" Text="{Binding ScaleName, StringFormat='End Epoch ({0}):'}"
                       ToolTip.Tip="{Binding ScaleTip}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Margin="8,0,0,0"/>
            <TextBox AutomationProperties.AutomationId="TimelineEndEpochBox" IsReadOnly="True"
                     Text="{Binding EndEpoch, Mode=OneWay}" Width="180" />
          </StackPanel>

          <TextBlock Text="Set the range in the Comet tab (step 3), then Download &amp; Commit there." FontSize="11"
                     Foreground="{DynamicResource Text.Secondary}" IsVisible="{Binding !HasCommittedState}" />

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCommittedState}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Committed Range:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="CommittedRangeTextHelp"
                                           HelpHeader="{Binding StrHelpHeaderCommittedRange}"
                                           HelpContent="{Binding StrHelpCommittedRange}" />
            </StackPanel>
            <TextBlock AutomationProperties.AutomationId="CommittedRangeText" Text="{Binding DisplayCommittedRange}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />
          </StackPanel>

          <!-- an edit waits in the Comet tab: the engine keeps the committed range until a recommit there -->
          <TextBlock AutomationProperties.AutomationId="PendingRangeEditText" Text="{x:Static vm:TimelineTabViewModel.PendingRangeEditText}"
                     Foreground="{DynamicResource Sem.Warning}" FontSize="11" TextWrapping="Wrap" MaxWidth="520"
                     IsVisible="{Binding HasPendingRangeEdit}" />
        </StackPanel>

        <!-- Center: Timeline Progress (Visible only when current session has a committed state) -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="32,0,16,0" IsVisible="{Binding HasCommittedState}">
          <!-- Playback Controls -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding StrSpeed}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="SpeedPickerHelp"
                                             HelpHeader="{Binding StrHelpHeaderSpeed}"
                                             HelpContent="{Binding StrHelpSpeed}" />
              </StackPanel>
              <ComboBox AutomationProperties.AutomationId="SpeedPicker"
                        ItemsSource="{Binding SpeedOptions}"
                        DisplayMemberBinding="{Binding Label, x:DataType=vm:TimelineTabViewModel+SpeedOption}"
                        SelectedValueBinding="{Binding Speed, x:DataType=vm:TimelineTabViewModel+SpeedOption}"
                        SelectedValue="{Binding SelectedSpeed}"
                        Width="150" PlaceholderText="{Binding StrSelectSpeed}" />
            </StackPanel>

            <Button AutomationProperties.AutomationId="ResetButton" Command="{Binding ResetCommand}" Classes="playback" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="{Binding StrTipReset}" ToolTip.ShowDelay="1000">
              <Path Data="M 16,6 L 8,12 L 16,18 Z M 24,6 L 16,12 L 24,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" Width="16" Height="12" />
            </Button>

            <Button AutomationProperties.AutomationId="PlayPauseButton" Command="{Binding PlayPauseCommand}" Classes="playback" ToolTip.Tip="{Binding StrTipPlayPause}" ToolTip.ShowDelay="1000">
              <Panel Width="14" Height="14">
                <Path Data="M 6,4 L 18,11 L 6,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" IsVisible="{Binding !IsPlaying}" />
                <Path Data="M 6,4 L 9,4 L 9,18 L 6,18 Z M 15,4 L 18,4 L 18,18 L 15,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>

            <Button AutomationProperties.AutomationId="RunToEndButton" Command="{Binding RunToEndCommand}" Classes="playback" ToolTip.Tip="{Binding StrTipRunToEnd}" ToolTip.ShowDelay="1000">
              <Path Data="M 8,6 L 8,18 L 11,18 L 11,6 Z M 13,6 L 21,12 L 13,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" Width="16" Height="12" />
            </Button>

            <!-- one ? for the playback buttons (Reset, Play / Pause, Run to End) -->
            <controls:PropertyHelpButton AutomationProperties.AutomationId="PlaybackHelp" VerticalAlignment="Center"
                                         HelpHeader="{Binding StrHelpHeaderPlayback}"
                                         HelpContent="{Binding StrHelpPlayback}" FlyoutMaxWidth="320" />
          </StackPanel>

          <!-- Progress Bar -->
          <ProgressBar AutomationProperties.AutomationId="TimelineProgress" Minimum="0" Maximum="100" Value="{Binding Progress, FallbackValue=0}" Height="6" CornerRadius="3" Background="{DynamicResource Bg.Subtle}" Foreground="{DynamicResource Accent.Primary}" />

          <!-- Current epoch: the engine clock (as the viewport shows it); type an epoch + Enter to seek -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock AutomationProperties.AutomationId="CurrentEpochLabel" Text="{Binding ScaleName, StringFormat='Epoch ({0})'}"
                         ToolTip.Tip="{Binding ScaleTip}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
              <!-- covers the box and Go -->
              <controls:PropertyHelpButton AutomationProperties.AutomationId="CurrentEpochBoxHelp"
                                           HelpHeader="{Binding StrHelpHeaderCurrentEpoch}"
                                           HelpContent="{Binding StrHelpCurrentEpoch}" />
            </StackPanel>
            <TextBox x:Name="CurrentEpochBox" AutomationProperties.AutomationId="CurrentEpochBox"
                     Text="{Binding CurrentEpochText}" Width="170"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                     Watermark="yyyy-MM-dd HH:mm:ss">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SeekToEpochCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button x:Name="SeekToEpochButton" AutomationProperties.AutomationId="SeekToEpochButton"
                    Content="Go" Command="{Binding SeekToEpochCommand}" ToolTip.Tip="{Binding StrTipGo}" ToolTip.ShowDelay="1000" />
            <!-- a UTC epoch outside the leap-second table: converted all the same, may be off by a leap second -->
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding HasCurrentEpochTimeScaleWarning}">
              <TextBlock AutomationProperties.AutomationId="CurrentEpochTimeScaleWarning" Text="⚠" Foreground="{DynamicResource Sem.Warning}"
                         VerticalAlignment="Center" ToolTip.Tip="{Binding CurrentEpochTimeScaleWarningText}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="CurrentEpochTimeScaleWarningHelp"
                 HelpHeader="Leap seconds" HelpContent="{Binding CurrentEpochTimeScaleWarningText}"
                     ActionText="Use TDB for dates" ActionCommand="{Binding UseTdbCommand}" FlyoutMaxWidth="320" />
            </StackPanel>
          </StackPanel>
          <TextBlock AutomationProperties.AutomationId="CurrentEpochErrorText" Text="{Binding CurrentEpochError}"
                     IsVisible="{Binding HasCurrentEpochError}" Foreground="{DynamicResource Sem.Error}"
                     FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Border>
</UserControl>