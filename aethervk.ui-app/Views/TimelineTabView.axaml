<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="120"
             x:Class="AetherVk.Views.TimelineTabView"
             x:DataType="vm:TimelineTabViewModel">
  <Design.DataContext>
    <vm:DesignTimelineTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.playback">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.playback:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg.Hover}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Bg.Canvas}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,1,0,0">
    <ScrollViewer Classes="left-scrollbar" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="16,8">

        <!-- Left: Epoch Settings -->
        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Start Epoch (TDB):" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
            <TextBox AutomationProperties.AutomationId="StartEpochBox"
              ToolTip.Tip="Start of the simulated period (ISO 8601, e.g. 2000-01-01T12:00:00Z). Typing here only proposes a range; commit it in the Comet tab. The period must be at least 1 day long." Text="{Binding StartEpoch}" Width="180" Watermark="e.g. 2000-01-01T12:00:00Z" />

            <TextBlock Text="End Epoch (TDB):" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" Margin="8,0,0,0"/>
            <TextBox AutomationProperties.AutomationId="EndEpochBox"
              ToolTip.Tip="End of the simulated period (ISO 8601). It must be at least 1 day after the start. Typing here only proposes a range; commit it in the Comet tab." Text="{Binding EndEpoch}" Width="180" Watermark="e.g. 2000-02-01T12:00:00Z" />

            <Button Content="Restore" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" ToolTip.Tip="Puts the committed range back in the boxes" ToolTip.ShowDelay="1000" />

            <!-- Indicator: proposed range differs from committed -->
            <TextBlock Text="●" Foreground="{DynamicResource Sem.Warning}" IsVisible="{Binding IsProposedDifferentFromCommitted}" ToolTip.Tip="Proposed range differs from committed" VerticalAlignment="Center" />
          </StackPanel>

          <!-- "Model" preset (feedback #20): N nucleus rotations ending at the image epoch -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Model range:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
            <TextBox AutomationProperties.AutomationId="ModelRotationsBox"
              ToolTip.Tip="Number of full nucleus rotations (a whole number, at least 1) that the model range should span. One rotation lasts the period set in the Comet tab (360 deg divided by the rotation rate)." Text="{Binding ModelRotations}" Width="48" />
            <TextBlock Text="rotations ending at" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
            <TextBox AutomationProperties.AutomationId="ModelEndEpochBox"
              ToolTip.Tip="End of the model range, normally the epoch of your telescope image (the FITS &quot;Model range&quot; button fills it with the observation epoch). Leave empty to use the End Epoch box." Text="{Binding ModelEndEpoch}" Width="180" Watermark="image epoch (empty: End)" />
            <Button AutomationProperties.AutomationId="ApplyModelRangeButton" Content="Set range" Command="{Binding ApplyModelRangeCommand}"
                    ToolTip.Tip="Sets Start and End so the timeline ends at the image epoch and starts N nucleus rotation periods earlier (N x period, never less than 1 day). The simulated dust history then covers N full spins before the image. It only proposes the range: commit it in the Comet tab." />
          </StackPanel>
          
          <!-- R3: jets ignite this long before the committed start, so the tail exists when play starts -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Dust lead time:" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
            <TextBox AutomationProperties.AutomationId="DustLeadDaysBox"
              ToolTip.Tip="Days the jets start emitting before the start epoch (0 to 30; 30 = one dust lifetime, the default). With 30 the tail is already fully formed when the timeline starts; with 0 the jets switch on at the start and the tail grows from nothing. Used the next time the comet is committed." Text="{Binding DustLeadDays}" Width="56" />
            <TextBlock Text="days before the start" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProposedState}">
              <TextBlock Text="Proposed Range:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
              <TextBlock AutomationProperties.AutomationId="ProposedRangeText" Text="{Binding DisplayProposedRange}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasCommittedState}">
              <TextBlock Text="Committed Range:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
              <TextBlock AutomationProperties.AutomationId="CommittedRangeText" Text="{Binding DisplayCommittedRange}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" />
            </StackPanel>
          </StackPanel>

          <!-- Edited after a commit: the engine keeps the committed range until a recommit -->
          <StackPanel AutomationProperties.AutomationId="RangeLockedPanel" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRangeLocked}">
            <TextBlock Text="{x:Static vm:TimelineTabViewModel.RangeLockedText}" Foreground="{DynamicResource Sem.Warning}" FontSize="11" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
            <Button AutomationProperties.AutomationId="RecommitWithRangeButton" Content="Recommit with this range" Command="{Binding RecommitWithRangeCommand}"
                    ToolTip.Tip="Commits the comet again (as Download &amp; Commit in the Comet tab) with the range in the boxes. The dust restarts from the new start." />
          </StackPanel>

          <!-- Error Message -->
          <TextBlock AutomationProperties.AutomationId="TimelineErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource Sem.Error}" IsVisible="{Binding HasError}" FontSize="11" />
        </StackPanel>

        <!-- Center: Timeline Progress (Visible only when current session has a committed state) -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="32,0,16,0" IsVisible="{Binding HasCommittedState}">
          <!-- Playback Controls -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding StrSpeed}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
              <ComboBox AutomationProperties.AutomationId="SpeedPicker"
                ToolTip.Tip="How fast simulated time runs while playing, as simulated time per real second (for example 1 hour per second)." ItemsSource="{Binding SpeedOptions}"
                        DisplayMemberBinding="{Binding Label, x:DataType=vm:TimelineTabViewModel+SpeedOption}"
                        SelectedValueBinding="{Binding Speed, x:DataType=vm:TimelineTabViewModel+SpeedOption}"
                        SelectedValue="{Binding SelectedSpeed}"
                        Width="150" PlaceholderText="{Binding StrSelectSpeed}" />
            </StackPanel>

            <Button Command="{Binding ResetCommand}" Classes="playback" IsVisible="{Binding !IsPlaying}" ToolTip.Tip="Reset (&lt;&lt;)" ToolTip.ShowDelay="1000">
              <Path Data="M 16,6 L 8,12 L 16,18 Z M 24,6 L 16,12 L 24,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" Width="16" Height="12" />
            </Button>

            <Button AutomationProperties.AutomationId="PlayPauseButton" Command="{Binding PlayPauseCommand}" Classes="playback" ToolTip.Tip="Play/Pause" ToolTip.ShowDelay="1000">
              <Panel Width="14" Height="14">
                <Path Data="M 6,4 L 18,11 L 6,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" IsVisible="{Binding !IsPlaying}" />
                <Path Data="M 6,4 L 9,4 L 9,18 L 6,18 Z M 15,4 L 18,4 L 18,18 L 15,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" IsVisible="{Binding IsPlaying}" />
              </Panel>
            </Button>

            <Button AutomationProperties.AutomationId="RunToEndButton" Command="{Binding RunToEndCommand}" Classes="playback" ToolTip.Tip="Run to End" ToolTip.ShowDelay="1000">
              <Path Data="M 8,6 L 8,18 L 11,18 L 11,6 Z M 13,6 L 21,12 L 13,18 Z" Fill="{DynamicResource Text.Primary}" Stretch="Uniform" Width="16" Height="12" />
            </Button>
          </StackPanel>

          <!-- Progress Bar -->
          <ProgressBar AutomationProperties.AutomationId="TimelineProgress" Minimum="0" Maximum="100" Value="{Binding Progress, FallbackValue=0}" Height="6" CornerRadius="3" Background="{DynamicResource Bg.Subtle}" Foreground="{DynamicResource Accent.Primary}" />

          <!-- Current epoch: the engine clock (as the viewport shows it); type an epoch + Enter to seek -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="Epoch (UTC)" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.Secondary}" />
            <TextBox x:Name="CurrentEpochBox" AutomationProperties.AutomationId="CurrentEpochBox"
                     Text="{Binding CurrentEpochText}" Width="170"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                     Watermark="yyyy-MM-dd HH:mm:ss"
                     ToolTip.Tip="The simulation's current epoch. Type an epoch inside the committed range and press Enter to jump there."
                     ToolTip.ShowDelay="1000">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SeekToEpochCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button x:Name="SeekToEpochButton" AutomationProperties.AutomationId="SeekToEpochButton"
                    Content="Go" Command="{Binding SeekToEpochCommand}" ToolTip.Tip="Jump to this epoch" ToolTip.ShowDelay="1000" />
          </StackPanel>
          <TextBlock AutomationProperties.AutomationId="CurrentEpochErrorText" Text="{Binding CurrentEpochError}"
                     IsVisible="{Binding HasCurrentEpochError}" Foreground="{DynamicResource Sem.Error}"
                     FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Border>
</UserControl>