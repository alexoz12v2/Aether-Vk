<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        x:Class="AetherVk.Views.SpawnMeshDialogWindow"
        x:DataType="vm:SpawnMeshViewModel"
        Title="Spawn Mesh Instance" Width="340" Height="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Entity Name:" />
        <TextBox Text="{Binding EntityName}" />
        
        <!-- Kinematic Mode Toggle -->
        <CheckBox Content="Kinematic (almanac-driven position)"
                  IsChecked="{Binding IsKinematic}"
                  ToolTip.Tip="When enabled, the entity position is driven by SPK ephemeris data instead of a manual position." />

        <!-- SPK ID (visible only in kinematic mode) -->
        <StackPanel Spacing="4" IsVisible="{Binding IsKinematic}">
            <TextBlock Text="NAIF SPK ID:" />
            <TextBox Text="{Binding SpkId}" Watermark="e.g. 1000012" />
        </StackPanel>
        
        <!-- Manual position (visible only in dynamic mode) -->
        <StackPanel Spacing="4" IsVisible="{Binding CanSetPosition}">
            <TextBlock Text="Starting Position (X, Y, Z):" />
            <Grid ColumnDefinitions="*, *, *">
                <TextBox Grid.Column="0" Text="{Binding PosX}" Margin="0,0,5,0" />
                <TextBox Grid.Column="1" Text="{Binding PosY}" Margin="0,0,5,0" />
                <TextBox Grid.Column="2" Text="{Binding PosZ}" />
            </Grid>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel" Click="OnCancelClick" />
            <Button Content="Spawn" Click="OnSpawnClick" IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
