<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        x:Class="AetherVk.Views.ManageImportsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Manage Imports" Width="400" Height="300"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*, Auto" Margin="10">
        <ListBox ItemsSource="{Binding ImportedModels}" Grid.Row="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150" />
                        <Button Content="Spawn" Command="{Binding SpawnCommand}" />
                        <Button Content="View Mesh" Command="{Binding ViewMeshCommand}" />
                        <Button Content="Unload" Command="{Binding UnloadCommand}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Import Image..." Command="{Binding ImportImageCommand}" />
            <Button Content="Close" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
