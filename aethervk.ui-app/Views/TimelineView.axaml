<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             x:DataType="vm:TimelineViewModel"
             x:Class="AetherVk.Views.TimelineView">
  
  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="16"
          Margin="16"
          BoxShadow="0 4 8 0 #1A000000">
    <Grid RowDefinitions="Auto, *">
      <!-- Top Row: Controls & Time -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
        <!-- Playback Controls -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding StopCommand}" ToolTip.Tip="Stop" Width="36" Height="36" CornerRadius="18">
            <PathIcon Data="M 4 4 L 12 4 L 12 12 L 4 12 Z" Width="12" Height="12" />
          </Button>
          <Button Command="{Binding PauseCommand}" ToolTip.Tip="Pause" Width="36" Height="36" CornerRadius="18">
            <PathIcon Data="M 4 2 L 6 2 L 6 14 L 4 14 Z M 10 2 L 12 2 L 12 14 L 10 14 Z" Width="12" Height="12" />
          </Button>
          <Button Command="{Binding PlayCommand}" Classes="accent" ToolTip.Tip="Play" Width="36" Height="36" CornerRadius="18">
            <PathIcon Data="M 4 2 L 14 8 L 4 14 Z" Width="12" Height="12" />
          </Button>
          
          <ComboBox ItemsSource="{Binding TimeScaleOptions}"
                    SelectedItem="{Binding Timeline.SelectedTimeScale}"
                    DisplayMemberBinding="{Binding DisplayName}"
                    VerticalAlignment="Center" Width="150" Margin="8,0,0,0" />
          
          <Button Content="Update Trajectories" Command="{Binding UpdateTrajectoriesCommand}" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Current Time Display -->
        <Border Grid.Column="2" 
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4" 
                Padding="12,6" 
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Timeline.UtcTime}" 
                     FontWeight="SemiBold" 
                     FontSize="16" 
                     FontFamily="Consolas, Monospace" 
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>
      </Grid>
      
      <!-- Bottom Row: Timeline Slider -->
      <Slider Grid.Row="1" 
              Minimum="{Binding Timeline.MinTai}" 
              Maximum="{Binding Timeline.MaxTai}" 
              Value="{Binding Timeline.TimeTai}" 
              Margin="0,16,0,0" 
              VerticalAlignment="Top"
              IsEnabled="{Binding !Timeline.IsPlaying}"
              PointerPressed="OnSliderPointerPressed"
              PointerReleased="OnSliderPointerReleased" />
    </Grid>
  </Border>
</UserControl>