<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:controls="using:AetherVk.Controls"
             x:DataType="vm:TimelineViewModel"
             x:Class="AetherVk.Views.TimelineView">
  
  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Padding="12,6">
    <Grid RowDefinitions="Auto, Auto">
      
      <!-- Top Row: Timeline Scrub Bar / Progress Bar -->
      <Grid Grid.Row="0" Margin="4,0,4,6" ColumnDefinitions="*, Auto">

        <!-- Scrub Slider: visible only when PAUSED (user can drag to seek) -->
        <Slider Grid.Column="0"
                Minimum="{Binding Timeline.MinTai}"
                Maximum="{Binding Timeline.MaxTai}"
                Value="{Binding Timeline.TimeTai}"
                VerticalAlignment="Center"
                IsVisible="{Binding !Timeline.IsPlaying}"
                PointerPressed="OnSliderPointerPressed"
                PointerReleased="OnSliderPointerReleased" />

        <!-- Progress bar: visible only while PLAYING (read-only epoch fill) -->
        <ProgressBar Grid.Column="0"
                     Minimum="{Binding Timeline.MinTai}"
                     Maximum="{Binding Timeline.MaxTai}"
                     Value="{Binding Timeline.TimeTai}"
                     Height="8"
                     VerticalAlignment="Center"
                     IsVisible="{Binding Timeline.IsPlaying}"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" />

        <!-- Playback speed badge: e.g. "0.43×" — only relevant while playing -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4" Padding="8,3"
                IsVisible="{Binding Timeline.IsPlaying}"
                ToolTip.Tip="Effective simulation speed (sim time / wall time). &lt;1× means GPU physics is slower than configured.">
          <TextBlock Text="{Binding PlaybackSpeedText}"
                     FontSize="11" FontFamily="Consolas, Monospace"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
        </Border>
      </Grid>

      <!-- Bottom Row: Controls that wrap when space is limited -->
      <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
        
        <!-- Playback Controls -->
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,4,24,4">
          <!-- Play/Pause Toggle -->
          <Button Command="{Binding PlayPauseCommand}"
                  ToolTip.Tip="{Binding PlayPauseTooltip}"
                  Width="32" Height="32" CornerRadius="16"
                  Classes="accent"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <Panel>
              <PathIcon Data="M 4 2 L 14 8 L 4 14 Z" Width="12" Height="12"
                         IsVisible="{Binding !Timeline.IsPlaying}" />
              <PathIcon Data="M 4 2 L 6 2 L 6 14 L 4 14 Z M 10 2 L 12 2 L 12 14 L 10 14 Z" Width="12" Height="12"
                         IsVisible="{Binding Timeline.IsPlaying}" />
            </Panel>
          </Button>

          <!-- Reset Button: restores snapshot to start epoch (enabled when paused with snapshot) -->
          <Button Command="{Binding ResetSimulationCommand}"
                  ToolTip.Tip="Reset simulation to start (restores snapshot)"
                  Width="32" Height="32" CornerRadius="16"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <PathIcon Data="M 8 1 A 7 7 0 1 0 15 8 L 13 8 A 5 5 0 1 1 8 3 L 8 1 L 5 4 L 8 1 L 11 4 Z" Width="12" Height="12" />
          </Button>
          
          <!-- Time Scale: always enabled so user can pre-select before pressing Play -->
          <ComboBox ItemsSource="{Binding TimeScaleOptions}"
                    SelectedItem="{Binding SelectedTimeScale}"
                    DisplayMemberBinding="{Binding DisplayName}"
                    VerticalAlignment="Center" Width="130"
                    FontSize="12" />
        </StackPanel>

        <!-- Epoch Range Controls -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,4,24,4">
          <TextBlock Text="Start:" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
          <TextBox Text="{Binding StartEpochText, Mode=TwoWay}"
                   Width="160" FontSize="11" FontFamily="Consolas, Monospace"
                   VerticalAlignment="Center" Padding="6,3"
                   IsEnabled="{Binding CanEditEpochs}"
                   ToolTip.Tip="Start epoch (ISO 8601, e.g. 2024-01-01T00:00:00Z)"
                   Watermark="2024-01-01T00:00:00Z"/>
          <TextBlock Text="End:" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
          <TextBox Text="{Binding EndEpochText, Mode=TwoWay}"
                   Width="160" FontSize="11" FontFamily="Consolas, Monospace"
                   VerticalAlignment="Center" Padding="6,3"
                   IsEnabled="{Binding CanEditEpochs}"
                   ToolTip.Tip="End epoch (ISO 8601, e.g. 2025-06-01T00:00:00Z)"
                   Watermark="2025-06-01T00:00:00Z"/>
          <Button Content="Apply" Command="{Binding ApplyEpochRangeCommand}"
                  FontSize="11" Padding="8,3"
                  IsEnabled="{Binding CanEditEpochs}"
                  ToolTip.Tip="Validate epoch range against almanac and apply"/>
        </StackPanel>
        
        <!-- Epoch Validation Status -->
        <Border VerticalAlignment="Center" Margin="0,4,24,4" IsVisible="{Binding HasEpochError}">
          <TextBlock Text="{Binding EpochErrorText}" 
                     FontSize="11" 
                     Foreground="#E74C3C"
                     VerticalAlignment="Center"/>
        </Border>

        <!-- Current Time Display -->
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="4" 
                Padding="10,4" 
                VerticalAlignment="Center"
                Margin="0,4,0,4">
          <TextBlock Text="{Binding Timeline.UtcTime}" 
                     FontWeight="SemiBold" 
                     FontSize="13" 
                     FontFamily="Consolas, Monospace" 
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>

      </WrapPanel>
    </Grid>
  </Border>
</UserControl>