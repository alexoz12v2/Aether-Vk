<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             x:DataType="vm:TimelineViewModel"
             x:Class="AetherVk.Views.TimelineView">
  <Grid RowDefinitions="Auto, *">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button Content="Stop" Command="{Binding SetSpeedCommand}" CommandParameter="0" Classes="accent" />
      <Button Content="Play (1D)" Command="{Binding SetSpeedCommand}" CommandParameter="1" Classes="accent" />
      <Button Content="Play (1W)" Command="{Binding SetSpeedCommand}" CommandParameter="2" Classes="accent" />
      <Button Content="Play (1M)" Command="{Binding SetSpeedCommand}" CommandParameter="3" Classes="accent" />
      <Button Content="Update Trajectories" Command="{Binding UpdateTrajectoriesCommand}" Classes="accent" />
      
      <TextBlock Text="{Binding UtcTime}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold" FontSize="16" />
    </StackPanel>
    
    <Slider Grid.Row="1" Minimum="{Binding MinTai}" Maximum="{Binding MaxTai}" Value="{Binding TimeTai}" 
            Margin="16,0" VerticalAlignment="Top"
            PointerPressed="OnSliderPointerPressed"
            PointerReleased="OnSliderPointerReleased" />
  </Grid>
</UserControl>