<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AetherVk.Views.FatalErrorWindow"
        Title="Fatal Engine Error"
        Width="600" Height="250"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource Bg.Canvas}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="CRITICAL ERROR" Foreground="Red" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" Margin="0,20,0,20">
            <TextBlock x:Name="ErrorMessageText" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}" FontFamily="Consolas, Monospace" FontSize="14" />
        </ScrollViewer>
        
        <Button Grid.Row="2" Content="Exit Application" Classes="accent" HorizontalAlignment="Right" Click="OnExitClicked" />
    </Grid>
</Window>
