<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AetherVk.Views.FatalErrorWindow"
        Title="Fatal Engine Error"
        Width="650" Height="400"
        d:DesignerWidth="650" d:DesignerHeight="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource Bg.Canvas}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Border Background="#1AFA5252" CornerRadius="8" Padding="12">
                <Path Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 1,1 20,12A8,8 0 0,1 12,20M11,7H13V13H11M11,15H13V17H11Z"
                      Fill="{DynamicResource Sem.Error}"
                      Width="32" Height="32" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CRITICAL ENGINE ERROR"
                           Foreground="{DynamicResource Sem.Error}"
                           FontWeight="Bold"
                           FontSize="22"
                           LetterSpacing="1" />
                <TextBlock Text="The application has encountered a fatal error and cannot continue."
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Error Content Section -->
        <Border Grid.Row="1"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Bg.Outline}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                BoxShadow="0 4 12 0 #10000000">
            <ScrollViewer>
                <TextBlock x:Name="ErrorMessageText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontFamily="Consolas, Monospace"
                           FontSize="13"
                           LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <!-- Footer Section -->
        <Border Grid.Row="2" Margin="0,24,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16">
                <Button Content="Exit Application"
                        Classes="accent"
                        Click="OnExitClicked"
                        Padding="24,8"
                        FontWeight="SemiBold"
                        CornerRadius="6" />
            </StackPanel>
        </Border>

    </Grid>
</Window>