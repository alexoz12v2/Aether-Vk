<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:models="using:AetherVk.Logic.Models"
             xmlns:utils="using:AetherVk.Utils"
             x:DataType="vm:HorizonJplViewModel"
             x:Class="AetherVk.Views.HorizonJplView">
  <Grid>
    <!-- Top Right Help Tooltip -->
    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Content="?" Width="30" Height="30"
            CornerRadius="15" Background="Transparent" Foreground="{DynamicResource Text.Secondary}" ZIndex="100">
      <ToolTip.Tip>
        <TextBlock
          Text="3-Step SPK Retrieval Process:&#x0a;1. Search for comets by designation.&#x0a;2. Select a comet to view available SPK records (filtered by simulation timeline).&#x0a;3. Download the full observation (SPK, EPA, Object constants)." />
      </ToolTip.Tip>
    </Button>

    <ScrollViewer Margin="0,40,0,0">
      <StackPanel Spacing="16" Margin="10">

        <!-- Step 1: Comet Search -->
        <Expander Header="Step 1: Comet Search" HorizontalAlignment="Stretch"
                  IsExpanded="{Binding IsStep1Expanded, Mode=TwoWay}">
          <StackPanel Spacing="10">
            <Button Content="List Comets" Command="{Binding SearchCometsCommand}" HorizontalAlignment="Right"
                    Classes="accent" Margin="0,10,0,0"/>

            <StackPanel IsVisible="{Binding CometsData.Count}">
              <TextBlock Text="Search Comets:" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <AutoCompleteBox ItemsSource="{Binding CometsData}" 
                               SelectedItem="{Binding SelectedComet}" 
                               ValueMemberBinding="{Binding Name, DataType=models:CometSearchResult}"
                               FilterMode="Contains"
                               Watermark="Type to search comets..."
                               MaxDropDownHeight="300"
                               HorizontalAlignment="Stretch" />
            </StackPanel>

            <Button Content="Next: Select Comet" Command="{Binding GoToStep2Command}" HorizontalAlignment="Right"
                    Classes="accent" Margin="0,10,0,0"
                    IsEnabled="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Expander>

        <!-- Step 2: SPK Record Enumeration -->
        <Expander Header="Step 2: SPK Records" HorizontalAlignment="Stretch"
                  IsExpanded="{Binding IsStep2Expanded, Mode=TwoWay}" IsEnabled="{Binding IsStep2Enabled}">
          <StackPanel Spacing="10">
            <TextBlock Text="Select a comet from Step 1 to view its SPK records matching the simulation timeline."
                       Foreground="{DynamicResource Text.Secondary}" Margin="10" />

            <StackPanel IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Spacing="10">
              
              <Button Content="Search Records" Command="{Binding SearchRecordsCommand}" HorizontalAlignment="Right"
                      Classes="accent" />

              <DataGrid x:Name="SpkRecordsDataGrid" ItemsSource="{Binding SpkRecordsData}"
                        SelectedItem="{Binding SelectedSpkRecord}" AutoGenerateColumns="False" IsReadOnly="True"
                        MaxHeight="300">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" />
                  <DataGridTextColumn Header="Epoch" Binding="{Binding EpochYear}" />
                  <DataGridTextColumn Header="Match Desig" Binding="{Binding MatchDesig}" />
                  <DataGridTextColumn Header="Primary Desig" Binding="{Binding PrimaryDesig}" />
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              
              <Button Content="Next: Select Record" Command="{Binding GoToStep3Command}" HorizontalAlignment="Right"
                      Classes="accent"
                      IsEnabled="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <!-- Step 3: Download SPK -->
        <Expander Header="Step 3: Download Observation" HorizontalAlignment="Stretch"
                  IsExpanded="{Binding IsStep3Expanded, Mode=TwoWay}" IsEnabled="{Binding IsStep3Enabled}">
          <StackPanel Spacing="10">
            <TextBlock Text="Select an SPK record from Step 2 to download the full observation (SPK, EPA, Constants)."
                       IsVisible="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNull}}"
                       Foreground="{DynamicResource Text.Secondary}" Margin="10" />

            <StackPanel IsVisible="{Binding SelectedSpkRecord, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="10" Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Download Selected Observation" Command="{Binding DownloadObservationCommand}" Classes="accent" />
                <Button Content="Start Over" Command="{Binding ResetWizardCommand}" />
              </StackPanel>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsDownloading}" Height="4" Margin="0,10,0,0" />
              
              <DataGrid ItemsSource="{Binding ObjectData}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400" Margin="0,10,0,0">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" />
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>