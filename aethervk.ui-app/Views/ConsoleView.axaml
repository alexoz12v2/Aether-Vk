<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ConsoleViewModel"
             x:Class="AetherVk.Views.ConsoleView">
    <Grid RowDefinitions="*,Auto">
        <TextBox x:Name="ConsoleTextBox" 
                 Grid.Row="0" 
                 Margin="5"
                 Text="{Binding FullText}" 
                 IsReadOnly="True" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True"
                 FontFamily="JetBrains Mono, Consolas, monospace" 
                 FontSize="{Binding ConsoleFontSize}"
                 PointerWheelChanged="OnConsolePointerWheelChanged" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="5">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                <Button Content="Zoom In (+)"
                  ToolTip.Tip="Increase the console font size." Command="{Binding ZoomInCommand}" Classes="accent"/>
                <Button Content="Zoom Out (-)"
                  ToolTip.Tip="Decrease the console font size." Command="{Binding ZoomOutCommand}" Classes="accent"/>
                <Button Content="Export Logs"
                  ToolTip.Tip="Save the console messages to a file." Command="{Binding ExportLogsCommand}" Classes="accent"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Clear Console"
              ToolTip.Tip="Remove all messages from the console." Command="{Binding ClearConsoleCommand}" Classes="accent"/>
        </Grid>
    </Grid>
</UserControl>