<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:input="using:AetherVk.Input"
             x:DataType="vm:Viewport3DViewModel"
             x:Class="AetherVk.Views.Viewport3DView"
             input:ActionContext.Id="Viewport"
             input:ActionContext.Handler="{Binding}">
    <Grid>
        <Image x:Name="RenderTargetImage" Stretch="Uniform" Focusable="True"
               PointerPressed="OnPointerPressed"
               PointerReleased="OnPointerReleased"
               PointerMoved="OnPointerMoved"
               PointerWheelChanged="OnPointerWheelChanged">
        </Image>

        <ItemsControl ItemsSource="{Binding Billboards}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:BillboardViewModel">
                    <StackPanel Orientation="Vertical">
                        <Image Source="{Binding ImageSource}" Width="{Binding Width}" Height="{Binding Height}" Opacity="{Binding Opacity}"
                               IsVisible="{Binding ImageSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                               PointerPressed="OnBillboardPointerPressed" />
                        <Border Background="{DynamicResource Bg.Surface}" CornerRadius="4" Padding="4" IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Text.Primary}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:BillboardViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    <Setter Property="ZIndex" Value="{Binding ZIndex}" />
                </Style>
            </ItemsControl.Styles>
        </ItemsControl>

        <!-- ── Radial Menu Overlay (Alt+S hold) ─────────────────────────────── -->
        <Canvas IsHitTestVisible="False" IsVisible="{Binding IsRadialMenuOpen}">
            <Canvas.Styles>
                <Style Selector="Border.radial-item">
                    <Setter Property="Background" Value="{DynamicResource Bg.Surface}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Bg.Outline}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="Width" Value="80"/>
                    <Setter Property="Height" Value="80"/>
                    <Setter Property="Padding" Value="6"/>
                    <Setter Property="Opacity" Value="0.92"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                            <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1"/>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.radial-item.hovered">
                    <Setter Property="Background" Value="{DynamicResource Bg.Raised}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="Border.radial-item TextBlock.label">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
                <Style Selector="Border.radial-item TextBlock.icon">
                    <Setter Property="FontSize" Value="22"/>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </Canvas.Styles>

            <!-- Central hub indicator -->
            <Ellipse Width="16" Height="16"
                     Fill="{DynamicResource Accent.Primary}" Opacity="0.7"
                     Canvas.Left="{Binding RadialHubLeft}"
                     Canvas.Top="{Binding RadialHubTop}"/>

            <!-- Radial item: Spawn Comet — top -->
            <Border Classes="radial-item"
                    Classes.hovered="{Binding IsCometHovered}"
                    Canvas.Left="{Binding RadialCometLeft}"
                    Canvas.Top="{Binding RadialCometTop}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="icon" Text="☄"/>
                    <TextBlock Classes="label" Text="Spawn&#x0a;Comet"/>
                </StackPanel>
            </Border>

            <!-- Radial item: Insert Billboard — top-right -->
            <Border Classes="radial-item"
                    Classes.hovered="{Binding IsBillboardHovered}"
                    Canvas.Left="{Binding RadialBillboardLeft}"
                    Canvas.Top="{Binding RadialBillboardTop}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="icon" Text="🖼"/>
                    <TextBlock Classes="label" Text="Billboard"/>
                </StackPanel>
            </Border>

            <!-- Radial item: Reset Camera — right -->
            <Border Classes="radial-item"
                    Classes.hovered="{Binding IsResetCameraHovered}"
                    Canvas.Left="{Binding RadialResetCameraLeft}"
                    Canvas.Top="{Binding RadialResetCameraTop}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="icon" Text="🎥"/>
                    <TextBlock Classes="label" Text="Reset&#x0a;Camera"/>
                </StackPanel>
            </Border>

            <!-- Radial item: Snap to Selected — bottom-right -->
            <Border Classes="radial-item"
                    Classes.hovered="{Binding IsSnapHovered}"
                    Canvas.Left="{Binding RadialSnapLeft}"
                    Canvas.Top="{Binding RadialSnapTop}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="icon" Text="🔍"/>
                    <TextBlock Classes="label" Text="Snap to&#x0a;Selected"/>
                </StackPanel>
            </Border>
        </Canvas>



        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="5" IsVisible="{Binding IsInitialized}">
            <Border Padding="5" CornerRadius="4" Background="{DynamicResource Bg.Surface}" Opacity="0.8" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1">
                <Rectangle x:Name="LivelinessIndicator" Width="16" Height="16" Fill="{DynamicResource Sem.Error}" RadiusX="2" RadiusY="2" />
            </Border>

            <Border Padding="10,5" CornerRadius="4" Background="{DynamicResource Bg.Surface}" Opacity="0.8" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding IsMeasuringMode, Converter={x:Static ObjectConverters.IsNull}}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" />
                    <TextBlock Text="Measuring Mode" IsVisible="{Binding IsMeasuringMode}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Sem.Warning}" />
                    <TextBlock Text="Normal Mode" IsVisible="{Binding !IsMeasuringMode}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointX, StringFormat='{}Point 1: [{0:F2}, '}" Foreground="{DynamicResource Text.Primary}" FontSize="12"/>
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointY, StringFormat='{}{0:F2}, '}" Foreground="{DynamicResource Text.Primary}" FontSize="12"/>
                    <TextBlock IsVisible="{Binding HasFirstMeasurementPoint}" Text="{Binding FirstMeasurementPointZ, StringFormat='{}{0:F2}]'}" Foreground="{DynamicResource Text.Primary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Background="{DynamicResource Bg.Surface}" Opacity="0.95" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowNoIntersectionFlyout}">
            <StackPanel Spacing="15">
                <TextBlock Text="No intersection found." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Sem.Warning}"/>

                <TextBlock Text="Do you want to place a point at arbitrary coordinates?" Foreground="{DynamicResource Text.Primary}"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBox Text="{Binding ManualMeasurementX}" Width="80" Watermark="X" />
                    <TextBox Text="{Binding ManualMeasurementY}" Width="80" Watermark="Y" />
                    <TextBox Text="{Binding ManualMeasurementZ}" Width="80" Watermark="Z" />
                    <Button Content="Submit Coordinates" Command="{Binding SubmitManualMeasurementCommand}" Classes="accent" />
                </StackPanel>

                <TextBlock Text="Do you want to place it under cursor?" Foreground="{DynamicResource Text.Primary}" Margin="0,10,0,0"/>
                <Button Content="Place Under Cursor" Command="{Binding SubmitCursorMeasurementCommand}" />

                <TextBlock Text="Do you want to undo the raycast?" Foreground="{DynamicResource Text.Primary}" Margin="0,10,0,0"/>
                <Button Content="Undo Raycast" Command="{Binding UndoMeasurementRaycastCommand}" />
            </StackPanel>
        </Border>

        <!-- Measurement Scale Indicator -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10,5"
                Background="Transparent"
                IsVisible="{Binding ShowMeasurementIndicator}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding MeasurementIndicatorText}" FontSize="12" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Grid Width="{Binding MeasurementIndicatorWidth}" Height="8" HorizontalAlignment="Center">
                    <Border Height="2" Background="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
                    <Border Width="2" Background="{DynamicResource Text.Primary}" HorizontalAlignment="Left" />
                    <Border Width="2" Background="{DynamicResource Text.Primary}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Removed Initialization Popup -->
    </Grid>
</UserControl>