<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:local="using:AetherVk.Views"
             xmlns:dvm="using:AetherVk.Logic.ViewModels.Design"
             x:DataType="vm:SplitNodeViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AetherVk.Views.SplitNodeView">
    <Design.DataContext>
        <dvm:SplitNodeViewModelDesign />
    </Design.DataContext>
    <UserControl.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <local:RatioToStarConverter x:Key="RatioToStar" />
        <local:InverseRatioToStarConverter x:Key="InverseRatioToStar" />
    </UserControl.Resources>
    <!-- A ContentControl builds its child view when its template is applied on measure, and the grid
         of the inactive orientation is never measured, so each child view exists once (the app tests
         count the viewport hosts). Viewport-only mode hides a side and zeroes its track; the
         children never move. -->
    <Grid>
        <!-- Horizontal split: FirstChild | splitter | SecondChild -->
        <Grid x:Name="HorizontalGrid" IsVisible="{Binding Orientation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:SplitOrientation.Horizontal}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SplitRatio, Converter={StaticResource RatioToStar}}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding SplitRatio, Converter={StaticResource InverseRatioToStar}}" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Content="{Binding FirstChild}" IsVisible="{Binding IsFirstShown}" />
            <GridSplitter Grid.Column="1" Background="{DynamicResource Bg.Outline}" ResizeDirection="Columns" IsVisible="{Binding IsSplitterShown}" />
            <ContentControl Grid.Column="2" Content="{Binding SecondChild}" IsVisible="{Binding IsSecondShown}" />
        </Grid>

        <!-- Vertical split: FirstChild / splitter / SecondChild -->
        <Grid x:Name="VerticalGrid" IsVisible="{Binding Orientation, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static vm:SplitOrientation.Vertical}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding SplitRatio, Converter={StaticResource RatioToStar}}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding SplitRatio, Converter={StaticResource InverseRatioToStar}}" />
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" Content="{Binding FirstChild}" IsVisible="{Binding IsFirstShown}" />
            <GridSplitter Grid.Row="1" Background="{DynamicResource Bg.Outline}" ResizeDirection="Rows" IsVisible="{Binding IsSplitterShown}" />
            <ContentControl Grid.Row="2" Content="{Binding SecondChild}" IsVisible="{Binding IsSecondShown}" />
        </Grid>
    </Grid>
</UserControl>