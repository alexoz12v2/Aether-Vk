<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:converters="using:AetherVk.Converters"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:b="using:AetherVk.Behaviors"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="900"
             x:Class="AetherVk.Views.ModelTabView"
             x:DataType="vm:IModelTabViewModel">
  <Design.DataContext>
    <vm:DesignModelTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.unit-of-measurement">
      <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
      <Setter Property="Margin" Value="4,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Centre TextBox text by default in this view -->
    <Style Selector="TextBox">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Unit label overlay: float the unit over the right edge of the control
         without participating in layout so text stays truly centred.
         Usage:  <Panel Classes="unit-overlay">
                   <TextBox ... />
                   <TextBlock Classes="unit-of-measurement" Text="kg/s"
                              HorizontalAlignment="Right" IsHitTestVisible="False" />
                 </Panel>                                                           -->
    <Style Selector="Panel.unit-overlay TextBlock.unit-of-measurement">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <!-- Suppress Fluent blue tint on selected list-tray items -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
    </Style>

    <!-- Forces flyouts inside this view to bound to the local VisualLayerManager. 
         To allow the flyout to act as a free-floating OS window (which can spill 
         outside the tab but might overlap the 3D viewport), remove this Setter. -->
    <Style Selector="Popup">
      <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>
  </UserControl.Styles>

  <VisualLayerManager>
    <ScrollViewer Classes="left-scrollbar"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,16,16,16" IsEnabled="{Binding !IsSimulationRunning}">

      <!-- ══════════════════ SUN ══════════════════════════════════════════════ -->
      <Border Background="Transparent" IsHitTestVisible="{Binding !EnableLegacyExpanders}" IsVisible="{Binding EnableLegacyExpanders}">
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Right">
            <TextBlock MaxWidth="280" TextWrapping="Wrap"
                       Text="This legacy panel is disabled. The simulation now automatically computes the positions of the Comet, Earth, and Sun using exact NASA JPL Horizon SPK ephemeris kernels across the epoch timeline. Procedural overrides for relative properties like Subsolar Latitude and distance are implicitly calculated by the engine and no longer require manual input." />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
        <i:Interaction.Behaviors>
          <b:ShowFlyoutOnHoverBehavior DelayMs="500" />
        </i:Interaction.Behaviors>
        <Border Classes="accordion" IsEnabled="{Binding EnableLegacyExpanders}">
          <Expander AutomationProperties.AutomationId="ModelSunSection">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding StrSun}" />
              <controls:PropertyHelpButton HelpHeader="{Binding StrSun}"
                                           HelpContent="{Binding StrSun}" />
            </StackPanel>
          </Expander.Header>

          <Grid ColumnDefinitions="*,12,1.6*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrDistance}" />
            <TextBox Grid.Row="0" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="AU" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:DistanceBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrSubsolarLatitude}" />
            <TextBox Grid.Row="2" Grid.Column="2" Classes="computed">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
            </TextBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrSTO}" />
            <TextBox Grid.Row="4" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrSunPA}" />
            <TextBox Grid.Row="6" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </Expander>
        </Border>
      </Border>

      <!-- ══════════════════ NUCLEUS AND SPIN AXIS ═══════════════════════════ -->
      <Border Background="Transparent" IsHitTestVisible="{Binding !EnableLegacyExpanders}" IsVisible="{Binding EnableLegacyExpanders}">
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Right">
            <TextBlock MaxWidth="280" TextWrapping="Wrap"
                       Text="This legacy panel is disabled. The IAU Rotational Model (Pole RA/Dec, Prime Meridian, and rotation rates) is now automatically parametrized and editable within the Comet tab upon committing a comet SPK." />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
        <i:Interaction.Behaviors>
          <b:ShowFlyoutOnHoverBehavior DelayMs="500" />
        </i:Interaction.Behaviors>
        <Border Classes="accordion" IsEnabled="{Binding EnableLegacyExpanders}">
          <Expander AutomationProperties.AutomationId="NucleusSpinSection">
          <Expander.Header>
            <TextBlock Text="Nucleus and Spin Axis" />
          </Expander.Header>

          <Grid ColumnDefinitions="*,12,1.6*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrRadius}" />
            <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" />


            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrRotationPeriod}" />
            <controls:UnboundedSlider Grid.Row="4" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="h" />
              </controls:UnboundedSlider.InnerRightContent>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrRotations}" />
            <TextBox Grid.Row="6" Grid.Column="2">
              <i:Interaction.Behaviors>
                <b:NaturalNumberBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding StrRA}" />
            <controls:UnboundedSlider Grid.Row="8" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding StrDec}" />
            <controls:UnboundedSlider Grid.Row="10" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding StrPM}" />
            <controls:UnboundedSlider Grid.Row="12" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding StrSpinAxisPA}" />
            <TextBox Grid.Row="14" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="16" Grid.Column="0" Text="{Binding StrSpinAxisInclination}" />
            <TextBox Grid.Row="16" Grid.Column="2">
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </Expander>
        </Border>
      </Border>

      <!-- ══════════════════ DUST ═════════════════════════════════════════════ -->
      <Border Classes="accordion">
        <Expander AutomationProperties.AutomationId="DustSection">
          <Expander.Header>
            <TextBlock Text="Dust" />
          </Expander.Header>

          <StackPanel Orientation="Vertical" Spacing="0">

            <!-- ──── Reference-position error lines (comet vs osculating reference) ── -->
            <CheckBox Margin="12,10,12,0"
                      Content="{Binding StrShowReferenceError}"
                      IsChecked="{Binding ShowReferencePositionError}"
                      ToolTip.Tip="Draws two lines from the comet to its reference orbit (red track): the closest point of the track (cross-track) and where the reference says the comet should be now (same-epoch). Each is shown only while longer than 10 nucleus radii." />

            <!-- ──── Dust visibility: asinh display stretch softening ───── -->
            <Grid ColumnDefinitions="*,12,1.6*"
                  Margin="12,10,12,0">
              <TextBlock Grid.Column="0"
                         Text="{Binding StrDustVisibility}"
                         VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2"
                                        Value="{Binding DustSoftening}"
                                        IsLogarithmic="True"
                                        HasBounds="True"
                                        MinBound="0.00001"
                                        MaxBound="1.0"
                                        DisplayFormat="G2"
                                        ToolTip.Tip="Display stretch of the dust (softening of an asinh curve over the accumulated optical depth, relative to the brightest dust in view, which adapts to the view like an eye).&#x0A;Smaller: the faint, old tail and trail (thousands of times fainter than the coma) become visible while the coma saturates.&#x0A;1: close to linear, physically proportional brightness.&#x0A;Visual only." />
            </Grid>

            <!-- ──── Dust view aids: tracers (real particles) and flow pulses (marks on synchrones) ── -->
            <CheckBox Margin="12,10,12,0"
                      Content="{Binding StrDustFlow}"
                      IsChecked="{Binding DustFlow}"
                      ToolTip.Tip="Brightness marks riding the dust along synchrones (the dust of one emission instant), a motion cue near the nucleus: peak 4x, trough 0.15x, mean 1.&#x0A;Off by default: seen from 0.03 AU and beyond the marks are the synchrone fan itself, hard rays through the nucleus that the physical optical depth does not show.&#x0A;Visual only." />
            <CheckBox Margin="12,10,12,0"
                      AutomationProperties.AutomationId="DustTracersToggle"
                      Content="{Binding StrDustTracers}"
                      IsChecked="{Binding DustTracers}"
                      ToolTip.Tip="Draws one dust cluster in 256 as bright dots at the exact positions of its grain sizes, from the slow large grains to the fast small ones: the dots span the tail.&#x0A;The dust drifts at 2 to 150 m/s while a pixel of a wide view spans tens of km: at low sim speed it moves far less than a pixel per second, and the dense dots blend into a still fog. Tracers are real particles to follow (raise the sim speed to see them stream).&#x0A;Visual only." />

            <!-- ──── Flow time-lapse factor of the dust marks ──────────── -->
            <Grid ColumnDefinitions="*,12,1.6*"
                  Margin="12,10,12,4">
              <TextBlock Grid.Column="0"
                         Text="{Binding StrDustFlowSpeed}"
                         VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2"
                                        Value="{Binding DustFlowSpeed}"
                                        IsLogarithmic="True"
                                        HasBounds="True"
                                        MinBound="1"
                                        MaxBound="10000"
                                        DisplayFormat="G3"
                                        ToolTip.Tip="Speed of the brightness marks that ride the dust while the simulation runs (they freeze on pause).&#x0A;1: the marks move exactly with the dust (its real speed on screen, often far below a pixel per second in wide views).&#x0A;K: every mark moves K times faster than its dust, in its direction, so the whole swarm keeps its true velocity field at a readable pace. Changing it never jumps the marks.&#x0A;Visual only." />
            </Grid>

            <!-- ──── Nucleus radius (required for jet placement) ──────── -->
            <Grid ColumnDefinitions="*,12,1.6*"
                  Margin="12,10,12,4">
              <TextBlock Grid.Column="0"
                         Text="Nucleus Radius"
                         VerticalAlignment="Center" />
              <controls:UnboundedSlider Grid.Column="2" AutomationProperties.AutomationId="NucleusRadiusSlider"
                                        Value="{Binding ManualNucleusRadiusKmNullable}"
                                        HasBounds="True"
                                        MinBound="0.1"
                                        MaxBound="100.0"
                                        ToolTip.Tip="Bounding-sphere radius of the comet nucleus in km.&#x0A;Auto-filled from Horizon when a comet is committed. Override here if needed before committing.">
                <controls:UnboundedSlider.InnerRightContent>
                  <TextBlock Classes="unit-of-measurement" Text="km" />
                </controls:UnboundedSlider.InnerRightContent>
              </controls:UnboundedSlider>
            </Grid>

            <CheckBox Margin="12,2,12,4"
                      AutomationProperties.AutomationId="SphereGizmoVisibleCheckBox"
                      IsChecked="{Binding IsGizmoVisible}"
                      Content="Show sphere gizmo"
                      ToolTip.Tip="The wireframe sphere and axes around the nucleus. Saved with the file." />

            <!-- Warning: no radius known yet -->
            <TextBlock Margin="12,0,12,6"
                       IsVisible="{Binding IsNucleusRadiusUnknown}"
                       Text="⚠ Enter a radius or commit a comet to enable jet creation."
                       Foreground="{DynamicResource Text.Tertiary}"
                       FontSize="11"
                       TextWrapping="Wrap" />

            <!-- ──── Jet list header ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="12,10,12,6">
              <TextBlock Grid.Column="0"
                         Text="Jets"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Text.Secondary}"
                         VerticalAlignment="Center" />
              <Panel Grid.Column="1">
                <Button Classes="accent" AutomationProperties.AutomationId="AddJetButton"
                        Command="{Binding AddJetCommand}"
                        ToolTip.Tip="Add a new dust emission jet"
                        Padding="10,2"
                        Content="+" />

                <Border Background="Transparent" IsHitTestVisible="{Binding !IsCometCommitted}">
                  <FlyoutBase.AttachedFlyout>
                    <Flyout>
                      <TextBlock Text="Commit a comet first in the Almanac tab to add jets." MaxWidth="250" TextWrapping="Wrap" />
                    </Flyout>
                  </FlyoutBase.AttachedFlyout>
                  <i:Interaction.Behaviors>
                    <b:ShowFlyoutOnHoverBehavior />
                  </i:Interaction.Behaviors>
                </Border>
              </Panel>
            </Grid>

            <CheckBox Margin="12,2,12,4"
                      AutomationProperties.AutomationId="ShowJetAnglesCheckBox"
                      IsChecked="{Binding ShowJetAngles}"
                      Content="Show jet angles"
                      ToolTip.Tip="Draws the selected jet's latitude and longitude as arcs with their degrees in the viewport. Saved with the file." />

            <!-- ──── Jet list ─────────────────────────────────────────────── -->
            <ListBox x:Name="JetListBox"
                     Classes="list-tray"
                     SelectionMode="Toggle"
                     ItemsSource="{Binding Jets}"
                     SelectedItem="{Binding SelectedJet, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JetViewModel">
                  <Grid ColumnDefinitions="*,32" VerticalAlignment="Center">

                    <!-- Jet label + coordinate summary -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="2"
                                VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text.Primary}">
                        <Run Text="Jet #" /><Run Text="{Binding DisplayIndex}" />
                      </TextBlock>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="φ " /><Run Text="{Binding LatitudeDeg, StringFormat='{}{0:F1}°'}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="λ " /><Run Text="{Binding LongitudeDeg, StringFormat='{}{0:F1}°'}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="∠ " /><Run Text="{Binding ApertureDeg, StringFormat='{}{0:F0}°'}" />
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>

                    <!-- Remove button — reflection binding to reach the parent UserControl's VM -->
                    <Button Grid.Column="1"
                            Content="−"
                            Command="{Binding #JetListBox.((vm:IModelTabViewModel)DataContext).RemoveJetCommand}"
                            CommandParameter="{Binding}"
                            Padding="6,2"
                            FontSize="15"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Remove this jet" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty-state hint -->
            <TextBlock Margin="12,10,12,10"
                       IsVisible="{Binding !Jets.Count}"
                       Text="No jets configured. Press + to add one."
                       Foreground="{DynamicResource Text.Tertiary}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <!-- ──── Jet detail panel ─────────────────────────────────────── -->
            <!-- Slides in below the list when a jet is selected.             -->
            <Border IsVisible="{Binding SelectedJet, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderBrush="{DynamicResource Bg.Outline}"
                    BorderThickness="0,1,0,0">

              <!-- Coloured header strip -->
              <StackPanel Orientation="Vertical" Spacing="0">
                <Border Background="{DynamicResource Accent.Subtle}"
                        Padding="12,7">
                  <TextBlock Text="Jet Properties"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent.Primary}" />
                </Border>

                <!-- Property rows, DataContext switches to the selected JetViewModel -->
                <Border Background="{DynamicResource Bg.Subtle}"
                        Padding="12,12,12,12"
                        DataContext="{Binding SelectedJet}">

                <Grid ColumnDefinitions="*,12,1.6*"
                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                      x:DataType="vm:JetViewModel">

                  <!-- Latitude -->
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Latitude" />
                  <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="JetLatitudeSlider"
                                            Value="{Binding LatitudeDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Longitude -->
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Longitude" />
                  <controls:UnboundedSlider Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="JetLongitudeSlider"
                                            Value="{Binding LongitudeDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Aperture -->
                  <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Aperture" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetApertureHelp" HelpHeader="Aperture"
                                                 HelpContent="Half-angle of the emission cone." />
                  </StackPanel>
                  <controls:UnboundedSlider Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="JetApertureSlider"
                                            Value="{Binding ApertureDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Start Velocity Mean -->
                  <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Velocity" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetVelocityHelp" HelpHeader="Velocity"
                                                 HelpContent="Mean ejection speed of the grains." />
                  </StackPanel>
                  <Panel Grid.Row="6" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="JetVelocityBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding StartVelocityMeanMs}"
                                                 Minimum="0.01" Maximum="1000" Format="0.##" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="m/s" />
                  </Panel>

                  <!-- Velocity Std -->
                  <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Vel. σ" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetVelocityStdHelp" HelpHeader="Vel. σ"
                                                 HelpContent="Standard deviation (σ) of the ejection speed." />
                  </StackPanel>
                  <Panel Grid.Row="8" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="JetVelocityStdBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding StartVelocityStdMs}"
                                                 Minimum="0" Maximum="500" Format="0.###" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="m/s" />
                  </Panel>

                  <!-- Stream Color -->
                  <TextBlock Grid.Row="10" Grid.Column="0" Text="Stream Color" />
                  <ColorPicker Grid.Row="10" Grid.Column="2"
                               Color="{Binding StreamColor, Converter={x:Static converters:Vector4ToColorConverter.Instance}}"
                               HorizontalAlignment="Left" />

                  <!-- Computed: β -->
                  <TextBlock Grid.Row="12" Grid.Column="0" Text="β (beta)" />
                  <TextBox Grid.Row="12" Grid.Column="2"
                           Classes="computed"
                           Text="{Binding Beta, StringFormat='{}{0:F4}'}" />

                  <!-- Computed: Dust production rate -->
                  <TextBlock Grid.Row="14" Grid.Column="0" Text="Q_dust @ 1 AU" />
                  <Panel Grid.Row="14" Grid.Column="2" Classes="unit-overlay">
                    <TextBox Classes="computed"
                             Text="{Binding DustProductionRateAt1AuKgs, StringFormat='{}{0:F4}'}" />
                    <TextBlock Classes="unit-of-measurement" Text="kg/s" />
                  </Panel>

                </Grid>
              </Border><!-- /content Border -->
            </StackPanel><!-- /detail StackPanel -->
          </Border><!-- /detail outer Border -->


            <!-- ──── Shared model properties (common to all jets) ─────────── -->
            <!-- Thin divider + section label separates this from the jet panel -->
            <Border BorderBrush="{DynamicResource Bg.Outline}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,0"
                    Padding="12,8,12,0">
              <TextBlock Text="Grain &amp; Activity Parameters"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Text.Secondary}" />
            </Border>

            <Grid ColumnDefinitions="*,12,1.6*"
                  RowDefinitions="Auto,8,Auto,8,Auto,8,Auto"
                  Margin="12,8,12,8">

              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustDensity}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustDensityHelp"
                                             HelpHeader="{Binding StrDustDensity}"
                                             HelpContent="Grain bulk density, g/cm³; enters β and the mass per brightness." />
              </StackPanel>
              <Panel Grid.Row="0" Grid.Column="2" Classes="unit-overlay">
                <TextBox AutomationProperties.AutomationId="DustDensityBox">
                  <i:Interaction.Behaviors>
                    <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DensityGCm3}" Minimum="0.00001" Maximum="7.0" />
                  </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock Classes="unit-of-measurement" Text="g/cm³" />
              </Panel>

              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustDiameter}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustDiameterHelp"
                                             HelpHeader="{Binding StrDustDiameter}"
                                             HelpContent="Grain diameter; with density it sets β, the radiation-pressure push: smaller or lighter grains curve away from the Sun faster." />
              </StackPanel>
              <Panel Grid.Row="2" Grid.Column="2" Classes="unit-overlay">
                <TextBox AutomationProperties.AutomationId="DustDiameterBox">
                  <i:Interaction.Behaviors>
                    <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DiametreUm}" Minimum="0.0001" Maximum="10000" />
                  </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock Classes="unit-of-measurement" Text="μm" />
              </Panel>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrScatteringEfficiency}" />
              <TextBox Grid.Row="4" Grid.Column="2">
                <i:Interaction.Behaviors>
                  <b:NumericTextBoxBehavior Value="{Binding CurrentSession.ScatteringEfficiency}" Minimum="0.5" Maximum="2" />
                </i:Interaction.Behaviors>
              </TextBox>

              <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrGeometricAlbedo}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustAlbedoHelp"
                                             HelpHeader="{Binding StrGeometricAlbedo}"
                                             HelpContent="Geometric albedo of the dust; cometary dust 0.03–0.06; scales brightness and the Afρ → kg/s conversion." />
              </StackPanel>
              <TextBox Grid.Row="6" Grid.Column="2" AutomationProperties.AutomationId="DustAlbedoBox">
                <i:Interaction.Behaviors>
                  <b:NumericTextBoxBehavior Value="{Binding CurrentSession.GeometricAlbedo}" Minimum="0.01" Maximum="0.5" />
                </i:Interaction.Behaviors>
              </TextBox>

            </Grid>

            <!-- Activity law: rarely changed, out of the way (it is not a grain-size law) -->
            <Expander AutomationProperties.AutomationId="ActivityAdvancedExpander" Margin="12,0,12,8">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Advanced: activity (Afρ)" />
                  <controls:PropertyHelpButton AutomationProperties.AutomationId="ActivityAdvancedHelp"
                                               HelpHeader="Activity (Afρ)"
                                               HelpContent="Afρ is not a grain distribution: it is how much dust the comet produces at each distance from the Sun.&#x0A;&#x0A;Afρ(r) = min(max, Afρ₀ · r⁻ᵏ), zero beyond the cutoff.&#x0A;• Afρ₀: activity at 1 AU (cm).&#x0A;• Exponent k: how fast activity falls with solar distance (k = 2: twice as far → 4× less dust).&#x0A;• Cutoff: distance where activity stops.&#x0A;• Max: cap close to the Sun.&#x0A;&#x0A;The engine turns Afρ into a production rate Q = 2ρ·s·v·Afρ / (3·p·f_v·(1+(σ/v)²)) kg/s (ρ density, s grain radius, v speed, p albedo, f_v speed factor of the size spread).&#x0A;&#x0A;Afρ is a brightness measurement, so it fixes how bright the coma is. Density and diameter do not set the amount of dust: they set how much mass that brightness needs, and how hard radiation pressure pushes the grains (β ∝ 1/(ρ·s)), i.e. how much the coma curves away from the Sun." />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Afρ₀ (at 1 AU)" />
                  <Panel Grid.Row="0" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="Afrho0Box">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.Afrho0Cm}" Minimum="1" Maximum="2000000" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="cm" />
                  </Panel>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Afρ exponent k" />
                  <TextBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="AfrhoPowerBox">
                    <i:Interaction.Behaviors>
                      <b:NumericTextBoxBehavior Value="{Binding CurrentSession.AfrhoPower}" Minimum="1" Maximum="4" />
                    </i:Interaction.Behaviors>
                  </TextBox>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Afρ cutoff" />
                  <Panel Grid.Row="4" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="AfrhoCutoffBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.AfrhoCutoffAu}" Minimum="3" Maximum="100" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="AU" />
                  </Panel>

                  <TextBlock Grid.Row="6" Grid.Column="0" Text="Afρ max" />
                  <Panel Grid.Row="6" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="AfrhoMaxBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.AfrhoMaxValueCm}" Minimum="1" Maximum="10000000" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="cm" />
                  </Panel>
                </Grid>

                <controls:CurvePlot AutomationProperties.AutomationId="AfrhoCurvePlot"
                                    Model="{Binding AfrhoPlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Accent.Secondary}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
                <TextBlock AutomationProperties.AutomationId="AfrhoNowText"
                           Text="{Binding AfrhoNowText}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" />
              </StackPanel>
            </Expander>

            <!-- Grain size law: only the discrete specks follow q -->
            <Expander AutomationProperties.AutomationId="SizeDistributionAdvancedExpander" Margin="12,0,12,12">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Advanced: grain size distribution" />
                  <controls:PropertyHelpButton AutomationProperties.AutomationId="SizeDistributionAdvancedHelp"
                                               HelpHeader="Grain size distribution"
                                               HelpContent="Grain radii follow n(s) ∝ s^−q from s₀/F to s₀·F, s₀ = diameter/2 (q = 3.5, F = 10, 100 µm → radii 5–500 µm).&#x0A;&#x0A;By number, small grains dominate; by cross-section (what sets brightness) the law is s^(2−q), so brightness favours small grains only slowly.&#x0A;&#x0A;The continuous dust rendering is built for q = 3.5; changing q only affects the individual bright specks." />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto,8,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrSizeQ}" />
                  <TextBox Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="SizeQBox">
                    <i:Interaction.Behaviors>
                      <b:NumericTextBoxBehavior Value="{Binding CurrentSession.SizeQ}" Minimum="2" Maximum="5" />
                    </i:Interaction.Behaviors>
                  </TextBox>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrSizeRange}" />
                  <TextBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="SizeRangeBox">
                    <i:Interaction.Behaviors>
                      <b:NumericTextBoxBehavior Value="{Binding CurrentSession.SizeRange}" Minimum="1" Maximum="1000" />
                    </i:Interaction.Behaviors>
                  </TextBox>
                </Grid>

                <controls:CurvePlot AutomationProperties.AutomationId="SizeDistributionPlot"
                                    Model="{Binding SizeDistributionPlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Sem.Warning}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Expander>
      </Border>

    </StackPanel>
  </ScrollViewer>
  </VisualLayerManager>
</UserControl>