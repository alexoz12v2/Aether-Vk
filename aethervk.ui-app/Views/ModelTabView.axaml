<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             xmlns:controls="using:AetherVk.Controls"
             xmlns:converters="using:AetherVk.Converters"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:b="using:AetherVk.Behaviors"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="900"
             x:Class="AetherVk.Views.ModelTabView"
             x:DataType="vm:IModelTabViewModel">
  <Design.DataContext>
    <vm:DesignModelTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.unit-of-measurement">
      <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
      <Setter Property="Margin" Value="4,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Centre TextBox text by default in this view -->
    <Style Selector="TextBox">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Unit label overlay: float the unit over the right edge of the control
         without participating in layout so text stays truly centred.
         Usage:  <Panel Classes="unit-overlay">
                   <TextBox ... />
                   <TextBlock Classes="unit-of-measurement" Text="kg/s"
                              HorizontalAlignment="Right" IsHitTestVisible="False" />
                 </Panel>                                                           -->
    <Style Selector="Panel.unit-overlay TextBlock.unit-of-measurement">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <!-- Suppress Fluent blue tint on selected list-tray items -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
    </Style>

    <!-- Forces flyouts inside this view to bound to the local VisualLayerManager. 
         To allow the flyout to act as a free-floating OS window (which can spill 
         outside the tab but might overlap the 3D viewport), remove this Setter. -->
    <Style Selector="Popup">
      <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>
  </UserControl.Styles>

  <VisualLayerManager>
    <ScrollViewer Classes="left-scrollbar"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Orientation="Vertical" Spacing="16" Margin="16,16,16,16" IsEnabled="{Binding !IsSimulationRunning}">

      <!-- ══════════════════ SUN ══════════════════════════════════════════════ -->
      <Border Background="Transparent" IsHitTestVisible="{Binding !EnableLegacyExpanders}" IsVisible="{Binding EnableLegacyExpanders}">
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Right">
            <TextBlock MaxWidth="280" TextWrapping="Wrap"
                       Text="This legacy panel is disabled. The simulation now automatically computes the positions of the Comet, Earth, and Sun using exact NASA JPL Horizon SPK ephemeris kernels across the epoch timeline. Procedural overrides for relative properties like Subsolar Latitude and distance are implicitly calculated by the engine and no longer require manual input." />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
        <i:Interaction.Behaviors>
          <b:ShowFlyoutOnHoverBehavior DelayMs="500" />
        </i:Interaction.Behaviors>
        <Border Classes="accordion" IsEnabled="{Binding EnableLegacyExpanders}">
          <Expander AutomationProperties.AutomationId="ModelSunSection">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding StrSun}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="ModelSunSectionHelp"
                                           HelpHeader="{Binding StrSun}"
                                           HelpContent="{Binding StrHelpSun}"
                                           FlyoutMaxWidth="300" />
            </StackPanel>
          </Expander.Header>

          <Grid ColumnDefinitions="*,12,1.6*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrDistance}" />
            <TextBox Grid.Row="0" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="AU" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:DistanceBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrSubsolarLatitude}" />
            <TextBox Grid.Row="2" Grid.Column="2" Classes="computed">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
            </TextBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrSTO}" />
            <TextBox Grid.Row="4" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrSunPA}" />
            <TextBox Grid.Row="6" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </Expander>
        </Border>
      </Border>

      <!-- ══════════════════ NUCLEUS AND SPIN AXIS ═══════════════════════════ -->
      <Border Background="Transparent" IsHitTestVisible="{Binding !EnableLegacyExpanders}" IsVisible="{Binding EnableLegacyExpanders}">
        <FlyoutBase.AttachedFlyout>
          <Flyout Placement="Right">
            <TextBlock MaxWidth="280" TextWrapping="Wrap"
                       Text="This legacy panel is disabled. The IAU Rotational Model (Pole RA/Dec, Prime Meridian, and rotation rates) is now automatically parametrized and editable within the Comet tab upon committing a comet SPK." />
          </Flyout>
        </FlyoutBase.AttachedFlyout>
        <i:Interaction.Behaviors>
          <b:ShowFlyoutOnHoverBehavior DelayMs="500" />
        </i:Interaction.Behaviors>
        <Border Classes="accordion" IsEnabled="{Binding EnableLegacyExpanders}">
          <Expander AutomationProperties.AutomationId="NucleusSpinSection">
          <Expander.Header>
            <TextBlock Text="Nucleus and Spin Axis" />
          </Expander.Header>

          <Grid ColumnDefinitions="*,12,1.6*"
                RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                Margin="12,8,12,12">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrRadius}" />
            <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" />


            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrRotationPeriod}" />
            <controls:UnboundedSlider Grid.Row="4" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="h" />
              </controls:UnboundedSlider.InnerRightContent>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrRotations}" />
            <TextBox Grid.Row="6" Grid.Column="2">
              <i:Interaction.Behaviors>
                <b:NaturalNumberBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding StrRA}" />
            <controls:UnboundedSlider Grid.Row="8" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding StrDec}" />
            <controls:UnboundedSlider Grid.Row="10" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding StrPM}" />
            <controls:UnboundedSlider Grid.Row="12" Grid.Column="2">
              <controls:UnboundedSlider.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </controls:UnboundedSlider.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </controls:UnboundedSlider>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding StrSpinAxisPA}" />
            <TextBox Grid.Row="14" Grid.Column="2">
              <TextBox.InnerRightContent>
                <TextBlock Classes="unit-of-measurement" Text="°" />
              </TextBox.InnerRightContent>
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>

            <TextBlock Grid.Row="16" Grid.Column="0" Text="{Binding StrSpinAxisInclination}" />
            <TextBox Grid.Row="16" Grid.Column="2">
              <i:Interaction.Behaviors>
                <b:AngleBehavior />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </Expander>
        </Border>
      </Border>

      <!-- ══════════════════ DUST ═════════════════════════════════════════════ -->
      <Border Classes="accordion">
        <Expander AutomationProperties.AutomationId="DustSection">
          <Expander.Header>
            <TextBlock Text="Dust" />
          </Expander.Header>

          <StackPanel Orientation="Vertical" Spacing="0">

            <!-- ──── Reference-position error lines (comet vs osculating reference) ── -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,10,12,0">
              <CheckBox AutomationProperties.AutomationId="ShowReferenceErrorToggle"
                        Content="{Binding StrShowReferenceError}"
                        IsChecked="{Binding ShowReferencePositionError}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="ShowReferenceErrorToggleHelp"
                                           HelpHeader="{Binding StrShowReferenceError}"
                                           HelpContent="{Binding StrHelpShowReferenceError}"
                                           FlyoutMaxWidth="300" />
            </StackPanel>

            <!-- ──── Dust visibility: asinh display stretch softening ───── -->
            <Grid ColumnDefinitions="*,12,1.6*"
                  Margin="12,10,12,0">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustVisibility}"
                           VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustVisibilitySliderHelp"
                                             HelpHeader="{Binding StrDustVisibility}"
                                             HelpContent="{Binding StrHelpDustVisibility}"
                                             FlyoutMaxWidth="320" />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2"
                                        AutomationProperties.AutomationId="DustVisibilitySlider"
                                        Value="{Binding DustSoftening}"
                                        IsLogarithmic="True"
                                        HasBounds="True"
                                        MinBound="0.00001"
                                        MaxBound="1.0"
                                        DisplayFormat="G2" />
            </Grid>

            <!-- ──── Dust view aids: tracers (real particles) and flow pulses (marks on synchrones) ── -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,10,12,0">
              <CheckBox Content="{Binding StrDustFlow}"
                        IsChecked="{Binding DustFlow}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="DustFlowHelp"
                                           HelpHeader="{Binding StrDustFlow}"
                                           HelpContent="{Binding StrHelpDustFlow}"
                                           FlyoutMaxWidth="320" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,10,12,0">
              <CheckBox AutomationProperties.AutomationId="DustRhoNormToggle"
                        Content="{Binding StrDustRhoNorm}"
                        IsChecked="{Binding DustRhoNorm}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="DustRhoNormToggleHelp"
                                           HelpHeader="{Binding StrDustRhoNorm}"
                                           HelpContent="{Binding StrHelpDustRhoNorm}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,10,12,0">
              <CheckBox AutomationProperties.AutomationId="DustTrajectoriesToggle"
                        Content="{Binding StrDustTrajectories}"
                        IsChecked="{Binding DustTrajectories}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="DustTrajectoriesToggleHelp"
                                           HelpHeader="{Binding StrDustTrajectories}"
                                           HelpContent="{Binding StrHelpDustTrajectories}" />
            </StackPanel>

            <!-- ──── Dust exposure compensation over the automatic exposure ──── -->
            <Grid ColumnDefinitions="*,12,1.6*,8,Auto"
                  Margin="12,10,12,4">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustExposure}"
                           VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustExposureSliderHelp"
                                             HelpHeader="{Binding StrDustExposure}"
                                             HelpContent="{Binding StrHelpDustExposure}" />
              </StackPanel>
              <Slider Grid.Column="2"
                      AutomationProperties.AutomationId="DustExposureSlider"
                      Minimum="-6" Maximum="6"
                      SmallChange="0.25" LargeChange="1" TickFrequency="0.25" IsSnapToTickEnabled="True"
                      Value="{Binding DustExposureEv}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="4"
                         Text="{Binding DustExposureEvText}"
                         MinWidth="64"
                         VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,10,12,0">
              <CheckBox AutomationProperties.AutomationId="DustTracersToggle"
                        Content="{Binding StrDustTracers}"
                        IsChecked="{Binding DustTracers}" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="DustTracersToggleHelp"
                                           HelpHeader="{Binding StrDustTracers}"
                                           HelpContent="{Binding StrHelpDustTracers}"
                                           FlyoutMaxWidth="320" />
            </StackPanel>

            <!-- ──── Flow time-lapse factor of the dust marks ──────────── -->
            <Grid ColumnDefinitions="*,12,1.6*"
                  Margin="12,10,12,4">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustFlowSpeed}"
                           VerticalAlignment="Center" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustFlowSpeedSliderHelp"
                                             HelpHeader="{Binding StrDustFlowSpeed}"
                                             HelpContent="{Binding StrHelpDustFlowSpeed}"
                                             FlyoutMaxWidth="320" />
              </StackPanel>
              <controls:UnboundedSlider Grid.Column="2"
                                        AutomationProperties.AutomationId="DustFlowSpeedSlider"
                                        Value="{Binding DustFlowSpeed}"
                                        IsLogarithmic="True"
                                        HasBounds="True"
                                        MinBound="1"
                                        MaxBound="10000"
                                        DisplayFormat="G3" />
            </Grid>

            <!-- one ? for the gizmo and its parts -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,2,12,4">
              <CheckBox AutomationProperties.AutomationId="SphereGizmoVisibleCheckBox"
                        IsChecked="{Binding IsGizmoVisible}"
                        Content="Show sphere gizmo" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="SphereGizmoVisibleCheckBoxHelp"
                                           HelpHeader="{Binding StrHelpHeaderGizmo}"
                                           HelpContent="{Binding StrHelpGizmo}"
                                           FlyoutMaxWidth="300" />
            </StackPanel>
            <WrapPanel Margin="28,0,12,4" IsEnabled="{Binding IsGizmoVisible}">
              <CheckBox Margin="0,0,10,0" AutomationProperties.AutomationId="GizmoGridCheckBox" IsChecked="{Binding ShowGizmoGrid}" Content="Grid" />
              <CheckBox Margin="0,0,10,0" AutomationProperties.AutomationId="GizmoBodyAxesCheckBox" IsChecked="{Binding ShowGizmoBodyAxes}" Content="Body X/Y" />
              <CheckBox Margin="0,0,10,0" AutomationProperties.AutomationId="GizmoSpinAxisCheckBox" IsChecked="{Binding ShowGizmoSpinAxis}" Content="Spin axis" />
              <CheckBox Margin="0,0,10,0" AutomationProperties.AutomationId="GizmoSunCheckBox" IsChecked="{Binding ShowGizmoSun}" Content="Sun" />
              <CheckBox AutomationProperties.AutomationId="GizmoVelocityCheckBox" IsChecked="{Binding ShowGizmoVelocity}" Content="Velocity" />
            </WrapPanel>

            <!-- Warning: no radius known yet -->
            <TextBlock Margin="12,0,12,6"
                       IsVisible="{Binding IsNucleusRadiusUnknown}"
                       Text="⚠ Enter a nucleus radius in the Comet tab or commit a comet to enable jet creation."
                       Foreground="{DynamicResource Text.Tertiary}"
                       FontSize="11"
                       TextWrapping="Wrap" />

            <!-- ──── Jet list header ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="12,10,12,6">
              <TextBlock Grid.Column="0"
                         Text="Jets"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource Text.Secondary}"
                         VerticalAlignment="Center" />
              <Panel Grid.Column="1">
                <Button Classes="accent" AutomationProperties.AutomationId="AddJetButton"
                        Command="{Binding AddJetCommand}"
                        ToolTip.Tip="Add a new dust emission jet"
                        Padding="10,2"
                        Content="+" />

                <Border Background="Transparent" IsHitTestVisible="{Binding !IsCometCommitted}">
                  <FlyoutBase.AttachedFlyout>
                    <Flyout>
                      <TextBlock Text="Commit a comet first in the Almanac tab to add jets." MaxWidth="250" TextWrapping="Wrap" />
                    </Flyout>
                  </FlyoutBase.AttachedFlyout>
                  <i:Interaction.Behaviors>
                    <b:ShowFlyoutOnHoverBehavior />
                  </i:Interaction.Behaviors>
                </Border>
              </Panel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,2,12,4">
              <CheckBox AutomationProperties.AutomationId="ShowJetAnglesCheckBox"
                        IsChecked="{Binding ShowJetAngles}"
                        Content="Show jet angles" />
              <controls:PropertyHelpButton AutomationProperties.AutomationId="ShowJetAnglesCheckBoxHelp"
                                           HelpHeader="{Binding StrHelpHeaderJetAngles}"
                                           HelpContent="{Binding StrHelpJetAngles}" />
            </StackPanel>

            <!-- ──── Jet list ─────────────────────────────────────────────── -->
            <ListBox x:Name="JetListBox"
                     Classes="list-tray"
                     SelectionMode="Toggle"
                     ItemsSource="{Binding Jets}"
                     SelectedItem="{Binding SelectedJet, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JetViewModel">
                  <Grid ColumnDefinitions="*,32" VerticalAlignment="Center">

                    <!-- Jet label + coordinate summary -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="2"
                                VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold"
                                 Foreground="{DynamicResource Text.Primary}">
                        <Run Text="Jet #" /><Run Text="{Binding DisplayIndex}" />
                      </TextBlock>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="φ " /><Run Text="{Binding LatitudeDeg, StringFormat='{}{0:F1}°'}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="λ " /><Run Text="{Binding LongitudeDeg, StringFormat='{}{0:F1}°'}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Text.Tertiary}">
                          <Run Text="∠ " /><Run Text="{Binding ApertureDeg, StringFormat='{}{0:0.##}°'}" />
                        </TextBlock>
                      </StackPanel>
                      <!-- the core refused this jet: say so (it is not in the simulation) and offer a retry -->
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding NativeError, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Sem.Warning}"
                                   AutomationProperties.AutomationId="JetNativeErrorText"
                                   Text="⚠ Not in the simulation" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding NativeError}" />
                        <Button Content="Retry" Padding="6,0" FontSize="11"
                                AutomationProperties.AutomationId="JetRetryButton"
                                Command="{Binding #JetListBox.((vm:IModelTabViewModel)DataContext).RetryNativeJetsCommand}"
                                ToolTip.Tip="Ask the core again for every refused jet" />
                      </StackPanel>
                      <!-- the site is never lit over the committed range: the jet emits no dust -->
                      <TextBlock FontSize="11" Foreground="{DynamicResource Sem.Warning}" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="JetLitWarning"
                                 IsVisible="{Binding LitWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Text="{Binding LitWarning, StringFormat='⚠ {0}'}" />
                    </StackPanel>

                    <!-- Remove button — reflection binding to reach the parent UserControl's VM -->
                    <Button Grid.Column="1"
                            Content="−"
                            Command="{Binding #JetListBox.((vm:IModelTabViewModel)DataContext).RemoveJetCommand}"
                            CommandParameter="{Binding}"
                            Padding="6,2"
                            FontSize="15"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            ToolTip.Tip="Remove this jet" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty-state hint -->
            <TextBlock Margin="12,10,12,10"
                       IsVisible="{Binding !Jets.Count}"
                       Text="No jets configured. Press + to add one."
                       Foreground="{DynamicResource Text.Tertiary}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <!-- ──── Jet detail panel ─────────────────────────────────────── -->
            <!-- Slides in below the list when a jet is selected.             -->
            <Border IsVisible="{Binding SelectedJet, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderBrush="{DynamicResource Bg.Outline}"
                    BorderThickness="0,1,0,0">

              <!-- Coloured header strip -->
              <StackPanel Orientation="Vertical" Spacing="0">
                <Border Background="{DynamicResource Accent.Subtle}"
                        Padding="12,7">
                  <TextBlock Text="Jet Properties"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent.Primary}" />
                </Border>

                <!-- Property rows, DataContext switches to the selected JetViewModel -->
                <Border Background="{DynamicResource Bg.Subtle}"
                        Padding="12,12,12,12"
                        DataContext="{Binding SelectedJet}">

                <Grid ColumnDefinitions="*,12,1.6*"
                      RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                      x:DataType="vm:JetViewModel">

                  <!-- Latitude -->
                  <!-- the ?s in the jet panel read the tab VM's strings (DataContext here is the jet) -->
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Latitude" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetLatitudeSliderHelp"
                                                 HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrLatitude}"
                                                 HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetLatitude}" />
                  </StackPanel>
                  <controls:UnboundedSlider Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="JetLatitudeSlider"
                                            Value="{Binding LatitudeDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Longitude -->
                  <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Longitude" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetLongitudeSliderHelp"
                                                 HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrLongitude}"
                                                 HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetLongitude}" />
                  </StackPanel>
                  <controls:UnboundedSlider Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="JetLongitudeSlider"
                                            Value="{Binding LongitudeDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Aperture -->
                  <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Aperture" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetApertureHelp" HelpHeader="Aperture"
                                                 HelpContent="Half-angle of the emission cone." />
                  </StackPanel>
                  <controls:UnboundedSlider Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="JetApertureSlider"
                                            Value="{Binding ApertureDeg}">
                    <controls:UnboundedSlider.InnerRightContent>
                      <TextBlock Classes="unit-of-measurement" Text="°" />
                    </controls:UnboundedSlider.InnerRightContent>
                  </controls:UnboundedSlider>

                  <!-- Start Velocity Mean -->
                  <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Velocity" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetVelocityHelp" HelpHeader="Velocity"
                                                 HelpContent="Mean ejection speed of the grains." />
                  </StackPanel>
                  <Panel Grid.Row="6" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="JetVelocityBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding StartVelocityMeanMs}"
                                                 Minimum="0.01" Maximum="1000" Format="0.##" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="m/s" />
                  </Panel>

                  <!-- Velocity Std -->
                  <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Vel. σ" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetVelocityStdHelp" HelpHeader="Vel. σ"
                                                 HelpContent="Standard deviation (σ) of the ejection speed." />
                  </StackPanel>
                  <Panel Grid.Row="8" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="JetVelocityStdBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding StartVelocityStdMs}"
                                                 Minimum="0" Maximum="500" Format="0.###" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="m/s" />
                  </Panel>

                  <!-- Stream Color -->
                  <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Stream Color" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetStreamColorHelp"
                                                 HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderStreamColor}"
                                                 HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetStreamColor}" />
                  </StackPanel>
                  <ColorPicker Grid.Row="10" Grid.Column="2"
                               AutomationProperties.AutomationId="JetStreamColorPicker"
                               Color="{Binding StreamColor, Converter={x:Static converters:Vector4ToColorConverter.Instance}}"
                               HorizontalAlignment="Left" />

                  <!-- Computed: β -->
                  <StackPanel Grid.Row="12" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="β (beta)" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetBetaHelp"
                                                 HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderJetBeta}"
                                                 HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetBeta}"
                                                 FlyoutMaxWidth="300" />
                  </StackPanel>
                  <TextBox Grid.Row="12" Grid.Column="2"
                           Classes="computed"
                           AutomationProperties.AutomationId="JetBetaBox"
                           Text="{Binding Beta, StringFormat='{}{0:F4}'}" />

                  <!-- Computed: Dust production rate -->
                  <StackPanel Grid.Row="14" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Q_dust @ 1 AU" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetQDustHelp"
                                                 HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderJetQDust}"
                                                 HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetQDust}" />
                  </StackPanel>
                  <Panel Grid.Row="14" Grid.Column="2" Classes="unit-overlay">
                    <TextBox Classes="computed"
                             AutomationProperties.AutomationId="JetQDustBox"
                             Text="{Binding DustProductionRateAt1AuKgs, StringFormat='{}{0:F4}'}" />
                    <TextBlock Classes="unit-of-measurement" Text="kg/s" />
                  </Panel>

                </Grid>
              </Border><!-- /content Border -->

              <!-- ──── This jet's grain: every jet has its own (new jets start from the defaults below) ── -->
              <Expander AutomationProperties.AutomationId="JetGrainExpander" Margin="12,8,12,0">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Grain" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetGrainHelp"
                                                 HelpHeader="{Binding StrHelpHeaderJetGrain}"
                                                 HelpContent="{Binding StrHelpJetGrain}"
                                                 FlyoutMaxWidth="320" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8">
                  <Border DataContext="{Binding SelectedJet}">
                    <Grid ColumnDefinitions="*,12,1.6*"
                          RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto"
                          x:DataType="vm:JetViewModel">

                      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Diameter" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetDiametreUmHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderJetDiameter}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetDiameter}" />
                      </StackPanel>
                      <Panel Grid.Row="0" Grid.Column="2" Classes="unit-overlay">
                        <TextBox AutomationProperties.AutomationId="JetDiametreUm">
                          <i:Interaction.Behaviors>
                            <b:NumericTextBoxBehavior Value="{Binding DiametreUm}" Minimum="0.0001" Maximum="10000" />
                          </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Classes="unit-of-measurement" Text="μm" />
                      </Panel>

                      <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Density" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetDensityHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrDensity}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetDensity}" />
                      </StackPanel>
                      <Panel Grid.Row="2" Grid.Column="2" Classes="unit-overlay">
                        <TextBox AutomationProperties.AutomationId="JetDensity">
                          <i:Interaction.Behaviors>
                            <b:NumericTextBoxBehavior Value="{Binding DensityGCm3}" Minimum="0.00001" Maximum="7.0" />
                          </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Classes="unit-of-measurement" Text="g/cm³" />
                      </Panel>

                      <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Q_pr" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetQprHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderQpr}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetQpr}" />
                      </StackPanel>
                      <TextBox Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="JetQpr">
                        <i:Interaction.Behaviors>
                          <b:NumericTextBoxBehavior Value="{Binding ScatteringEfficiency}" Minimum="0.5" Maximum="2" />
                        </i:Interaction.Behaviors>
                      </TextBox>

                      <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Albedo" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetAlbedoHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrAlbedo}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetAlbedo}" />
                      </StackPanel>
                      <TextBox Grid.Row="6" Grid.Column="2" AutomationProperties.AutomationId="JetAlbedo">
                        <i:Interaction.Behaviors>
                          <b:NumericTextBoxBehavior Value="{Binding GeometricAlbedo}" Minimum="0.01" Maximum="0.5" />
                        </i:Interaction.Behaviors>
                      </TextBox>

                      <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Size law q" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetSizeQHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderSizeLawQ}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetSizeQ}" />
                      </StackPanel>
                      <TextBox Grid.Row="8" Grid.Column="2" AutomationProperties.AutomationId="JetSizeQ">
                        <i:Interaction.Behaviors>
                          <b:NumericTextBoxBehavior Value="{Binding SizeQ}" Minimum="2" Maximum="5" />
                        </i:Interaction.Behaviors>
                      </TextBox>

                      <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Size range F" />
                        <controls:PropertyHelpButton AutomationProperties.AutomationId="JetSizeRangeHelp"
                                                     HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderSizeRangeF}"
                                                     HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetSizeRange}" />
                      </StackPanel>
                      <TextBox Grid.Row="10" Grid.Column="2" AutomationProperties.AutomationId="JetSizeRange">
                        <i:Interaction.Behaviors>
                          <b:NumericTextBoxBehavior Value="{Binding SizeRange}" Minimum="1" Maximum="1000" />
                        </i:Interaction.Behaviors>
                      </TextBox>
                    </Grid>
                  </Border>

                  <controls:CurvePlot AutomationProperties.AutomationId="JetSizeDistributionPlot"
                                    Model="{Binding JetSizeDistributionPlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Sem.Warning}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
                </StackPanel>
              </Expander>

              <!-- ──── This jet's activity: its own Q_d₀, the law's shape is shared ── -->
              <Expander AutomationProperties.AutomationId="JetActivityExpander" Margin="12,8,12,0">
                <Expander.Header>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Advanced: activity (Q_d)" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="JetActivityHelp"
                                                 HelpHeader="{Binding StrHelpHeaderJetActivity}"
                                                 HelpContent="{Binding StrHelpJetActivity}"
                                                 FlyoutMaxWidth="320" />
                  </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,12,1.6*" DataContext="{Binding SelectedJet}" x:DataType="vm:JetViewModel">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Q_d at 1 AU (kg/s)" />
                      <controls:PropertyHelpButton AutomationProperties.AutomationId="JetDustRate0Help"
                                                   HelpHeader="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpHeaderQd1Au}"
                                                   HelpContent="{Binding $parent[view:ModelTabView].((vm:IModelTabViewModel)DataContext).StrHelpJetDustRate0}" />
                    </StackPanel>
                    <Panel Grid.Column="2" Classes="unit-overlay">
                      <TextBox AutomationProperties.AutomationId="JetDustRate0">
                        <i:Interaction.Behaviors>
                          <b:NumericTextBoxBehavior Value="{Binding DustRate1AuKgs}" Minimum="0" Maximum="1000000" Format="0.###" />
                        </i:Interaction.Behaviors>
                      </TextBox>
                      <TextBlock Classes="unit-of-measurement" Text="kg/s" />
                    </Panel>
                  </Grid>

                  <controls:CurvePlot AutomationProperties.AutomationId="JetDustRateCurvePlot"
                                    Model="{Binding JetDustRatePlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Accent.Secondary}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
                  <TextBlock AutomationProperties.AutomationId="DustRateNowText"
                             Text="{Binding DustRateNowText}"
                             FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource Text.Secondary}" />
                </StackPanel>
              </Expander>

              <StackPanel Orientation="Horizontal" Spacing="4"
                          Margin="12,8,12,12"
                          HorizontalAlignment="Right">
                <Button AutomationProperties.AutomationId="CopyGrainToAllJetsButton"
                        Padding="10,2"
                        Content="Copy to all jets"
                        Command="{Binding CopyGrainToAllJetsCommand}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="CopyGrainToAllJetsButtonHelp"
                                             VerticalAlignment="Center"
                                             HelpHeader="{Binding StrHelpHeaderCopyGrain}"
                                             HelpContent="{Binding StrHelpCopyGrain}" />
              </StackPanel>
            </StackPanel><!-- /detail StackPanel -->
          </Border><!-- /detail outer Border -->

            <!-- ──── Grain and activity defaults for new jets (each jet then has its own) ── -->
            <!-- Thin divider + section label separates this from the jet panel -->
            <Border BorderBrush="{DynamicResource Bg.Outline}"
                    BorderThickness="0,1,0,0"
                    Margin="0,0,0,0"
                    Padding="12,8,12,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Defaults for new jets"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Secondary}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="JetDefaultsHelp"
                                             HelpHeader="{Binding StrHelpHeaderJetDefaults}"
                                             HelpContent="{Binding StrHelpJetDefaults}"
                                             FlyoutMaxWidth="300" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,12,1.6*"
                  RowDefinitions="Auto,8,Auto,8,Auto,8,Auto"
                  Margin="12,8,12,8">

              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustDensity}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustDensityHelp"
                                             HelpHeader="{Binding StrDustDensity}"
                                             HelpContent="{Binding StrHelpDustDensity}" />
              </StackPanel>
              <Panel Grid.Row="0" Grid.Column="2" Classes="unit-overlay">
                <TextBox AutomationProperties.AutomationId="DustDensityBox">
                  <i:Interaction.Behaviors>
                    <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DensityGCm3}" Minimum="0.00001" Maximum="7.0" />
                  </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock Classes="unit-of-measurement" Text="g/cm³" />
              </Panel>

              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrDustDiameter}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustDiameterHelp"
                                             HelpHeader="{Binding StrDustDiameter}"
                                             HelpContent="{Binding StrHelpDustDiameter}" />
              </StackPanel>
              <Panel Grid.Row="2" Grid.Column="2" Classes="unit-overlay">
                <TextBox AutomationProperties.AutomationId="DustDiameterBox">
                  <i:Interaction.Behaviors>
                    <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DiametreUm}" Minimum="0.0001" Maximum="10000" />
                  </i:Interaction.Behaviors>
                </TextBox>
                <TextBlock Classes="unit-of-measurement" Text="μm" />
              </Panel>

              <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrScatteringEfficiency}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustQprHelp"
                                             HelpHeader="{Binding StrScatteringEfficiency}"
                                             HelpContent="{Binding StrHelpScatteringEfficiency}" />
              </StackPanel>
              <TextBox Grid.Row="4" Grid.Column="2" AutomationProperties.AutomationId="DustQprBox">
                <i:Interaction.Behaviors>
                  <b:NumericTextBoxBehavior Value="{Binding CurrentSession.ScatteringEfficiency}" Minimum="0.5" Maximum="2" />
                </i:Interaction.Behaviors>
              </TextBox>

              <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding StrGeometricAlbedo}" />
                <controls:PropertyHelpButton AutomationProperties.AutomationId="DustAlbedoHelp"
                                             HelpHeader="{Binding StrGeometricAlbedo}"
                                             HelpContent="{Binding StrHelpDustAlbedo}" />
              </StackPanel>
              <TextBox Grid.Row="6" Grid.Column="2" AutomationProperties.AutomationId="DustAlbedoBox">
                <i:Interaction.Behaviors>
                  <b:NumericTextBoxBehavior Value="{Binding CurrentSession.GeometricAlbedo}" Minimum="0.01" Maximum="0.5" />
                </i:Interaction.Behaviors>
              </TextBox>

            </Grid>

            <!-- Activity law: rarely changed, out of the way (it is not a grain-size law) -->
            <Expander AutomationProperties.AutomationId="ActivityAdvancedExpander" Margin="12,0,12,8">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Advanced: activity (Q_d)" />
                  <controls:PropertyHelpButton AutomationProperties.AutomationId="ActivityAdvancedHelp"
                                               HelpHeader="{Binding StrHelpHeaderActivity}"
                                               HelpContent="{Binding StrHelpActivity}"
                                               FlyoutMaxWidth="320" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8">
                <!-- the whole comet's activity: Σ over the jets -->
                <TextBlock AutomationProperties.AutomationId="TotalActivityText"
                           Text="{Binding TotalActivityText}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" />
                <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">

                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Q_d at 1 AU (kg/s)" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="DustRate0BoxHelp"
                                                 HelpHeader="{Binding StrHelpHeaderQd1Au}"
                                                 HelpContent="{Binding StrHelpDustRate0}" />
                  </StackPanel>
                  <Panel Grid.Row="0" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="DustRate0Box">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DustRate1AuKgs}" Minimum="0" Maximum="1000000" Format="0.###" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="kg/s" />
                  </Panel>

                  <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Q_d law exponent" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="DustRatePowerBoxHelp"
                                                 HelpHeader="{Binding StrHelpHeaderQdExponent}"
                                                 HelpContent="{Binding StrHelpDustRatePower}" />
                  </StackPanel>
                  <TextBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="DustRatePowerBox">
                    <i:Interaction.Behaviors>
                      <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DustRatePower}" Minimum="1" Maximum="4" />
                    </i:Interaction.Behaviors>
                  </TextBox>

                  <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Cutoff (AU)" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="DustRateCutoffBoxHelp"
                                                 HelpHeader="{Binding StrHelpHeaderQdCutoff}"
                                                 HelpContent="{Binding StrHelpDustRateCutoff}" />
                  </StackPanel>
                  <Panel Grid.Row="4" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="DustRateCutoffBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DustRateCutoffAu}" Minimum="3" Maximum="100" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="AU" />
                  </Panel>

                  <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Q_d max (kg/s)" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="DustRateMaxBoxHelp"
                                                 HelpHeader="{Binding StrHelpHeaderQdMax}"
                                                 HelpContent="{Binding StrHelpDustRateMax}" />
                  </StackPanel>
                  <Panel Grid.Row="6" Grid.Column="2" Classes="unit-overlay">
                    <TextBox AutomationProperties.AutomationId="DustRateMaxBox">
                      <i:Interaction.Behaviors>
                        <b:NumericTextBoxBehavior Value="{Binding CurrentSession.DustRateMaxKgs}" Minimum="0.001" Maximum="10000000" Format="0.###" />
                      </i:Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="unit-of-measurement" Text="kg/s" />
                  </Panel>
                </Grid>

                <controls:CurvePlot AutomationProperties.AutomationId="DustRateCurvePlot"
                                    Model="{Binding DustRatePlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Accent.Secondary}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
              </StackPanel>
            </Expander>

            <!-- Grain size law: only the discrete specks follow q -->
            <Expander AutomationProperties.AutomationId="SizeDistributionAdvancedExpander" Margin="12,0,12,12">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Advanced: grain size distribution" />
                  <controls:PropertyHelpButton AutomationProperties.AutomationId="SizeDistributionAdvancedHelp"
                                               HelpHeader="{Binding StrHelpHeaderSizeDistribution}"
                                               HelpContent="{Binding StrHelpSizeDistribution}"
                                               FlyoutMaxWidth="320" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="8">
                <!-- q is per jet only (jet Grain panel; reviewer 2026-10-29): new jets start at 3.5 -->
                <Grid ColumnDefinitions="*,12,1.6*" RowDefinitions="Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding StrSizeRange}" />
                    <controls:PropertyHelpButton AutomationProperties.AutomationId="SizeRangeBoxHelp"
                                                 HelpHeader="{Binding StrSizeRange}"
                                                 HelpContent="{Binding StrHelpSizeRange}" />
                  </StackPanel>
                  <TextBox Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="SizeRangeBox">
                    <i:Interaction.Behaviors>
                      <b:NumericTextBoxBehavior Value="{Binding CurrentSession.SizeRange}" Minimum="1" Maximum="1000" />
                    </i:Interaction.Behaviors>
                  </TextBox>
                </Grid>

                <controls:CurvePlot AutomationProperties.AutomationId="SizeDistributionPlot"
                                    Model="{Binding SizeDistributionPlot}"
                                    Height="140" HorizontalAlignment="Stretch"
                                    PlotBackground="{DynamicResource Bg.Surface}"
                                    PrimaryBrush="{DynamicResource Accent.Primary}"
                                    SecondaryBrush="{DynamicResource Sem.Warning}"
                                    MarkerBrush="{DynamicResource Sem.Warning}"
                                    AxisBrush="{DynamicResource Text.Disabled}"
                                    TextBrush="{DynamicResource Text.Secondary}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Expander>
      </Border>

    </StackPanel>
  </ScrollViewer>
  </VisualLayerManager>
</UserControl>