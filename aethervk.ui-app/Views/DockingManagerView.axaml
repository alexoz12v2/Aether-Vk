<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:local="using:AetherVk.Views"
             xmlns:dvm="using:AetherVk.Logic.ViewModels.Design"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:DockingManagerViewModel"
             x:Class="AetherVk.Views.DockingManagerView">
    <Design.DataContext>
        <vm:DockingManagerViewModel />
    </Design.DataContext>
    <!-- Data Template defined in App. TODO: ResourceDict -->
    <Grid>
        <ContentControl Content="{Binding RootNode}" />
    </Grid>
</UserControl>