<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        xmlns:controls="using:AetherVk.Controls"
        x:DataType="vm:SpawnCometViewModel"
        x:Class="AetherVk.Views.SpawnCometWindow"
        Title="Spawn Comet"
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Canvas}">
        
  <Grid RowDefinitions="Auto, *, Auto">
    
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource Bg.Outline}" Padding="16">
      <TextBlock Text="Spawn Comet" FontWeight="Bold" FontSize="18" />
    </Border>

    <!-- Main Content Area -->
    <ScrollViewer Grid.Row="1" Margin="16" Name="WizardContainer">
      <Panel>
      <Panel.Styles>
        <Style Selector="StackPanel.stepStack">
          <Setter Property="Spacing" Value="16" />
        </Style>
      </Panel.Styles>

      <!-- Step 1: Select Mesh -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep1}">
        <TextBlock Text="Step 1: Select 3D Mesh" FontWeight="Bold" FontSize="16" />
        
        <TabControl>
          <TabItem Header="Imported GLTF Assets">
            <Panel>
              <!-- Empty State -->
              <StackPanel IsVisible="{Binding HasNoModels}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,40,0,0">
                <Button Content="+" FontSize="24" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Classes="accent" Command="{Binding ImportMeshCommand}" />
                <TextBlock Text="No GLTF/GLB models imported. Import one from disk?" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
              </StackPanel>

              <!-- List State -->
              <Grid RowDefinitions="*, Auto" Margin="0,10,0,0" IsVisible="{Binding HasModels}">
                <ListBox ItemsSource="{Binding ImportedModels}" SelectedItem="{Binding SelectedModel}" Grid.Row="0" MaxHeight="250">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ImportedModelItem">
                      <TextBlock Text="{Binding Name}" Padding="8" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                  <Button Content="Import Mesh..." Command="{Binding ImportMeshCommand}" />
                </StackPanel>
              </Grid>
            </Panel>
          </TabItem>
        </TabControl>
      </StackPanel>

      <!-- Step 2: Physics Type -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep2}">
        <TextBlock Text="Step 2: Physics Interaction &amp; Placement" FontWeight="Bold" FontSize="16" />
        
        <Grid ColumnDefinitions="*,*,*" Margin="0,16,0,0">
          <RadioButton Grid.Column="0" Content="Static" GroupName="Physics" IsChecked="{Binding PhysicsType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Static'}" Margin="4" Classes="card" />
          
          <!-- WIP States -->
          <RadioButton Grid.Column="1" Content="Kinematic (WIP)" GroupName="Physics" IsEnabled="False" Margin="4" Classes="card" />
          <RadioButton Grid.Column="2" Content="Dynamic (WIP)" GroupName="Physics" IsEnabled="False" Margin="4" Classes="card" />
        </Grid>

        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,16,0,0" IsVisible="{Binding PhysicsType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='Static'}">
          <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
            <TextBlock Text="Position" FontWeight="Bold" />
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="1" Value="{Binding PosX}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="3" Value="{Binding PosY}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="5" Value="{Binding PosZ}"/>
            </Grid>

            <TextBlock Text="Scale" FontWeight="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="1" Value="{Binding ScaleX}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="3" Value="{Binding ScaleY}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <controls:UnboundedSlider Grid.Column="5" Value="{Binding ScaleZ}"/>
            </Grid>

            <TextBlock Text="Rotation (Degrees)" FontWeight="Bold" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="Auto, *">
              <TextBlock Grid.Column="0" Text="Pitch (X):" VerticalAlignment="Center" Width="60" />
              <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Pitch}" Margin="8,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto, *">
              <TextBlock Grid.Column="0" Text="Yaw (Y):" VerticalAlignment="Center" Width="60" />
              <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Yaw}" Margin="8,0" />
            </Grid>
            <Grid ColumnDefinitions="Auto, *">
              <TextBlock Grid.Column="0" Text="Roll (Z):" VerticalAlignment="Center" Width="60" />
              <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Roll}" Margin="8,0" />
            </Grid>
          </StackPanel>

          <!-- Frames -->
          <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0">
            <TextBlock Text="User Local Frame" FontWeight="Bold" />
            <TextBlock Text="{Binding UserLocalFrameString}" FontFamily="Consolas, Courier New, monospace" FontSize="12" />
            
            <TextBlock Text="Simulation Local Frame" FontWeight="Bold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding SimulationLocalFrameString}" FontFamily="Consolas, Courier New, monospace" FontSize="12" />
          </StackPanel>

          <!-- Gizmo -->
          <Border Grid.Column="2" Width="150" Height="150" Background="{DynamicResource Bg.Outline}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <controls:RotationGizmo Pitch="{Binding Pitch, Mode=TwoWay}" Yaw="{Binding Yaw, Mode=TwoWay}" Roll="{Binding Roll, Mode=TwoWay}" />
          </Border>
        </Grid>
      </StackPanel>

      <!-- Step 3: Horizon Data -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep3}">
        <TextBlock Text="Step 3: Horizon JPL Orbit Data" FontWeight="Bold" FontSize="16" />

        <StackPanel Spacing="12">
          <Button Content="Load JPL Comets Database" Command="{Binding FetchCometsCommand}" Classes="accent" HorizontalAlignment="Left" />
          
          <ComboBox ItemsSource="{Binding CometsData}" 
                    SelectedItem="{Binding SelectedComet}" 
                    PlaceholderText="Select a comet..."
                    MaxDropDownHeight="300"
                    Width="300"
                    HorizontalAlignment="Left">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Nucleus & Orbit Data (Visible only when a comet is selected) -->
        <StackPanel Spacing="16" Margin="0,16,0,0" IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="16">
              <TextBlock Text="Object Parameters" FontWeight="Bold" FontSize="14" />
              
              <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                <TextBlock Grid.Column="0" Text="Nucleus Radius (km):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <NumericUpDown Grid.Column="1" Value="{Binding CometRadiusKm}" FormatString="0.000" Minimum="0.001" Width="140" HorizontalAlignment="Left" ToolTip.Tip="Radius from Horizon JPL physical properties." />
              </Grid>

              <TextBlock Text="Orbital Elements (EPA)" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Target Date:" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding TargetDate}" />
                <Button Content="Fetch Orbit Data" Command="{Binding FetchOrbitDataCommand}" Classes="accent" />
              </StackPanel>

              <!-- EPA Results Grid -->
              <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto" Margin="0,12,0,0" IsVisible="{Binding FetchedOrbitData, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Semi-Major Axis:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FetchedOrbitData.SemiMajorAxis, StringFormat='{}{0:F4} AU'}" Margin="0,0,16,4"/>
                
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Eccentricity:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding FetchedOrbitData.Eccentricity, StringFormat='{}{0:F6}'}" Margin="0,0,0,4"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inclination:" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FetchedOrbitData.Inclination, StringFormat='{}{0:F4}°'}" Margin="0,0,16,0"/>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Mean Anomaly:" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding FetchedOrbitData.MeanAnomaly, StringFormat='{}{0:F4}°'}" Margin="0,0,0,0"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetchingHorizonData}" Height="4" Margin="0,10,0,0" />
      </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource Bg.Canvas}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,1,0,0" Padding="16">
      <Grid>
        <Button Content="Cancel" x:CompileBindings="False" Command="{Binding $parent[Window].CancelCommand}" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Back" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoBack}" />
          
          <Button Content="Next" Command="{Binding NextStepCommand}" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding !IsStep3}" Classes="accent" />
          
          <Button Content="Spawn" x:CompileBindings="False" Command="{Binding $parent[Window].SpawnCommand}" IsVisible="{Binding IsStep3}" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
