<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        xmlns:models="using:AetherVk.Logic.Models"
        xmlns:controls="using:AetherVk.Controls"
        x:DataType="vm:SpawnCometViewModel"
        x:Class="AetherVk.Views.SpawnCometWindow"
        Title="Spawn Comet"
        Width="650" Height="550"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Canvas}">
        
  <Grid RowDefinitions="Auto, *, Auto">
    
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource Bg.Outline}" Padding="16">
      <TextBlock Text="Spawn Comet" FontWeight="Bold" FontSize="18" />
    </Border>

    <!-- Main Content Area -->
    <ScrollViewer Grid.Row="1" Margin="16" Name="WizardContainer">
      <Panel>
      <Panel.Styles>
        <Style Selector="StackPanel.stepStack">
          <Setter Property="Spacing" Value="16" />
        </Style>
      </Panel.Styles>

      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <!-- Step 1: Select Mesh                                                   -->
      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep1}">
        <TextBlock Text="Step 1: Select 3D Mesh" FontWeight="Bold" FontSize="16" />
        
        <TabControl>
          <TabItem Header="Imported GLTF Assets">
            <Panel>
              <!-- Empty State -->
              <StackPanel IsVisible="{Binding HasNoModels}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,40,0,0">
                <Button Content="+" FontSize="24" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Classes="accent" Command="{Binding ImportMeshCommand}" />
                <TextBlock Text="No GLTF/GLB models imported. Import one from disk?" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
              </StackPanel>

              <!-- List State -->
              <Grid RowDefinitions="*, Auto" Margin="0,10,0,0" IsVisible="{Binding HasModels}">
                <ListBox ItemsSource="{Binding ImportedModels}" SelectedItem="{Binding SelectedModel}" Grid.Row="0" MaxHeight="250">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ImportedModelItem">
                      <TextBlock Text="{Binding Name}" Padding="8" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                  <Button Content="Import Mesh..." Command="{Binding ImportMeshCommand}" />
                </StackPanel>
              </Grid>
            </Panel>
          </TabItem>
        </TabControl>
      </StackPanel>

      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <!-- Step 2: Physics Type                                                  -->
      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep2}">
        <TextBlock Text="Step 2: Physics Interaction" FontWeight="Bold" FontSize="16" />
        
        <Grid ColumnDefinitions="*,*,*" Margin="0,16,0,0">
          <RadioButton Grid.Column="0" Content="Static" GroupName="Physics"
                       IsChecked="{Binding IsStaticMode}"
                       Command="{Binding SetPhysicsTypeCommand}" CommandParameter="Static"
                       Margin="4" Classes="card" />
          <RadioButton Grid.Column="1" Content="Kinematic" GroupName="Physics"
                       IsChecked="{Binding IsKinematicMode}"
                       Command="{Binding SetPhysicsTypeCommand}" CommandParameter="Kinematic"
                       Margin="4" Classes="card" />
          <RadioButton Grid.Column="2" Content="Dynamic (WIP)" GroupName="Physics" IsEnabled="False" Margin="4" Classes="card" />
        </Grid>

        <!-- Static Mode: Initial Position -->
        <StackPanel Spacing="12" Margin="0,20,0,0" IsVisible="{Binding IsStaticMode}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Initial Position (AU — Macro Frame)" FontWeight="Bold" FontSize="14" />
            <Button Background="Transparent" Padding="0" BorderThickness="0" Cursor="Hand">
              <Button.Flyout>
                <Flyout>
                  <TextBlock Text="Position is relative to the Sun, on the J2000 plane, in Astronomical Units (AU)." MaxWidth="250" TextWrapping="Wrap"/>
                </Flyout>
              </Button.Flyout>
              <PathIcon Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 13 17 L 11 17 L 11 11 L 13 11 L 13 17 Z M 13 9 L 11 9 L 11 7 L 13 7 L 13 9 Z" 
                          Width="14" Height="14" Foreground="{DynamicResource Text.Secondary}" />
            </Button>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <controls:UnboundedSlider Grid.Column="1" Value="{Binding PosX}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <controls:UnboundedSlider Grid.Column="3" Value="{Binding PosY}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="4" Text="Z:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <controls:UnboundedSlider Grid.Column="5" Value="{Binding PosZ}"/>
          </Grid>
        </StackPanel>

        <!-- Kinematic Mode: Info panel -->
        <Border Margin="0,20,0,0" IsVisible="{Binding IsKinematicMode}" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="Kinematic Mode" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Position will be driven by JPL Horizons SPK ephemeris data (almanac). Rotation will be driven by the IAU rotational model parameters set in Step 3." TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <!-- Step 3: Choose Comet + Nucleus Data                                   -->
      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep3}">
        <TextBlock Text="Step 3: Comet Selection &amp; Nucleus Data" FontWeight="Bold" FontSize="16" />

        <!-- Comet Search -->
        <StackPanel Spacing="12">
          <Button Content="Load JPL Comets Database" Command="{Binding FetchCometsCommand}" Classes="accent" HorizontalAlignment="Left" IsVisible="{Binding HasNoComets}" />
          
          <StackPanel Spacing="12" IsVisible="{Binding HasComets}">
            <AutoCompleteBox Name="CometsAutoCompleteBox"
                             ItemsSource="{Binding CometsData}" 
                             SelectedItem="{Binding SelectedComet}" 
                             ValueMemberBinding="{Binding Name, DataType=models:CometSearchResult}"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             Watermark="Type to search comets..."
                             MaxDropDownHeight="300"
                             DoubleTapped="CometsAutoCompleteBox_DoubleTapped"
                             HorizontalAlignment="Stretch" />
          </StackPanel>
        </StackPanel>

        <!-- SPK Record Selection -->
        <StackPanel Spacing="8" Margin="0,16,0,0"
                    IsVisible="{Binding SelectedComet, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Reference Year:" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding OrbitYear}" FormatString="0" Minimum="1900" Maximum="2100" Width="120" />
            </StackPanel>
            <Button Content="Fetch Historical Records"
                    Command="{Binding FetchSpkRecordsCommand}"
                    Classes="accent" HorizontalAlignment="Left" />
          </StackPanel>

          <ListBox ItemsSource="{Binding SpkRecordsData}"
                   SelectedItem="{Binding SelectedSpkRecord}"
                   MaxHeight="120"
                   IsVisible="{Binding HasSpkRecords}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="models:SpkRecordItem">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding RecordId}" FontFamily="Consolas, Courier New, monospace" FontWeight="Bold" Width="80" />
                  <TextBlock Text="{Binding EpochYear}" Foreground="{DynamicResource Text.Secondary}" Width="40" />
                  <TextBlock Text="—" Foreground="{DynamicResource Text.Secondary}" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <!-- Nucleus Parameters (visible once SPK record is selected) -->
        <Border Margin="0,16,0,0" IsVisible="{Binding HasValidSpkRecord}"
                Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Nucleus Parameters" FontWeight="Bold" FontSize="14" />

            <!-- Radius -->
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto, Auto, Auto">
                <TextBlock Grid.Column="0" Text="Radius (km):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <controls:UnboundedSlider Grid.Column="1" Value="{Binding CometRadiusKm}" Width="200" />
                <Button Grid.Column="2" Content="↺ Reset" Command="{Binding ResetRadiusCommand}"
                        IsVisible="{Binding IsRadiusOverridden}"
                        Margin="8,0,0,0" Padding="8,4" FontSize="11" />
              </Grid>
            </StackPanel>

            <!-- Mass -->
            <Grid ColumnDefinitions="Auto, *">
              <TextBlock Grid.Column="0" Text="Mass (kg):" VerticalAlignment="Center" FontWeight="SemiBold" Width="90" />
              <controls:UnboundedSlider Grid.Column="1" Value="{Binding MassKg}" />
            </Grid>

            <!-- Entity Name -->
            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Entity Name" FontWeight="SemiBold" />
              <TextBox Text="{Binding EntityName}" Watermark="New Comet" />
            </StackPanel>

            <!-- Initial Orientation -->
            <TextBlock Text="Orientation" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
              <StackPanel Grid.Column="0" Spacing="8">
                <Grid ColumnDefinitions="Auto, *">
                  <TextBlock Grid.Column="0" Text="Pitch (X):" VerticalAlignment="Center" Width="70" />
                  <controls:UnboundedSlider Grid.Column="1" Value="{Binding Pitch}" IsWrapped="True" Margin="8,0" />
                </Grid>
                <Grid ColumnDefinitions="Auto, *">
                  <TextBlock Grid.Column="0" Text="Yaw (Y):" VerticalAlignment="Center" Width="70" />
                  <controls:UnboundedSlider Grid.Column="1" Value="{Binding Yaw}" IsWrapped="True" Margin="8,0" />
                </Grid>
                <Grid ColumnDefinitions="Auto, *">
                  <TextBlock Grid.Column="0" Text="Roll (Z):" VerticalAlignment="Center" Width="70" />
                  <controls:UnboundedSlider Grid.Column="1" Value="{Binding Roll}" IsWrapped="True" Margin="8,0" />
                </Grid>

                <!-- Local Frames -->
                <StackPanel Spacing="4" Margin="0,8,0,0">
                  <TextBlock Text="User Local Frame" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding UserLocalFrameString}" FontFamily="Consolas, Courier New, monospace" FontSize="11" />
                  <TextBlock Text="Sim Local Frame" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding SimulationLocalFrameString}" FontFamily="Consolas, Courier New, monospace" FontSize="11" />
                </StackPanel>
              </StackPanel>

              <!-- Gizmo -->
              <Border Grid.Column="1" Width="120" Height="120" Background="{DynamicResource Bg.Outline}" CornerRadius="8" Padding="12" VerticalAlignment="Top" Margin="12,0,0,0">
                <controls:RotationGizmo Pitch="{Binding Pitch, Mode=TwoWay}" Yaw="{Binding Yaw, Mode=TwoWay}" Roll="{Binding Roll, Mode=TwoWay}" />
              </Border>
            </Grid>

            <!-- IAU Rotational Model -->
            <Expander Header="IAU Rotational Model (optional)" Margin="0,8,0,0">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Pole RA (°):" VerticalAlignment="Center" Width="120" />
                  <controls:UnboundedSlider Grid.Row="0" Grid.Column="1" Value="{Binding PoleRaDeg}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Pole Dec (°):" VerticalAlignment="Center" Width="120" Margin="0,4,0,0" />
                  <controls:UnboundedSlider Grid.Row="1" Grid.Column="1" Value="{Binding PoleDecDeg}" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Prime Meridian (°):" VerticalAlignment="Center" Width="120" Margin="0,4,0,0" />
                  <controls:UnboundedSlider Grid.Row="2" Grid.Column="1" Value="{Binding PrimeMeridianDeg}" Margin="0,4,0,0" />
                </Grid>

                <TextBlock Text="Rates" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Pole RA rate (°/cy):" VerticalAlignment="Center" Width="140" />
                  <controls:UnboundedSlider Grid.Row="0" Grid.Column="1" Value="{Binding PoleRaRateDeg}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Pole Dec rate (°/cy):" VerticalAlignment="Center" Width="140" Margin="0,4,0,0" />
                  <controls:UnboundedSlider Grid.Row="1" Grid.Column="1" Value="{Binding PoleDecRateDeg}" Margin="0,4,0,0" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Spin rate (°/day):" VerticalAlignment="Center" Width="140" Margin="0,4,0,0" />
                  <controls:UnboundedSlider Grid.Row="2" Grid.Column="1" Value="{Binding RotationRateDeg}" Margin="0,4,0,0" />
                </Grid>
              </StackPanel>
            </Expander>

            <!-- Angular Velocity -->
            <TextBlock Text="Angular Velocity (rad/s)" FontWeight="Bold" FontSize="14" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,4,0,0">
              <TextBlock Grid.Column="0" Text="ωx:" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <controls:UnboundedSlider Grid.Column="1" Value="{Binding AngularVelX}" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="2" Text="ωy:" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <controls:UnboundedSlider Grid.Column="3" Value="{Binding AngularVelY}" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="4" Text="ωz:" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <controls:UnboundedSlider Grid.Column="5" Value="{Binding AngularVelZ}"/>
            </Grid>
          </StackPanel>
        </Border>
        
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsFetchingHorizonData}" Height="4" Margin="0,10,0,0" />
      </StackPanel>

      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <!-- Step 4: Timeline Confirmation                                         -->
      <!-- ══════════════════════════════════════════════════════════════════════ -->
      <StackPanel Classes="stepStack" IsVisible="{Binding IsStep4}">
        <TextBlock Text="Step 4: Confirm Timeline" FontWeight="Bold" FontSize="16" />

        <TextBlock Text="Set the simulation epoch interval. SPK coverage will be verified (and downloaded if necessary) when you click Validate." TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />

        <!-- Start Epoch -->
        <controls:EpochDatePicker Label="Start Epoch" SelectedEpoch="{Binding WizardStartEpoch, Mode=TwoWay}" />

        <!-- End Epoch -->
        <controls:EpochDatePicker Label="End Epoch" SelectedEpoch="{Binding WizardEndEpoch, Mode=TwoWay}" />

        <!-- Validation Message -->
        <TextBlock Text="Start epoch must be before end epoch."
                   IsVisible="{Binding !IsEpochRangeValid}"
                   Foreground="Orange" FontSize="12" />

        <!-- Validate Timeline Button -->
        <Button Content="Validate Timeline"
                Command="{Binding ValidateTimelineCommand}"
                IsEnabled="{Binding CanValidateTimeline}"
                Classes="accent"
                HorizontalAlignment="Left" />

        <!-- Validation Progress -->
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsValidatingTimeline}" Height="4" />

        <!-- Validation Status -->
        <TextBlock Text="{Binding TimelineValidationStatus}"
                   IsVisible="{Binding TimelineValidationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="13"
                   Foreground="{DynamicResource Text.Secondary}" />
      </StackPanel>
      </Panel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource Bg.Canvas}" BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="0,1,0,0" Padding="16">
      <Grid>
        <Button Content="Cancel" x:CompileBindings="False" Command="{Binding $parent[Window].CancelCommand}" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Back" Command="{Binding PreviousStepCommand}" IsEnabled="{Binding CanGoBack}" />
          
          <Button Content="Next" Command="{Binding NextStepCommand}" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding !IsFinalStep}" Classes="accent" />
          
          <Button Content="Spawn" x:CompileBindings="False" Command="{Binding $parent[Window].SpawnCommand}" IsEnabled="{Binding IsTimelineValidated}" IsVisible="{Binding IsFinalStep}" Classes="accent" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
