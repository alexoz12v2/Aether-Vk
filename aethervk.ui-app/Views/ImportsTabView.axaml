<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AetherVk.Logic.ViewModels"
             xmlns:view="using:AetherVk.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AetherVk.Views.ImportsTabView"
             x:DataType="vm:IImportsTabViewModel">
    <Design.DataContext>
        <vm:DesignImportsTabViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="../Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- TODO: implement ImportsTabView -->
    <Border Background="{DynamicResource Bg.Canvas}" Padding="16">
        <TextBlock Text="TODO: implement ImportsTabView"
                   Foreground="{DynamicResource Text.Secondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>
