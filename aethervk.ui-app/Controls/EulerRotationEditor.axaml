<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AetherVk.Controls"
             x:Class="AetherVk.Controls.EulerRotationEditor"
             x:CompileBindings="False">
    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding IsRotationEditable}">
        <TextBlock Grid.Column="0" Text="Pitch (X):" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <controls:UnboundedSlider Grid.Column="1" Value="{Binding RotXDeg, RelativeSource={RelativeSource AncestorType=controls:EulerRotationEditor}}" IsWrapped="True" WrapMin="0" WrapMax="360" Margin="0,0,8,0"/>
        
        <TextBlock Grid.Column="2" Text="Yaw (Y):" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <controls:UnboundedSlider Grid.Column="3" Value="{Binding RotYDeg, RelativeSource={RelativeSource AncestorType=controls:EulerRotationEditor}}" IsWrapped="True" WrapMin="0" WrapMax="360" Margin="0,0,8,0"/>
        
        <TextBlock Grid.Column="4" Text="Roll (Z):" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <controls:UnboundedSlider Grid.Column="5" Value="{Binding RotZDeg, RelativeSource={RelativeSource AncestorType=controls:EulerRotationEditor}}" IsWrapped="True" WrapMin="0" WrapMax="360"/>
    </Grid>
</UserControl>
