<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AetherVk.Controls"
             x:Class="AetherVk.Controls.PropertyHelpButton"
             x:DataType="controls:PropertyHelpButton">

  <!--
    A small circled question-mark icon that opens an informational flyout.
    HelpHeader and HelpContent are bound by the parent view via StyledProperty.
    Opened with the pointer, the flyout stays while the pointer is over the ? or the panel and
    hides shortly after it leaves both; a click inside the panel (or opening it with the
    keyboard) pins it until a click outside or Escape. The hover ToolTip on the ? shows the
    header. Accessible name and AutomationId are forwarded to the inner button in code.
  -->
  <!--
    Hit target: the button is 24×24 but a -3 margin keeps its layout footprint at the old
    18×18, so existing rows do not move; the icon stays 14×14 inside.
  -->
  <Button x:Name="HelpBtn"
          Classes="help-trigger"
          Width="24" Height="24"
          Margin="-3"
          Padding="0"
          VerticalAlignment="Center">

    <!-- ── Circled ? icon ──────────────────────────────────────────────────
         All drawn on a nominal 18×18 canvas with Stretch="Uniform".

         Sub-paths:
           1. Full circle (r=7, centre 9,9).  The near-duplicate endpoint
              trick (8.999 vs 9) forces Avalonia to render the closed arc.
           2. Question-mark curve (cubic Bézier segments).
           3. Question-mark stem.
           4. Dot below the stem.
    ──────────────────────────────────────────────────────────────────────-->
    <Path Width="14" Height="14"
          Stretch="Uniform"
          Fill="{DynamicResource Text.Tertiary}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Data="M 9,2 A 7,7 0 1 1 8.999,2 Z
                M 9,11.5 C 8.45,11.5 8,11.95 8,12.5
                         C 8,13.05 8.45,13.5 9,13.5
                         C 9.55,13.5 10,13.05 10,12.5
                         C 10,11.95 9.55,11.5 9,11.5 Z
                M 9,10.5 L 9,9.8
                  C 10.35,9.35 11.25,8.05 11,6.6
                  C 10.75,5.1 9.45,4 7.95,4.05
                  C 6.6,4.1 5.5,5.05 5.2,6.35
                  C 5.1,6.85 5.45,7.35 5.95,7.45
                  C 6.45,7.55 6.95,7.2 7.05,6.7
                  C 7.2,6.05 7.8,5.6 8.45,5.6
                  C 9.2,5.6 9.8,6.2 9.8,6.95
                  C 9.8,7.65 9.2,8.2 8.45,8.2
                  C 7.9,8.2 7.45,8.65 7.45,9.2
                  L 7.45,10.5
                  C 7.45,11.05 7.9,11.5 8.45,11.5 Z"/>

    <Button.Flyout>
      <!--
        ShowMode=Transient: a click outside or Escape closes it. The pointer-away dismissal of
        an unpinned flyout is done in code over the union of the ? and the panel (the built-in
        TransientWithDismissOnPointerMoveAway closed it while the text was being read).
        Placement is overridden from FlyoutPlacement in code.
      -->
      <Flyout
              Placement="RightEdgeAlignedTop"
              ShowMode="Transient">
        <!--
          DataContext is pushed to this Border on Opened (DataContext = the PropertyHelpButton).
          x:DataType here tells the compiler the expected type inside this scope.
        -->
        <Border x:Name="HelpPanel"
                Classes="help-flyout-panel"
                x:DataType="controls:PropertyHelpButton">
          <StackPanel Spacing="5" MaxWidth="{Binding FlyoutMaxWidth}">

            <!-- Header: bold label for the orbital element -->
            <TextBlock Classes="help-flyout-header"
                       Text="{Binding HelpHeader}"/>

            <!-- Body: one word-wrapped TextBlock per paragraph (blank-line separated) -->
            <ItemsControl Classes="help-flyout-paragraphs"
                          ItemsSource="{Binding Paragraphs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="help-flyout-body"
                             Text="{Binding}"
                             TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Optional footer action (hidden unless ActionText is set) -->
            <Button x:Name="ActionBtn"
                    Classes="help-flyout-action"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0"
                    Content="{Binding ActionText}"
                    IsVisible="{Binding ActionText, Converter={x:Static ObjectConverters.IsNotNull}}"/>

          </StackPanel>
        </Border>
      </Flyout>
    </Button.Flyout>

  </Button>

</UserControl>
