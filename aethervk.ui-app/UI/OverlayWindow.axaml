<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AetherVk.UI"
        xmlns:controls="using:AetherVk.UI.Controls"
        xmlns:vm="using:AetherVk.Logic.ViewModels"
        xmlns:vmDebug="using:AetherVk.Logic.ViewModels.Debug"
        xmlns:conv="using:AetherVk.Converters"
        x:DataType="vm:ViewportOverlayViewModel"
        x:Class="AetherVk.UI.OverlayWindow"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="False">

  <Panel Name="TransparentRoot" Background="Transparent">

    <!-- Restored Camera Mode Indicator -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="10,10,10,0"
            CornerRadius="10"
            Background="{DynamicResource Bg.Surface}" Opacity="0.85"
            BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1"
            ClipToBounds="True"
            Classes.expanded="{Binding IsModeIndicatorExpanded}">
      <Border.Styles>
        <Style Selector="Border">
          <Setter Property="MaxWidth" Value="44"/>
        </Style>
        <Style Selector="Border.expanded">
          <Setter Property="MaxWidth" Value="210"/>
        </Style>
      </Border.Styles>
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="MaxWidth" Duration="0:0:0.32" Easing="CubicEaseInOut"/>
        </Transitions>
      </Border.Transitions>

      <StackPanel Orientation="Horizontal" Spacing="0" Margin="12,8">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
          <Grid>
            <Canvas Width="16" Height="16" IsVisible="{Binding IsModeEarthPosition}">
              <Path Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.2" Fill="Transparent"
                    Data="M 8 1 A 7 7 0 1 1 7.999 1 Z
                    M 1 8 L 15 8
                    M 8 1 C 12 1 12 15 8 15
                    M 8 1 C 4 1 4 15 8 15"/>
            </Canvas>

            <Canvas Width="16" Height="16" IsVisible="{Binding IsModeUpZenith}">
              <Path Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.2"
                    StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                    Data="M 0 15 L 16 15
                    M 8 13 L 8 2
                    M 4 7 L 8 2 L 12 7"/>
            </Canvas>

            <Canvas Width="16" Height="16" IsVisible="{Binding IsModeCometOrbiting}">
              <Path Stroke="{DynamicResource Text.Primary}" StrokeThickness="1.2" Fill="Transparent"
                    Data="M 1 8 A 7 3.5 0 0 1 15 8 A 7 3.5 0 0 1 1 8 Z"/>
              <Ellipse Canvas.Left="11" Canvas.Top="5" Width="4" Height="4"
                       Fill="{DynamicResource Text.Primary}"/>
            </Canvas>
          </Grid>
        </Viewbox>

        <TextBlock Text="{Binding CameraModeName}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text.Primary}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Classes.expanded="{Binding IsModeIndicatorExpanded}">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="TextBlock.expanded">
              <Setter Property="Opacity" Value="1"/>
            </Style>
          </TextBlock.Styles>
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Detached Camera Matrix Debug Panel -->
    <controls:DebugOnly>
      <Template>
        <Border x:CompileBindings="False"
                DataContext="{ReflectionBinding CameraMatrixDebug}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="10,60,10,0"
                Background="{DynamicResource Bg.Surface}" Opacity="0.85"
                BorderBrush="{DynamicResource Bg.Outline}" BorderThickness="1"
                CornerRadius="8" Padding="12,8">
          <ui:CameraMatrixDebugPanel />
        </Border>
      </Template>
    </controls:DebugOnly>

    <ItemsControl ItemsSource="{Binding Billboards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:BillboardViewModel">
          <Grid RenderTransformOrigin="50%,50%">
            <Grid.RenderTransform>
              <RotateTransform Angle="{Binding Rotation}" />
            </Grid.RenderTransform>

            <StackPanel Orientation="Vertical">
              <!-- No conv reference because we don't have it here... Wait, we do! But we need xmlns.
              Let's add xmlns:conv="using:AetherVk.Converters" to the Window -->
              <Image Source="{Binding ImageSource, Converter={x:Static conv:FilePathToBitmapConverter.Instance}}"
                     Width="{Binding ScaledWidth}" Height="{Binding ScaledHeight}" Opacity="{Binding Opacity}"
                     IsVisible="{Binding ImageSource, Converter={x:Static ObjectConverters.IsNotNull}}"
                     IsHitTestVisible="{Binding IsSelected}"
                     Cursor="SizeAll" />
              <Border Background="{DynamicResource Bg.Surface}" CornerRadius="4" Padding="4"
                      IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Text.Primary}"
                           FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>

            <Border IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2"
                    CornerRadius="4" Margin="-4" Padding="0" Background="Transparent" />

            <Button IsVisible="{Binding IsSelected}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="20" Height="20" Padding="0"
                    Background="{DynamicResource Sem.Error}" Foreground="White"
                    CornerRadius="10" FontSize="10" Content="✕"
                    Command="{Binding $parent[ItemsControl].((vm:ViewportOverlayViewModel)DataContext).RemoveBillboardCommand}"
                    CommandParameter="{Binding}"
                    Margin="0,-12,-12,0" />

            <Ellipse IsVisible="{Binding IsSelected}" Width="10" Height="10"
                     Fill="{DynamicResource Sem.Warning}" Stroke="White" StrokeThickness="1"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-5,-5,0,0" Cursor="TopLeftCorner" />
            <Ellipse IsVisible="{Binding IsSelected}" Width="10" Height="10"
                     Fill="{DynamicResource Sem.Warning}" Stroke="White" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-5,-5,0" Cursor="TopRightCorner" />
            <Ellipse IsVisible="{Binding IsSelected}" Width="10" Height="10"
                     Fill="{DynamicResource Sem.Warning}" Stroke="White" StrokeThickness="1"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-5,0,0,-5" Cursor="BottomLeftCorner" />
            <Ellipse IsVisible="{Binding IsSelected}" Width="10" Height="10"
                     Fill="{DynamicResource Sem.Warning}" Stroke="White" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-5,-5" Cursor="BottomRightCorner" />

            <Ellipse IsVisible="{Binding IsSelected}"
                     Width="14" Height="14" Fill="{DynamicResource Accent.Primary}"
                     Stroke="White" StrokeThickness="1.5"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-20,0,0" Cursor="Hand"
                     ToolTip.Tip="Drag to rotate (Ctrl = 15° snap)" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter" x:DataType="vm:BillboardViewModel">
          <Setter Property="Canvas.Left" Value="{Binding X}" />
          <Setter Property="Canvas.Top" Value="{Binding Y}" />
          <Setter Property="ZIndex" Value="{Binding ZIndex}" />
          <Setter Property="IsVisible" Value="{Binding IsEntityVisible}" />
        </Style>
      </ItemsControl.Styles>
    </ItemsControl>

    <Canvas x:Name="GoniometerOverlay" IsHitTestVisible="False" IsVisible="False" />



    <!--  Measurement Indicator -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10,5"
            Background="Transparent"
            IsVisible="{Binding ShowMeasurementIndicator}">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding MeasurementIndicatorText}" FontSize="12" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center" FontWeight="Bold"/>
        <Grid Width="{Binding MeasurementIndicatorWidth}" Height="8" HorizontalAlignment="Center">
          <Border Height="2" Background="{DynamicResource Text.Primary}" VerticalAlignment="Center" />
          <Border Width="2" Background="{DynamicResource Text.Primary}" HorizontalAlignment="Left" />
          <Border Width="2" Background="{DynamicResource Text.Primary}" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Comet Orbit Debug Panel — bottom-left, visible only in CometOrbiting mode -->
    <controls:DebugOnly>
      <Template>
        <Border x:CompileBindings="False"
                DataContext="{ReflectionBinding CometOrbitDebug}"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="10,0,0,60"
                IsVisible="{Binding IsVisible}">
          <ui:CometOrbitDebugPanel/>
        </Border>
      </Template>
    </controls:DebugOnly>

    <!-- Debug Telemetry Panel -->
    <controls:DebugOnly>
      <Template>
        <Border x:CompileBindings="False"
                DataContext="{ReflectionBinding DebugTelemetry}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10,10,0,0">
          <ui:DebugTelemetryPanel />
        </Border>
      </Template>
    </controls:DebugOnly>



    <!--
    RenderDoc frame-capture button.
    Wrapped in DebugOnly so it's not instantiated in Release builds.
    -->
    <controls:DebugOnly>
      <Template>
        <Border x:CompileBindings="False"
                DataContext="{ReflectionBinding RenderDoc}"
                CornerRadius="6"
                Background="{DynamicResource Bg.Surface}" Opacity="0.9"
                BorderBrush="#994444" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,10"
                IsVisible="{Binding IsRenderDocAvailable}">
          <Button Command="{Binding CaptureCommand}"
                  ToolTip.Tip="Capture the next rendered frame (RenderDoc)"
                  Padding="8,5"
                  Background="Transparent"
                  Foreground="{DynamicResource Text.Primary}">
            📷 Capture Frame
          </Button>
        </Border>
      </Template>
    </controls:DebugOnly>

    <!-- Sun direction indicator ─────────────────────────────────────────────
    Shown only when the sun is outside the camera frustum (IsSunOffScreen = true).
    A gold "^" chevron rotates to point toward the off-screen sun.
    SunIndicatorLeft / SunIndicatorTop position the 24×24 border so its centre sits
    on a circle of radius min(32 epx, min(W,H)/2) around the viewport centre.
    SunIndicatorAngleDeg (clockwise from screen-up) is applied by the RotateTransform. -->
    <Canvas IsHitTestVisible="False"
            IsVisible="{Binding IsSunOffScreen}">
      <Border Canvas.Left="{Binding SunIndicatorLeft}"
              Canvas.Top="{Binding SunIndicatorTop}"
              Width="24" Height="24"
              Background="Transparent">
        <Border.RenderTransform>
          <!-- Rotate around the border centre so the ^ tip always points toward the sun -->
          <RotateTransform Angle="{Binding SunIndicatorAngleDeg}"
                           CenterX="12" CenterY="12"/>
        </Border.RenderTransform>
        <!-- "^" chevron pointing up at 0°; yellow/gold (#FFD700) -->
        <Path Stroke="#FFD700" StrokeThickness="2.5"
              StrokeLineCap="Round" StrokeJoin="Round"
              Data="M 12 2 L 22 14 M 12 2 L 2 14"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>
      </Border>
    </Canvas>

    <!-- Simulation Current Epoch Overlay -->
    <ContentControl Content="{Binding CurrentEpochString}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type x:String}">
          <TextBlock Text="{Binding}" Foreground="White" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Jet Preview Size Overlay -->
    <ContentControl Content="{Binding JetPreviewSizeString}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="{x:Type x:String}">
          <TextBlock Text="{Binding}" Foreground="LightGray" FontSize="12" IsVisible="{Binding Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

  </Panel>
</Window>