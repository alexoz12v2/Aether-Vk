<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AetherVk.UI.CameraMatrixDebugPanel">

  <StackPanel Spacing="6">
  <Grid ColumnDefinitions="Auto,24,Auto" Margin="0,4,0,0">

    <!-- POS column -->
    <StackPanel Grid.Column="0" Spacing="1">
      <TextBlock Text="POSITION (km)"
                 FontWeight="Bold" FontSize="9"
                 Foreground="{DynamicResource Accent.Primary}"
                 Margin="0,0,0,3"/>
      <TextBlock Text="{ReflectionBinding PosX, StringFormat='X: {0:F3}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{ReflectionBinding PosY, StringFormat='Y: {0:F3}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{ReflectionBinding PosZ, StringFormat='Z: {0:F3}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
    </StackPanel>

    <!-- ROT column -->
    <StackPanel Grid.Column="2" Spacing="1">
      <TextBlock Text="ROTATION (Quat)"
                 FontWeight="Bold" FontSize="9"
                 Foreground="{DynamicResource Accent.Primary}"
                 Margin="0,0,0,3"/>
      <TextBlock Text="{ReflectionBinding RotX, StringFormat='X: {0:F4}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{ReflectionBinding RotY, StringFormat='Y: {0:F4}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{ReflectionBinding RotZ, StringFormat='Z: {0:F4}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
      <TextBlock Text="{ReflectionBinding RotW, StringFormat='W: {0:F4}'}"
                 FontFamily="Consolas,Monospace" FontSize="9"
                 Foreground="{DynamicResource Text.Primary}"/>
    </StackPanel>

  </Grid>

  <!-- Native Earth observer (mode, aim error, target elevation) -->
  <StackPanel Spacing="1" IsVisible="{ReflectionBinding EarthObserver, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
    <TextBlock Text="EARTH OBSERVER"
               FontWeight="Bold" FontSize="9"
               Foreground="{DynamicResource Accent.Primary}"
               Margin="0,0,0,3"/>
    <TextBlock Text="{ReflectionBinding EarthObserver}"
               FontFamily="Consolas,Monospace" FontSize="9"
               Foreground="{DynamicResource Text.Primary}"/>
  </StackPanel>

  <!-- Dust history per age tier (live/capacity, age span present, band) -->
  <StackPanel Spacing="1" IsVisible="{ReflectionBinding DustHistory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
    <TextBlock Text="DUST HISTORY"
               FontWeight="Bold" FontSize="9"
               Foreground="{DynamicResource Accent.Primary}"
               Margin="0,0,0,3"/>
    <TextBlock Text="{ReflectionBinding DustHistory}"
               FontFamily="Consolas,Monospace" FontSize="9"
               Foreground="{DynamicResource Text.Primary}"/>
  </StackPanel>
  </StackPanel>
</UserControl>
